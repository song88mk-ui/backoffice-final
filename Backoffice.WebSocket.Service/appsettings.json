{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "MessageBroker": {
    "Host": "localhost",
    "Username": "fcadmin",
    "Password": "${RABBITMQ_PASSWORD}",
    "VirtualHost": "/",
    "Exchange": "e.central",
    "Queue": "q.bo.websocket",
    "Consumer": "BO.WebSocket.Service",
    "RoutingKey": "r.oe.sb.engine.onoddschange|r.oe.sb.engine.onbetstopfixture|r.oe.sb.engine.onbetstopglobal|r.oe.bm.engine.notifications",
    "IsPriority": "true",
    "IsExclusive": "true"
  },
  "Custom": {
    "WebSocketAPI": "http://localhost:5000/bohub",
    "AsianClientCodes": "A88,BE8,B88,ID8,W88,V88,SET,S88,EKI,EKT,APL,IDN,BDV,TSO"
  },
  "API": {
    "PlatformAPI": {
      "Uri": "https://preprod-platformapi.song88.com",
      "APIKey": "${API_KEY}"
    },
    "PlatformSportsbook": {
      "Uri": "http://localhost:5005"
    }
  },
  "Telemetry": {
    "Enabled": false
  }
}
