{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "API": {
    "AuthenticationAPI": {
      "Uri": "http://localhost:40114",
      "Security": {
        "APIKey": "${API_KEY}"
      },
      "JWT": {
        "Key": "${JWT_KEY}",
        "Issuer": "bo.auth.api"
      }
    },
    "PlatformAPI": {
      "HK": {
        "APIKey": "${API_KEY}",
        "Uri": "https://platform-api.stg.song88.com"
      },
      "SA": {
        "APIKey": "${API_KEY}",
        "Uri": "https://platform-api.stg.song88.com"
      }
    },
    "TradingAPI": {
