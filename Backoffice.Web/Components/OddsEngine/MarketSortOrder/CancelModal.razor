<div class="modal-body">
    <div class="d-flex flex-column justify-content-center p-5">
        <div class="text-center">
            <img src="icons/svg/warning-icon.svg" />
        </div>
        <div class="text-center mt-4">
            Are you sure you want to discard all the changes in @ClientName?
            <br />
            Please be certain as this cannot be undone
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn btn-cancel" data-bs-dismiss="modal" @onclick="OnCancelClickEvent">Cancel</button>
    <button type="button" class="btn modal-btn btn-continue" @onclick="OnContinueClickEvent">Continue</button>
</div>