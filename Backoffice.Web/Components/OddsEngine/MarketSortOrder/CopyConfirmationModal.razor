<div class="modal-body">
    <div class="d-flex flex-column justify-content-center p-5">
        <div class="text-center">
            <img src="icons/svg/warning-icon.svg" />
        </div>
        <div class="text-center mt-4">
            This setting will override @ClientName > @SportName > @FixtureStatusName @_translationState.GetValue("Market Sort Order").
            <br />
             Are you sure you want to copy this setting?
        </div>
    </div>
</div>
<div class="modal-footer mx-4">
    <button type="button" class="btn btn-cancel" @onclick="OnCancelClickEvent">@_translationState.GetValue("Cancel")</button>
    <button type="button" class="btn btn-copy" @onclick="OnCopyClickEvent">@_translationState.GetValue("Copy")</button>
</div>