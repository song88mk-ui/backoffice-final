<div class="row">
    <div class="col-md-12">
        <div class="content-filter mx-3 d-flex justify-content-between">
            <div class="select-container d-flex">
                <div class="me-2">
                    <select class="form-select d-block" @onchange="OnClientChangedEvent">
                        @foreach(var client in Clients)
                        {
                            if (SelectedClientCode == client.Value)
                            {
                                <option value="@client.Value" selected>@client.Name</option>
                            }
                            else
                            {
                                <option value="@client.Value">@client.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="me-2">
                    <select class="form-select d-block" @onchange="OnSportChangedEvent">
                        @foreach (var sport in Sports)
                        {
                            @if (SelectedSportId == sport.Value)
                            {
                                <option value="@sport.Value" selected>@sport.Name</option>
                            }
                            else
                            {
                                <option value="@sport.Value">@sport.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="me-2">
                    <select class="form-select d-block" @onchange="OnFixtureStatusChangedEvent">
                        @foreach (var fixtureStatus in FixtureStatuses)
                        {
                            @if (SelectedFixtureStatusId == fixtureStatus.Value)
                            {
                                <option value="@fixtureStatus.Value" selected>@fixtureStatus.Name</option>
                            }
                            else
                            {
                                <option value="@fixtureStatus.Value">@fixtureStatus.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="button-container d-flex flex-row-reverse align-items-end">
                <div class="me-2">
                    <a href="javascript:void(0)" class="btn btn-copy px-3">
                        <i class="fa fa-copy"></i>
                        Copy
                    </a>
                </div>
                @if (!IsUpdate)
                {
                    <div class="me-2">
                        <a href="javascript:void(0)" class="btn btn-edit px-3" @onclick="OnUpdateClickEvent">
                            <i class="fa fa-edit"></i>
                            Update
                        </a>
                    </div>
                }
                else
                {
                    <div class="me-2">
                        <a href="javascript:void(0)" class="btn btn-save px-3">
                            <i class="fa fa-check"></i>
                            Save
                        </a>
                    </div>
                    <div class="me-2">
                        <a href="javascript:void(0)" class="btn btn-cancel px-3"@onclick="OnCancelClickEvent">
                            Cancel
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        @if (ClientMarketTemplateGroups.Any())
        {
            <div class="d-flex mx-3 mt-3">
                @foreach (var model in ClientMarketTemplateGroups)
                {
                    <div class="me-2">
                        <a href="javascript:void(0)" class="btn btn-market-group @(SelectedMarketTemplateGroupId == model.MarketTemplateGroupId ? "active" : "") px-3" id="mtg-@model.MarketTemplateGroupId" @onclick="() => OnMarketGroupClickEvent(model.MarketTemplateGroupId)">
                            @model.Name
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>