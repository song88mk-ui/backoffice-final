<div class="row">
    <div class="col-md-12">
        <div class="content-filter mx-3 d-flex justify-content-between">
            <div class="select-container d-flex">
                <div class="me-2">
                    <select class="form-select d-block" @onchange="OnClientChangedEvent">
                        @foreach (var client in Clients)
                        {
                            if (_filterModel.SelectedClientCode == client.Value)
                            {
                                <option value="@client.Value" selected>@client.Name</option>
                            }
                            else
                            {
                                <option value="@client.Value">@client.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="me-2">
                    <select class="form-select d-block" @onchange="OnSportChangedEvent">
                        @foreach (var sport in Sports)
                        {
                            <option value="@sport.Value" selected="@(sport.Value == _filterModel.SelectedSportId)">@TranslationState.GetValue(sport.Name)</option>
                        }
                    </select>
                </div>
                <div class="me-2">
                    <select class="form-select d-block" @onchange="OnFixtureStatusChangedEvent">
                        @foreach (var fixtureStatus in FixtureStatuses)
                        {
                            <option value="@fixtureStatus.Value" selected="@(fixtureStatus.Value == _filterModel.SelectedSportId)">@TranslationState.GetValue(fixtureStatus.Name)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="button-container d-flex flex-row-reverse align-items-end">
                <AuthorizeView Policy="sbc-market-sortorder-canedit">
                    <Authorized Context="ActivateAll">
                        <div class="me-2">
                            <a href="javascript:void(0)" class="btn btn-copy px-3 @(IsPreLoader ? "disabled" : "")" @onclick="OnCopyClickEvent">
                                <i class="fa fa-copy"></i>
                                @TranslationState.GetValue("Copy")
                            </a>
                        </div>
                        @if (!IsUpdate)
                        {
                            <div class="me-2">
                                <a href="javascript:void(0)" class="btn btn-edit px-3 @(IsPreLoader ? "disabled" : "")" @onclick="OnUpdateClickEvent">
                                    <i class="fa fa-edit"></i>
                                    @TranslationState.GetValue("Update")
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="me-2">
                                <a href="javascript:void(0)" class="btn btn-save px-3" @onclick="OnSaveClickEvent">
                                    <i class="fa fa-check"></i>
                                    @TranslationState.GetValue("Save")
                                </a>
                            </div>
                            <div class="me-2">
                                <a href="javascript:void(0)" class="btn btn-cancel px-3" @onclick="OnCancelClickEvent">
                                    @TranslationState.GetValue("Cancel")
                                </a>
                            </div>
                        }
                    </Authorized>
                    <NotAuthorized Context="ActivateAll">
                        <div class="me-2">
                            <a href="javascript:void(0)" class="btn btn-copy px-3" disabled>
                                <i class="fa fa-copy"></i>
                                @TranslationState.GetValue("Copy")
                            </a>
                        </div>
                        <div class="me-2">
                            <a href="javascript:void(0)" class="btn btn-edit px-3" disabled>
                                <i class="fa fa-edit"></i>
                                @TranslationState.GetValue("Update")
                            </a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</div>