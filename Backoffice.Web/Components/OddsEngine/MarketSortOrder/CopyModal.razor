<div class="modal-body">
    <div class="row mb-2">
        <div class="col-2 text-center">
            <span>Client</span>
        </div>
        <div class="col">
            <select class="form-select" @onchange="OnClientChangedEvent">
                <option value="" selected>@_translationState.GetValue("Select Client")</option>
                @foreach (var item in Clients)
                {
                    if (item.Value == SelectedClientCode)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
             </select>
        </div>
    </div>
    <div class="row mb-2">
        <div class="col-2 text-center">
            <span>Sport</span>
        </div>
        <div class="col">
            <select class="form-select" @onchange="OnSportChangedEvent">
                <option value="0" selected>@_translationState.GetValue("Select Sport")</option>
                @foreach (var sport in Sports)
                {
                    if (sport.SportId == SelectedSportId)
                    {
                        <option value="@sport.SportId" selected>@sport.SportName</option>
                    }
                    else
                    {
                        <option value="@sport.SportId">@sport.SportName</option>
                    }
                }
             </select>
        </div>
    </div>
    <div class="row mb-2">
        <div class="col-2 text-center">
            <span>Scope</span>
        </div>
        <div class="col">
            <select class="form-select" @onchange="OnScopeChangedEvent">
                <option value="-1" selected>@_translationState.GetValue("Select Scope")</option>
                @foreach (var scope in Scopes)
                {
                    if (scope.Value == SelectedScopeId)
                    {
                        <option value="@scope.Value" selected>@scope.Name</option>
                    }
                    else
                    {
                        <option value="@scope.Value">@scope.Name</option>
                    }
                }
             </select>
        </div>
    </div>
</div>
<div class="modal-footer mx-4">
    <button type="button" class="btn btn-cancel" @onclick="OnCancelClickEvent">@_translationState.GetValue("Cancel")</button>
    @if (!string.IsNullOrEmpty(SelectedClientCode) && SelectedSportId > 0 && SelectedScopeId >= 0)
    {
        <button type="button" class="btn btn-copy" @onclick="OnCopyClickEvent">@_translationState.GetValue("Copy")</button>
    }
    else
    {
        <button type="button" class="btn btn-copy" disabled>@_translationState.GetValue("Copy")</button>
    }
</div>