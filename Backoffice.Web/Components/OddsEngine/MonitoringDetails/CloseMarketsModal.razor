<div class="modal-body">
    <div class="business-container">
        <div class="row">
            <div class="col-md-12">
                Select the markets that will be set to Closed or select all to close th whole fixture.<br/>
                <table class="table table-bordered">
                    <thead class="table-head">
                        <tr>
                            <th class="w-50 border-0">Fixture Details</th
                            <th class="w-50 border-0"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>23/06/2023<br />23:30</td>
                            <td>FixtureName</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-12">
                @foreach (var group in MarketTemplateGroups)
                {
                    var groupId = $"radio{group.MarketTemplateGroup.MarketTemplateGroupId}";
                    <div class="d-inline-block">
                        <input type="radio" class="btn-check" name="options" id="@groupId" autocomplete="off" @onclick="OnMarketGroupRadioClickEvent" />
                        <label class="btn" for="importRadio">@group.MarketTemplateGroup.MarketTemplateGroupName</label>
                    </div>
                }

            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <table class="table table-bordered">
                    <thead class="table-head">
                        <tr>
                            <th class="w-50 border-0"></th
                            <th class="w-50 border-0">Market Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td></td>
                            <td>Market Name</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modalBtn modalCancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent" disabled="@IsPreload">Cancel</button>
    <button type="button" class="btn modalBtn modalSave waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickEvent" disabled="@IsPreload">Close Markets</button>
</div>