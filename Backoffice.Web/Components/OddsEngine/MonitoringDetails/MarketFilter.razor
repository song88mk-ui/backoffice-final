<div class="d-flex flex-column market-column">
    <div class="me-3">
        @if (MarketTemplates.Any())
        {
            <Virtualize Items="MarketTemplates" Context="marketTemplate" OverscanCount="15">
                <a href="javascript:void(0);" class="d-block btn btn-market px-3 border-bottom @(marketTemplate.IsSelected ? "active" : "")" @onclick="_ => OnMarketTemplateClickEvent(marketTemplate)">
                    @TranslationState.GetValue(marketTemplate.MarketName)
                </a>
            </Virtualize>
        }
    </div>
</div>