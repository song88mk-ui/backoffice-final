<div class="content-filter mx-3 d-flex justify-content-between">
    <div class="select-container d-flex">
        <div class="me-2">
            <select class="form-select d-block" @onchange="OnMarketChangedEvent">
                @foreach (var item in MarketTemplates)
                {
                    if (item.Value == SelectedMarketTemplateId)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
    </div>
    <div class="close-market-container d-flex flex-row-reverse align-items-end">
        <div class="me-2">
            <a href="javascript:void(0);" @onclick="OnCloseMarketsClickEvent" class="btn btn-close-market px-3 active">
                Close Markets
            </a>
        </div>
    </div>
</div>