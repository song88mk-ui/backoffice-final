<div class="content-filter mx-3 d-flex justify-content-between">
    <div class="select-container d-flex">
        <div class="me-2">
            <div class="dropdown">
                <button class="btn form-select dropdown-toggle" type="button" id="client-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    @if (_clientFilter.Any())
                    {
                        if (_clientFilter.Count == _selectedClientCount)
                        {
                            <span>All Clients (@_selectedClientCount)</span>
                        }
                        else
                        {
                            <span>@(_selectedClientCount == 1 ? _selectedClientName : $"Clients ({_selectedClientCount})")</span>
                        }
                    }
                    else
                    {
                        <span>No Clients Available</span>
                    }
                </button>
                @if (_clientFilter.Any())
                {
                    <SelectWithCheckbox Items="_clientFilter" OnCheckboxCallback="OnClientCheckboxClickEvent" AriaLabel="client-dropdown" />
                }
            </div>
        </div>
        <div class="me-2">
            @if (MarketTemplates != null && MarketTemplates.Any())
            {
                <select class="form-select d-block" @onchange="OnMarketChangedEvent">
                    @foreach (var item in MarketTemplates)
                    {
                        if (item.Value == SelectedMarketTemplateId)
                        {
                            <option value="@item.Value" selected>@item.Name</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Name</option>
                        }
                    }
                </select>
            }
        </div>
    </div>
    @*COMMENTED AS THIS FEATURE IS NOT NEEDED FOR NOW*@
    @*<div class="close-market-container d-flex flex-row-reverse align-items-end">
        <div class="me-2">
            <a href="javascript:void(0);" @onclick="OnCloseMarketsClickEvent" class="btn btn-close-market px-3 active">
                Close Markets
            </a>
        </div>
    </div>*@
</div>