<tr>
    <td>
        <span class="selection-name-container fw-bold">@Selection.SelectionName</span>
    </td>
    <td>
        <div class="d-flex justify-content-center">
            <div class="odds-container @GetClientColor() py-1">
                <span class="d-block text-center">@GetClientOdds(null)</span>
            </div>
        </div>
    </td>
    @if (_clients != null && _clients.Any())
    {
        foreach (var client in _clients)
        {
            <td>
                <div class="d-flex justify-content-center">
                    <div class="odds-container @GetClientColor(client.ClientCode) py-1">
                        @if (HasClientConfig(client.ClientCode, _clientCode, _clientCodeMargin))
                        {
                            <span class="d-block text-center">@GetClientOdds(client.ClientCode)</span>
                        }
                        else
                        {
                            <span class="d-block text-center">-.-</span>
                        }
                    </div>
                </div>
            </td>
        }
    }
</tr>