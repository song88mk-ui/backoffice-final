<tr>
    <td class="td-selection">
        <span class="selection-name-container fw-bold">@Selection.SelectionName</span>
    </td>
    <MatchDetailsClientSelectionComponent Selection="Selection" MarketStatusId="Market.MarketStatusId" IsBetStopGlobal="Market.IsBetStopGlobal" HasConfig="true" />
    @if (_clients != null && _clients.Any())
    {
        foreach (var client in _clients)
        {
            var hasConfig = HasClientConfig(client.ClientCode, _clientCode, _clientCodeMargin);

            <MatchDetailsClientSelectionComponent Selection="Selection" CurrentClientCode="@client.ClientCode" MarketStatusId="Market.MarketStatusId" IsBetStopGlobal="Market.IsBetStopGlobal" HasConfig="hasConfig" />
        }
    }
</tr>