<div class="content-filter mx-3 d-flex justify-content-between mt-3">
    <div class="button-cotainer d-flex">

        @if (MarketTemplateGroups != null)
        {
            foreach (var template in MarketTemplateGroups)
            {
                <div class="me-2">
                    <a href="" @onclick:preventDefault @onclick="_ => OnMarketTemplateGroupClickEvent(template.MarketTemplateGroup.MarketTemplateGroupId)" class="@(template.IsSelected ? "btn btn-market-group active px-3" : "btn btn-market-group px-3") ">
                        @template.MarketTemplateGroup.MarketTemplateGroupName
                    </a>
                </div>
            }
        }
        
    </div>
    <div class="input-container d-flex flex-row-reverse align-items-end">
        <EditForm Model="SearchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
            <div class="input-group">
                <InputText id="search" placeholder="Find" class="form-control search-text valid border-end-0" @bind-Value="SearchForm.SearchText" />
                <span class="input-group-text border-start-0">
                    <i class="fa fa-search"></i>
                </span>
            </div>
        </EditForm>
    </div>
</div>