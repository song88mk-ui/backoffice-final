<div class="content-filter mx-3">
    <div class="d-flex justify-content-between">
        <div class="select-container d-flex">
            <div class="me-2">
                <div class="dropdown">
                    <button class="btn form-select dropdown-toggle" type="button" id="client-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        @if (_clientFilter.Any())
                        {
                            if (_clientFilter.Count == _selectedClientCount)
                            {
                                <span>@TranslationState.GetValue("All Clients") (@_selectedClientCount)</span>
                            }
                            else
                            {
                                <span>@(_selectedClientCount == 1 ? _selectedClientName : $"{TranslationState.GetValue("Clients")} ({_selectedClientCount})")</span>
                            }
                        }
                        else
                        {
                            <span>@TranslationState.GetValue("No Clients Available")</span>
                        }
                    </button>
                    @if (_clientFilter.Any())
                    {
                        <SelectWithCheckbox Items="_clientFilter" OnCheckboxCallback="OnClientCheckboxClickEvent" AriaLabel="client-dropdown" />
                    }
                </div>
            </div>
            <div class="me-2">
                @if (_topMarketTemplates != null && _topMarketTemplates.Any())
                {
                    <select class="form-select d-block" @onchange="OnMarketChangedEvent">
                        @foreach (var item in _topMarketTemplates)
                        {
                            <option value="@item.MainMarketTemplateId" selected="@(item.MainMarketTemplateId.ToString() == _marketTemplateId)">@item.Name</option>
                        }
                    </select>
                }
            </div>
        </div>
        <div>
            @if (_topMarketTemplates != null)
            {
                <EditForm Model="_searchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
                    <div class="input-group">
                        <InputText id="search" placeholder=@TranslationState.GetValue("Search") class="form-control search-text valid border-end-0" @bind-Value="_searchForm.SearchText" />
                        <span class="input-group-text border-start-0">
                            <i class="fa fa-search"></i>
                        </span>
                    </div>
                </EditForm>
            }

        </div>
    </div>
</div>