<div class="content-filter mx-3">
    <div class="w-100 d-flex justify-content-between">
        <div class="select-container">
            @if (TopMarketTemplates.Any())
            {
                <select class="form-select d-block" @onchange="OnMarketChangedEvent">
                    @foreach (var item in TopMarketTemplates)
                    {
                        if (item.MainMarketTemplateId.ToString() == MarketTemplateId)
                        {
                            <option value="@item.MainMarketTemplateId" selected>@item.Name</option>
                        }
                        else
                        {
                            <option value="@item.MainMarketTemplateId">@item.Name</option>
                        }
                    }
                </select>
            }
        </div>
        <div>
            <EditForm Model="SearchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
                <div class="input-group">
                    <InputText id="search" placeholder="Search" class="form-control search-text valid border-end-0" @bind-Value="SearchForm.SearchText" />
                    <span class="input-group-text border-start-0">
                        <i class="fa fa-search"></i>
                    </span>
                </div>
            </EditForm>
        </div>
    </div>
</div>