<tr>
    @FixtureHeaderContent

    <!-- BR CTRL -->
    <td class="td-master">
        <div class="d-flex justify-content-left">
            @if (_ctrlMarket?.Market != null)
            {
                <MonitoringFixtureSelectionComponent Market="_ctrlMarket.Market" />
            }
            else
            {
                <div class="odds-container me-2 py-1 px-3">
                    <span>-.-</span>
                </div>
                <div class="odds-container me-2 py-1 px-3">
                    <span>-.-</span>
                </div>
                <div class="py-1 px-2">
                    <span>-.-</span>
                </div>
            }

        </div>
    </td>

    <!-- Client Odds -->
    @if (_clientList != null)
    {
        foreach (var client in _clientList)
        {
            <td class="td-master">
                <div class="d-flex justify-content-left">
                    @if (client.Market != null)
                    {
                        <MonitoringFixtureSelectionComponent Market="client.Market" />
                    }
                    else
                    {
                        <div class="odds-container me-2 py-1 px-3">
                            <span>-.-</span>
                        </div>
                        <div class="odds-container me-2 py-1 px-3">
                            <span>-.-</span>
                        </div>
                        <div class="py-1 px-2">
                            <span>-.-</span>
                        </div>
                    }
                </div>
            </td>
        }
    }

</tr>