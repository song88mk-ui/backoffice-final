<div class="modal-body">
    <div class="row">
        <div class="col-md-12">
            @if (_isPreloader)
            {
                <Preloader />
            }
            else
            {
                if (_clientSportOrderAudit != null && _clientSportOrderAudit.Any())
                {
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th class="th-date">@_translationState.GetValue("Date")</th>
                                <th class="th-client">@_translationState.GetValue("Client")</th>
                                <th class="th-changes-from">@_translationState.GetValue("Changes From")</th>
                                <th class="th-changes-from">@_translationState.GetValue("Changes To")</th>
                                <th class="th-updated-by">@_translationState.GetValue("Updated By")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize Items="_clientSportOrderAudit" Context="model">
                                <tr>
                                    <td>
                                        @model.Timestamp.ToLocalTime().ToString("MM/dd/yyyy") <br>
                                        @model.Timestamp.ToLocalTime().ToString("hh:mm:ss tt")
                                    </td>
                                    <td>@model.ClientName</td>
                                    <td>
                                        <span>@((MarkupString)model.ChangesFrom)</span>
                                    </td>
                                    <td>
                                        <span>@((MarkupString)model.ChangesTo)</span>
                                    </td>
                                    <td>@model.UpdatedBy</td>
                                </tr>
                            </Virtualize>
                        </tbody>
                        <Pagination MetaData="_metaData" Spread="3" SelectPageEvent="SelectedPage" PaginationColspan="5" />
                    </table>
                }
                else
                {
                    <NoRecordFound Message="@_translationState.GetValue("No Record Found")" />
                }
            }
        </div>
    </div>
</div>
<div class="modal-footer mx-4">
    <button type="button" class="btn btn-cancel" @onclick="OnCancelClickEvent">@_translationState.GetValue("Close")</button>
</div>