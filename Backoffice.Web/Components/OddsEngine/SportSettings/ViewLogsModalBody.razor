<div class="modal-body">
    <form>
        <div class="row">
            <div class="col-md-12">
                @if (IsPreLoader)
                {
                    <Preloader />
                }
                else
                {
                    <table class="table table-bordered table-hover no-margin">
                        <thead>
                            <tr>
                                <th valign="middle" align="left"><strong>Date</strong></th>
                                <th valign="middle" align="left"><strong>Client</strong></th>
                                <th valign="middle" align="left"><strong>Changes From</strong></th>
                                <th valign="middle" align="left"><strong>Changes To</strong></th>
                                <th valign="middle" align="left"><strong>Updated By</strong></th>
                            </tr>
                        </thead>
                        @if (ClientSportOrderAudit != null)
                        {
                            @if (ClientSportOrderAudit.Any())
                            {
                                @if (ClientSportOrderAudit != null)
                                {
                                    <tbody>
                                        @foreach (var audit in ClientSportOrderAudit)
                                        {
                                            <tr>
                                                <td>
                                                    @audit.TimeStamp.ToLocalTime().ToString("MM/dd/yyyy") <br>
                                                    @audit.TimeStamp.ToLocalTime().ToString("hh:mm:ss tt")
                                                </td>
                                                <td>@audit.ClientName</td>
                                                <td>@((MarkupString)audit.ChangesFrom)</td>
                                                <td>@((MarkupString)audit.ChangesTo)</td>
                                                <td>@audit.UserName</td>
                                            </tr>
                                        }
                                    </tbody>
                                }
                            }
                            else
                            {
                                <NoRecordFound />
                            }
                        }
                    </table>
                }
            </div>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-danger waves-effect" @onclick="OnCancelClickEvent">Close</button>
</div>