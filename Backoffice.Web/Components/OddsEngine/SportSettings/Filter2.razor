<div class="d-flex mx-3 justify-content-between">
    <div>
        <select class="form-select" @onchange="OnClientChangedEvent">
            @foreach (var item in _clients)
            {
                if (_selectedClientCode == item.Value)
                {
                    <option value="@item.Value" selected>@item.Name</option>
                }
                else
                {
                    <option value="@item.Value">@item.Name</option>
                }
            }
        </select>
    </div>
    <div class="d-flex justify-content-end">
        <AuthorizeView Policy="sbc-sports-setting-canedit">
            <Authorized Context="ActivateAll">
                @if (!_isUpdate)
                {
                    <div class="me-2">
                        <a href="javascript:void(0)" class="btn btn-update px-3 rounded @(IsPreload ? "disabled" : "")" @onclick="OnUpdateClick">
                            <i class="fa fa-edit"></i>
                            Update
                        </a>
                    </div>
                    <div class="me-2">
                        <a href="javascript:void(0)" class="btn btn-copy px-3 rounded @(IsPreload ? "disabled" : "")" @onclick="OnCopyClickEvent">
                            <i class="fa fa-copy"></i>
                            Copy
                        </a>
                    </div>
                }
                else
                {
                    <div class="me-2">
                        <a href="javascript:void(0)" class="btn btn-cancel px-3 rounded @(IsPreload ? "disabled" : "")" @onclick="OnCancelClick">
                            Cancel
                        </a>
                    </div>
                    <div>
                        <a href="javascript:void(0)" class="btn btn-edit px-3 rounded @(IsPreload ? "disabled" : "")" @onclick="OnSaveChangesClick">
                            Save Changes
                        </a>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
        @if (!_isUpdate)
        {
            <div>
                <a href="javascript:void(0)" class="btn btn-logs px-3 rounded border @(IsPreload ? "disabled" : "")">
                    <i class="fa fa-table"></i>
                    Logs
                </a>
            </div>
        }
    </div>
</div>