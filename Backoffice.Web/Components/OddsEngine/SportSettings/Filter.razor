<div class="content-filter mx-3 d-flex justify-content-between">
    <div class="select-container d-flex">
        <div class="me-2">
            @if(IsPreLoader)
            {
                <select class="form-select d-block" disabled>
                    @foreach (var item in Clients)
                    {
                        if (ClientSportOrderFilter.ClientCode == item.Key)
                        {
                            <option value="@item.Key" selected>@item.Value</option>
                        }
                        else
                        {
                            <option value="@item.Key">@item.Value</option>
                        }
                    }
                </select>
            }
            else
            {
                <select class="form-select d-block" @onchange="OnClientSelectionChangedEvent">
                    @foreach (var item in Clients)
                    {
                        if (ClientSportOrderFilter.ClientCode == item.Key)
                        {
                            <option value="@item.Key" selected>@item.Value</option>
                        }
                        else
                        {
                            <option value="@item.Key">@item.Value</option>
                        }
                    }
                </select>
            }
        </div>
    </div>
    <div class="button-container d-flex flex-row-reverse align-items-end">
        @if (IsPreLoader)
        {
            <div class="me-2">
                <a href="javascript:void(0)" class="btn btn-logs px-3 disable-link">
                    <i class="fa fa-list"></i>
                    Logs
                </a>
            </div>
            <div class="me-2">
                <a href="javascript:void(0)" class="btn btn-copy px-3 disable-link">
                    <i class="fa fa-copy"></i>
                    Copy
                </a>
            </div>
            @if (!ClientSportOrderFilter.IsUpdate)
            {
                <div class="me-2">
                    <a href="javascript:void(0)" class="btn btn-edit px-3 disable-link">
                        <i class="fa fa-edit"></i>
                        Update
                    </a>
                </div>
            }
            else
            {
                <div class="me-2">
                    <a href="javascript:void(0)" class="btn btn-save px-3 disable-link">
                        <i class="fa fa-check"></i>
                        Save
                    </a>
                </div>
                <div class="me-2">
                    <a href="javascript:void(0)" class="btn btn-cancel px-3 disable-link">
                        Cancel
                    </a>
                </div>
            }
        }
        else
        {
            <div class="me-2">
                <a href="javascript:void(0)" class="btn btn-logs px-3" @onclick="OnViewLogsClickEvent">
                    <i class="fa fa-list"></i>
                    Logs
                </a>
            </div>
            <div class="me-2">
                <a href="javascript:void(0)" class="btn btn-copy px-3" @onclick="OnCopyClickEvent">
                    <i class="fa fa-copy"></i>
                    Copy
                </a>
            </div>
            @if (!ClientSportOrderFilter.IsUpdate)
            {
                <div class="me-2">
                    <a href="javascript:void(0)" class="btn btn-edit px-3" @onclick="OnEditClickEvent">
                        <i class="fa fa-edit"></i>
                        Update
                    </a>
                </div>
            }
            else
            {
                <div class="me-2">
                    <a href="javascript:void(0)" class="btn btn-save px-3" @onclick="OnSaveClickEvent">
                        <i class="fa fa-check"></i>
                        Save
                    </a>
                </div>
                <div class="me-2">
                    <a href="javascript:void(0)" class="btn btn-cancel px-3" @onclick="OnCancelClickEvent">
                        Cancel
                    </a>
                </div>
            }
        }
    </div>
</div>