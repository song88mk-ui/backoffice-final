<div class="content-filter mx-3 d-flex justify-content-between">
    <div class="select-container d-flex">
        <div class="me-2">
            <select class="form-select d-block" @onchange="OnClientChangedEvent">
                @foreach (var item in Clients)
                {
                    if (SelectedClientCode == item.Value)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
    </div>
    <div class="button-container d-flex flex-row-reverse align-items-end">
        <AuthorizeView Policy="sbc-sports-setting-canedit">
            <Authorized Context="ActivateAll">
                <div class="me-2">
                    <a href="javascript:void(0)" class="btn btn-logs px-3 @(IsPreload ? "disabled" : "")" @onclick="OnViewLogsClickEvent">
                        <i class="fa fa-list"></i>
                        @_translationState.GetValue("Logs")
                    </a>
                </div>
                <div class="me-2">
                    <a href="javascript:void(0)" class="btn btn-copy px-3 @(IsPreload ? "disabled" : "")" @onclick="OnCopyClickEvent">
                        <i class="fa fa-copy"></i>
                        @_translationState.GetValue("Copy")
                    </a>
                </div>
                @if (!IsUpdate)
                {
                    <div class="me-2">
                        <a href="javascript:void(0)" class="btn btn-edit px-3 @(IsPreload ? "disabled" : "")" @onclick="OnUpdateClickEvent">
                            <i class="fa fa-edit"></i>
                            @_translationState.GetValue("Update")
                        </a>
                    </div>
                }
                else
                {
                    <div class="me-2">
                        <a href="javascript:void(0)" class="btn btn-save px-3 @(IsPreload ? "disabled" : "")" @onclick="OnSaveClickEvent">
                            <i class="fa fa-check"></i>
                            @_translationState.GetValue("Save")
                        </a>
                    </div>
                    <div class="me-2">
                        <a href="javascript:void(0)" class="btn btn-cancel px-3 @(IsPreload ? "disabled" : "")"  @onclick="OnCancelClickEvent">
                            @_translationState.GetValue("Cancel")
                        </a>
                    </div>
                }
            </Authorized>
            <NotAuthorized Context="ActivateAll">
                <div class="me-2">
                    <a href="javascript:void(0)" class="btn btn-logs px-3 @(IsPreload ? "disabled" : "")" @onclick="OnViewLogsClickEvent">
                        <i class="fa fa-list"></i>
                        @_translationState.GetValue("Logs")
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>