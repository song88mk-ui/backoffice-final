@if (IsPreLoader)
{
    <Preloader />
}
else
{
    <div class="modal-body">
        <div class="d-flex flex-column justify-content-center p-5">
            <div class="text-center">
                <img src="icons/svg/warning-icon.svg" />
            </div>
            @if(_userAction == 0)
            {
                <div class="text-center mt-4">
                    Are you sure you want to cancel?
                    <br />
                    All your progress won’t be saved.
                </div>
            }
            else if(_userAction == 1)
            {
                <div class="text-center mt-4">
                    Do you want to save your changes before navigating
                    <br />
                    away from this page?
                </div>
            }
        </div>
        @* <AlertMessage AlertModel="@AlertModel" /> *@
    </div>
    <div class="modal-footer mx-4">
        <button type="button" class="btn modal-btn btn-cancel">No</button>

        @if (_userAction == 0)
        {
            <button type="button" class="btn modal-btn btn-continue" disabled="@IsUpdating">Yes, Cancel</button>
        }
        else if (_userAction == 1)
        {
            <button type="button" class="btn modal-btn btn-continue" disabled="@IsUpdating">Save Changes</button>
        }
    </div>
}