<div class="modal-body">   
    <div class="d-flex flex-column justify-content-center p-5">
        <div class="text-center">
            <icon class="ico ico-warning"></icon>
        </div>
        <div class="text-center mt-4">
            This setting will override @ToClientName settings.
            <br />
             Are you sure you want to copy this setting?
        </div>
    </div>

    @if (IsPreloader)
    {
        <Preloader />
    }
</div>
<div class="modal-footer mx-4">
    <button type="button" class="btn btn-cancel" @onclick="OnCancelClickEvent">Cancel</button>
    <button type="button" class="btn btn-copy" @onclick="OnCopyClickEvent">Copy</button>
</div>