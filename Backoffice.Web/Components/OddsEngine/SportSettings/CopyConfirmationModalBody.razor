<div class="modal-body">
    @if (IsPreLoader)
    {
        <Preloader Classes="@("container-loader popup")" AlwaysLoad="true" />
    }
    <div class="row">
        <div class="col-md-12">
            <p align="center" class="text-center">
                <br>
                <i class="fa fa-warning text-danger fa-4x"></i><br>
                <br>
                This setting will override @CopyToClientName settings. <br>Are you sure you want to copy this setting?
            </p>
        </div>
    </div>
</div>
<div class="modal-footer notifications">
    @if (IsPreLoader)
    {
        <button type="button" class="btn btn-default waves-effect " data-dismiss="modal" disabled>Cancel</button>
        <button type="button" data-type="inverse" data-from="top" data-align="right" class="btn btn-success waves-effect waves-light" data-dismiss="modal" @ref="CopyButton" disabled>Copy</button>
    }
    else
    {
        <button type="button" @onclick="OnCancelClickEvent" class="btn btn-default waves-effect " data-dismiss="modal">Cancel</button>
        <button type="button" @onclick="OnCopySportOrder" data-type="inverse" data-from="top" data-align="right" class="btn btn-success waves-effect waves-light" data-dismiss="modal" @ref="CopyButton" >Copy</button>
    }
</div>