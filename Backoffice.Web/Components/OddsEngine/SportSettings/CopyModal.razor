<div class="modal-body">
    <div class="row mb-2">
        <div class="col-2 text-center">
            <span>@TranslationState.GetValue("To")</span>
        </div>
        <div class="col">
            <select class="form-select" @onchange="OnClientChangedEvent">
                <option value="" selected>@TranslationState.GetValue("Select Client")</option>
                @foreach (var item in Clients)
                {
                    if (item.Value == SelectedClientCode)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
             </select>
        </div>
    </div>
</div>
<div class="modal-footer mx-4">
    <button type="button" class="btn btn-cancel" @onclick="OnCancelClickEvent">@TranslationState.GetValue("Cancel")</button>
    @if (!string.IsNullOrEmpty(SelectedClientCode))
    {
        <button type="button" class="btn btn-copy" @onclick="OnCopyClickEvent">@TranslationState.GetValue("Copy")</button>
    }
    else
    {
        <button type="button" class="btn btn-copy" disabled>@TranslationState.GetValue("Copy")</button>
    }
</div>