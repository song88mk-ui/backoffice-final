<div class="d-flex flex-column sportsree-container py-3 me-2">
    <div class="d-flex justify-content-between mx-3 mb-3">
        <div>
            <span class="fw-bold sports-tree-title">Sports Tree</span>
        </div>
        <div class="d-flex justify-content-end">
            <button class="bg-transparent px-2 border-0 clear-selection-btn" @onclick="OnClearSportsSelectionClick">Clear Selection</button>
            <button class="bg-transparent px-2 border-0 remove-btn" @onclick="OnRemoveClick">Remove</button>
        </div>
    </div>
    <div id="sportstreeEditable" class="d-flex flex-column mx-3 connect-list">
        @foreach (var sport in _sportSettings)
        {
            <SportAccordion @key="sport" Sport="sport" Page="EditSportSettingsPage.Sport"
                            OnSportToggleCallback="OnSportAccordionSelectedEvent" IsSelected="_removeAll" OnCheckboxChangedCallback="OnCheckboxChanged" />
        }
    </div>
</div>
<div class="main-container d-flex flex-column">
    <EditForm Model="_searchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
        <div class="input-group mb-3">
            <InputText id="search" placeholder="Find Sports" class="form-control border-end-0" @bind-Value="_searchForm.SearchText" />
            <span class="input-group-text border-start-0">
                <i class="fa fa-search" />
            </span>
        </div>
    </EditForm>
    <div class="all-sports-container flex-column d-flex rounded justify-content-between py-3">
        <div class="d-flex justify-content-between mx-3 mb-3">
            <div class="d-flex flex-column justify-content-center">
                <span class="fw-bold sports-tree-title">All Sports</span>
            </div>
            <div class="d-flex justify-content-end">
                <button class="bg-transparent px-2 border-0 clear-selection-btn" @onclick="OnClearSelectionClick">Clear Selection</button>
                <button class="bg-transparent px-2 border-0 select-all-btn me-2" @onclick="OnSelectAllClick">Select All</button>
                <button class="btn bg-white add-to-btn border rounded" @onclick="OnAddToSportstreeClick">
                    <i class="fa fa-plus me-2" />
                    Add To Sports Tree
                </button>
            </div>
        </div>
        <div id="allSportsEditable" class="d-flex flex-column mx-3 connect-list">
            @foreach (var sport in _sportLookupSettings)
            {
                <SportAccordion @key="sport" Sport="sport" Page="EditSportSettingsPage.Sport" IsSelected="_selectAll" />
            }
        </div>
    </div>
</div>
