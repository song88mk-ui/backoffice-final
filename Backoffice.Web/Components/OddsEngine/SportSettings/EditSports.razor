 <div>
   <div class="d-flex flex-column sportstree-container py-3 me-2">
        <div class="d-flex justify-content-between mx-3 mb-3">
            <div>
                <span class="fw-bold sports-tree-title">Sports Tree</span>
            </div>
            <div class="d-flex justify-content-end">
                <button class="bg-transparent px-2 border-0 clear-selection-btn" disabled="@(!selectedSportIds.Any())" @onclick="OnClearSportsSelectionClick">Clear Selection</button>
                <button class="bg-transparent px-2 border-0 remove-btn" disabled="@(!selectedSportIds.Any())" @onclick="OnRemoveClick">Remove</button>
            </div>
        </div>
        <div id="sportstreeEditable" class="d-flex flex-column mx-3 connect-list">
            @if (_sportSettings.Any() && _sportSettings.Count() > 0)
            {
                @foreach (var sport in _sportSettings)
                {
                    <SportAccordion @key="sport" Sport="sport" Page="EditSportSettingsPage.Sport" IsSelected="selectedSportIds.Any(x => x == sport.SportId)" OnCheckboxChangedCallback="OnCheckboxChanged" />
                }
            }
            else
            {
            <div class="d-flex justify-content-center align-items-center empty-placeholder text-center mt-4">
                    Add a sport by dragging or by
                    <br />
                    selecting multiple sports and
                    <br />
                    clicking Add To Sports Tree
                </div>
            }
        </div>
    </div>
    </div>
<div class="col main-container d-flex flex-column">
    <EditForm Model="_searchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
        <div class="input-group mb-3">
            <InputText id="search" placeholder="Find Sports" class="form-control border-end-0" @bind-Value="_searchForm.SearchText" />
            <span class="input-group-text border-start-0">
                <i class="fa fa-search" />
            </span>
        </div>
    </EditForm>
    <div class="all-sports-container flex-column d-flex rounded justify-content-between py-3">
        <div class="d-flex justify-content-between mx-3 mb-3">
            <div class="d-flex flex-column justify-content-center">
                <span class="fw-bold sports-tree-title">All Sports</span>
            </div>
            <div class="d-flex justify-content-end">
                <button class="bg-transparent px-2 border-0 clear-selection-btn" disabled="@(!_hasChanges)" @onclick="OnClearSelectionClick">Clear Selection</button>
                <button class="bg-transparent px-2 border-0 select-all-btn" @onclick="OnSelectAllClick">Select All</button>
                <button class="btn bg-white add-to-btn border rounded" disabled="@(!_hasChanges)" @onclick="OnAddToSportstreeClick">
                    <i class="fa fa-plus me-2" />
                    Add To Sports Tree
                </button>
            </div>
        </div>
        <div id="allSportsEditable" class="d-flex flex-column mx-3 connect-list">
            @if (_sportLookupSettings.Any() && _sportLookupSettings.Count() > 0)
            {
                @foreach (var sport in _sportLookupSettings)
                {
                    <SportAccordion @key="sport" Sport="sport" Page="EditSportSettingsPage.Sport" IsSelected="selectedAllSportIds.Any(x => x == sport.SportId)" OnCheckboxChangedCallback="OnAllSportsCheckboxChanged" />
                }
            }
            else
            {
                <div class="d-flex justify-content-center align-items-center empty-placeholder text-center mt-4">
                    All available sports have been
                    <br />
                    included in the sports tree
                </div>
            }
        </div>
    </div>
</div>
