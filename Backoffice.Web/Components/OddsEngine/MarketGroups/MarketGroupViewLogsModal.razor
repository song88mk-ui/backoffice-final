@using Backoffice.Shared.Enums;
@using Backoffice.Web.Services;
<div class="modal-body">
    @*<NoRecordFound />*@

    <!--uncomment block code below for output-->
    <div class="row">
        <div class="col-12">
            @if (!IsPreLoader)
            {
                @if (ActivityLogs != null && ActivityLogs.Any())
                {
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th scope="col"><strong>Date</strong></th>
                                <th scope="col"><strong>Activity</strong></th>
                                <th scope="col"><strong>From</strong></th>
                                <th scope="col"><strong>To</strong></th>
                                <th scope="col"><strong>Updated By</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var logs in ActivityLogs)
                            {
                                <tr>
                                    <td>@logs.TimeStamp.ToLocalTime().ToString("dd/MM/yy") @logs.TimeStamp.ToLocalTime().ToString("HH:mm")</td>
                                    <td>@logs.Activity</td>
                                    <td>@((MarkupString)CommonService.GetActivity(logs.From, logs.To, Page.OE_Administration_MarketGroup, logs.Activity, true))</td>
                                    <td>@((MarkupString)CommonService.GetActivity(logs.From, logs.To, Page.OE_Administration_MarketGroup, logs.Activity, false))</td>
                                    <td>@logs.UserId</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <Pagination MetaData="MetaData" Spread="2" SelectPageEvent="SelectedPage" />
                }
                else
                {
                    <NoRecordFound />
                }
            }
            else
            {
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn modal-close" @onclick="OnCloseModalClickEvent">Close</button>
</div>