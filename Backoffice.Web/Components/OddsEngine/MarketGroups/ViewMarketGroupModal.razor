<div class="modal-body">
    <div class="row mb-2">
        <div class="col-12">
            <span>Group Name</span>
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-12">
            <input type="text" class="form-control" disabled value="10 Bet Asia Group" />
        </div>
    </div>

    <div class="row mb-2">
        <div class="col-12">
            <span>Market Template</span>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            @if (IsPreLoader)
            {
                <Preloader />
            }
            else
            {
                @if (ClientMarketTemplates != null && ClientMarketTemplates.Any())
                {
                    var rowNumber = 0;

                    <table class="table table-striped">
                        <thead class="text-center">
                            <tr>
                                <th width="5%" valign="middle" align="left"><strong>#</strong></th>
                                <th width="95%" valign="middle" align="left"><strong>Market Name</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ClientMarketTemplates)
                            {
                                rowNumber++;
                                <tr>
                                    <td width="3%"><span>@rowNumber</span></td>
                                    <td width="55%" align="left"><span>@item.MarketTemplateName</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn modal-cancel" @onclick="OnModalCancel">Cancel</button>
</div>