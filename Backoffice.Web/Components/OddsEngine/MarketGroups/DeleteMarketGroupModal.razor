<div class="modal-body">
    <div class="row mb-2">
        <div class="col text-center">
            <img src="icons/svg/warning-icon.svg" />
        </div>
    </div>
    <div class="row">
        @if (IsPreLoader)
        {
            <Preloader />
        }
        else
        {
            <div class="col text-center">
                <p>
                    @_translationState.GetValue("This market group is currently in use.")
                    <br />
                    @_translationState.GetValue("market_group_delete_question")
                </p>
            </div>
        }
    </div>
    @if (_alertModel != null && string.IsNullOrEmpty(_alertModel.Message))
    {
        <AlertMessage AlertModel="@_alertModel" />
    }
</div>
<div class="modal-footer">

    @if (IsPreLoader)
    {
        <button type="button" class="btn modal-btn modal-cancel" disabled>@_translationState.GetValue("Cancel")</button>
        <button type="button" class="btn modal-btn modal-delete" disabled>@_translationState.GetValue("Delete")</button>
    }
    else
    {
        <button type="button" class="btn modal-btn modal-cancel" @onclick="OnCancelModalClick">@_translationState.GetValue("Cancel")</button>
        <button type="button" class="btn modal-btn modal-delete" @onclick="OnDeleteModalClick">@_translationState.GetValue("Delete")</button>
    }
</div>