<div class="modal-body">
    <div class="row mb-2">
        <div class="col text-center">
            <img src="icons/svg/warning-icon.svg" />
        </div>        
    </div>
    <div class="row">
        <div class="col text-center">
            <p>
                This market group is currently in use.
                <br />
                Are you sure you want to permanently delete this Market Group?
            </p>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn modal-cancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelModalClick">Cancel</button>
    <button type="button" class="btn modal-btn modal-delete waves-effect" data-bs-dismiss="modal" @onclick="OnDeleteModalClick">Delete</button>
</div>