<div class="modal-body">
    <div class="row justify-content-centers align-content-center">
        <div class="col-3 text-center">
            <span>@_translationState.GetValue("Market Group Name")</span>
        </div>
        <div class="col-7">
            <input class="form-control @(IsPreLoader ? "disable" : "")" type="text" id="marketGroupNameField" aria-label="Market Group Name Field"
                   @bind-value="@MarketTemplateGroup.Name" />
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn modal-cancel" @onclick="OnModalCancelEvent" disabled="@IsPreLoader">@_translationState.GetValue("Cancel")</button>
    <button type="button" class="btn modal-btn modal-save" @onclick="OnModalSaveEvent" disabled="@IsPreLoader">@_translationState.GetValue("Save")</button>
</div>