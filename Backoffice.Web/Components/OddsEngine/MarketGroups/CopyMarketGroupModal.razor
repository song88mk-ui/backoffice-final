<div class="modal-body">
    @if (!_confirming)
    {
        <section class="mg-copy-section mb-3">
            <div class="mg-copy-from mb-2">
                @_translationState.GetValue("From"): <strong>@_fromClientName</strong> &gt; @_sportName &gt; @_scopeName
            </div>
            <div class="d-flex gap-3">
                <div class="mg-copy-select">
                    <label class="form-label">@_translationState.GetValue("Clients")</label>
                    <div class="dropdown">
                        <button class="btn btn-client dropdown-toggle" type="button" id="market-group-copy-client-dropdown" data-bs-auto-close="outside" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (_clients.Count > 1)
                            {
                                <span>@(_selected.Count == 1 ? _selected[0].Name : $"{_translationState.GetValue("Clients")} ({_selected.Count})")</span>
                            }
                            else
                            {
                                <span>@_translationState.GetValue("No Clients Available")</span>
                            }
                        </button>
                        @if (_clients.Count > 1)
                        {
                            <SelectWithCheckbox Items="_clients" AriaLabel="market-group-copy-client-dropdown" OnCheckboxCallback="OnClientCheckboxEvent" />
                        }
                    </div>
                </div>
                <div class="mg-copy-selected flex-grow-1 d-flex flex-wrap align-content-start border rounded p-2">
                    @foreach (var client in _selected)
                    {
                        <div class="mg-chip mg-client-chip mx-1 mb-1 py-1 px-2" @key="client.Code">
                            @client.Name
                            <button type="button" class="btn-close btn-close-white ms-2" aria-label="Close" @onclick="() => OnRemoveClientEvent(client.Code)"></button>
                        </div>
                    }
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_clientError))
            {
                <div class="alert alert-danger mt-3 mb-0" role="alert">@_clientError</div>
            }
        </section>

        <section class="mg-copy-section">
            <label class="form-label">@_translationState.GetValue("Market Groups")</label>
            <div class="mg-group-container d-flex flex-wrap p-3">
                @if (_groups.Any())
                {
                    @foreach (var group in _groups)
                    {
                        <div class="mg-chip mg-group-chip mx-1 mb-2 py-1 px-2" @key="group.MarketTemplateGroupId">@group.Name</div>
                    }
                }
                else
                {
                    <span class="mg-no-groups">@_fromClientName has no saved market groups for @_sportName &gt; @_scopeName to copy.</span>
                }
            </div>
        </section>
    }
    else
    {
        <div class="alert alert-warning mb-0" role="alert">
            Copying will replace the existing Market Groups (@_sportName &gt; @_scopeName) of
            <strong>@_selected.Count client@(_selected.Count == 1 ? "" : "s")</strong> (@string.Join(", ", _selected.Select(c => c.Name)))
            with the @_groups.Count market group@(_groups.Count == 1 ? "" : "s") of <strong>@_fromClientName</strong>. Do you want to continue?
        </div>
    }

    @if (_alert != null && !string.IsNullOrEmpty(_alert.Message))
    {
        <div class="mt-3">
            <AlertMessage AlertModel="@_alert" />
        </div>
    }
</div>
<div class="modal-footer mx-4 p-0 py-3 border-0">
    @if (!_confirming)
    {
        <button type="button" class="btn btn-cancel waves-effect" @onclick="OnCancelClickEvent">@_translationState.GetValue("Cancel")</button>
        <button type="button" class="btn btn-save waves-effect" disabled="@(!_groups.Any())" @onclick="OnSaveClickEvent">@_translationState.GetValue("Save")</button>
    }
    else
    {
        <button type="button" class="btn btn-cancel waves-effect" disabled="@_isSaving" @onclick="OnBackClickEvent">@_translationState.GetValue("Back")</button>
        <button type="button" class="btn btn-save waves-effect" disabled="@_isSaving" @onclick="OnConfirmClickEvent">@_translationState.GetValue("Confirm")</button>
    }
</div>
