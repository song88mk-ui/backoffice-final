<div class="modal-body">
    @if (IsPreLoader)
    {
        <Preloader />
    }
    else
    {
        <div class="row mb-2">
            <div class="col-2 text-center">
                <span>@TranslationState.GetValue("From")</span>
            </div>
            <div class="col-10">
                <select class="form-select" placeholder="Select Client" @onchange="OnClientChangedEvent">
                    @if (Clients != null)
                    {
                        <option value="" selected>@TranslationState.GetValue("Select Client")</option>

                        foreach (var client in Clients)
                        {
                            if (client.Value == SelectedClientCode)
                            {
                                <option value="@client.Value" selected>@client.Name</option>
                            }
                            else
                            {
                                <option value="@client.Value">@client.Name</option>
                            }
                        }
                    }
                </select>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-2"></div>
            <div class="col-10">
                <select class="form-select" placeholder="@TranslationState.GetValue("Select Sport")" @onchange="OnSportChangedEvent">
                    @if (Sports != null)
                    {
                        <option value="0" selected>@TranslationState.GetValue("Select Sport")</option>

                        foreach (var sport in Sports)
                        {
                            <option value="@sport.Value" selected="@(sport.Value == SelectedSportId)">@TranslationState.GetValue(sport.Name)</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="row mb-2">
            <div class="col-2"></div>
            <div class="col-10">
                <select class="form-select" placeholder="Select Scope" @onchange="OnFixtureStatusChangedEvent">
                    @if (FixtureStatuses != null)
                    {
                        <option value="-1" selected>@TranslationState.GetValue("Select Scope")</option>

                        foreach (var fixtureStatus in FixtureStatuses)
                        {
                            <option value="@fixtureStatus.Value" selected="@(fixtureStatus.Value == SelectedFixtureStatusId)">@TranslationState.GetValue(fixtureStatus.Name)</option>
                        }
                    }
                </select>
            </div>
        </div>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn modal-cancel" @onclick="OnModalCancelEvent">@TranslationState.GetValue("Cancel")</button>
    @if (string.IsNullOrEmpty(SelectedClientCode) || SelectedSportId <= 0 || SelectedFixtureStatusId <= -1)
    {
        <button type="button" class="btn modal-btn modal-save" disabled>@TranslationState.GetValue("Copy")</button>
    }
    else
    {
        <button type="button" class="btn modal-btn modal-save" @onclick="OnModalCopyEvent" disabled="@IsPreLoader">@TranslationState.GetValue("Copy")</button>
    }
</div>