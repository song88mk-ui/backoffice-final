@using Backoffice.Web.Models.OddsEngine.LeagueSorting

<div class="modal-body">
    <div class="ls-filter-panel mb-3">
        <div class="ls-filter-field">
            <label class="form-label">@_translationState.GetValue("Segment")</label>
            <select class="form-select" @onchange="OnFilterSegmentChangedEvent">
                <option value="0" selected="@(_filterSegmentId == 0)">@_translationState.GetValue("ALL")</option>
                @foreach (var segment in FilterSegments)
                {
                    <option value="@segment.SegmentId" selected="@(_filterSegmentId == segment.SegmentId)">@segment.SegmentName</option>
                }
            </select>
        </div>
        <div class="ls-filter-field">
            <label class="form-label">@_translationState.GetValue("League")</label>
            <select class="form-select" @onchange="OnFilterLeagueChangedEvent">
                <option value="0" selected="@(_filterLeagueId == 0)">@_translationState.GetValue("ALL")</option>
                @foreach (var league in FilterLeagues)
                {
                    <option value="@league.LeagueId" selected="@(_filterLeagueId == league.LeagueId)">@league.LeagueName</option>
                }
            </select>
        </div>
    </div>

    <table class="table table-hover table-borderless table-edit-league-sorting">
        <thead class="table-head">
            <tr>
                <th class="th-no">@_translationState.GetValue("No.")</th>
                <th class="th-segment">@_translationState.GetValue("Segment")</th>
                <th class="th-league">@_translationState.GetValue("League")</th>
                <th class="th-status">@_translationState.GetValue("Status")</th>
                <th class="th-action">@_translationState.GetValue("Action")</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < _rows.Count; i++)
            {
                var row = _rows[i];
                var number = i + 1;

                <tr @key="row" data-id="@row.Key" class="@(IsRowVisible(row) ? null : "d-none")">
                    <td>@number</td>
                    <td>@row.SegmentName</td>
                    <td>
                        <div class="league-dropdown">
                            <button type="button" class="btn dropdown-toggle d-block w-100" @onclick="() => OnDropdownClickEvent(row)">
                                @(row.IsEmpty ? _translationState.GetValue("Select League") : row.LeagueName)
                            </button>
                            @if (_openRowKey == row.Key)
                            {
                                <LeagueSelect Segments="_segments"
                                              Taken="TakenByOtherRows(row)"
                                              SelectedSegmentId="row.SegmentId"
                                              SelectedLeagueId="row.LeagueId"
                                              OnSelected="selection => OnLeagueSelectedEvent(row, selection)"
                                              OnClose="OnDropdownCloseEvent" />
                            }
                        </div>
                    </td>
                    <td>
                        <span class="status-active py-1 px-4 rounded-pill">@_translationState.GetValue("Active")</span>
                    </td>
                    <td class="actions">
                        <a href="javascript:void(0);" class="me-2" @onclick="() => OnAddClickEvent(row)">
                            <i class="fa fa-plus-square" aria-hidden="true"></i>
                        </a>
                        <a href="javascript:void(0);" class="me-2" @onclick="() => OnDeleteClickEvent(row)">
                            <i class="fa fa-minus-square" aria-hidden="true"></i>
                        </a>
                        <a href="javascript:void(0);" class="drag-handle">
                            <i class="fa fa-bars" aria-hidden="true"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (_alert != null && !string.IsNullOrEmpty(_alert.Message))
    {
        <div class="mt-3">
            <AlertMessage AlertModel="@_alert" />
        </div>
    }
</div>
<div class="modal-footer mx-4 p-0 py-3 border-0">
    <button type="button" class="btn btn-cancel waves-effect" @onclick="OnCancelClickEvent">@_translationState.GetValue("Cancel")</button>
    <button type="button" class="btn btn-save waves-effect" disabled="@_isSaving" @onclick="OnSaveClickEvent">@_translationState.GetValue("Save")</button>
</div>
