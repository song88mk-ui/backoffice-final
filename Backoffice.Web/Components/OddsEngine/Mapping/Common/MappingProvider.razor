<div class="filters-container">
    <div class="dropdowns-container">
        @if (DropdownFilters[MappingCategory.Sport].Items != null && _showSportsDropdown)
        {
            <DropdownFilter FilterGroup="DropdownFilters[MappingCategory.Sport]" OnClickCallback="OnDropdownItemClickCallback" MappingCategory="MappingCategory.Sport" />
        }
        @if (DropdownFilters[MappingCategory.Segment].Items != null && _showSegmentsDropdown)
        {
            <DropdownFilter FilterGroup="DropdownFilters[MappingCategory.Segment]" OnClickCallback="OnDropdownItemClickCallback" MappingCategory="MappingCategory.Segment" />
        }
        @if (DropdownFilters[MappingCategory.League].Items != null && _showLeaguesDropdown)
        {
            <DropdownFilter FilterGroup="DropdownFilters[MappingCategory.League]" OnClickCallback="OnDropdownItemClickCallback" MappingCategory="MappingCategory.League" />
        }
    </div>
    <div class="search-container">
        <input class="input-search" placeholder="@_translationState.GetValue("Search")" @bind="_searchQuery" @oninput="FilterProviderItems" />
        <i class="fa fa-search" />
    </div>
</div>

<div class="providers-container">
    <div class="providers-container">
        @foreach (var group in _groupProviderItems)
        {
            <div class="provider">
                <span class="provider-label header-label">@providerIdToName[group.Key]</span>
                <div class="provider-items-container provider-@(group.Key)-items-container">
                    @foreach (var item in group.Value)
                    {
                        <div class="provider-item @GetLinkedItemCss(item)" @onclick="_ => HandleItemClick(item)">
                            <div class="provider-item-name-container">
                                <img class="drag-icon" src="icons/svg/draggable.svg" />
                                <span class="provider-item-name">@(GetItemLabel(item))</span>
                            </div>
                            @if (item.HasLinkedItem)
                            {
                                <img class="linked-icon" src="icons/svg/linked.svg" />
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>