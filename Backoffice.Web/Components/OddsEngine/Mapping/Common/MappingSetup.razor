<EditForm id="@FormId" EditContext="_editContext" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <div class="mapping-setup-content-container">
        @if (IsEdit)
        {
            <div class="text-input">
                <span>@_translationState.GetValue("ID")</span>
                <InputText class="form-control" type="text" readonly="true" @bind-Value="_mappingSetupItem.Id" />
                <ValidationMessage For="() => _mappingSetupItem.Id" />
            </div>
        }
        <div class="text-input">
            <span>@_translationState.GetValue("Name")</span>
            <input type="text" class="form-control" placeholder="Enter Name" value="@_mappingSetupItem.Name" @oninput="OnNameInputChange" />
            <ValidationMessage For="() => _mappingSetupItem.Name" />
        </div>
        <div>
            <div class="item-list-container">
                @if (_mappingSetupItem.Providers.Any())
                {
                    <ul class="item-list">
                        @foreach (var item in _mappingSetupItem.Providers)
                        {
                            <li class="item" @onclick="() => HandleRemoveProviderItemClick(item)">
                            <div>@(GetItemLabel(item))</div>
                                <ProviderIcon ChannelTypeId="item.ChTyId" />
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="empty-message italic">@_translationState.GetValue("Click on the items you want to map.")</div>
                }
            </div>
            <ValidationMessage For="() => _mappingSetupItem.Providers" />
        </div>
        @if(HasSubmitButton)
        {
            <button type="submit" class="btn-create-mapping @(GetDisabledCreateBtnCss())" disabled="@(IsDisabledCreateBtn())">@_translationState.GetValue("Create Mapping")</button>
        }
    </div>
</EditForm>