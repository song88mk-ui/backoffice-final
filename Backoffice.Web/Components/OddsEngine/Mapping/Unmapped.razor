@using Backoffice.Web.Components.OddsEngine.Mapping

<div class="dropdowns-container">
    <select class="dropdown">
        <option value="" disabled selected hidden>@_translationState.GetValue("Select Sports")</option>
        <option value="Sports 1">Sports 1</option>
        <option value="Sports 2">Sports 2</option>
    </select>
    <select class="dropdown">
        <option value="" disabled selected hidden>@_translationState.GetValue("Select Segments")</option>
        <option value="Segment 1">Segment 1</option>
        <option value="Segment 2">Segment 2</option>
    </select>
    <select class="dropdown">
        <option value="" disabled selected hidden>@_translationState.GetValue("Select Leagues")</option>
        <option value="League 1">League 1</option>
        <option value="League 2">League 2</option>
    </select>
</div>

<div class="main-content-grid">
    <div class="left">
        <MappingSetup DraggedProviderItems="_draggedProviderItems" OnSubmitCallback="HandleCreateMappingClick" />
        <MappedItems CurrentMappedItems="_currentMappedItems" OnSaveMappingCallback="HandleSaveMappingClick" OnRemoveAllCallback="HandleRemoveAllClick"/>
    </div>
    <div class="right">
        @if (_unmappedSports != null && _unmappedSports.Count() > 0)
        {
            <MappingProvider ProviderItems="_unmappedSports" OnDragItemCallback="HandleDragProviderItem" />
        }
    </div>
</div>