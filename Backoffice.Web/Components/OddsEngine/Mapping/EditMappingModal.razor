<div class="modal-header">
    <div class="title">Edit Mapping</div>
    <div>
        <button data-bs-dismiss="modal" @onclick="OnCloseClickEvent" class="btn-cancel">Cancel</button>
        <button data-bs-dismiss="modal" type="submit" form="@_formId" class="btn-save">Save changes</button>
    </div>
</div>
<div class="modal-body pt-0">
    <div class="information-container mb-3">
        <MappingSetup HasSubmitButton=false FormId="@_formId" DraggedProviderItem="_draggedProviderItem" OnSubmitCallback="HandleUpdateMappingClick" />
    </div>
    <div class="information-container p-3">
        @if (_unmappedSports != null && _unmappedSports.Count() > 0)
        {
            <MappingProvider ProviderItems="_unmappedSports" OnDragCallback="HandleDragProviderItem" />
        }
    </div>
</div>