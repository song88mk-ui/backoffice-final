@using Backoffice.Web.Components.OddsEngine.Mapping.Base

<div>
    <div class="d-flex flex-row justify-content-between">
        <div />
        <div class="input-search input-group mb-3">
            <input type="text"class="form-control no-left-border" value="@_searchText" @oninput="OnSearchTextChanged" placeholder="Search">
            <span class="input-group-text">
                <img src="icons/svg/icon-search.svg" alt="Search Icon">
            </span>
        </div>
    </div>

    <table class="table">
        <thead class="table-head text-white">
            <tr>
                <th>Sport Name</th>
                <th>Source</th>
                <th>ID</th>
                <th>Date Mapped</th>
                <AuthorizeView Policy="sbc-mapping-canedit">
                    <Authorized>
                        <th>Action</th>
                    </Authorized>
                </AuthorizeView>
            </tr>
        </thead>
        <tbody>
            @foreach (var mappingItem in _sportMapping)
            {
            <tr>
                <td>@mappingItem.SpNa</td>
                <td>
                    <div class="d-flex flex-row">
                        <div class="source-item @(mappingItem.Info.SrId > 0 ? "bg-danger text-white" : "inactive")">SR</div>
                        <div class="source-item @(mappingItem.Info.BgId > 0 ? "bg-primary text-white" : "inactive")">BG</div>
                    </div>
                </td>
                <td>@mappingItem.SpId</td>
                <td>@mappingItem.Ti</td>
                <AuthorizeView Policy="sbc-mapping-canedit">
                    <Authorized>
                        <td class="action-row">
                            <button class="btn-icon" @onclick="() => HandleEditMappingClickEvent(mappingItem)">
                                <img src="icons/svg/icon-update.svg" />
                            </button>
                            <button class="btn-icon" @onclick="() => HandleDeleteMappingClickEvent(mappingItem)">
                                <img src="icons/svg/icon-trash.svg" />
                            </button>
                        </td>
                    </Authorized>
                </AuthorizeView>
            </tr>
            }
        </tbody>
    </table>
    <div>
        <CustomModal OnSaveClickCallback="OnSaveClickEvent" />
    </div>
</div>
