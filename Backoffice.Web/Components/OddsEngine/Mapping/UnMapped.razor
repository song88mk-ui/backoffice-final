@using Backoffice.Web.Components.OddsEngine.Mapping

<div class="dropdowns-container">
    <select class="dropdown">
        <option value="" disabled selected hidden>@_translationState.GetValue("Select Sports")</option>
        <option value="Sports 1">Sports 1</option>
        <option value="Sports 2">Sports 2</option>
    </select>
    <select class="dropdown">
        <option value="" disabled selected hidden>@_translationState.GetValue("Select Segments")</option>
        <option value="Segment 1">Segment 1</option>
        <option value="Segment 2">Segment 2</option>
    </select>
    <select class="dropdown">
        <option value="" disabled selected hidden>@_translationState.GetValue("Select Leagues")</option>
        <option value="League 1">League 1</option>
        <option value="League 2">League 2</option>
    </select>
</div>

<div class="main-content-grid">
    <div class="left">
        <div class="mapping-setup-container">
            <div class="mapping-setup-header">
                <span class="header-label">@_translationState.GetValue("Mapping Setup")</span>
                <img class="download-icon" src="icons/svg/download.svg" />
            </div>
            <div class="mapping-setup-content-container">
                <div class="text-input">
                    <span>@_translationState.GetValue("Mapped ID")</span>
                    <input type="text" placeholder="255" />
                </div>
                <div class="text-input">
                    <span>@_translationState.GetValue("New Fixture Name")</span>
                    <input type="text" placeholder="Enter Fixture Name" />
                </div>
                <div class="item-list-container" dropzone="move" @ondrop="HandleDropProviderItem" ondragover="event.preventDefault();">
                    <span class="empty-message italic">@_translationState.GetValue("Drag and drop the item you want to map.")</span>
                </div>
                <button class="btn-create-mapping @(false ? "inactive" : "active")">@_translationState.GetValue("Create Mapping")</button>
            </div>
        </div>
        <div class="mapped-items-container">
            <div class="mapped-items-header">
                <span class="header-label">@_translationState.GetValue("Mapped Items")</span>
                <div class="header-cluster">
                    <span class="remove-all-label">@_translationState.GetValue("Remove All")</span>
                    <button class="btn-save">@_translationState.GetValue("Save")</button>
                    <img class="download-icon" src="icons/svg/upload.svg" />
                </div>
            </div>
            <div class="item-list-container">
                <span class="empty-message">@_translationState.GetValue("No fixture mappings have been created.")</span>
            </div>
        </div>
    </div>
    <div class="right">
        <MappingProvider ProviderItems="_providerItems" OnDragCallback="HandleDragProviderItem" />
    </div>
</div>