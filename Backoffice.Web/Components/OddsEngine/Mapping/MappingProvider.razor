<div class="search-container">
    <input class="input-search" placeholder="@_translationState.GetValue("Search")" @bind="_searchQuery" @oninput="FilterProviderItems" />
    <i class="fa fa-search" />
</div>
<div class="providers-container">
    <div class="providers-container">
        @foreach (var group in _groupProviderItems)
        {
            <div class="provider">
                <span class="provider-label header-label">@providerIdToName[group.Key]</span>
                <div class="provider-items-container">
                    @foreach (var item in group.Value)
                    {
                        <div class="provider-item @GetLinkedItemCss(item)" 
                            draggable="true" 
                            @ondragstart="_ => HandleDragStart(item)" 
                             @onmouseover="_ => HandleMouseOver(item)" 
                             @onmouseout="HandleMouseOut"
                        >
                            <div class="provider-item-name-container">
                                <img class="drag-icon" src="icons/svg/draggable.svg" />
                                <span class="provider-item-name">@item.Na</span>
                            </div>
                            <img class="linked-icon" src="icons/svg/linked.svg" />
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>