@using Backoffice.Web.Components.OddsEngine.Mapping.Common

@if (_isPreLoader)
{
    <div class="p-3">
        <Preloader />
    </div>
}
else
{
    <div class="modal-header">
        <div class="title">@_translationState.GetValue("Edit Mapping")</div>
        <div>
            <button data-bs-dismiss="modal" @onclick="OnCloseClickEvent" class="btn-cancel">@_translationState.GetValue("Cancel")</button>
            <button data-bs-dismiss="modal" type="submit" form="@_formId" class="btn-save">@_translationState.GetValue("Save changes")</button>
        </div>
    </div>
    <div class="modal-body pt-0">
        <AlertMessage AlertModel="_alertModel" AlertClass="pb-2" />
        <div class="information-container mb-3">
            <MappingSetup MappingCategory="MappingCategory.Segment" IsEdit=true FormId="@_formId" MappingSetupItem="_mappingSetupItem" HasSubmitButton=false MappingSetupProviderItems="_currentMappingSetupProviderItems" OnSubmitCallback="HandleUpdateMappingClick" OnRemoveProviderItemCallback="HandleRemoveMappingSetupProviderItem" />
        </div>
        <div class="information-container p-3">
            @if (_tempFilteredUnmappedSegments != null && _tempFilteredUnmappedSegments.Count() > 0)
            {
                <MappingProvider MappingCategory="MappingCategory.Segment" MappingSetupProviderItems="_currentMappingSetupProviderItems" ProviderItems="_tempFilteredUnmappedSegments" OnClickItemCallback="HandleProviderItemClick" />
            }
        </div>
    </div>
}