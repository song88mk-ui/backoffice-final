<div class="container">
    <span class="header">Delete Mapped League</span>

    <div>Are you sure you want to delete the mapped league:@_leagueName</div>
    <br />
    <span>This action cannot be undone.</span>
</div>

<div class="btn-container d-flex justify-content-center">    
    <button @onclick="OnCloseClickEvent" type="button" class="btn modal-btn btn-cancel">@_translationState.GetValue("Cancel")</button>
    <button @onclick="OnDeleteClickEvent" type="button" class="btn modal-btn btn-delete">@_translationState.GetValue("Delete")</button>
</div>