@using Backoffice.Web.Components.OddsEngine.Mapping.Common
@using Backoffice.Web.Components.OddsEngine.Mapping.Base

@inherits BaseUnmapped

<span class="title">League Mapping</span>
<div class="main-content-grid">
    <div class="left">
        <MappingSetup MappingSetupProviderItems="CurrentMappingSetupProviderItems" OnSubmitCallback="HandleCreateMappingClick" OnRemoveProviderItemCallback="HandleRemoveMappingSetupProviderItem" />
        <MappedItems CurrentMappedItems="CurrentMappedItems" OnSaveMappingCallback="HandleSaveMappingClick" OnRemoveCallback="HandleRemoveMappedItem" />
    </div>
    <div class="right">
        @if (TempFilteredUnmappedItems != null && TempFilteredUnmappedItems.Count() > 0)
        {
            <MappingProvider MappingSetupProviderItems="CurrentMappingSetupProviderItems" ProviderItems="TempFilteredUnmappedItems" OnClickItemCallback="HandleProviderItemClick" />
        }
    </div>
</div>
