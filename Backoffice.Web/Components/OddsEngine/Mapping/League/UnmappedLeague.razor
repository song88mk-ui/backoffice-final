@using Backoffice.Web.Components.OddsEngine.Mapping.Common

<span class="title">League Mapping</span>
<div class="main-content-grid">
    <div class="left">
        <MappingSetup MappingSetupProviderItems="_currentMappingSetupProviderItems" OnSubmitCallback="HandleCreateMappingClick" OnRemoveProviderItemCallback="HandleRemoveMappingSetupProviderItem" />
        <MappedItems CurrentMappedItems="_currentMappedItems" OnSaveMappingCallback="HandleSaveMappingClick" OnRemoveCallback="HandleRemoveMappedItem" />
    </div>
    <div class="right">
        @if (_tempFilteredUnmappedSports != null && _tempFilteredUnmappedSports.Count() > 0)
        {
            <MappingProvider MappingSetupProviderItems="_currentMappingSetupProviderItems" ProviderItems="_tempFilteredUnmappedSports" OnClickItemCallback="HandleProviderItemClick" />
        }
    </div>
</div>
