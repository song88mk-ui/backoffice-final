@using BlazorDateRangePicker;

<div class="modal-body">
    <div class="row">
        <div class="col-md-4 col-sm-6">
            <div class="form-group">
                <DateRangePicker class="form-control" DateFormat="MM/dd/yyyy" LinkedCalendars="true" StartDate="StartDate" EndDate="EndDate" MaxDate="DateTime.Today" OnRangeSelect="OnRangeSelect" />
            </div>
        </div>
        <div class="col align-self-end pr-1">
            <div class="form-group">
                <EditForm class="f-right form-group" Model="SearchForm" OnValidSubmit="OnSubmitClickEvent" Context="FormContext">
                    <div class="right-icon-control">
                        <InputText id="search" class="form-control search-text" placeholder="@($"{TranslationState.GetValue("Search Here")}...")" @bind-Value="SearchForm.SearchText" />
                        <div class="form-icon"> <i class="feather icon-search"></i> </div>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            @if (!IsPreLoader)
            {
                @if (ActivityLogs != null && ActivityLogs.Any())
                {
                    <table class="table table-bordered mt-3">
                        <thead>
                            <tr>
                                <th valign="middle" align="left"><strong>#</strong></th>
                                <th valign="middle" align="left"><strong>Date</strong></th>
                                <th valign="middle" align="left"><strong>@TranslationState.GetValue("Client name")</strong></th>
                                <th valign="middle" align="left"><strong>Activity</strong></th>
                                <th valign="middle" align="left"><strong>Changed From</strong></th>
                                <th valign="middle" align="left"><strong>Changed To</strong></th>
                                <th valign="middle" align="left"><strong>Updated By</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var rowCount = (MetaData.CurrentPage - 1) * MetaData.PageSize;
                            }

                            @foreach (var log in ActivityLogs)
                            {
                                rowCount++;

                                <tr>
                                    <td>@rowCount</td>
                                    <td>@log.TimeStamp.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                                    <td>@ClientName</td>
                                    <td><strong>@log.Activity</strong></td>
                                    <td>@((MarkupString)EvaluateActivity(log.From))</td>
                                    <td>@((MarkupString)EvaluateActivity(log.To))</td>
                                    <td>@log.UserName</td>
                                </tr>
                            }
                        </tbody>
                        <Pagination MetaData="MetaData" Spread="2" SelectPageEvent="SelectedPage" PaginationColspan="7" />
                    </table>

                }
                else
                {
                    <NoRecordFound />
                }
            }
        </div>
    </div>
</div>
<div class="modal-footer notifications">
    <button type="button" @onclick="OnCancelClickEvent" class="btn btn-danger waves-effect" data-dismiss="modal">@TranslationState.GetValue("Cancel")</button>
</div>