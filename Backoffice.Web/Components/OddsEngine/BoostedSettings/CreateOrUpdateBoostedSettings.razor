<div class="modal-body">
    <form>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th class="col-md-3">Client Name</th>
                    <th class="col"><center>% Cap of Current Odds from Boosted Odds</center></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@ClientName</td>
                    <td class="text-center">
                        <center>
                            <div class="col-md-4 input-icon input-icon-right">
                                <input class="cap-bg-default col-4 col-sm-2 col-md-4 col-lg-8 text-center" type="number" placeholder='0.00' @bind-value="CapEdit" data-decimal="2" oninput="enforceNumberValidation(this)" />
                                <i>%</i>
                            </div>
                        </center>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
</div>
<div class="modal-footer">
    @if (IsPreLoader)
    {
        <button type="button" class="btn btn-cancel" disabled>Cancel</button>
        <button type="button" class="btn btn-save" data-type="inverse" data-from="top" data-align="right" @ref="SaveButton" disabled>Save</button>
    }
    else
    {
        <button type="button" class="btn btn-cancel" @onclick="_ => OnCancelClickEvent()">Cancel</button>
        <button type="button" class="btn btn-save" data-type="inverse" data-from="top" data-align="right" @onclick="_ => OnSaveClickEvent()" @ref="SaveButton">Save</button>
    }
</div>