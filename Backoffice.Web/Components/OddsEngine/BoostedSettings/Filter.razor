<div class="content-filter mx-3 d-flex justify-content-between">
    <div class="input-container d-flex">
        <EditForm Model="_searchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
            <div class="input-group">
                <InputText id="search" placeholder="@TranslationState.GetValue("Find Client")" class="form-control search-text border-end-0" @bind-Value="_searchForm.SearchText" />
                <button class="input-group-text border-start-0">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </EditForm>
    </div>
    <div class="button-container d-flex flex-row-reverse align-items-end">
        <div>
            <a href="javascript:void(0)" class="btn btn-logs px-3" @onclick="OnViewLogsClickEvent">
                <i class="fa fa-list"></i>
                @TranslationState.GetValue("Logs")
            </a>
        </div>
    </div>
</div>