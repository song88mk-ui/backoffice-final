<div class="content-filter mx-3 d-flex justify-content-between">
    <div class="input-container d-flex">
        <EditForm Model="SearchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
            <div class="input-group">
                <InputText id="search" placeholder="Find Client" class="form-control search-text valid border-end-0" @bind-Value="SearchForm.SearchText" />
                <span class="input-group-text border-start-0">
                    <i class="fa fa-search"></i>
                </span>
            </div>
        </EditForm>
    </div>
    <div class="button-container d-flex flex-row-reverse align-items-end">
        <div>
            <a href="javascript:void(0)" class="btn btn-logs px-3" @onclick="OnViewLogsClickEvent">
                <i class="fa fa-list"></i>
                Logs
            </a>
        </div>
    </div>
</div>