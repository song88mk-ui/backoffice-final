<tr id="@BoostedSettings.ClientId">
    <td><span class="text-center"><strong>@BoostedSettings.ClientName</strong></span></td>
    <td align="center" valign="middle">
        <div class="py-2">
            <span class="m-rl-xs cap-bg-default">@BoostedSettings.Cap.ToString("P", CultureInfo.InvariantCulture)</span>
        </div>
    </td>
    <td align="center" valign="middle">

        <div class="d-flex justify-content-center">
            <AuthorizeView Policy="sbc-priceboost-settings-canedit">
                <Authorized Context="ActivateAll">
                    <a class="link-edit me-2" @onclick="async () => await OnEditSetting(BoostedSettings)" href="javascript:(0)">
                        <i class="fa fa-edit"></i>
                    </a>
                </Authorized>
                <NotAuthorized Context="ActivateAll">
                    <a class="link-edit me-2" href="javascript:(0)" disabled>
                        <i class="fa fa-edit"></i>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
            <a class="link-logs me-2" @onclick="async () => await OnViewLogs(BoostedSettings)" href="javascript:(0)">
                <i class="fa fa-list"></i>
            </a>
        </div>
    </td>
</tr>