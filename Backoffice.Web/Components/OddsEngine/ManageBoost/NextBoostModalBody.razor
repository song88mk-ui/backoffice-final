@if (IsPreLoader)
{
    <Preloader InlineCss="@PreloaderInlineCss" />
}
<div class="modal-body">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th scope="col">@_translationState.GetValue("Details")</th>
                <th scope="col">@_translationState.GetValue("Sports")</th>
                <th scope="col">@_translationState.GetValue("Client name")</th>
                <th scope="col">BR CTRL</th>
                <th scope="col">@_translationState.GetValue("Current Odds")</th>
                <th scope="col">@_translationState.GetValue("Boosted Odds")</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <th scope="row" rowspan="@(AddPriceBoostFilterModel.PriceBoostConfigList.Count+1)">
                    <div class="d-flex flex-column">
                        <span><b>@_translationState.GetValue(AddPriceBoostFilterModel.SelectionName)</b></span>
                        <span>@AddPriceBoostFilterModel.MarketName</span>
                        <span>@AddPriceBoostFilterModel.SegmentName</span>
                        <span>@AddPriceBoostFilterModel.LeagueName</span>
                        <span>@AddPriceBoostFilterModel.FixtureName</span>
                        <span>@(AddPriceBoostFilterModel.PriceBoostConfigList.FirstOrDefault()?.TimeStamp.ToString("dd/MM/yy", CultureInfo.InvariantCulture))</span>
                        <span>@(AddPriceBoostFilterModel.PriceBoostConfigList.FirstOrDefault()?.TimeStamp.ToString("HH:mm"))</span>
                    </div>
                </th>
                <td rowspan="@(AddPriceBoostFilterModel.PriceBoostConfigList.Count+1)">@_translationState.GetValue(AddPriceBoostFilterModel.SportName)</td>
            </tr>
            @foreach (var config in AddPriceBoostFilterModel.PriceBoostConfigList)
            {
                <tr scope="row">
                    <td>@config.ClientName</td>
                    <td>@config.BROdds.ToString("0.00")</td>
                    <td>@config.ClientOdds.ToString("0.00")</td>
                    <td>
                        @{
                            Placeholder = config.BoostedOdds == 0 ? "-.-" : config.BoostedOdds.ToString("0.00");
                        }

                        @if (config.ClientOdds == 0)
                        {
                            <input type="number" class="form-control" @bind-value="@config.BoostedOddsStr" placeholder="@Placeholder" disabled />
                        }
                        else
                        {
                            <input type="number" class="form-control" @bind:event="oninput" @bind="@config.BoostedOddsStr" placeholder="@Placeholder" @onkeyup="OnConfigBoostedInputChangedEvent" />
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn modal-cancel" @onclick="OnCancelModalClick">@_translationState.GetValue("Cancel")</button>
    <button type="button" class="btn modal-btn modal-save" @onclick="OnSaveModalClick" disabled="@IsSaveDisabled">@_translationState.GetValue("Save")</button>
</div>