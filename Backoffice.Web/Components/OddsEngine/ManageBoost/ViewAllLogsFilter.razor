@using BlazorDateRangePicker
<div class="row">
    <div class="col-4">
        <button class="btn btn-filter" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
            <i class="fa fa-filter"></i>&nbsp;Filters
        </button>
    </div>
    <div class="col-4"></div>
    <div class="col-4 position-relative">
        <EditForm class="f-right" Model="FilterModel" OnValidSubmit="OnSubmitClickEvent">
            <div class="right-icon-control">
                <InputText id="search" class="form-control search-text" placeholder="Search Here..." @bind-Value="FilterModel.SearchText" />
                <div class="form-icon"> <i class="feather icon-search"></i> </div>
            </div>
        </EditForm>
    </div>
</div>
<div class="row mt-3">
    <div class="col-12">
        <div class="row collapse" id="filterCollapse">
            @if (SelectedPage == Backoffice.Shared.Enums.Page.OE_PriceBoost_Manage)
            {
                <div class="col-2">
                    <select class="form-select" @onchange="OnPageSelectionChangedEvent">
                        <optgroup label="Logs Type">
                            @foreach (var item in Pages)
                            {
                                @if (SelectedPage == item.Key)
                                {
                                    <option value="@item.Key" selected>@item.Value</option>
                                }
                                else
                                {
                                    <option value="@item.Key">@item.Value</option>
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select" @onchange="OnClientChangedEvent">
                        <optgroup label="Clients">
                            <option value="ALL">All Clients</option>
                            @if (FilterModel != null && FilterModel.Clients != null)
                            {
                                @foreach (var client in FilterModel.Clients)
                                {
                                    @if (client.Value == FilterModel.ClientCode)
                                    {
                                        <option value="@client.Key" selected>@client.Value</option>
                                    }
                                    else
                                    {
                                        <option value="@client.Key">@client.Value</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select" @onchange="OnSportChangedEvent">
                        <optgroup label="Sports">
                            <option value="0">Select Sports</option>
                            @if (FilterModel != null && FilterModel.Sports != null)
                            {
                                @foreach (var sport in FilterModel.Sports.Sports)
                                {
                                    @if (sport.SportId == FilterModel.SportId)
                                    {
                                        <option value="@sport.SportId" selected>@sport.SportName</option>
                                    }
                                    else
                                    {
                                        <option value="@sport.SportId">@sport.SportName</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select" @onchange="OnSegmentChangedEvent">
                        <optgroup label="Segment">
                            <option value="0">Select Segment</option>
                            @if (FilterModel != null && FilterModel.Segments != null)
                            {
                                @foreach (var segment in FilterModel.Segments.SegmentLookup)
                                {
                                    @if (segment.SegmentId == FilterModel.SegmentId)
                                    {
                                        <option value="@segment.SegmentId" selected>@segment.SegmentName</option>
                                    }
                                    else
                                    {
                                        <option value="@segment.SegmentId">@segment.SegmentName</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select" @onchange="OnLeagueChangedEvent">
                        <optgroup label="League">
                            <option value="0">Select League</option>
                            @if (FilterModel != null && FilterModel.Leagues != null)
                            {
                                @foreach (var league in FilterModel.Leagues.LeagueLookup)
                                {
                                    @if (league.LeagueId == FilterModel.LeagueId)
                                    {
                                        <option value="@league.LeagueId" selected>@league.LeagueName</option>
                                    }
                                    else
                                    {
                                        <option value="@league.LeagueId">@league.LeagueName</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>

                <div class="col-2">
                    <DateRangePicker class="form-control" DateFormat="MM/dd/yyyy" LinkedCalendars="true" StartDate="FilterModel.DateFrom" EndDate="FilterModel.DateTo" MaxDate="DateTime.Today" OnRangeSelect="OnDateRangeChangedEvent"></DateRangePicker>
                </div>
            }
            else
            {
                <div class="col-3">
                    <select class="form-select" @onchange="OnPageSelectionChangedEvent">
                        <optgroup label="Logs Type">
                            @foreach (var item in Pages)
                            {
                                @if (SelectedPage == item.Key)
                                {
                                    <option value="@item.Key" selected>@item.Value</option>
                                }
                                else
                                {
                                    <option value="@item.Key">@item.Value</option>
                                }
                            }
                        </optgroup>
                    </select>
                </div>

                <div class="col-3">
                    <DateRangePicker class="form-control" DateFormat="MM/dd/yyyy" LinkedCalendars="true" StartDate="FilterModel.DateFrom" EndDate="FilterModel.DateTo" MaxDate="DateTime.Today" OnRangeSelect="OnDateRangeChangedEvent"></DateRangePicker>
                </div>
            }

        </div>
    </div>
</div>