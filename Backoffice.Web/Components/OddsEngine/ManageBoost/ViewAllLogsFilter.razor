@using BlazorDateRangePicker
<div class="row">
    <div class="col-4">
        <button class="btn btn-filter" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
            <i class="fa fa-filter"></i>&nbsp;Filters
        </button>
    </div>
    <div class="col-4"></div>
    <div class="col-4 position-relative">
        <input type="text" class="form-control" placeholder="Search Here..." /><span><i class="fa fa-search"></i></span>
    </div>
</div>
<div class="row mt-3">
    <div class="col-12">
        <div class="row collapse" id="filterCollapse">
            <div class="col-2">
                <select class="form-select">
                    <optgroup label="Logs Type">
                        <option value="0">
                            Manage Boost
                        </option>
                        <option value="1">
                            Boosted Settings
                        </option>
                    </optgroup>
                </select>
            </div>

            <div class="col-2">
                <select class="form-select">
                    <optgroup label="Clients">
                        <option value="0">
                            All Clients
                        </option>
                        <option value="1">
                            10 BET CRYPTO
                        </option>

                        <option value="2">
                            10 BET DRC
                        </option>

                        <option value="3">
                            10 BET GHANA
                        </option>

                        <option value="4">
                            10 BET INDIA
                        </option>

                        <option value="5">
                            10 BET JAPAN
                        </option>
                    </optgroup>
                </select>
            </div>

            <div class="col-2">
                <select class="form-select">
                    <optgroup label="Sports">
                        <option value="0">
                            Select Sports
                        </option>
                        <option value="1">
                            Alpine Skiing
                        </option>

                        <option value="2">
                            American Football
                        </option>

                        <option value="3">
                            Athletics
                        </option>

                        <option value="4">
                            Aussie Rules
                        </option>

                        <option value="5">
                            Badminton
                        </option>
                    </optgroup>
                </select>
            </div>

            <div class="col-2">
                <select class="form-select">
                    <optgroup label="Segment">
                        <option value="0">
                            Select Segment
                        </option>
                        <option value="1">
                            Segment 1
                        </option>

                        <option value="2">
                            Segment 2
                        </option>

                        <option value="3">
                            Segment 3
                        </option>

                        <option value="4">
                            Segment 4
                        </option>

                        <option value="5">
                            Segment 5
                        </option>
                    </optgroup>
                </select>
            </div>

            <div class="col-2">
                <select class="form-select">
                    <optgroup label="League">
                        <option value="0">
                            Select League
                        </option>
                        <option value="1">
                            League 1
                        </option>

                        <option value="2">
                            League 2
                        </option>

                        <option value="3">
                            League 3
                        </option>

                        <option value="4">
                            League 4
                        </option>

                        <option value="5">
                            League 5
                        </option>
                    </optgroup>
                </select>
            </div>

            <div class="col-2">
                <DateRangePicker class="form-control" DateFormat="MM/dd/yyyy" LinkedCalendars="true" MaxDate="DateTime.Today"></DateRangePicker>
            </div>

        </div>
    </div>
</div>