<div class="modal-body">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th scope="col">Date</th>
                <th scope="col">Activity</th>
                <th scope="col">From</th>
                <th scope="col">To</th>
                <th scope="col">Updated By</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var log in ActivityLogs)
            {
                <tr>
                    <th scope="row">
                        @log.TimeStamp.ToLocalTime().ToString("dd/MM/yy") @log.TimeStamp.ToLocalTime().ToString("HH:mm")
                    </th>
                    <td>
                        @log.Activity
                    </td>
                    <td>
                        @((MarkupString)GetLogDetails(log, true))
                    </td>
                    <td>
                        @((MarkupString)GetLogDetails(log, false))
                    </td>
                    <td>
                        @log.Username
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="modal-footer">
    <button type="button" class="btn modalBtn modalCancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelModalClick">Close</button>
</div>