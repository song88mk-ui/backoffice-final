<div class="modal-body">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th scope="col">@_translationState.GetValue("Date")</th>
                <th scope="col">@_translationState.GetValue("Activity")</th>
                <th scope="col">@_translationState.GetValue("From")</th>
                <th scope="col">@_translationState.GetValue("To")</th>
                <th scope="col">@_translationState.GetValue("Updated By")</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var log in ActivityLogs)
            {
                <tr>
                    <th scope="row">
                        @log.TimeStamp.ToLocalTime().ToString("dd/MM/yy", CultureInfo.InvariantCulture) @log.TimeStamp.ToLocalTime().ToString("HH:mm")
                    </th>
                    <td>
                        @log.Activity
                    </td>
                    <td>
                        @((MarkupString)GetLogDetails(log, true))
                    </td>
                    <td>
                        @((MarkupString)GetLogDetails(log, false))
                    </td>
                    <td>
                        @log.Username
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn modal-cancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelModalClick">@_translationState.GetValue("Cancel")</button>
</div>