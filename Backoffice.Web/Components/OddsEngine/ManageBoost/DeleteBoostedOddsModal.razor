<Preloader @InlineCss="@InlineCss"/>
<div class="modal-body">
    <div class="d-flex flex-column justify-content-center p-5">
        <div class="text-center">
            <img src="icons/svg/warning-icon.svg" />
        </div>
        <div class="text-center">
            You are about to delete "<span class="fw-bold">Boosted Odds for @(DisplayMessage())</span>".
            <br />
            Please be certain as this cannot be undone
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn modal-cancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelModalClick">Cancel</button>
    <button type="button" class="btn modal-btn modal-save waves-effect" data-bs-dismiss="modal" @onclick="OnDeleteModalClick">Delete</button>
</div>