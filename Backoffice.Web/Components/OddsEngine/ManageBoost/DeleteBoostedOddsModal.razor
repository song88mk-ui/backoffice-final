
<div class="modal-body">
    <div class="d-flex flex-column justify-content-center p-5">
        <div>
            <div class="text-center mb-4">
                <img src="icons/svg/warning-icon.svg" />
            </div>
            <div class="text-center">
                You are about to delete "<span class="fw-bold">Boosted Odds for @(DisplayMessage())</span>".
                <br />
                @TranslationState.GetValue("Please be certain as this cannot be undone")
            </div>
        </div>
        @if (IsPreLoader)
        {
            <div class="mt-4">
                <Preloader InlineCss="@InlineCss"/>   
            </div>
        }
    </div>
</div>
<div class="modal-footer mx-4 pe-0">
    <button type="button" class="btn modal-btn modal-cancel" @onclick="OnCancelModalClick">@TranslationState.GetValue("Cancel")</button>
    <button type="button" class="btn modal-btn modal-save" @onclick="OnDeleteModalClick">@TranslationState.GetValue("Delete")</button>
</div>