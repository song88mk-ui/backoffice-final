@if (_isPreloader)
{
    <div class="mb-4">
        <Preloader InlineCss="@InlineCss" />
    </div>
}
else
{
    <div class="modal-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th scope="col">Client Name</th>
                    <th scope="col">Sports</th>
                    <th scope="col">Details</th>
                    <th scope="col">BR Ctrl</th>
                    <th scope="col">Current Odds</th>
                    <th scope="col">Update Selection</th>
                    <th scope="col">Boosted Odds</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">@_priceBoostConfigModel.ClientName</th>
                    <td>@_priceBoostConfigModel.SportName</td>
                    <td class="d-flex flex-column">
                        <span><b>@_priceBoostConfigModel.SelectionName</b></span>
                        <span>@_priceBoostConfigModel.MarketName</span>
                        <span>@_priceBoostConfigModel.SegmentName</span>
                        <span>@_priceBoostConfigModel.LeagueName</span>
                        <span>@_priceBoostConfigModel.FixtureName</span>
                        @if (_priceBoostConfigModel.FixtureStatusId == (int)FixtureStatus.Live)
                        {
                            <span class="period">@_priceBoostConfigModel.CurrentPeriod</span>
                            if (!string.IsNullOrEmpty(_priceBoostConfigModel.CurrentMinute) && int.Parse(_priceBoostConfigModel.CurrentMinute) > 0)
                            {
                                <span class="time">@_priceBoostConfigModel.CurrentMinute</span>
                            }
                        }
                        else
                        {
                            <span>@_priceBoostConfigModel.FixtureStartDate.ToLocalTime().ToString("dd/MM/yy")</span>
                            <span>@_priceBoostConfigModel.FixtureStartDate.ToLocalTime().ToString("HH:mm")</span>
                        }
                    </td>
                    <td class="text-center">@_priceBoostConfigModel.BROdds.ToString("0.00")</td>
                    <td class="text-center">@_priceBoostConfigModel.ClientOdds.ToString("0.00")</td>
                    <td class="pe-3">
                        <div class="row selection-width">
                            <div class="col">
                                <div class="row align-items-center">
                                    <div class="col-2 p-0">
                                        <div class="dropdown">
                                            <button class="btn dropdown-toggle fs-3" type="button" id="@_priceBoostConfigModel.SelectionName" data-bs-toggle="dropdown" aria-expanded="false" disabled>
                                                <i class="flag-en"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="@_priceBoostConfigModel.BoostedSelectionName">
                                                <li>
                                                    <a class="dropdown-item" href="#"></a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="col p-0">
                                        <div>
                                            <input type="text" class="form-control" @bind-value="_priceBoostConfigModel.BoostedSelectionName" />
                                        </div>
                                    </div>
                                    @if (_languages.Languages.Any())
                                    {
                                        <div class="col-1 p-0">
                                            <button type="button" class="btn" @onclick="OnAddSelection">
                                                <i class="fa fa-plus-circle"></i>
                                            </button>
                                        </div>
                                    }
                                    <div class="col-1 p-0">
                                        <button type="button" class="btn" disabled>
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (_priceBoostConfigModel.BoostedSelectionTranslations != null && _priceBoostConfigModel.BoostedSelectionTranslations.Any())
                        {
                            <EditBoostedOddsModalRow BoostedSelectionTranslationModel="@_priceBoostConfigModel.BoostedSelectionTranslations" LanguagesModel="@_languages"
                                             OnAddSelectionCallback="OnAddSelection"
                                             OnDeleteSelectionCallback="OnDeleteSelection"
                                             OnSelectLanguageCallback="OnSelectLanguage" />
                        }
                    </td>
                    <td>
                        <input type="number" class="form-control text-center" @bind-value="_priceBoostConfigModel.BoostedOddsStr" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
}
<div class="modal-footer mx-4 pe-0">
    <button type="button" class="btn modal-btn modal-cancel" @onclick="OnCancelModalClick" disabled="@_isPreloader">Cancel</button>
    <button type="button" class="btn modal-btn modal-save" @onclick="OnSaveModalClick" disabled="@_isPreloader">Save</button>
</div>