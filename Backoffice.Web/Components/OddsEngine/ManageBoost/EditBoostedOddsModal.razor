@using Backoffice.Shared.Enums;

@if (IsPreloader)
{
    <div class="mb-4">
        <Preloader InlineCss="@InlineCss" />
    </div>
}
else
{
    <div class="modal-body">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th scope="col">Client Name</th>
                    <th scope="col">Sports</th>
                    <th scope="col">Details</th>
                    <th scope="col">BR Ctrl</th>
                    <th scope="col">Current Odds</th>
                    <th scope="col">Update Selection</th>
                    <th scope="col">Boosted Odds</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <th scope="row">@PriceBoostConfigModel.ClientName</th>
                    <td>@PriceBoostConfigModel.SportName</td>
                    <td class="d-flex flex-column">
                        <span><b>@PriceBoostConfigModel.SelectionName</b></span>
                        <span>@PriceBoostConfigModel.MarketName</span>
                        <span>@PriceBoostConfigModel.SegmentName</span>
                        <span>@PriceBoostConfigModel.LeagueName</span>
                        <span>@PriceBoostConfigModel.FixtureName</span>
                        @if (PriceBoostConfigModel.FixtureStatusId == (int)FixtureStatus.Live)
                        {
                            <span class="period">@PriceBoostConfigModel.CurrentPeriod</span>
                            if (!string.IsNullOrEmpty(PriceBoostConfigModel.CurrentMinute) && int.Parse(PriceBoostConfigModel.CurrentMinute) > 0)
                            {
                                <span class="time">@PriceBoostConfigModel.CurrentMinute</span>
                            }
                        }
                        else
                        {
                            <span>@PriceBoostConfigModel.FixtureStartDate.ToLocalTime().ToString("dd/MM/yy")</span>
                            <span>@PriceBoostConfigModel.FixtureStartDate.ToLocalTime().ToString("HH:mm")</span>
                        }
                    </td>
                    <td class="text-center">@PriceBoostConfigModel.BROdds.ToString("0.00")</td>
                    <td class="text-center">@PriceBoostConfigModel.ClientOdds.ToString("0.00")</td>
                    <td class="pe-3">
                        <div class="row selection-width">
                            <div class="col">
                                <div class="row align-items-center">
                                    <div class="col-2 p-0">
                                        <div class="dropdown">
                                            <button class="btn dropdown-toggle fs-3" type="button" id="@PriceBoostConfigModel.SelectionName" data-bs-toggle="dropdown" aria-expanded="false" disabled>
                                                <i class="flag-en"></i>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="@PriceBoostConfigModel.SelectionName">
                                                <li>
                                                    <a class="dropdown-item" href="#"></a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="col p-0">
                                        <div>
                                            <input type="text" class="form-control" @bind-value="PriceBoostConfigModel.SelectionName" />
                                        </div>
                                    </div>
                                    <div class="col-1 p-0">
                                        <button type="button" class="btn" @onclick="OnAddSelection">
                                            <i class="fa fa-plus-circle"></i>
                                        </button>
                                    </div>
                                    <div class="col-1 p-0">
                                        <button type="button" class="btn" disabled>
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (PriceBoostConfigModel.BoostedSelectionTranslations != null && PriceBoostConfigModel.BoostedSelectionTranslations.Any())
                        {
                            <EditBoostedOddsModalRow BoostedSelectionTranslationModel="@PriceBoostConfigModel.BoostedSelectionTranslations" LanguagesModel="@Languages"
                                             OnAddSelectionCallback="OnAddSelection"
                                             OnDeleteSelectionCallback="OnDeleteSelection"
                                             OnSelectLanguageCallback="OnSelectLanguage" />
                        }
                    </td>
                    <td>
                        <input type="number" class="form-control text-center" @bind-value="PriceBoostConfigModel.BoostedOddsStr" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
}
<div class="modal-footer mx-4 pe-0">
    <button type="button" class="btn modal-btn modal-cancel" @onclick="OnCancelModalClick" disabled="@IsPreloader">Cancel</button>
    <button type="button" class="btn modal-btn modal-save" @onclick="OnSaveModalClick" disabled="@IsPreloader">Save</button>
</div>