@for (int index = 0; index < BoostedSelectionTranslationModel.Count; index++)
{
    var selection = BoostedSelectionTranslationModel[index];

    <div class="d-flex flex-row">
        <div class="dropdown">
            <button class="btn dropdown-toggle" type="button" id="@selection.BoostedSelectionName" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="icofont icofont-lang-en" aria-hidden="true"></i>
            </button>
            <div class="dropdown-menu" aria-labelledby="@selection.BoostedSelectionName">
                @for (int langIndex = 0; langIndex < LanguagesModel.Languages.Count; langIndex++)
                {
                    var language = LanguagesModel.Languages[langIndex];

                    <button class="dropdown-item" @onclick="_ => OnSelectLanguage(index,language)">
                        <i class="@($"fa fa-flag-{language.LanguageCode.ToLower()}")" aria-hidden="true">
                            <span>@language.LanguageName</span>
                        </i>
                    </button>
                }
            </div>
        </div>
        <div>
            <input type="text" class="form-control" @bind-value="selection.BoostedSelectionName" />
        </div>
        <div>
            <button type="button" class="btn" @onclick="OnAddSelection">
                <i class="fa fa-plus-circle"></i>
            </button>
        </div>
        <div>
            <button type="button" class="btn" @onclick="_ => OnDeleteSelection(selection)">
                <i class="fa fa-trash"></i>
            </button>
        </div>
    </div>
}