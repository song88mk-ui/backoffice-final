@for (int index = 0; index < BoostedSelectionTranslationModel.Count; index++)
{
    var selection = BoostedSelectionTranslationModel[index];

    <div class="row">
        <div class="col">
            <div class="row align-items-center">
                <div class="col-2 p-0">
                    <div class="dropdown">
                        <button class="btn @(LanguagesModel.Languages.Any() ? "dropdown-toggle" : "") fs-3" type="button" id="@selection.BoostedSelectionName" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="@($"flag-{selection.Language.LanguageCode.ToLower()}")" aria-hidden="true"></i>
                        </button>
                        @if (LanguagesModel.Languages.Any())
                        {
                            <div class="dropdown-menu" aria-labelledby="@selection.BoostedSelectionName">
                                @for (int langIndex = 0; langIndex < LanguagesModel.Languages.Count; langIndex++)
                                {
                                    var language = LanguagesModel.Languages[langIndex];

                                    <button class="dropdown-item position-relative" @onclick="_ => OnSelectLanguage(BoostedSelectionTranslationModel.IndexOf(selection),language)">
                                        <i class="@($"ico-flag flag-{language.LanguageCode.ToLower()}")" aria-hidden="true">
                                        </i>
                                        <span class="lang-name">@language.LanguageName</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="col p-0">
                    <input type="text" class="form-control" @bind-value="selection.BoostedSelectionName" />
                </div>
                @if (LanguagesModel.Languages.Any())
                {
                    <div class="col-1 p-0">
                        <button type="button" class="btn" @onclick="OnAddSelection">
                            <i class="fa fa-plus-circle"></i>
                        </button>
                    </div>
                }
                <div class="col-1 p-0">
                    <button type="button" class="btn" @onclick="_ => OnDeleteSelection(selection)">
                        <i class="fa fa-trash"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
}