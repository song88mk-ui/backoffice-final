<div class="modal-body">
    @if (IsPreloader)
    {
        <Preloader InlineCss="@PreloaderInlineCss" />
    }
    <div class="d-flex flex-row">
        <div>
            <input type="radio" class="btn-check" name="matchTabOptions" id="matchType" checked @onclick="@(e => OnMatchTypeChanged(FixtureType.Match))" />
            <label class="btn match-tab-lbl" for="matchType">@TranslationState.GetValue("Match Type")</label>
        </div>

        <div>
            <input type="radio" class="btn-check" name="matchTabOptions" id="outrights" @onclick="@(e => OnMatchTypeChanged(FixtureType.Outright))" />
            <label class="btn match-tab-lbl" for="outrights">Outrights</label>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-6">
            <label for="sportSelect" class="form-label">@TranslationState.GetValue("Sports")</label>
            <select class="form-select" id="sportSelect" @onchange="OnSportSelectChanged">
                <option value="0">Select Sport</option>
                @foreach (var item in Model.Sports)
                {
                    if (Model.SportId == item.Value)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-6">
            <label for="segmentSelect" class="form-label">@TranslationState.GetValue("Segment")</label>
            <select class="form-select" id="segmentSelect" @onchange="OnSegmentSelectChanged">
                <option value="0">Select Segment</option>
                @foreach (var item in Model.Segments)
                {
                    if (Model.SegmentId == item.Value)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-6">
            <label for="leagueSelect" class="form-label">@TranslationState.GetValue("League")</label>
            <select class="form-select" id="LeagueSelect" @onchange="OnLeagueSelectChanged">
                <option value="0">Select League</option>
                @foreach (var item in Model.Leagues)
                {
                    if (Model.LeagueId == item.Value)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-6">
            <label for="fixtureSelect" class="form-label">Fixture</label>
            <select class="form-select" id="fixtureSelect" @onchange="OnFixtureSelectChanged">
                <option value="">Select Fixture</option>
                @foreach(var item in Model.Fixtures)
                {
                    if (Model.ProviderFixtureId == item.Value)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-6">
            <label for="marketSelect" class="form-label">Market</label>
            <select class="form-select" id="marketSelect" @onchange="OnMarketSelectChanged">                
                <option value="">Select Market</option>
                @foreach (var item in Model.Markets)
                {
                    if (Model.MarketName == item.Name)
                    {
                                <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                                <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-6">
            <label for="selectionSelect" class="form-label">Selection</label>
            <select class="form-select" id="selectionSelect" @onchange="OnSelectionSelectChanged">
                <option value="">Select Selection</option>
                @foreach (var item in Model.Selections)
                {
                    if (Model.SelectionName == item.Name)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn modal-cancel" @onclick="OnCancelModalClick">@TranslationState.GetValue("Cancel")</button>
    <button type="button" class="btn modal-btn modal-save" @onclick="OnNextModalClick">Next</button>
</div>