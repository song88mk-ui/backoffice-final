@using Backoffice.Shared.Enums;

<div class="modal-body">
    @if (IsPreloader)
    {
        <Preloader InlineCss="@PreloaderInlineCss" />
    }
    <div class="d-flex flex-row">
        <div>
            <input type="radio" class="btn-check" name="matchTabOptions" id="matchType" checked @onclick="@(e => OnMatchTypeChanged(FixtureType.Match))" />
            <label class="btn match-tab-lbl" for="matchType">Match Type</label>
        </div>

        <div>
            <input type="radio" class="btn-check" name="matchTabOptions" id="outrights" @onclick="@(e => OnMatchTypeChanged(FixtureType.Outright))" />
            <label class="btn match-tab-lbl" for="outrights">Outrights</label>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-6">
            <label for="sportSelect" class="form-label">Sports</label>
            <select class="form-select" id="sportSelect" @onchange="OnSportSelectChanged">
                <option value="0">Select Sport</option>
                @foreach (var item in AddPriceBoostFilterModel.Sports)
                {
                    if (AddPriceBoostFilterModel.SportId == item.Value)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-6">
            <label for="segmentSelect" class="form-label">Segment</label>
            <select class="form-select" id="segmentSelect" @onchange="OnSegmentSelectChanged">
                <option value="0">Select Segment</option>
                @foreach (var item in AddPriceBoostFilterModel.Segments)
                {
                    if (AddPriceBoostFilterModel.SegmentId == item.Value)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-6">
            <label for="leagueSelect" class="form-label">League</label>
            <select class="form-select" id="LeagueSelect" @onchange="OnLeagueSelectChanged">
                <option value="0">Select League</option>
                @foreach (var item in AddPriceBoostFilterModel.Leagues)
                {
                    if (AddPriceBoostFilterModel.LeagueId == item.Value)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-6">
            <label for="fixtureSelect" class="form-label">Fixture</label>
            <select class="form-select" id="fixtureSelect" @onchange="OnFixtureSelectChanged">
                <option value="">Select Fixture</option>
                @foreach(var item in AddPriceBoostFilterModel.Fixtures)
                {
                    if (AddPriceBoostFilterModel.ProviderFixtureId == item.Value)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-6">
            <label for="marketSelect" class="form-label">Market</label>
            <select class="form-select" id="marketSelect" @onchange="OnMarketSelectChanged">                
                <option value="">Select Market</option>
                @foreach (var item in AddPriceBoostFilterModel.Markets)
                {
                    if (AddPriceBoostFilterModel.MarketName == item.Name)
                    {
                                <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                                <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-6">
            <label for="selectionSelect" class="form-label">Selection</label>
            <select class="form-select" id="selectionSelect" @onchange="OnSelectionSelectChanged">
                <option value="">Select Selection</option>
                @foreach (var item in AddPriceBoostFilterModel.Selections)
                {
                    if (AddPriceBoostFilterModel.SelectionName == item.Name)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modalBtn modalCancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelModalClick">Cancel</button>
    <button type="button" class="btn modalBtn modalSave waves-effect" data-bs-dismiss="modal" @onclick="OnNextModalClick">Next</button>
</div>