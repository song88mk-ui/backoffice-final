<div class="row">
    <div class="col-md-12">
        <div class="content-filter mx-3 d-flex justify-content-between">
            <div class="select-container d-flex">
                <div class="me-4">
                    <label class="form-label d-block">Clients</label>
                    @if (PriceboostFilterModel.Clients.Any())
                    {
                        <select class="form-select d-block" @onchange="OnClientChangedEvent">
                            <option value="">All Clients</option>
                            @foreach (var item in PriceboostFilterModel.Clients)
                            {
                                if (item.Name == PriceboostFilterModel.ClientCode)
                                {
                                    <option value="@item.Value" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            }
                        </select>
                    }
                </div>
                <div class="me-4">
                    <label class="form-label d-block">Sport</label>
                    <select class="form-select d-block" @onchange="OnSportChangedEvent">
                        @if (PriceboostFilterModel.Sports.Any())
                        {
                            <option value="0">All Sports</option>
                            @foreach (var item in PriceboostFilterModel.Sports)
                            {
                                if (item.Value == PriceboostFilterModel.SportId)
                                {
                                    <option value="@item.Value" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            }
                        }
                        else
                        {
                            <option value="0">--</option>
                        }
                    </select>
                </div>
                <div class="me-4">
                    <label class="form-label d-block">Segment</label>
                    <select class="form-select d-block" @onchange="OnSegmentChangedEvent">
                        @if (PriceboostFilterModel.Segments.Any())
                        {
                            <option value="0">All Segments</option>
                            @foreach (var item in PriceboostFilterModel.Segments)
                            {
                                if (item.Value == PriceboostFilterModel.SegmentId)
                                {
                                    <option value="@item.Value" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            }
                        }
                        else
                        {
                            <option value="0">--</option>
                        }
                    </select>
                </div>
                <div class="me-4">
                    <label class="form-label d-block">League</label>
                    <select class="form-select d-block" @onchange="OnLeagueChangedEvent">
                        @if (PriceboostFilterModel.Leagues.Any())
                        {
                            <option value="0">All Leagues</option>
                            @foreach (var item in PriceboostFilterModel.Leagues)
                            {
                                if (item.Value == PriceboostFilterModel.LeagueId)
                                {
                                    <option value="@item.Value" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            }
                        }
                        else
                        {
                            <option value="0">--</option>
                        }
                    </select>
                </div>
            </div>
            <div class="input-container d-flex flex-row-reverse align-items-end">
                <EditForm Model="SearchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
                    <div class="input-group">
                        <InputText id="search" placeholder="Search" class="form-control search-text valid border-end-0" @bind-Value="SearchForm.SearchText" />
                        <span class="input-group-text border-start-0">
                            <i class="fa fa-search"></i>
                        </span>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="mx-3 d-flex justify-content-between mt-3">
            <div>
                <a href="javascript:void(0)" class="btn btn-boosted-odds px-3" @onclick="OnAddBoostedOdds">
                    <i class="fa fa-rocket"></i>
                    Add Boosted Odds
                </a>
            </div>
            <div>
                <a href="javascript:void(0)" class="btn btn-logs px-3" @onclick="OnViewAllLogs">
                    <i class="fa fa-list"></i>
                    Logs
                </a>
            </div>
        </div>
    </div>
</div>