<div class="row">
    <div class="col-md-12">
        <div class="content-filter mx-3 d-flex justify-content-between">
            <div class="select-container d-flex">
                <div class="client-container me-4">
                    <label class="form-label d-block">@TranslationState.GetValue("Clients")</label>
                    <select class="form-select d-block" @onchange="OnClientChangedEvent">
                        @if (_clients.Any())
                        {
                            @foreach (var item in _clients)
                            {
                                <option value="@item.Value" selected="@(item.Value == SelectedClientCode)">@TranslationState.GetValue(item.Name)</option>
                            }
                        }
                        else
                        {
                            <option value="0">--</option>
                        }
                    </select>
                </div>
                <div class="sport-container me-4">
                    <label class="form-label d-block">@TranslationState.GetValue("Sports")</label>
                    <select class="form-select d-block" @onchange="OnSportChangedEvent">
                        @if (_sports.Any())
                        {
                            @foreach (var item in _sports)
                            {
                                <option value="@item.Value" selected="@(item.Value == SelectedSportId)">@TranslationState.GetValue(item.Name)</option>
                            }
                        }
                        else
                        {
                            <option value="0">--</option>
                        }
                    </select>
                </div>
                <div class="segment-container me-4">
                    <label class="form-label d-block">@TranslationState.GetValue("Segment")</label>
                    <select class="form-select d-block" @onchange="OnSegmentChangedEvent">
                        @if (_segments.Any())
                        {
                            @foreach (var item in _segments)
                            {
                                <option value="@item.Value" selected="@(item.Value == SelectedSegmentId)">@TranslationState.GetValue(item.Name)</option>
                            }
                        }
                        else
                        {
                            <option value="0">--</option>
                        }
                    </select>
                </div>
                <div class="league-container me-4">
                    <label class="form-label d-block">@TranslationState.GetValue("League")</label>
                    <select class="form-select d-block" @onchange="OnLeagueChangedEvent">
                        @if (_leagues != null)
                        {
                            @foreach (var item in _leagues)
                            {
                                <option value="@item.Value" selected=@(item.Value == SelectedLeagueId)>@TranslationState.GetValue(item.Name)</option>
                            }
                        }
                        else
                        {
                            <option value="0">--</option>
                        }
                    </select>
                </div>
            </div>
            <div class="input-container d-flex flex-row-reverse align-items-end">
                <EditForm Model="SearchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
                    <div class="input-group">
                        <InputText id="search" placeholder=@TranslationState.GetValue("Search") class="form-control search-text valid border-end-0" @bind-Value="SearchForm.SearchText" />
                        <span class="input-group-text border-start-0">
                            <i class="fa fa-search"></i>
                        </span>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="mx-3 d-flex justify-content-between mt-3">
            <div>
                <AuthorizeView Policy="sbc-priceboost-manage-canedit">
                    <Authorized Context="ActivateAll">
                        <a href="javascript:void(0)" class="btn btn-boosted-odds px-3" @onclick="OnAddBoostedOdds">
                            <i class="fa fa-rocket"></i>
                            @TranslationState.GetValue("Add Boosted Odds")
                        </a>
                    </Authorized>
                </AuthorizeView>
            </div>
            <div>
                <a href="javascript:void(0)" class="btn btn-logs px-3" @onclick="OnViewAllLogs">
                    <i class="fa fa-list"></i>
                    @TranslationState.GetValue("Logs")
                </a>
            </div>
        </div>
    </div>
</div>