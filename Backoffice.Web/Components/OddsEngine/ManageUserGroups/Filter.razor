<div class="content-filter mx-3 d-flex justify-content-between">
    <div class="button-container d-flex">
        <div>
            <a href="javascript:void(0)" class="btn btn-create px-3">
                <i class="fa fa-user-plus"></i>
                Add Users
            </a>
        </div>
    </div>
    <div class="input-container d-flex flex-row-reverse align-items-end">
        <div class="ms-2">
            <select class="form-select d-block">
                <option value="1" selected>Sort By User Group Name (Ascending)</option>
                <option value="2">Sort By User Group Name (Descending)</option>
            </select>
        </div>
        <EditForm Model="SearchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
            <div class="input-group">
                <InputText id="search" placeholder="Find Group Name" class="form-control search-text valid border-end-0" @bind-Value="SearchForm.SearchText" />
                <span class="input-group-text border-start-0">
                    <i class="fa fa-search"></i>
                </span>
            </div>
        </EditForm>
    </div>
</div>