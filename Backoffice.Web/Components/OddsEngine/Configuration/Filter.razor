<div class="row ms-2 mb-3">
    <div class="col-md-12 mb-3">        
        <h4 class="fw-bold">@ConfigFilterModel.HeaderTitle</h4>
    </div>

    <div class="col">
        <select class="form-select" aria-label="Sport Select" @onchange="OnSportChangedEvent">
            @foreach (var item in ConfigFilterModel.Sports)
            {
                if (item.Value == ConfigFilterModel.SportId)
                {
                    <option value="@item.Value" selected>@item.Name</option>
                }
                else
                {
                    <option value="@item.Value">@item.Name</option>
                }
            }
        </select>
    </div>

    <div class="col">
        <select class="form-select" aria-label="Segment Select" @onchange="OnSegmentChangedEvent">
            @foreach (var item in ConfigFilterModel.Segments)
            {
                if (item.Value == ConfigFilterModel.SegmentId)
                {
                    <option value="@item.Value" selected>@item.Name</option>
                }
                else
                {
                    <option value="@item.Value">@item.Name</option>
                }
            }
        </select>
    </div>    
    
    <div class="col">
        <select class="form-select" aria-label="League Select" @onchange="OnLeagueChangedEvent">
            @foreach (var item in ConfigFilterModel.Leagues)
            {
                if (item.Value == ConfigFilterModel.LeagueId)
                {
                    <option value="@item.Value" selected>@item.Name</option>
                }
                else
                {
                    <option value="@item.Value">@item.Name</option>
                }
            }
        </select>
    </div>        

    <div class="col">
        <select class="form-select" aria-label="Scope Select" @onchange="OnScopeChangedEvent">
            @foreach (var item in ConfigFilterModel.Scopes)
            {
                <option value="@item.Value">@item.Name</option>
            }
        </select>
    </div>        

    <div class="col">
        <select class="form-select" aria-label="Client Select" @onchange="OnClientChangedEvent">
            @foreach (var item in ConfigFilterModel.Clients)
            {
                <option value="@item.ClientCode">@item.ClientName</option>
            }
        </select>
    </div>        

    <div class="col">
        <select class="form-select" aria-label="Config Select" @onchange="OnConfigChangedEvent">
            @foreach(var item in ConfigFilterModel.ConfigStatuses)
            {
                <option value="@item.Value">@item.Name</option>
            }
        </select>
    </div>        

    <div class="col">
        @if (ConfigFilterModel.MarketTemplateGroups.Count > 0)
        {
            <select class="form-select" aria-label="Market Select" @onchange="OnMarketChangedEvent">
                @foreach(var item in ConfigFilterModel.MarketTemplateGroups)
                {
                    <option value="@item.MarketTemplateGroup.MarketTemplateGroupId">@item.MarketTemplateGroup.MarketTemplateGroupName</option>
                }
            </select>
        }
        else
        {
            <select class="form-select" aria-label="Market Select">
                <option value="" selected></option>
            </select>
        }
    </div>        

    <div class="col-3 ps-5 pe-4">
        <div class="searchDiv">
            <i class="fa fa-search" aria-hidden="true"></i>
            <input type="text" id="searchField" class="form-control" placeholder="Find" />
        </div>
    </div>            
</div>

<div class="row d-none">
    <div class="col ps-3">
        <button type="button" class="btn">
            <i class="fa fa-file-excel-o"></i>
            Export To Excel
        </button>
        <button type="button" class="btn">
            <i class="fa fa-file-excel-o"></i>
            Import From Excel
        </button>
        <i class="fa fa-info-circle"></i>
    </div>
</div>