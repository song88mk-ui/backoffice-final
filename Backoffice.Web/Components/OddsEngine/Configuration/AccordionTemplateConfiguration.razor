<div class="accordion">
    <div class="accordion-item">
        <div class="accordion-header">
            <button class="accordion-button ps-5" type="button" data-bs-toggle="collapse" aria-expanded="false" data-bs-target="@($"#Market-{Market.MarketLookup.MarketTemplateId}")">
                @Market.MarketLookup.MarketTemplateName
            </button>

            <div class="d-flex justify-content-around market-toggle">
                <span class="market-is-active-text">@(Market.MarketLookup.IsActive ? "Market Active" : "Market Inactive")&nbsp;</span>
                <AuthorizeView Policy="sbc-config-canedit">
                    <Authorized Context="ActivateAll">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox"
                                   id="@($"Market-{Market.NewMarketLookup.MarketTemplateId}Toggle")" role="switch"
                                   aria-label="@($"{Market.NewMarketLookup.MarketTemplateName} Toggle Switch")"
                            @bind="Market.NewMarketLookup.IsActive" @oninput="OnMarketActiveChangedEvent" />
                        </div>
                    </Authorized>
                    <NotAuthorized Context="ActivateAll">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox"
                                   id="@($"Market-{Market.MarketLookup.MarketTemplateId}Toggle")" role="switch"
                                   aria-label="@($"{Market.MarketLookup.MarketTemplateName} Toggle Switch")"
                            @bind="Market.MarketLookup.IsActive" disabled />
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <div id="@($"Market-{Market.MarketLookup.MarketTemplateId}")" class="accordion-collapse collapse show">
            <div class="accordion-body">
                @{
                    var configStatus = Market.MarketLookup.IsActive ? "1" : "2";
                    if (FilterConfigStatus == null || !FilterConfigStatus.Any() || FilterConfigStatus.Contains(configStatus))
                    {
                        if ((Scope == 99 || Scope == 0))
                        {
                            //prematch
                            <PreMatchConfig @key=@(Market.MarketLookup.MarketTemplateId + "prematch") PrematchSettings="@Market.NewPrematchSettings" OnMarginChangeCallback="OnTemplateMarginChangeCallback" />
                        }

                        if ((Scope == 99 || Scope == 1))
                        {
                            //live
                            <LiveMatchConfig @key=@(Market.MarketLookup.MarketTemplateId + "live") LiveSettings="@Market.NewLiveSettings" OnMarginChangeCallback="OnMarginChangedEvent" />
                        }
                    }
                }
            </div>
        </div>
    </div>
</div>