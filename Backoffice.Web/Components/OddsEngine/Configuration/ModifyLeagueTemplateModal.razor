<div class="modal-body">
    @if (IsPreLoader)
    {
        <Preloader />
    }
    else
    {
        <div class="container px-3 pb-4 border-bottom">
            <div class="mb-2 d-flex justify-content-between">
                <label class="text-secondary fw-bold">Leagues Selected</label>

                <a href="javascript:void(0)" @onclick="OnShowAllClickedEvent">@(!IsShowAll ? "Show All" : "Show Less")</a>
            </div>
            <div class="row league-body">
                @if (Leagues != null && Leagues.Any())
                {
                    var leagues = IsShowAll ? Leagues : Leagues.Take(3);
                    @foreach (var item in leagues)
                    {
                        <div class="col-12 mb-2 p-0">
                            <div class="container border">
                                <p class="fw-bold my-2">@item.LeagueName</p>
                                <p class="mb-2">@($"{item.ClientName} | {item.SportName}")</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="d-flex my-3 ms-2">
            <label for="scopeSelect" class="col-8 col-sm-2 col-form-label">Template</label>
            <div class="col col-sm-10">
                <div class="dropdown">
                    <button class="btn w-100 form-select dropdown-toggle" type="button" id="client-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        @if (SelectedItem != null && !string.IsNullOrEmpty(SelectedItem.Name))
                        {
                            <span class="@(SelectedItem.Value == -1 ? "text-danger":"")">@SelectedItem.Name</span>
                        }
                        else
                        {
                            <span class="template-name-italic">Select Template</span>
                        }
                    </button>
                    @if (Templates != null && Templates.Any())
                    {
                        <SelectWithSearch State="State" Items="Templates" AriaLabel="scope-dropdown" OnSelectionCallback="OnTemplateSelectChanged" />
                    }
                </div>
            </div>            
        </div>

        <div class="col-sm-12 ms-2">
            @if (IsRemoveCurrentTemplate)
            {
                <div class="d-flex align-items-baseline flex-gap">
                    <i class="fa fa-info-circle" aria-hidden="true"></i><span class="fst-italic fw-bold">By removing the currently assigned template, the leagues you have selected will be moved to the Unassigned page.</span>
                </div>
            }
        </div>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn btn-cancel" @onclick="OnCancelClickedEvent" disabled="@IsPreLoader">Cancel</button>
    <button type="button" class="btn modal-btn btn-save" @onclick="OnSaveClickedEvent" disabled="@IsPreLoader">Apply</button>
</div>