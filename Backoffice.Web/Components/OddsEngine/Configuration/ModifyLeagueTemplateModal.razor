<div class="modal-body">
    @if (IsPreLoader)
    {
        <Preloader />
    }
    else
    {
        <div class="container px-3 pb-4 border-bottom">
            <div class="mb-2 d-flex justify-content-between">
                <label class="text-secondary fw-bold">@_translationState.GetValue("Leagues selected")</label>

                <a href="javascript:void(0)" @onclick="HandleShowAllClick">@(!IsShowAll ? "Show All" : "Show Less")</a>
            </div>
            <div class="row league-body">
                @if (Leagues != null && Leagues.Any())
                {
                    var leagues = IsShowAll ? Leagues : Leagues.Take(3);
                    @foreach (var item in leagues)
                    {
                        <div class="col-12 mb-2 p-0">
                            <div class="container border">
                                <p class="fw-bold my-2">@item.SegmentName > @item.LeagueName</p>
                                <p class="mb-2">@($"{item.ClientName} | {_translationState.GetValue(item.SportName)}")</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="d-flex my-3 ms-2">
            <label for="scopeSelect" class="col-8 col-sm-2 col-form-label">@_translationState.GetValue("Prematch")</label>
            <div class="col col-sm-10">
                <div class="dropdown">
                    <button class="btn w-100 form-select dropdown-toggle" type="button" id="client-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        @if (_prematchSelectedItem != null && !string.IsNullOrEmpty(_prematchSelectedItem.Name))
                        {
                            <span class="@(_prematchSelectedItem.Value == -1 ? "text-danger":"")">@_prematchSelectedItem.Name</span>
                        }
                        else
                        {
                            <span class="template-name-italic">@_translationState.GetValue("Select Template")</span>
                        }
                    </button>
                    @if (PrematchTemplates != null && PrematchTemplates.Any())
                    {
                        <SelectWithSearch SelectedItem="_prematchSelectedItem" State="State" Items="PrematchTemplates" AriaLabel="scope-dropdown" OnSelectionCallback="HandlePrematchTemplateSelectChange" />
                    }
                </div>
            </div>            
        </div>
        <div class="d-flex my-3 ms-2">
            <label for="scopeSelect" class="col-8 col-sm-2 col-form-label">@_translationState.GetValue("Live")</label>
            <div class="col col-sm-10">
                <div class="dropdown">
                    <button class="btn w-100 form-select dropdown-toggle" type="button" id="live-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        @if (_liveSelectedItem != null && !string.IsNullOrEmpty(_liveSelectedItem.Name))
                        {
                            <span class="@(_liveSelectedItem.Value == -1 ? "text-danger":"")">@_liveSelectedItem.Name</span>
                        }
                        else
                        {
                            <span class="template-name-italic">@_translationState.GetValue("Select Template")</span>
                        }
                    </button>
                    @if (LiveTemplates != null && LiveTemplates.Any())
                    {
                        <SelectWithSearch SelectedItem="_liveSelectedItem" State="State" Items="LiveTemplates" AriaLabel="scope-dropdown" OnSelectionCallback="HandleLiveTemplateSelectChange" />
                    }
                </div>
            </div>
        </div>

        <div class="col-sm-12 ms-2">
            @if (IsRemoveCurrentPrematchTemplate || IsRemoveCurrentLiveTemplate)
            {
                <div class="d-flex align-items-baseline flex-gap">
                    <i class="fa fa-info-circle" aria-hidden="true"></i><span class="fst-italic fw-bold">By removing the currently assigned template, the leagues you have selected will be moved to the Unassigned page.</span>
                </div>
            }
        </div>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn btn-cancel" @onclick="HandleCancelClick" disabled="@IsPreLoader">@_translationState.GetValue("Cancel")</button>
    <button type="button" class="btn modal-btn btn-save" @onclick="HandleSaveClick" disabled="@(IsPreLoader || !_hasChanged)">@_translationState.GetValue("Apply")</button>
</div>