<div class="col-md-12 mb-3">
    <label class="fw-bold">Select the Clients and Leagues that you'd like to assign to this template</label>
</div>

<div class="col-md-12 mb-4">
    <div class="d-flex justify-content-between">
        <div class="d-flex select-div">
            <div class="dropdown">
                <button class="form-select dropdown-toggle" type="button" id="client-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    @if (Clients.Any())
                    {
                        if (Clients.Count - 1 == SelectedClientCount)
                        {
                            <span>All Clients (@SelectedClientCount)</span>
                        }
                        else
                        {
                            <span>@(SelectedClientCount == 1 ? SelectedClientName : $"Clients ({SelectedClientCount})")</span>
                        }
                    }
                    else
                    {
                        <span>No Clients Available</span>
                    }
                </button>
                @if (Clients.Any())
                {
                    <SelectWithCheckbox Items="Clients" OnCheckboxCallback="OnClientCheckboxClickEvent" AriaLabel="client-dropdown" />
                }
            </div>

            <div class="dropdown">
                <button class="form-select dropdown-toggle" type="button" id="league-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    @if (Leagues.Any())
                    {
                        if (Leagues.Count - 1 == SelectedLeagueCount)
                        {
                            <span>All Leagues (@SelectedLeagueCount)</span>
                        }
                        else
                        {
                            <span>@(SelectedLeagueCount == 1 ? SelectedLeagueName : $"Leagues ({SelectedLeagueCount})")</span>
                        }
                    }
                    else
                    {
                        <span>No Leagues Available</span>
                    }
                </button>
                @if (Leagues.Any())
                {
                    <SelectWithCheckbox Items="Leagues" OnCheckboxCallback="OnLeagueCheckboxClickEvent" AriaLabel="league-dropdown" />
                }
            </div>
        </div>

        <div class="d-flex filter-div">
            <div class="input-group">
                <input type="text" id="search" placeholder="Find" class="form-control search-text valid border-end-0" />
                <span class="input-group-text border-start-0">
                    <i class="fa fa-search"></i>
                </span>
            </div>

            <div class="btn-filter-div">
                <div class="dropdown">
                    <button type="button" class="btn btn-filter dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false" id="dropdownMenu"><i class="fa fa-filter"></i>Filter</button>

                    <ul class="dropdown-menu">
                        <li><h6 class="dropdown-header">FILTER BY</h6></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><h6 class="dropdown-header">Markets</h6></li>
                        <li>
                            <button class="form-select dropdown-toggle" type="button" id="market-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (Markets.Any())
                                {
                                    if (Markets.Count - 1 == SelectedMarketCount)
                                    {
                                        <span>All Markets</span>
                                    }
                                    else
                                    {
                                        <span>@(SelectedMarketCount == 1 ? SelectedMarketName : $"Markets ({SelectedMarketCount})")</span>
                                    }
                                }
                                else
                                {
                                    <span>No Markets Available</span>
                                }
                            </button>
                            @if (Markets.Any())
                            {
                                <SelectWithCheckbox Items="Markets" OnCheckboxCallback="OnMarketCheckboxClickEvent" AriaLabel="market-dropdown" />
                            }
                        </li>
                        <li><h6 class="dropdown-header">Config Status</h6></li>
                        <li>
                            <button class="form-select dropdown-toggle" type="button" id="config-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (ConfigStatuses.Any())
                                {
                                    if (ConfigStatuses.Count - 1 == SelectedConfigStatusCount)
                                    {
                                        <span>All Config Status</span>
                                    }
                                    else
                                    {
                                        <span>@(SelectedConfigStatusCount == 1 ? SelectedConfigStatusName : $"Config Status ({SelectedConfigStatusCount})")</span>
                                    }
                                }
                                else
                                {
                                    <span>No Configs Available</span>
                                }
                            </button>
                            @if (ConfigStatuses.Any())
                            {
                                <SelectWithCheckbox Items="ConfigStatuses" OnCheckboxCallback="OnConfigCheckboxClickEvent" AriaLabel="config-dropdown" />
                            }
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li class="d-flex flex-row-reverse me-2"><button type="button" class="btn btn-apply">APPLY</button></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>