<div class="modal-body">
    <ViewLogsFilter @bind-ConfigLogsFilterModel="ConfigLogsFilterModel" GetContentCallback="GetContents"/>

    @if(ConfigLogsFilterModel.ConfigLogsDetails != null )
    {        
        @if (ConfigLogsFilterModel.ConfigLogsDetails.Any())
        {
            <table class="table table-bordered mt-3">
                <thead>
                    <tr>
                        <th scope="col">@_translationState.GetValue("Date")</th>
                        <th scope="col">@_translationState.GetValue("Client")</th>
                        <th scope="col">@_translationState.GetValue("Sports")</th>
                        <th scope="col">@_translationState.GetValue("Segment")</th>
                        <th scope="col">@_translationState.GetValue("League")</th>
                        <th scope="col">@_translationState.GetValue("Changes Made")</th>
                        <th scope="col">@_translationState.GetValue("From")</th>
                        <th scope="col">@_translationState.GetValue("To")</th>
                        <th scope="col">@_translationState.GetValue("Updated By")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in ConfigLogsFilterModel.ConfigLogsDetails)
                    {
                        <tr>
                            <td>@log.Date</td>
                            <td>@log.Client</td>
                            <td>@_translationState.GetValue(log.Sports)</td>
                            <td>@_translationState.GetValue(log.Segment)</td>
                            <td>@_translationState.GetValue(log.League)</td>
                            <td>@log.ChangesMade</td>
                            <td>@((MarkupString)log.OldValue)</td>
                            <td>@((MarkupString)log.NewValue)</td>
                            <td>@log.UpdatedBy</td>
                        </tr>
                    }
                </tbody>
                <Pagination MetaData="MetaData" Spread="3" SelectPageEvent="SelectedPage" PaginationColspan="7" />
            </table>
        }
        else
        {
            <NoRecordFound Message="@_translationState.GetValue("No Record Found")" />
        }
    }
    else
    {
        <NoRecordFound Message="@_translationState.GetValue("No Record Found")" />
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn modal-close" @onclick="OnCloseModalClickEvent">@_translationState.GetValue("Close")</button>
</div>