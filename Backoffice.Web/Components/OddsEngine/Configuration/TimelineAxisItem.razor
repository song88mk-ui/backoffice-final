<div class="d-flex py-2 pe-2 mx-3 mt-2 align-items-center timeline-axis">
    <div class="timeline-axis-line"></div>
    <span class="timeline-axis-label label-prematch">Prematch</span>

    <div class="timeline-axis-item my-3 first-axis">
        <a id="timeline-INST" class="waves-effect waves-light timeline-axis-item-key-container">
            <span class="timeline-axis-item-key-big timeline-axis-item-key-init" title="Click to edit key">110</span>
        </a>
        <span class="timeline-axis-item-label">INST</span>
    </div>

    @foreach(var timeline in TimelineList)
    {
        <div class="timeline-axis-item my-3">
            <a id="timeline-@timeline" class="waves-effect waves-light timeline-axis-item-key-container">
                <span class="timeline-axis-item-key" title="Click to edit key">
                </span>
            </a>
            <span class="timeline-axis-item-label">@timeline</span>
        </div>
    }

    
    <span class="timeline-axis-label label-kickoff">Kick Off</span>
</div>