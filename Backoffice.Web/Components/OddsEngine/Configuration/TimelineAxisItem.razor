<div class="d-flex py-2 pe-2 mx-3 mt-2 align-items-center timeline-axis">
    <div class="timeline-axis-line"></div>
    <span class="timeline-axis-label label-prematch">@_translationState.GetValue("Prematch")</span>

    @foreach(var setting in PrematchSettings.Settings)
    {
        var settingClass = setting.Key != null && setting.Key > 0 ? "timeline-axis-item-key-big" : "timeline-axis-item-key";

        <div class="timeline-axis-item my-3 first-axis">
            @if(IsReadOnly)
            {
                <a id="timeline-@setting.TimeDisplay" class="timeline-axis-item-key-container read-only">
                    <span class="@settingClass">
                        @setting.Key
                        <BlazoredToolTip @bind-IsVisible="setting.IsTooltipVisible" contentComponent="ContentComponent" Parameters="Parameters" />
                    </span>
                </a>
            }
            else
            {
                <a id="timeline-@setting.TimeDisplay" class="waves-effect waves-light timeline-axis-item-key-container"
                @onclick="_ => OnAddKeyClickEvent(setting)"
                @onclick:preventDefault @onclick:stopPropagation
                @onpointerleave="CloseModal" disabled="@IsReadOnly">
                    <span class="@settingClass" title="Click to edit key">
                        @setting.Key
                        <BlazoredToolTip @bind-IsVisible="setting.IsTooltipVisible" contentComponent="ContentComponent" Parameters="Parameters" />
                    </span>
                </a>
            }

            <span class="timeline-axis-item-label">@setting.TimeDisplay</span>
        </div>
    }

    
    <span class="timeline-axis-label label-kickoff">@_translationState.GetValue("Kick Off")</span>
</div>