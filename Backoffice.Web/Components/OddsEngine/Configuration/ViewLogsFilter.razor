@using BlazorDateRangePicker
<div class="row">
    <div class="col-4">
        <button class="btn btn-filter" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse" disabled="@IsFilterButtonDisabled" @onclick="Initialize">
            <i class="fa fa-filter"></i>&nbsp;Filters
        </button>
    </div>
    <div class="col-4"></div>
    <div class="col-4 position-relative">
        <EditForm class="f-right" Model="ConfigLogsFilterModel" OnValidSubmit="OnSubmitClickEvent">
            <div class="right-icon-control">
                <InputText id="search" class="form-control search-text" placeholder="@TranslationState.GetValue("Search Here")..." @bind-Value="ConfigLogsFilterModel.Filter" />
                <div class="form-icon"> <i class="feather icon-search"></i> </div>
            </div>
        </EditForm>
    </div>
</div>
<div class="row mt-3">
    <div class="collapse" id="filterCollapse">
        <div class="col-12">
            <div class="row mb-2">
                <div class="col-2">
                    <select class="form-select" @onchange="OnFixtureTypeChangedEvent">
                        <optgroup label="Logs Type">
                            @if (ConfigLogsFilterModel != null && ConfigLogsFilterModel.FixtureTypeLookUp != null && ConfigLogsFilterModel.FixtureTypeLookUp.Any())
                            {
                                @foreach (var item in ConfigLogsFilterModel.FixtureTypeLookUp)
                                {
                                    if (item.Value == ConfigLogsFilterModel.FixtureTypeId)
                                    {
                                        <option value="@item.Value" selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Name</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select" @onchange="OnClientChangedEvent">
                        <optgroup label="Clients">
                            @if (ConfigLogsFilterModel != null && ConfigLogsFilterModel.Clients != null && ConfigLogsFilterModel.Clients.Any())
                            {
                                @foreach (var item in ConfigLogsFilterModel.Clients)
                                {
                                    if (item.Value == ConfigLogsFilterModel.ClientId)
                                    {
                                        <option value="@item.Value" selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Name</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select" @onchange="OnSportsChangedEvent">
                        <optgroup label="Sports">
                            <option value="0">Select Sports</option>
                            @if (ConfigLogsFilterModel != null && ConfigLogsFilterModel.Sports != null && ConfigLogsFilterModel.Sports.Any())
                            {                                
                                @foreach (var item in ConfigLogsFilterModel.Sports)
                                {
                                    if (item.Value == ConfigLogsFilterModel.SportId)
                                    {
                                        <option value="@item.Value" selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Name</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select" @onchange="OnSegmentChangedEvent">
                        <optgroup label="Segment">
                            <option value="0">Select Segment</option>
                            @if (ConfigLogsFilterModel != null && ConfigLogsFilterModel.Segments != null && ConfigLogsFilterModel.Segments.Any())
                            {                                
                                @foreach (var item in ConfigLogsFilterModel.Segments)
                                {
                                    if (item.Value == ConfigLogsFilterModel.SegmentId)
                                    {
                                        <option value="@item.Value" selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Name</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select" @onchange="OnLeagueChangedEvent">
                        <optgroup label="League">
                            <option value="0">Select League</option>
                            @if (ConfigLogsFilterModel != null && ConfigLogsFilterModel.Leagues != null && ConfigLogsFilterModel.Leagues.Any())
                            {                                
                                @foreach (var item in ConfigLogsFilterModel.Leagues)
                                {
                                    if (item.Value == ConfigLogsFilterModel.LeagueId)
                                    {
                                        <option value="@item.Value" selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Name</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select" @onchange="OnMarketGroupChangedEvent">
                        <optgroup label="Markets">
                            <option value="0">Select Market Group</option>
                            @if (ConfigLogsFilterModel != null && ConfigLogsFilterModel.MarketTemplateGroups != null && ConfigLogsFilterModel.MarketTemplateGroups.Any())
                            {                                
                                @foreach (var item in ConfigLogsFilterModel.MarketTemplateGroups)
                                {
                                    if (item.Value == ConfigLogsFilterModel.MarketTemplateGroupId)
                                    {
                                        <option value="@item.Value" selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Name</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>                
            </div>

            <div class="row">
                <div class="col-2">
                    <select class="form-select" @onchange="OnMarketChangedEvent">
                        <optgroup label="Markets">
                            <option value="0">Select Market</option>
                            @if (ConfigLogsFilterModel != null && ConfigLogsFilterModel.Markets != null && ConfigLogsFilterModel.Markets.Any())
                            {                                
                                @foreach (var item in ConfigLogsFilterModel.Markets)
                                {
                                    if (item.Value == ConfigLogsFilterModel.MarketId)
                                    {
                                        <option value="@item.Value" selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Name</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select" @onchange="OnScopeChangedEvent">
                        <optgroup label="Scope">
                            <option value="0">All Scopes</option>
                            @if (ConfigLogsFilterModel != null && ConfigLogsFilterModel.Scopes != null && ConfigLogsFilterModel.Scopes.Any())
                            {                                
                                @foreach (var item in ConfigLogsFilterModel.Scopes)
                                {
                                    if (item.Value == ConfigLogsFilterModel.Scope)
                                    {
                                        <option value="@item.Value" selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Name</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>

                <div class="col-3">
                    <DateRangePicker class="form-control" DateFormat="MM/dd/yyyy" LinkedCalendars="true" StartDate="ConfigLogsFilterModel.FromDate" EndDate="ConfigLogsFilterModel.ToDate" MaxDate="DateTime.Today" OnRangeSelect="OnDateRangeChangedEvent"></DateRangePicker>
                </div>
            </div>
        </div>
    </div>
</div>
