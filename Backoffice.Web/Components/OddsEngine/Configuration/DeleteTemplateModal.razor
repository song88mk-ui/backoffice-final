<div class="modal-body">

    @if (_isPreloader)
    {
        <Preloader />
    }
    else
    {
        <div class="d-flex flex-column justify-content-center p-5">
            <div class="text-center">
                <icon class="ico ico-warning"></icon>
            </div>
            @if (_isEmptyLeagues)
            {
                <div class="text-center">
                    Are you sure want to delete "<span class="fw-bold">@ConfigTemplateModel.Name</span>"
                    <br />
                    You can't undo this action.
                </div>
            }
            else
            {
                <div class="text-center">
                    Please remove the assigned clients and leagues before deleting the template.
                </div>
            }
        </div>
    }
</div>
<div class="modal-footer">
    <button class="btn modal-btn modal-@(!_isEmptyLeagues ? "apply" : "cancel" )" @onclick="OnCancelClickEvent" disabled="@_isPreloader">@TranslationState.GetValue("Cancel")</button>
    @if (_isEmptyLeagues)
    {
        <button class="btn modal-btn modal-apply" @onclick="OnApplyClickEvent" disabled="@_isPreloader">@TranslationState.GetValue("Apply")</button>
    }
</div>