<tr class="@(Config.IsChecked ? "table-active" :"")">
    <AuthorizeView Policy="sbc-config-canedit">
        <Authorized Context="ActivateAll">
            <th class="text-center">
                <input type="checkbox" class="form-check-input" @onchange="OnCheckboxClicked" checked="@Config.IsChecked" disabled="@(State == ConfigState.Assigned)" />
            </th>
        </Authorized>
    </AuthorizeView>
    <th class="text-center font-weight-normal">@Config.Index</th>
    <td class="px-4">@Config.ClientName</td>
    <td class="px-4">@_translationState.GetValue(Config.SportName)</td>
    <td class="px-4">@Config.SegmentName > @Config.LeagueName</td>
    <td class="@(Config.PrematchTemplateId == -1 ? "template-name-italic" : "") px-4">
        @if (Config.PrematchTemplateId == -1)
        {
            <label>No template assigned</label>
        }
        else
        {
            <label class="@(State == ConfigState.Assigned ? "text-muted" : "")">@Config.PrematchTemplateName</label>
        }

    </td>
    <td class="@(Config.LiveTemplateId == -1 ? "template-name-italic" : "") px-4">
        @if (Config.LiveTemplateId == -1)
        {
            <label>No template assigned</label>
        }
        else
        {
            <label class="@(State == ConfigState.Assigned ? "text-muted" : "")">@Config.LiveTemplateName</label>
        }
    </td>
</tr>