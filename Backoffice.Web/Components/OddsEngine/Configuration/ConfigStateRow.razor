<tr>
    <th class="text-center" scope="row">
        <input type="checkbox" class="form-check-input" @onchange="OnCheckboxClicked" checked="@Config.IsChecked" />
    </th>
    <th class="text-center" scope="row">@Index</th>
    <td class="text-center">@Config.ClientName</td>
    <td class="text-center">@Config.SportName</td>
    <td class="text-center">@Config.FixtureStatusName</td>
    <td class="text-center">@Config.LeagueName</td>
    <td class="template-name px-4">No template assigned</td>
</tr>