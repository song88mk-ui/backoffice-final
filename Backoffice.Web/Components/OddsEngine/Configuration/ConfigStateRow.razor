<tr class="@(Config.IsChecked ? "table-active" :"")">
    <AuthorizeView Policy="sbc-config-canedit">
        <Authorized Context="ActivateAll">
            <th class="text-center">
                <input type="checkbox" class="form-check-input" @onchange="OnCheckboxClicked" checked="@Config.IsChecked" />
            </th>
        </Authorized>
    </AuthorizeView>
    <th class="text-center font-weight-normal">@Config.Index</th>
    <td class="px-4">@Config.ClientName</td>
    <td class="px-4">@_translationState.GetValue(Config.SportName)</td>
    <td class="px-4">@Config.SegmentName > @Config.LeagueName</td>
    <td class="px-4">
        @if (State == ConfigState.Assigned)
        {
            <span class="badge @(Config.IsRestricted ? "bg-danger" : "bg-success")">@_translationState.GetValue(Config.IsRestricted ? "Restricted" : "Active")</span>
        }
        else
        {
            <span class="template-name-italic">@_translationState.GetValue("Not reviewed")</span>
        }
    </td>
</tr>