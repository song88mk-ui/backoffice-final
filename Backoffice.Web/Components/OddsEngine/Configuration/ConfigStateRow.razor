<tr class="@(Config.IsChecked ? "table-active" :"")">
    <AuthorizeView Policy="sbc-config-canedit">
        <Authorized Context="ActivateAll">
            <th class="text-center">
                <input type="checkbox" class="form-check-input" @onchange="OnCheckboxClicked" checked="@Config.IsChecked" />
            </th>
        </Authorized>
    </AuthorizeView>
    <th class="text-center font-weight-normal">@Index</th>
    <td class="px-4">@Config.ClientName</td>
    <td class="px-4">@TranslationState.GetValue(Config.SportName)</td>
    <td class="px-4">@Config.SegmentName > @Config.LeagueName</td>
    <td class="@(State == ConfigState.UnAssigned ? "template-name-italic" : "") px-4">
        @if (Config.PrematchTemplateId == -1)
        {
            <label>No template assigned</label>
        }
        else
        {
            if (State == ConfigState.UnAssigned)
            {
                <label>@Config.PrematchTemplateName</label>
            }
            else
            {
                <a @onclick="_ => OnEditTemplateClickEvent(Config.PrematchTemplateId)">@Config.PrematchTemplateName</a>
            }
        }

    </td>
    <td class="@(State == ConfigState.UnAssigned ? "template-name-italic" : "") px-4">
        @if (Config.LiveTemplateId == -1)
        {
            <label>No template assigned</label>
        }
        else
        {
            if (State == ConfigState.UnAssigned)
            {
                <label>@Config.LiveTemplateName</label>
            }
            else
            {
                <a @onclick="_ => OnEditTemplateClickEvent(Config.LiveTemplateId)">@Config.LiveTemplateName</a>                
            }
        }
    </td>
</tr>