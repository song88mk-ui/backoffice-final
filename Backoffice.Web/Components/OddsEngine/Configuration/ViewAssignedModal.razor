<div class="modal-body">
    @if (_isPreloader)
    {
        <Preloader />
    }
    else
    {
        if (!_isComplete)
        {
            <div class="assigned-message">
                <span>
                    <icon class="fa fa-warning mx-2" />
                    Some parts are restricted due to account limits. Please contact admin if needed.
                </span>
            </div>
        }
        <div class="accordion" id="viewAssignedAccordion">
            @foreach (var client in _leagues.Select(x => new
            {
                ClientId = x.ClientId,
                ClientCode = x.ClientCode,
                ClientName = x.ClientName
            }).Distinct().ToList())
            {
                <div class="accordion-item mb-2">
                    <h2 class="accordion-header" id="header2">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@client.ClientId" aria-expanded="true" aria-controls="collapse-@client.ClientId">
                            @client.ClientName
                        </button>
                    </h2>

                    <div id="collapse-@client.ClientId" class="accordion-collapse collapse" aria-labelledby="header2">
                        <div class="accordion-body">
                            <ul class="list-group">
                                @foreach (var item in _leagues.Where(x => x.ClientId == client.ClientId).ToList())
                                {
                                    <li class="list-group-item">@item.LeagueName</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn" @onclick="OnCloseClickEvent">@TranslationState.GetValue("Close")</button>
</div>