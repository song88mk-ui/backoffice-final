<div class="modal-body">
    <div class="accordion" id="viewAssignedAccordion">

        @foreach(var client in Leagues.Select(x => x.ClientCode).Distinct().ToList())
        {
            <div class="accordion-item">
                <h2 class="accordion-header" id="header2">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="true" aria-controls="collapseTwo">
                        @client
                    </button>
                </h2>

                <div id="collapseTwo" class="accordion-collapse collapse show" aria-labelledby="header2">
                    <div class="accordion-body">
                        <ul class="list-group">
                            @foreach (var item in Leagues.Where(x => x.ClientCode == client).ToList())
                            {
                                <li class="list-group-item">@item.LeagueName</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn" @onclick="OnCloseClickEvent">Close</button>
</div>