<div class="modal-body">
    <div class="row mb-3">
        <div class="col">
            <label for="fromClient" class="form-label">From</label>
            <select class="form-select" id="fromClient" @onchange="OnFromClientChangedEvent">
                @foreach(var item in FromClients)
                {
                    <option value="@item.Value">@item.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <label for="toClient" class="form-label">To</label>
            <select class="form-select" id="toClient" @onchange="OnToClientChangedEvent">
                @foreach (var item in ToClients)
                {
                    <option value="@item.Value">@item.Name</option>
                }
            </select>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn btn-cancel" data-bs-dismiss="modal" @onclick="OnCancelModalClickEvent">Cancel</button>
    <button type="button" class="btn modal-btn btn-apply" @onclick="OnApplyModalClickEvent">Apply</button>
</div>