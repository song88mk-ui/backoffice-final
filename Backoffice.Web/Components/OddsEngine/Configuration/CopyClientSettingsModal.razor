<div class="modal-body">
    <div class="row mb-3">
        <div class="col">
            <label for="fromClient" class="form-label">From</label>
            <select class="form-select" id="fromClient" @onchange="@(e => OnFromClientChangedEvent(e))">
                @foreach (var item in Clients)
                {
                    if (SelectedToClient.Key != item.ClientCode)
                    {
                        <option @key="item" value="@item.ClientCode" selected="@(item.ClientCode == SelectedFromClient.Key)">@item.ClientName</option>
                    }
                }
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <label for="toClient" class="form-label">To</label>
            <select class="form-select" id="toClient" @onchange="OnToClientChangedEvent">
                @foreach (var item in Clients)
                {
                    if (SelectedFromClient.Key != item.ClientCode)
                    {
                        <option @key="item" value="@item.ClientCode" selected="@(item.ClientCode == SelectedToClient.Key)">@item.ClientName</option>
                    }
                }
            </select>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn btn-cancel" data-bs-dismiss="modal" @onclick="OnCancelModalClickEvent">@TranslationState.GetValue("Cancel")</button>
    <button type="button" class="btn modal-btn btn-apply" @onclick="OnApplyModalClickEvent">@TranslationState.GetValue("Apply")</button>
</div>