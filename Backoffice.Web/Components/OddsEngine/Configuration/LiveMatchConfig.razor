<div class="border pb-3 mb-3">
    <div class="row">
        <div class="col-lg-12">
            <div class="p-1 bg-default">
                <div class="row">
                    <div class="col-sm-4"></div>
                    <div class="col-sm-2">
                        <span>First Key: @LiveSettings.FirstKey</span>
                    </div>
                    <div class="col-sm-2">
                        @if (LiveSettings.LastKey.Length > 0)
                        {
                            <span>Last Key: @LiveSettings.LastKey</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-12 timeline-col">
            <TimelineKeyItem LiveSettings="LiveSettings" OnMarginChangeCallback="OnMarginChangeCallback" IsReadOnly="IsReadOnly" />
        </div>
    </div>
</div>