@if (Alerts != null && Alerts.Any())
{
    foreach (var alert in Alerts)
    {
        <AlertMessage AlertStatus="@alert.Status" AlertMessageStr="@alert.Message" Opacity="@alert.Opacity" Guid="Guid" />
    }
}

<div class="top-menu">
    <a href="javascript:void(0)" class="p-2" @onclick="OnImportExportMarginsClickEvent">
        <i class="fa fa-exchange"></i>
        Import/Export Margins
    </a>

    <a href="javascript:void(0)" class="p-2" @onclick="OnLogsClickEvent">
        <i class="fa fa-list-alt"></i>
        Logs
    </a>

    <a href="javascript:void(0)" class="p-2" @onclick="OnCopyClientSettingsClickEvent">
        <i class="fa fa-copy"></i>
        Copy Client Settings
    </a>
</div>