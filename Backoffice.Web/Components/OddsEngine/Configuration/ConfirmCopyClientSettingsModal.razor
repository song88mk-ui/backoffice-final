<div class="modal-body">
    <div class="d-flex flex-column justify-content-center p-5">
        <div class="text-center">
            <img src="icons/svg/warning-icon.svg" />
        </div>
        <div class="text-center">
            Are you sure you want to copy @SelectedFromClient.Value settings?
            <br />
            This will override @SelectedToClient.Value settings.
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn btn-cancel" data-bs-dismiss="modal" @onclick="OnCancelModalClickEvent">Cancel</button>
    <button type="button" class="btn modal-btn btn-apply" @onclick="OnApplyModalClickEvent">Apply</button>
</div>