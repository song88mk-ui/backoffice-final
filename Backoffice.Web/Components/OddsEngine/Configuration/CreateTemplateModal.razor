<div class="modal-body">
    @if(_isPreloader)
    {
        <Preloader/>
    }
    else
    {
        <div class="row mb-3">
            <label for="nameTemplate" class="col-sm-2 col-form-label">Name:</label>
            <div class="col-sm-10">
                <input type="text" class="form-control" id="nameTemplate" @bind-value="_templateName" />
                @if (_isConfigNameExisting)
                {
                    <span class="fst-italic text-danger">Sorry, that name already exists!</span>
                }
            </div>
        </div>

        <div class="row mb-3">
            <label for="sportsSelect" class="col-sm-2 col-form-label">@_translationState.GetValue("Sports"):</label>
            <div class="col-sm-10">
                <select class="form-select" @onchange="OnSportSelectChanged">
                    @if (_sports.Any())
                    {
                        @foreach (var item in _sports)
                        {
                            <option value="@item.Value" selected="@(item.Value == _selectedSportId)">@_translationState.GetValue(item.Name)</option>
                        }
                    }
                    else
                    {
                        <option value="-1">--</option>
                    }
                </select>
            </div>
        </div>

        <div class="row mb-3">
            <label for="scopeSelect" class="col-sm-2 col-form-label">
                @($"{_translationState.GetValue("Scope")}:")
            </label>
            <div class="col-sm-10">
                <select class="form-select" @onchange="OnScopeSelectChanged">
                    @if (_scopes.Any())
                    {
                        @foreach (var item in _scopes)
                        {
                            <option value="@item.Value" selected="@(item.Value == _selectedScopeId)">@_translationState.GetValue(item.Name)</option>
                        }
                    }
                    else
                    {
                        <option value="-1">--</option>
                    }
                </select>
            </div>
        </div>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn btn-cancel" @onclick="OnCancelClickEvent" disabled="@_isPreloader">@_translationState.GetValue("Cancel")</button>
    <button type="button" class="btn modal-btn btn-save" @onclick="OnSaveClickEvent" disabled="@_isPreloader">@_translationState.GetValue("Save")</button>
</div>