<div class="modal-body">
    <div class="row mb-3">
        <label for="nameTemplate" class="col-sm-2 col-form-label">Name:</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" id="nameTemplate" />
        </div>
    </div>

    <div class="row mb-3">
        <label for="sportsSelect" class="col-sm-2 col-form-label">Sports:</label>
        <div class="col-sm-10">
            <select class="form-select">
                <option value="1">Basketball</option>
                <option value="2">Soccer</option>
                <option value="3">Baseball</option>
                <option value="4">Tennis</option>
            </select>
        </div>
    </div>

    <div class="row mb-3">
        <label for="scopeSelect" class="col-sm-2 col-form-label">Scope:</label>
        <div class="col-sm-10">
            <select class="form-select">
                <option value="1">Prematch</option>
                <option value="2">Live</option>
            </select>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn btn-cancel" @onclick="OnCancelClickEvent">Cancel</button>
    <button type="button" class="btn modal-btn btn-save" @onclick="OnSaveClickEvent">Save</button>
</div>