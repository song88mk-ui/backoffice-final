<div class="d-flex justify-content-between col mx-4 config-nav-container">
    <div>
        <a href="javascript:void(0)" class="@_myTemplateCss"
           @onclick="_myTemplateClickEvent">@_myTemplateText</a>
        <a href="javascript:void(0)" class="@_assignedCss"
           @onclick="_assignedClickEvent">@_assignedText</a>
        <a href="javascript:void(0)" class="@_unAssignedCss"
           @onclick="_unAssignedClickEvent">@_unAssignedText</a>
    </div>
    <div>
        <a class="btn btn-copy-client" href="javascript:(0)" @onclick="HandleCopyClientSettingsSelect">@_translationState.GetValue("Copy Client Settings")</a>
    </div>
</div>