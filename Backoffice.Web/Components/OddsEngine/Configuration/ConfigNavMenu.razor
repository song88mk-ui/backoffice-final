<div class="col mx-4 config-nav-container">
    <a href="javascript:void(0)" class="@(CurrentMenu == ConfigTemplateNavMenu.MyTemplates ? "config-nav active" : "config-nav")" @onclick="_ => OnSelectConfigNavMenu(ConfigTemplateNavMenu.MyTemplates)">My Templates (@(IsCounting ? "Counting..." : @TemplateConfigCount.MyTemplatesCount))</a>
    <a href="javascript:void(0)" class="@(CurrentMenu == ConfigTemplateNavMenu.Assigned ? "config-nav active" : "config-nav")" @onclick="_ => OnSelectConfigNavMenu(ConfigTemplateNavMenu.Assigned)">Assigned (@(IsCounting ? "Counting..." : TemplateConfigCount.AssignedTemplatesCount))</a>
    <a href="javascript:void(0)" class="@(CurrentMenu == ConfigTemplateNavMenu.UnAssigned ? "config-nav active" : "config-nav")" @onclick="_ => OnSelectConfigNavMenu(ConfigTemplateNavMenu.UnAssigned)">Unassigned (@(IsCounting ? "Counting..." : TemplateConfigCount.UnAssignedTemplatesCount))</a>
</div>