<div class="col mx-4 config-nav-container">
    <a href="javascript:void(0)" class="@(CurrentMenu == ConfigTemplateNavMenu.MyTemplates ? "config-nav active" : "config-nav")" @onclick="_ => OnSelectConfigNavMenu(ConfigTemplateNavMenu.MyTemplates)">My Templates (@(MyTemplatesCount == -1 ? "Calculating..." : MyTemplatesCount))</a>
    <a href="javascript:void(0)" class="@(CurrentMenu == ConfigTemplateNavMenu.Assigned ? "config-nav active" : "config-nav")" @onclick="_ => OnSelectConfigNavMenu(ConfigTemplateNavMenu.Assigned)">Assigned (@(AssignedLeaguesCount == -1 ? "Calculating..." : AssignedLeaguesCount))</a>
    <a href="javascript:void(0)" class="@(CurrentMenu == ConfigTemplateNavMenu.UnAssigned ? "config-nav active" : "config-nav")" @onclick="_ => OnSelectConfigNavMenu(ConfigTemplateNavMenu.UnAssigned)">Unassigned (@(UnAssignedLeaguesCount == -1 ? "Calculating..." : UnAssignedLeaguesCount))</a>
</div>