@using BlazorDateRangePicker

<div class="row">
    <div class="col-md-12">
        <div class="content-filter mx-3 d-flex justify-content-between">
            <div class="button-container d-flex">
                <a href="javascript:void(0)" class="btn btn-market-settlement px-3" @onclick="OnAddMarketSettlementClickEvent">
                    <i class="fa fa-plus me-1"></i>
                    Add Market Settlement
                </a>
            </div>
            <div class="button-container d-flex flex-row-reverse align-items-end">
                <a href="javascript:void(0)" class="btn btn-export px-3 ms-2" @onclick="OnExportClickEvent">
                    <i class="fa fa-file-excel-o me-1"></i>
                    Export to Excel
                </a>
                <a href="javascript:void(0)" class="btn btn-filter px-3" @onclick="OnFilterClickEvent">
                    <i class="fa fa-filter me-1"></i>
                    @TranslationState.GetValue("Filters")
                </a>
            </div>
        </div>
    </div>
</div>

@if (ShowFilter)
{
    <div class="row">
        <div class="col-md-12 mx-3 mt-4">
            <div class="d-flex">
                <div class="me-4 select-container">
                    <select class="form-select d-block" @onchange="OnSportChangedEvent">
                        <option value="0">@TranslationState.GetValue("All Sports")</option>
                        @foreach (var item in Sports)
                        {
                            <option value="@item.Value" selected="@(item.Value == FilterModel.SportId)">@TranslationState.GetValue(item.Name)</option>
                        }
                    </select>
                </div>
                <div class="me-4 select-container">
                    <select class="form-select d-block" @onchange="OnSegmentChangedEvent">
                        <option value="0">@TranslationState.GetValue("All Segments")</option>
                        @foreach (var item in Segments)
                        {
                            <option value="@item.Value" selected="@(item.Value == FilterModel.SegmentId)">@TranslationState.GetValue(item.Name)</option>
                        }
                    </select>
                </div>
                <div class="me-4 select-container">
                    <select class="form-select d-block" @onchange="OnLeagueChangedEvent">
                        <option value="0">@TranslationState.GetValue("All Leagues")</option>
                        @foreach (var item in Leagues)
                        {
                            <option value="@item.Value" selected="@(item.Value == FilterModel.LeagueId)">@TranslationState.GetValue(item.Name)</option>
                        }
                    </select>
                </div>
                <div class="me-4 select-container">
                    <select class="form-select d-block" @onchange="OnFixtureChangedEvent">
                        <option value="0">All Fixtures</option>
                        @foreach (var item in Fixtures)
                        {
                            <option value="@item.Value" selected="@(item.Value == FilterModel.FixtureId)">@TranslationState.GetValue(item.Name)</option>
                        }
                    </select>
                </div>
                <div class="me-4 select-container">
                    <select class="form-select d-block" @onchange="OnStatusChangedEvent">
                        <option value="0">All Status</option>
                        @foreach (var item in Statuses)
                        {
                            <option value="@item.Value">@TranslationState.GetValue(item.Name)</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="col-md-12 mx-3 mt-2">
            <div class="d-flex">
                <div class="me-4 select-container">
                    <select class="form-select d-block" @onchange="OnMarketChangedEvent">
                        <option value="0" selected>@TranslationState.GetValue("All Markets")</option>
                        @foreach (var item in Markets)
                        {
                            <option value="@item.Value" selected="@(item.Value == FilterModel.MarketId)">@TranslationState.GetValue(item.Name)</option>
                        }
                    </select>
                </div>
                <div class="me-4 select-container">
                    <select class="form-select d-block" @onchange="OnSelectionChangedEvent">
                        <option value="0" selected>All Selections</option>
                        @if (Selections != null && Selections.Any())
                        {
                            @foreach (var item in Selections)
                            {
                                <option value="@item.Value" selected="@(item.Value == FilterModel.SelectionId)">@TranslationState.GetValue(item.Name)</option>
                            }
                        }
                    </select>
                </div>
                <div class="me-4 input-container">
                    <DateRangePicker class="form-control" DateFormat="MM/dd/yyyy" LinkedCalendars="true" StartDate="FilterModel.FromDate" EndDate="FilterModel.ToDate" MaxDate="DateTime.Today" OnRangeSelect="OnRangeSelect" />
                </div>
                <div class="me-4 input-container">
                    <input type="text" class="form-control" placeholder="Settled By" @bind-value="FilterModel.SettledBy" />
                </div>
                <div class="me-4 input-container">
                    <a href="javascript:void(0)" class="btn btn-search px-3" @onclick="OnSearchClickEvent">
                        @TranslationState.GetValue("Search")
                    </a>
                </div>
            </div>
        </div>
    </div>
}