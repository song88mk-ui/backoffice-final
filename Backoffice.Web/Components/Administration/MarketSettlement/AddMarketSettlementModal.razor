
<div class="modal-body">
    <div class="row">
        <div class="col-md-12">
            <MarketSettlementModalFilter OnUpdateRowCallback="UpdateRowDetails" OnLeagueChangedCallback="SetMarketFixtures" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            @if (IsPreLoader)
            {
                <Preloader />
            }
            <table class="table table-bordered mt-4">
                <thead class="table-head">
                    <tr>
                        @if (!string.IsNullOrEmpty(AddMarketSettlement.BetId) && AddMarketSettlement.AddMarketSettlementSelections.Count() > 1)
                        {
                            <th scope="col">Select</th>
                        }
                        <th scope="col">Event Details</th>
                        <th scope="col">Selection</th>
                        <th scope="col">Status</th>
                        <th scope="col">Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @if (AddMarketSettlement.AddMarketSettlementSelections.Any())
                    {
                        var marketId = string.Empty;
                        for (var index = 0; index < AddMarketSettlement.AddMarketSettlementSelections.Count; index++)
                        {
                            var marketSelection = AddMarketSettlement.AddMarketSettlementSelections[index];

                            <tr>
                                @if (!string.IsNullOrEmpty(AddMarketSettlement.BetId) && AddMarketSettlement.AddMarketSettlementSelections.Count() > 1)
                                {
                                    <td>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @onchange="(args) => OnCheckboxClicked(args, marketSelection)" />
                                        </div>
                                    </td>
                                }

                                @if (index == 0 || marketSelection.MarketId != marketId)
                                {
                                    marketId = marketSelection.MarketId;
                                    var rowCount = AddMarketSettlement.AddMarketSettlementSelections.Where(c => c.MarketId == marketId).Count();
                                    <td rowspan="@rowCount" align="left" valign="top">
                                        @if (string.IsNullOrEmpty(marketSelection.FixtureName))
                                        {
                                            <p>_</p>
                                        }
                                        else
                                        {
                                            <span>&nbsp;&nbsp;</span> @marketSelection.SportName

                                            <br />
                                            <span>@marketSelection.SegmentName</span> <br>
                                            <span>@marketSelection.LeagueName.ToUpper()</span>

                                            <br />
                                            @marketSelection.FixtureName.ToUpper()

                                            <br />
                                            <span>
                                                @marketSelection.FixtureStartDate.ToLocalTime().ToString("dd/MM/yy") <strong>@marketSelection.FixtureStartDate.ToLocalTime().ToString("HH:mm")</strong>
                                            </span>

                                            <br />
                                            <span>@marketSelection.MarketName.ToUpper() @(GetMarketLine(marketSelection.MarketName, marketSelection.Line))</span>
                                        }
                                    </td>
                                }
                                <td align="left" valign="top">
                                    @if (string.IsNullOrEmpty(marketSelection.SelectionName))
                                    {
                                        <p>_</p>
                                    }
                                    else
                                    {
                                        @marketSelection.SelectionName
                                    }
                                </td>
                                <td valign="middle" align="left">
                                    <select class="form-select input-sm" name="Status" @onchange="(e) => OnAddStatusChange(e, marketSelection.RowCount)">
                                        <option value="0">Select Status</option>
                                        @foreach (var item in marketSelection.Statuses)
                                        {
                                            if (item.Value == marketSelection.ToStatus)
                                            {
                                                <option value="@item.Value" selected>@item.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@item.Value">@item.Name</option>
                                            }
                                        }
                                    </select>
                                </td>
                                <td valign="middle" align="left"><textarea @bind="marketSelection.Reason" class="form-control" placeholder="Reason"></textarea></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="div-alert mb-2 mt-2 pt-1 pb-1">
        <AlertMessage AlertModel="@AlertModel" />
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn btn-cancel" @onclick="OnCancelModal" disabled="@IsPreLoader">Cancel</button>
    <button type="button" class="btn modal-btn btn-settle" @onclick="OnMarketSettlement" disabled="@IsPreLoader">Settle Market</button>
</div>