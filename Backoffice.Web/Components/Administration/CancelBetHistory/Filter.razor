@using BlazorDateRangePicker

<div class="row">
    <div class="col-md-12">
        <div class="content-filter mx-3 d-flex justify-content-between">
            <div class="input-container d-flex">
                <div class="me-4">
                    <label class="form-label d-block">Cancelled By</label>
                    <input type="text" placeholder="Enter Name or Username" class="form-control" />
                </div>
                <div class="me-4">
                    <label class="form-label d-block">Bet/Reference ID</label>
                    <input type="text" placeholder="Enter Bet/Reference ID" class="form-control" />
                </div>
                <div class="me-4">
                    <label class="form-label d-block">Member Name</label>
                    <input type="text" placeholder="Enter Member Name" class="form-control" />
                </div>
            </div>
            <div class="button-container d-flex flex-row-reverse align-items-end">
                <button type="button" class="btn btn-export px-4 py-2">
                    <i class="fa fa-file-excel-o me-3"></i>
                    Export To Excel
                </button>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="content-filter mx-3 d-flex align-items-end mt-3">
            <div class="me-4">
                <label class="form-label d-block">Partner/SB Client Name</label>
                <input type="text" placeholder="Enter Partner/SB Client Name" class="form-control" />
            </div>
            <div class="me-4">
                <label class="form-label d-block">Date</label>
                <DateRangePicker class="form-control" DateFormat="MM/dd/yyyy" LinkedCalendars="true" StartDate="FilterModel.DateFrom" EndDate="FilterModel.DateTo" MaxDate="DateTime.Today" OnRangeSelect="OnDateRangeChangedEvent"></DateRangePicker>
            </div>
            <div class="me-4">
                <button type="button" class="btn btn-search px-4 py-2">
                    Search
                </button>
            </div>
        </div>
    </div>
</div>

