<div class="modal-body">
    @if (IsPreLoader)
    {
        <Preloader />
    }
    else
    {
        @if (Alerts != null && Alerts.Any())
        {
            <div class="col">
                @foreach (var alert in Alerts)
                {
                    <AlertMessage AlertModel="@alert" />
                }
            </div>
        }
        <div class="information-container mb-3">
            <div class="row">
                <div class="col-md-12 mb-1">
                    <h6 class="title fw-bold ps-2 py-1">User Information</h6>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">Username</label>
                    <input type="text" class="form-control @(IsValidUsername ? "valid" : "invalid")" placeholder="Enter Username" @bind-value="UserRegister.UserName" disabled="@IsEdit" @oninput="@(() => RemoveError("username"))" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email Address</label>
                    <input type="text" class="form-control @(IsValidEmail ? "valid" : "invalid")" placeholder="Enter Email Address" @bind-value="UserRegister.Email" @oninput="@(() => RemoveError("email"))" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Password</label>
                    <div class="input-group">
                        <input id="password" type="password" class="form-control pe-5 @(IsValidPassword ? "valid" : "invalid")" placeholder="Enter your password" @bind-value="UserRegister.Password" @oninput="@(() => RemoveError("password"))" />
                        <button type="button" class="d-flex align-items-center position-absolute end-0 h-100 bg-transparent border-0 password-eye" onclick="password_show_hide();">
                            <i class="fa fa-eye-slash text-center eye-icon" id="show_eye"></i>
                            <i class="fa fa-eye d-none text-center eye-icon" id="hide_eye"></i>
                        </button>
                    </div>
                    <div class="form-text fst-italic">
                        Password must be 8-15 characters long, which should contain uppercase and lowercase characters, with any digit from 0-9, and must include at least one special character
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">User Group</label>
                    <select class="form-select" @onchange="OnUserGroupOnChangedEvent">
                        @if (UserGroupList != null)
                        {
                            @foreach (var userGroup in UserGroupList)
                            {
                                <option value="@userGroup.UserGroupId" selected="@(UserRegister.RoleId == userGroup.UserGroupId)">@userGroup.UserGroupName</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <div class="btn-group border rounded px-2 d-flex" role="group">
                        <input id="radio-normal" name="btn-radio" type="radio" class="btn-check" checked="@(UserRegister.Status == "Normal" || UserRegister.Status == null)" @onclick="() => OnStatusClickedEvent(false)" />
                        <label class="btn btn-radio my-1 w-50 rounded" for="radio-normal">Normal</label>

                        <input id="radio-locked" name="btn-radio" type="radio" class="btn-check" checked="@(UserRegister.Status == "Locked")" @onclick="() => OnStatusClickedEvent(true)" />
                        <label class="btn btn-radio my-1 w-50 rounded" for="radio-locked">Locked</label>
                    </div>
                </div>
            </div>
        </div>
        <Permission Permissions="Permissions.Permissions" IsReadOnly="true" ClientModel="ClientModel" @ref="PermissionComponent" />
    }
</div>
<div class="modal-footer mx-4">
    <button type="button" class="btn btn-cancel waves-effect" data-bs-dismiss="modal" @onclick="OnCloseClickEvent">Cancel</button>
    <button type="submit" class="btn btn-edit waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickedEvent" disabled="@IsPreLoader">Save</button>
</div>

