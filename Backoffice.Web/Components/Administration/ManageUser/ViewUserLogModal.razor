<div class="modal-body modal-scroll">
    <div class="row mb-3">
        <EditForm Model="SearchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
            <div class="input-group">
                <input id="search" type="text" placeholder=@TranslationState.GetValue("Search") class="form-control search-text valid border-end-0" @bind-value="SearchForm.SearchText" />
                <span class="input-group-text border-start-0">
                    <i class="fa fa-search"></i>
                </span>
            </div>
        </EditForm>
    </div>
    <div class="row">
        <div class="col col-max-height">
            @if (IsPreLoader)
            {
                <Preloader />
            }
            else
            {
                <table class="table align-middle">
                    <thead class="text-center thead-sticky">
                        <tr>
                            <th scope="col">Last Login Date</th>
                            <th scope="col">IP Address</th>
                            <th scope="col">Device</th>
                            <th scope="col">Country of Origin</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(LogInActivityLogs != null)
                        {
                        @foreach (var item in LogInActivityLogs)
                        {
                            <tr class="text-center">
                                <th scope="row">
                                    <span>@item.Date.ToLocalTime().ToString("yyyy/MM/dd hh:mm:ss tt")</span>
                                </th>
                                <td>
                                    <span>@item.IpAddress</span>
                                </td>
                                <td>
                                    @((MarkupString)ParseUserAgent(item.UserAgent))
                                </td>
                                <td>
                                    <span>
                                        <i class="flag-@item.Country.ToLower()"></i>
                                    </span>
                                </td>
                            </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan=4>
                                    <NoRecordFound />
                                </td>
                            </tr>
                        }
                    </tbody>
                    <Pagination MetaData="MetaData" Spread="3" SelectPageEvent="SelectPage" PaginationColspan="4"></Pagination>
                </table>
            }
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-close" @onclick="OnCloseModalClickEvent">Close</button>
</div>