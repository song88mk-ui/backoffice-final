<div class="modal-body">
    <div class="d-flex flex-column justify-content-center p-5">
        <div class="text-center">
            <icon class="ico ico-warning"></icon>
        </div>
        <div class="text-center">
            Are you sure want to reset?
            <br />
            All your progress will be lost
        </div>
    </div>
</div>
<div class="modal-footer">
    <button class="btn modal-btn modal-cancel" type="button" @onclick="OnModalCancel">@_translationState.GetValue("Cancel")</button>
    <button class="btn modal-btn modal-reset" type="button" @onclick="OnModalReset">@_translationState.GetValue("Reset")</button>
</div>