<div class="modal-body">
    <div class="d-flex flex-column justify-content-center p-5">
        <div class="text-center">
            <icon class="ico ico-question-circle"></icon>
        </div>
        <div class="text-center">
            Do you wish to proceed?
            <br />
            @if (IsProviderCancellation)
            {
                <text>Please confirm to send the cancellation of all reference IDs added to Bet Genius.</text>
            }
            else
            {
                <text>Please confirm to settle all reference IDs added.</text>
            }
        </div>
    </div>
</div>
<div class="modal-footer">
    <button class="btn modal-btn modal-cancel" type="button" @onclick="OnModalCancel">@_translationState.GetValue("Cancel")</button>
    <button class="btn modal-btn modal-confirm" type="button" @onclick="OnModalConfirm">@_translationState.GetValue("Confirm")</button>
</div>