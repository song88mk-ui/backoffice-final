<div class="modal-body">
    <div class="d-flex flex-column justify-content-center p-5">
        <div class="text-center">
            <img src="icons/svg/question-circle.svg" />
        </div>
        <div class="text-center">
            Do you wish to proceed?
            <br />
            Please confirm to cancel all bet reference IDs added.
        </div>
    </div>
</div>
<div class="modal-footer">
    @if (Alerts != null && Alerts.Any())
    {
            <div class="col-md-8">
            @foreach (var alert in Alerts)
            {
                        <AlertMessage AlertStatus="@alert.AlertStatus" AlertMessageStr="@alert.AltertMessage" Opacity="@alert.Opacity" />
            }
            </div>
    }
    <button type="button" class="btn modal-btn modal-close" @onclick="OnCloseModalClickEvent">Cancel</button>
    <button type="button" class="btn modal-btn modal-apply" @onclick="OnConfirmCancelClickEvent">Confirm</button>
</div>