<div class="modal-body">
    <div class="d-flex flex-column justify-content-center p-5">
        <div class="text-center">
            <icon class="ico ico-question-circle"></icon>
        </div>
        <div class="text-center">
            Do you wish to proceed?
            <br />
            Please confirm to cancel all bet reference IDs added.
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn modal-close" @onclick="OnCloseModalClickEvent">@TranslationState.GetValue("Cancel")</button>
    <button type="button" class="btn modal-btn modal-apply" @onclick="OnConfirmCancelClickEvent">@TranslationState.GetValue("Confirm")</button>
</div>