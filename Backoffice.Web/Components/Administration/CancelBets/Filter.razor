<div class="content-filter mx-3 d-flex justify-content-between">
    <div class="add-reference-container d-flex">
        <button type="button" class="btn btn-add-bet px-4 py-2 me-3" @onclick="OnAddBetReferenceIdCallbackEvent" disabled="@IsPreload">
            <i class="fa fa-plus me-3"></i>
            Add Bet Reference ID
        </button>
    </div>
    <div class="button-container d-flex flex-row-reverse align-items-end">
        <button type="button" class="btn btn-cancel-bets px-4 py-2" @onclick="OnCancelBetCallbackEvent" disabled="@IsPreload">Cancel Bets</button>
        <button type="button" class="btn btn-reset px-4 py-2 me-3" @onclick="OnResetCallbackEvent" disabled="@IsPreload">Reset</button>
    </div>
</div>