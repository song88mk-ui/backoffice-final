<div class="dropdown p-0">
    <div class="client-list-container d-flex gap-2 border border-2 p-2 align-items-center mt-3 btn w-100 @_selectionCss" disabled="@Disable" type="button" id="client-dropdown" data-bs-toggle="dropdown" aria-expanded="false" @onclick="HandleEditListClick">
        @if (_activeClients?.Any() ?? false)
        {
            foreach (var client in _activeClients)
            {
                <div class="client-item border border-dark rounded-pill bg-dark text-white p-1">
                    <p>@client.Name</p>
                    <span @onclick="e => HandleRemoveClientClick(client.Value)">
                        <i class="fa fa-times-circle"></i>
                    </span>
                </div>
            }
        }
        else
        {
            <p class="placeholder bg-white">Click here to select clients</p>
        }
    </div>
    @if (Clients != null && Clients.Any())
    {
        <ul class="dropdown-menu w-100 pt-0">
            <li>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fa fa-search"></i>
                    </span>
                    <input id="search" placeholder=@_translationState.GetValue("Find client") class="search-client form-control border-bottom px-0" @bind="@_searchField" />
                </div>
            </li>
            @foreach (var item in Clients)
            {
                <li id="@item.Value">
                    <div class="form-check ms-2" @onclick="() => HandleCheckboxCheck(item)">
                        @* <input type="checkbox" class="form-check-input" @onclick="() => CheckboxClicked(item)" checked="@item.IsChecked" disabled="@IsReadOnly" /> *@
                        <input type="checkbox" class="form-check-input" checked="@item.IsChecked" />
                        <label class="form-check-label fw-bold">@_translationState.GetValue(item.Name)</label>
                    </div>
                </li>
            }
        </ul>
    }
</div>