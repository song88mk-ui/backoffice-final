@using Backoffice.Shared.Enums;
@using Backoffice.Web.Services;

<div class="modal-body">
    @*<NoRecordFound />*@

    <!--uncomment block code below for output-->
    <div class="row">
        <div class="col-12">
            @if (IsPreLoader)
            {
                <Preloader />
            }
            else
            {
                @if (ActivityLogs != null && ActivityLogs.Any())
                {
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th scope="col"><strong>Date</strong></th>
                                <th scope="col"><strong>Activity</strong></th>
                                <th scope="col"><strong>From</strong></th>
                                <th scope="col"><strong>To</strong></th>
                                <th scope="col"><strong>Updated By</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var logs in ActivityLogs)
                            {
                                <tr>
                                    <td>@logs.TimeStamp.ToLocalTime().ToString("dd/MM/yy") @logs.TimeStamp.ToLocalTime().ToString("HH:mm")</td>
                                    <td>@logs.Activity</td>
                                    <td class="td-left">@((MarkupString)CommonService.GetActivity<AdminPermission>(logs.From, logs.To, AdminPermission.Admin_ManageUserGroups, logs.Activity, true))</td>
                                    <td class="td-left">@((MarkupString)CommonService.GetActivity<AdminPermission>(logs.From, logs.To, AdminPermission.Admin_ManageUserGroups, logs.Activity, false))</td>
                                    <td>@logs.UserName</td>
                                </tr>
                            }
                        </tbody>
                        <Pagination MetaData="MetaData" Spread="3" SelectPageEvent="SelectedPage" PaginationColspan="5" />
                    </table>                    
                }
                else
                {
                    <NoRecordFound />
                }
            }
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn modal-close" @onclick="OnCloseModalClickEvent">Close</button>
</div>