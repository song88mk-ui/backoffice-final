<div class="modal-body">
    <div class="information-container mb-3">
        @if (IsPreload)
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="mt-4 mx-3">
                        <Preloader />
                    </div>
                </div>
            </div>
        }
        <div class="row">
            <div class="col-md-12 mb-1">
                <h6 class="title fw-bold ps-2 py-1">Group Information</h6>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <label class="form-label">User Group Name</label>
                <input type="text" class="form-control" placeholder="Enter User Group Name" @bind-value="UserGroup.UserGroupName" />
            </div>
            <div class="col-md-8">
            </div>
        </div>
    </div>
    <Permission IsReadOnly="@IsPreload" Permissions="@Permissions.Permissions" ClientModel="@ClientModel" />
</div>
<div class="modal-footer mx-4">
    @if (Alerts != null && Alerts.Any())
    {
        <div class="col-md-8">
            @foreach (var alert in Alerts)
            {
                <AlertMessage AlertStatus="@alert.Status" AlertMessageStr="@alert.Message" Opacity="@alert.Opacity" />
            }
        </div>
    }
    <button type="button" class="btn btn-cancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent" disabled="@IsPreload">Cancel</button>
    <button type="button" class="btn btn-edit waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickEvent" disabled="@IsPreload">Save</button>
</div>