<div class="content-filter mx-3">
    <div class="w-100 d-flex flex-row justify-content-between">
        <div class="input-container d-flex">
            <div class="me-4">
                <EditForm Model="SearchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
                    <label class="form-label d-block">User Group Name</label>
                    <InputText id="search" placeholder="Search" class="form-control search-text valid" @bind-Value="SearchForm.SearchText" />
                </EditForm>
            </div>
            <div class="me-4">
                <label class="form-label d-block">Sort By</label>
                <select class="form-select d-block" @onchange="OnSortByChangedEvent">
                    @foreach (var item in SelectSortByList)
                    {
                        if (SortBy == item.Value)
                        {
                            <option value="@item.Value" selected>@item.Name</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Name</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="button-container d-flex flex-row-reverse align-items-end">
            <a href="javascript:void(0)" class="btn btn-create px-4" @onclick="OnCreateUserGroupCallbackEvent">Create User Group</a>
        </div>
    </div>
</div>