@using BlazorDateRangePicker
<div class="row mb-3">
    <div class="col-md-12">
        <div class="content-filter mx-3 d-flex justify-content-between">
            <div class="add-reference-container d-flex">
                <button type="button" class="btn btn-add px-4 py-2 me-3" @onclick="OnAddReferenceClickEvent">
                    <i class="fa fa-plus me-3"></i>
                    Add Reference ID
                </button>
            </div>
            <div class="button-container d-flex flex-row-reverse align-items-end">
                <button type="button" class="btn btn-export px-4 py-2" @onclick="OnExportToExcelClickEvent" disabled="@IsExportDisabled">
                    <i class="fa fa-file-excel-o"></i>
                    Export To Excel
                </button>
                <button type="button" class="btn btn-filter px-4 py-2 me-3" @onclick="OnFilterClickEvent">
                    <i class="fa fa-filter me-3"></i>
                    Filters
                </button>
            </div>
        </div>
    </div>
</div>

@if (ShowFilter)
{
    <div class="row mx-1 mb-2">
        <div class="col-2">
            <div class="dropdown">
                <button class="btn form-select dropdown-toggle" type="button" id="client-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    @if (Clients.Any())
                    {
                        if (Clients.Count - 1 == SelectedClientCount)
                        {
                            <span>@TranslationState.GetValue("All Clients") (@SelectedClientCount)</span>
                        }
                        else
                        {
                            <span>@(SelectedClientCount == 1 ? SelectedClientName : $"Clients ({SelectedClientCount})")</span>
                        }
                    }
                    else
                    {
                        <span>No Clients Available</span>
                    }
                </button>
                @if (Clients.Any())
                {
                    <SelectWithCheckbox Items="Clients" OnCheckboxCallback="OnClientCheckboxClickEvent" AriaLabel="client-dropdown" />
                }
            </div>
        </div>

        <div class="col-2">
            <div class="dropdown">
                <button class="btn form-select dropdown-toggle" type="button" id="sport-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    @if (Sports.Any())
                    {
                        if (Sports.Count - 1 == SelectedSportCount)
                        {
                            <span>@TranslationState.GetValue($"All Sports ({{{SelectedClientCount}}})")</span>
                        }
                        else
                        {
                            <span>
                                @(SelectedSportCount == 1 ? SelectedSportName : @TranslationState.GetValue($"Sports({{{SelectedSportCount}}})"))
                            </span>
                        }
                    }
                    else
                    {
                        <span>@TranslationState.GetValue("No sports Available")</span>
                    }
                </button>
                @if (Sports.Any())
                {
                    <SelectWithCheckbox Items="Sports" OnCheckboxCallback="OnSportCheckboxClickEvent" AriaLabel="sport-dropdown" />
                }
            </div>
        </div>

        <div class="col-2">
            <div class="dropdown">
                <button class="btn form-select dropdown-toggle" type="button" id="currency-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    @if (Currencies.Any())
                    {
                        if (Currencies.Count - 1 == SelectedCurrencyCount)
                        {
                            <span>All Currencies (@SelectedCurrencyCount)</span>
                        }
                        else
                        {
                            <span>@(SelectedCurrencyCount == 1 ? SelectedCurrencyName : $"Currencies ({SelectedCurrencyCount})")</span>
                        }
                    }
                    else
                    {
                        <span>No Currencies Available</span>
                    }
                </button>
                @if (Sports.Any())
                {
                    <SelectWithCheckbox Items="Currencies" OnCheckboxCallback="OnCurrencyCheckboxClickEvent" AriaLabel="currency-dropdown-dropdown" />
                }
            </div>
        </div>

        <div class="col-2">
            <div class="dropdown">
                <button class="btn form-select dropdown-toggle" type="button" id="fromstatus-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    @if (FromStatuses.Any())
                    {
                        if (FromStatuses.Count - 1 == SelectedFromStatusCount)
                        {
                            <span>All From Status @SelectedFromStatusCount</span>
                        }
                        else
                        {
                            <span>@(SelectedFromStatusCount == 1 ? SelectedFromStatusName : $"All From Status ({SelectedFromStatusCount})")</span>
                        }
                    }
                    else
                    {
                        <span>No From Status Available</span>
                    }
                </button>
                @if (FromStatuses.Any())
                {
                    <SelectWithCheckbox Items="FromStatuses" OnCheckboxCallback="OnFromStatusCheckboxClickEvent" AriaLabel="fromstatus-dropdown" />
                }
            </div>
        </div>

        <div class="col-2">
            <div class="dropdown">
                <button class="btn form-select dropdown-toggle" type="button" id="tostatus-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    @if (ToStatuses.Any())
                    {
                        if (ToStatuses.Count - 1 == SelectedToStatusCount)
                        {
                            <span>All To Status (@SelectedToStatusCount)</span>
                        }
                        else
                        {
                            <span>@(SelectedToStatusCount == 1 ? SelectedToStatusName : $"All To Status ({SelectedToStatusCount})")</span>
                        }
                    }
                    else
                    {
                        <span>No To Status Available</span>
                    }
                </button>
                @if (ToStatuses.Any())
                {
                    <SelectWithCheckbox Items="ToStatuses" OnCheckboxCallback="OnToStatusCheckboxClickEvent" AriaLabel="tostatus-dropdown" />
                }
            </div>
        </div>
    </div>

    <div class="row mx-1">
        <div class="col-2">
            <input type="text" placeholder="Bet/Reference ID" class="form-control" @oninput="OnReferenceIdChangedEvent" />
        </div>

        <div class="col-2">
            <DateRangePicker class="form-control" DateFormat="MM/dd/yyyy" LinkedCalendars="true" StartDate="CallbackModel.DateFrom" EndDate="CallbackModel.DateTo" MaxDate="DateTime.Today" OnRangeSelect="OnDateRangeChangedEvent"></DateRangePicker>
        </div>

        <div class="col-2">
            <input type="text" placeholder="Member Name" class="form-control" @oninput="OnMemberNameChangedEvent" />
        </div>

        <div class="col-2">
            <input type="text" placeholder="Settled By" class="form-control" @oninput="OnSettledByChangedEvent" />
        </div>

        <div class="col-2">
            <button type="button" class="btn filter-btn-search" @onclick="OnSearchButtonClickedEvent">@TranslationState.GetValue("Search")</button>
        </div>
    </div>
} 