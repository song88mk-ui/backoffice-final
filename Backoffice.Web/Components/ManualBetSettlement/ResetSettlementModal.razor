<div class="modal-body">
    <div class="d-flex flex-column justify-content-center p-5">
        <div class="text-center">
            <img src="icons/svg/warning-icon.svg" />
        </div>
        <div class="text-center">
            Are you sure want to reset?
            <br />
            All your progress will be lost
        </div>
    </div>
</div>
<div class="modal-footer">
    <button class="btn modal-btn modal-cancel" type="button" @onclick="OnModalCancel">Cancel</button>
    <button class="btn modal-btn modal-reset" type="button" @onclick="OnModalReset">Reset</button>
</div>