@using Backoffice.Shared.Enums;
@using static Backoffice.Shared.Models.ManualBetDetailsModel;
<div class="modal-body">
    @if (Alerts != null && Alerts.Any())
    {
        foreach (var alert in Alerts)
        {
            <AlertMessage AlertStatus="@alert.Status" AlertMessageStr="@alert.Message" Opacity="@alert.Opacity" Guid="Guid"/>
        }
    }
    <table class="table">
        <thead class="align-middle">
            <tr>
                <th scope="col">#</th>
                <th scope="col">Reference ID</th>
                <th scope="col">Event Details</th>
                <th scope="col">Bet Date</th>
                <th scope="col">Status</th>
                <th scope="col">Reason</th>
                <th scope="col">
                    <button type="button" class="btn" @onclick="OnAddReferenceIdClickedEvent" disabled="@IsAddDisabled">
                        <i class="fa fa-plus-circle" aria-hidden="true" />
                    </button>
                </th>
            </tr>
        </thead>
        <tbody>
            @for(int i = 0; i<ManualBetDetailsModel.Bets.Count; i++)
            {
                ManualBetDetails bet = ManualBetDetailsModel.Bets[i];
            
                <tr>
                    <th scope="row">
                        <span>@(i + 1)</span>
                    </th>

                    <td>
                        <textarea class="ref-id form-control" @bind="bet.BetId" placeholder="Reference ID" @oninput="(ChangeEventArgs args) => OnReferenceIdOnChangeEvent(args, bet, ManualBetDetailsModel.Bets.IndexOf(bet))" disabled="@IsActionDisabled"></textarea>
                    </td>

                    <td class="fw-bold">
                        <div class="d-flex flex-column text-start">
                            @((MarkupString)BuildEventDetails(bet.Selections.FirstOrDefault(), bet.OddsTypeName))
                        </div>
                    </td>

                    <td class="fw-bold">
                        <div class="d-flex flex-column text-start">
                            @((MarkupString)BuildBetDate(bet))
                        </div>
                    </td>

                    <td>
                        <select class="form-select" @onchange="(ChangeEventArgs e) => OnBetStatusChangedEvent(e, bet)" disabled="@IsBetSelectDisabled">
                            <option value="0">None</option>
                            <option value="@((int)BetStatus.Won)">Won</option>
                            <option value="@((int)BetStatus.Lost)">Lost</option>
                            <option value="@((int)BetStatus.HalfWon)">Half Won</option>
                            <option value="@((int)BetStatus.HalfLost)">Half Lost</option>
                            <option value="@((int)BetStatus.Void)">Void</option>
                        </select>
                    </td>
                    <td>
                        <textarea class="reason form-control" placeholder="Reason" @oninput="(ChangeEventArgs e) => OnReasonChangedEvent(e, bet)" disabled="@IsReasonDisabled"></textarea>
                    </td>
                    <td>
                        <button type="button" class="btn" @onclick="() => OnDeleteClickEvent(bet)" disabled="@((ManualBetDetailsModel.Bets.Count == 1 ? true: false) || @IsActionDisabled)">
                            <i class="fa fa-trash" />
                        </button>
                    </td>
                </tr>
            }            
        </tbody>
    </table>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn modal-reset" @onclick="OnModalResetClickEvent">Reset</button>
    <button type="button" class="btn modal-btn modal-settle-bets" @onclick="OnModalSettleClickEvent">Settle Bets</button>
</div>