<div class="row mb-3">
    <div class="col-md-12">
        <div class="content-filter mx-3 d-flex justify-content-between">
            <div class="add-reference-container d-flex">
                <button type="button" class="btn btn-add px-4 py-2 me-3" @onclick="OnAddReferenceClickEvent">
                    <i class="fa fa-plus me-3"></i>
                    Add Reference ID
                </button>
            </div>
            <div class="button-container d-flex flex-row-reverse align-items-end">
                <button type="button" class="btn btn-export px-4 py-2">
                    <i class="fa fa-file-excel-o"></i>
                    Export To Excel
                </button>
                <button type="button" class="btn btn-filter px-4 py-2 me-3" @onclick="OnFilterClickEvent">
                    <i class="fa fa-filter me-3"></i>
                    Filters
                </button>
            </div>
        </div>
    </div>
</div>

@if(ShowFilter)
{
    <div class="row mx-1 mb-2">
        <div class="col-2">
            <select class="form-select">
                <option value="0">Clients</option>
            </select>
        </div>

        <div class="col-2">
            <select class="form-select">
                <option value="0">Sports</option>
            </select>
        </div>

        <div class="col-2">
            <select class="form-select">
                <option value="0">Currencies</option>
            </select>
        </div>

        <div class="col-2">
            <select class="form-select">
                <option value="0">From Status</option>
            </select>
        </div>

        <div class="col-2">
            <select class="form-select">
                <option value="0">To Status</option>
            </select>
        </div>
    </div>

    <div class="row mx-1">
        <div class="col-2">
            <input type="text" placeholder="Bet/Reference ID" class="form-control" />
        </div>

        <div class="col-2">
            <input type="text" placeholder="Date Range" class="form-control" />
        </div>

        <div class="col-2">
            <input type="text" placeholder="Member Name" class="form-control" />
        </div>

        <div class="col-2">
            <input type="text" placeholder="Settled By" class="form-control" />
        </div>

        <div class="col-2">
            <button type="button" class="btn filter-btn-search">Search</button>
        </div>
    </div>
}