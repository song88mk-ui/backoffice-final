<div class="modal-body">
    @if (_isPreload)
    {
        <Preloader />
    } 
    else
    {
        <span class="bold-text">@_translationState.GetValue("Delete Announcement?")</span>
        <span class="sub-text">@_translationState.GetValue("announcement_delete_message")</span>
        <div class="btns-container">
            <button type="button" class="btn modal-btn modal-cancel" disabled="@_isPreload" @onclick="OnCancelModalClick">@_translationState.GetValue("Cancel")</button>
            <button type="button" class="btn modal-btn modal-delete" disabled="@_isPreload" @onclick="OnDeleteModalClick">@_translationState.GetValue("Delete")</button>
        </div>
    }
    @if (_alert != null && string.IsNullOrEmpty(_alert.Message))
    {
        <AlertMessage AlertModel="@_alert" />
    }
</div>