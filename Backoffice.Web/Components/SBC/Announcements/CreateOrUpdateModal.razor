@using BlazorDateRangePicker

<div class="modal-body">
    @if (_isPreload)
    {
        <div class="col-md-12">
            <div class="mt-4 mx-3">
                <Preloader />
            </div>
        </div>
    }
    else
    {
        <EditForm EditContext="EditContext">
            <div class="announcement-container">
                <div class="announcement-header-container">
                    <span class="announcement-header-title">@_translationState.GetValue("Announcements")</span>
                    <div class="announcement-switch-container">
                        <span class="announcement-switch-label" for="@_announcement.IsActive">@_translationState.GetValue(_announcement.IsActive? "Active" : "Inactive")</span>
                        <div class="form-switch">
                            @if (_announcement.IsActive)
                            {
                                <input class="form-check-input" type="checkbox" role="switch" checked @onclick="OnStatusClickEvent" />
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" role="switch" @onclick="OnStatusClickEvent" />
                            }
                        </div>
                    </div>
                </div>
                <div class="announcement-title-container">
                    <div class="announcement-title-label">Title</div>
                    <div class="announcement-title-sub-label">The title of your announcement.</div>
                    <input type="text" class="form-control @(ShowNoTitleAlert() ? "has-error" : "")" id="titleField" placeholder="Enter title" @bind-value="_announcement.Title" @onblur="HandleBlur" />
                    @if (ShowNoTitleAlert())
                    {
                        <span class="announcement-error-message">@(NO_TITLE_ERR_MSG)</span>
                    }
                </div>
                <div class="announcement-dates-container">
                    <div class="announcement-start-date-container">
                        <span class="announcement-start-date-title">Start Date / Time (UTC)</span>
                        <div class="announcement-date-input-wrapper @GetDateRangeClass()">
                            <DateRangePicker class="form-control"
                                StartDate="_announcement.StartDate"
                                OnRangeSelect="OnRangeSelectStartDate"
                                TimePicker="true"
                                TimePicker24Hour="true"
                                SingleDatePicker="true"
                                DateFormat="@($"MMM dd, yyyy HH:mm")"
                                />
                            <i class="ico ico-calendar" />
                        </div>
                        @if (ShowInvalidStartDateAlert())
                        {
                            <span class="announcement-error-message">@(INVALID_START_DATE_ERR_MSG)</span>
                        }
                    </div>
                    <div class="announcement-end-date-container">
                        <span class="announcement-end-date-title">End Date / Time (UTC)</span>
                        <div class="announcement-date-input-wrapper">
                            <DateRangePicker class="form-control"
                                MinDate="_announcement.StartDate"
                                StartDate="_announcement.EndDate"
                                OnRangeSelect="OnRangeSelectEndDate"
                                TimePicker="true"
                                TimePicker24Hour="true"
                                SingleDatePicker="true"
                                DateFormat="@($"MMM dd, yyyy HH:mm")" 
                            />
                            <i class="ico ico-calendar" />
                        </div>
                    </div>
                </div>
                <div class="announcement-clients-container">
                    <span class="announcement-clients-label">Clients</span>
                    <span class="announcement-clients-sub-label">Select the clients who will see this announcement.</span>
                    @if (_clients != null)
                    {
                        <div class="announcement-clients-input-wrapper @(ShowNoClientAlert() ? "has-error" : "")" @onblur="HandleBlur">
                            <Dropdown DropdownClass="announcements" DropdownName="Clients" OnClickEventCallback="OnClientCheckboxClickEvent" Items="_clients" Multiple=true />
                        </div>
                    }
                    @if (ShowNoClientAlert())
                    {
                        <span class="announcement-error-message">@(NO_CLIENT_ERR_MSG)</span>
                    }
                </div>
                <div class="announcement-language-container">
                    <span class="announcement-language-label">Language</span>
                    <span class="announcement-language-sub-label">Select the language to display this announcement to all selected clients.</span>
                    <div class="announcement-language-list">
                        @foreach (var language in _languages.Languages)
                        {
                            <div key="@(language)-lang" class="announcement-language-item" @onclick="language.ClickAction">
                                <i class="announcement-language-item-icon @($"ico-flag flag-{language.Language.ToString().ToLower()}") @(_selectedLanguage == language.Language ? "selected" : "")" aria-hidden="true" />
                                <span class="announcement-language-item-label">@language.Language</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="announcement-message-container">
                    <span class="announcement-message-label">Message</span>
                    <span class="announcement-message-sub-label">Enter the message of your announcement.</span>
                    <textarea class="announcement-message-input @(ShowNoMessageAlert() ? "has-error" : "")" maxlength="500" placeholder="Enter the message of your announcement" @bind="_announcementMessages[_selectedLanguage]" rows="4" @onblur="HandleBlur" />
                    @if (ShowNoMessageAlert())
                    {
                        <span class="announcement-error-message">@(NO_MSG_ERR_MSG)</span>
                    }
                </div>
            </div>

        </EditForm>
    }
</div>
<div class="modal-footer">
    @if (ShowGeneralErrorAlert())
    {
        <div class="col-md-8">
            @foreach (var alert in _alerts.Where(a => a.AnnouncementAlertType == AnnouncementAlertType.GeneralError).ToList())
            {
                <AlertMessage AlertModel="@alert" />
            }
        </div>
    }
    <button type="button" class="announcement-cancel-btn" data-bs-dismiss="modal" @onclick="OnCancelClickEvent" disabled=@_isPreload>@_translationState.GetValue("Cancel")</button>
    <button type="button" class="announcement-save-btn" data-bs-dismiss="modal" @onclick="OnSaveClickEvent" disabled=@_isPreload>@_translationState.GetValue("Save Announcement")</button>
</div>