@using BlazorDateRangePicker

<div class="modal-body">
    @if (_isPreload)
    {
        <div class="col-md-12">
            <div class="mt-4 mx-3">
                <Preloader />
            </div>
        </div>
    }
    else
    {
        <EditForm EditContext="EditContext">
            <div class="announcement-container">
                <div class="announcement-header-container">
                    <span class="announcement-header-title">@TranslationState.GetValue("Announcements")</span>
                    <div class="announcement-switch-container">
                        <span class="announcement-switch-label" for="@_announcement.IsActive">@TranslationState.GetValue(_announcement.IsActive? "Active" : "Inactive")</span>
                        <div class="form-switch">
                            @if (_announcement.IsActive)
                            {
                                <input class="form-check-input" type="checkbox" role="switch" checked @onclick="OnStatusClickEvent" />
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" role="switch" @onclick="OnStatusClickEvent" />
                            }
                        </div>
                    </div>
                </div>
                <div class="announcement-title-container">
                    <div class="announcement-title-label">Title</div>
                    <div class="announcement-title-sub-label">The title of your announcement.</div>
                    <input type="text" class="form-control" id="titleField" placeholder="Enter title" @bind-value="_announcement.Title" />
                </div>
                <div class="announcement-dates-container">
                    <div class="announcement-start-date-container">
                        <span class="announcement-start-date-title">Start Date / Time</span>
                        <DateRangePicker class="form-control"
                            StartDate="_announcement.StartDate"
                            OnRangeSelect="OnRangeSelectStartDate"
                            TimePicker="true"
                            TimePicker24Hour="true"
                            SingleDatePicker="true"
                            DateFormat="@($"MMM dd, yyyy HH:mm")" 
                        />
                        <i class="ico ico-calendar" />
                    </div>
                    <div class="announcement-end-date-container">
                        <span class="announcement-end-date-title">End Date / Time</span>
                        <DateRangePicker class="form-control"
                            MinDate="_announcement.StartDate"
                            StartDate="_announcement.EndDate"
                            OnRangeSelect="OnRangeSelectEndDate"
                            TimePicker="true"
                            TimePicker24Hour="true"
                            SingleDatePicker="true"
                            DateFormat="@($"MMM dd, yyyy HH:mm")" 
                        />
                        <i class="ico ico-calendar" />
                    </div>
                </div>
                <div class="announcement-clients-container">
                    <span class="announcement-clients-label">Clients</span>
                    <span class="announcement-clients-sub-label">Select the clients who will see this announcement.</span>
                    @if (_clients != null)
                    {
                        <Dropdown DropdownClass="announcements" DropdownName="Clients" OnClickEventCallback="OnClientCheckboxClickEvent" Items="_clients" Multiple=true />
                    }
                </div>
                <div class="announcement-language-container">
                    <span class="announcement-language-label">Language</span>
                    <span class="announcement-language-sub-label">Select the language to display this announcement to all selected clients.</span>
                    <div class="announcement-language-list">
                        @foreach (var language in _languageCodes)
                        {
                            <div key="@(language)-lang" class="announcement-language-item" @onclick="() => OnLanguageClicked(language)">
                                <i class="announcement-language-item-icon @($"ico-flag flag-{language.ToString().ToLower()}") @(_selectedLanguage == language ? "selected" : "")" aria-hidden="true" />
                                <span class="announcement-language-item-label">@language</span>
                            </div>
                        }
                    </div>
                </div>
                <div class="announcement-message-container">
                    <span class="announcement-message-label">Clients</span>
                    <span class="announcement-message-sub-label">Select the clients who will see this announcement.</span>
@*                     <input type="textarea" class="form-control" id="messageField" placeholder="Enter the message of your announcement" @bind-value="_announcementMessages[_selectedLanguage]" multiple /> *@
                    <textarea class="announcement-message-input" placeholder="Enter the message of your announcement" @bind="_announcementMessages[_selectedLanguage]" rows="4"/>
                </div>
            </div>

        </EditForm>
    }
</div>
<div class="modal-footer">
    @if (_alerts != null && _alerts.Any())
    {
        <div class="col-md-8">
            @foreach (var alert in _alerts)
            {
                <AlertMessage AlertModel="@alert" />
            }
        </div>
    }
    <button type="button" class="announcement-cancel-btn" data-bs-dismiss="modal" @onclick="OnCancelClickEvent" disabled=@_isPreload>@TranslationState.GetValue("Cancel")</button>
    <button type="button" class="announcement-save-btn" data-bs-dismiss="modal" @onclick="OnSaveClickEvent" disabled=@_isPreload>@TranslationState.GetValue("Save Announcement")</button>
</div>