@using BlazorDateRangePicker

<div class="modal-body">
    @if (_isPreload)
    {
        <div class="col-md-12">
            <div class="mt-4 mx-3">
                <Preloader />
            </div>
        </div>
    }
    else
    {
        <EditForm EditContext="EditContext">
            <div class="announcement-container">
                <div class="announcement-header-container">
                    <span class="announcement-header-title">@TranslationState.GetValue("Announcements")</span>
                    <div class="announcement-switch-container">
                        <span class="announcement-switch-label" for="@_announcement.IsActive">@TranslationState.GetValue(_announcement.IsActive? "Active" : "Inactive")</span>
                        <div class="form-switch">
                            @if (_announcement.IsActive)
                            {
                                <input class="form-check-input" type="checkbox" role="switch" checked @onclick="OnStatusClickEvent" />
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" role="switch" @onclick="OnStatusClickEvent" />
                            }
                        </div>
                    </div>
                </div>
                <div class="announcement-title-container">
                    <div class="announcement-title-label">Title</div>
                    <div class="announcement-title-sub-label">The title of your announcement</div>
                    <input type="text" class="form-control" id="titleField" placeholder="Enter title" @bind-value="_announcement.Title" />
                </div>
                <div class="announcement-dates-container">
                    <div class="announcement-start-date-container">
                        <span class="announcement-start-date-title">Start Date / Time</span>
                        <DateRangePicker class="form-control"
                            StartDate="_announcement.StartDate"
                            OnRangeSelect="OnRangeSelectStartDate"
                            TimePicker="true"
                            TimePicker24Hour="true"
                            SingleDatePicker="true"
                            DateFormat="@($"MMM dd, yyyy HH:mm")" 
                        />
                    </div>
                    <div class="announcement-end-date-container">
                        <span class="announcement-end-date-title">End Date / Time</span>
                        <DateRangePicker class="form-control"
                            MinDate="_announcement.StartDate"
                            StartDate="_announcement.EndDate"
                            OnRangeSelect="OnRangeSelectEndDate"
                            TimePicker="true"
                            TimePicker24Hour="true"
                            SingleDatePicker="true"
                            DateFormat="@($"MMM dd, yyyy HH:mm")" 
                        />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <h6 class="title fw-bold ps-2 py-1">Clients</h6>
                        <label for="titleField" class="form-label">Select the clients who will see this announcement.</label>
                    </div>
                    <div class="col-md-12">
                        <div class="row mb-3">
                            <div class="col">
                                @if (_clients != null)
                                {
                                    <Dropdown DropdownName="Clients" OnClickEventCallback="OnClientCheckboxClickEvent" Items="_clients" Multiple=true />
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <h6 class="title fw-bold ps-2 py-1">Language</h6>
                    </div>
                    <div class="col-md-12">
                        <div class="row mb-3">
                            @foreach (var language in _languageCodes)
                            {
                                <div class="col">
                                    @if (_selectedLanguage == language)
                                    {
                                        <input type="radio" class="btn-check" name="currencyOptions" id="@language" @onchange="() => OnLanguageClicked(language)" checked />
                                    }
                                    else
                                    {
                                        <input type="radio" class="btn-check" name="currencyOptions" id="@language" @onchange="() => OnLanguageClicked(language)" />
                                    }
                                    <label class="btn modalTab" for="@language">@language</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <h6 class="title fw-bold ps-2 py-1">Message</h6>
                    </div>
                    <div class="col-md-12">
                        <div class="row mb-3">
                            <div class="col">
                                <label for="messageField" class="form-label">Enter the message of your announcement</label>
                                <input type="text" class="form-control" id="messageField" placeholder="Enter the message of your announcement" @bind-value="_announcementMessages[_selectedLanguage]" multiple />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </EditForm>
    }
</div>
<div class="modal-footer">
    @if (_alerts != null && _alerts.Any())
    {
        <div class="col-md-8">
            @foreach (var alert in _alerts)
            {
                <AlertMessage AlertModel="@alert" />
            }
        </div>
    }
    <button type="button" class="btn modalBtn modalCancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent" disabled=@_isPreload>@TranslationState.GetValue("Cancel")</button>
    <button type="button" class="btn modalBtn modalSave waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickEvent" disabled=@_isPreload>@TranslationState.GetValue("Save")</button>
</div>