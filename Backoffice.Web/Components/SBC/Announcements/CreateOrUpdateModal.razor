@using BlazorDateRangePicker

<div class="modal-body">
    @if (_isPreload)
    {
        <div class="col-md-12">
            <div class="mt-4 mx-3">
                <Preloader />
            </div>
        </div>
    }
    else
    {
        <EditForm EditContext="EditContext">
            <div class="announcement-container">
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-switch d-inline-block pull-right">
                            @if (_announcement.IsActive)
                            {
                                <input class="form-check-input" type="checkbox" role="switch" checked @onclick="OnStatusClickEvent" />
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" role="switch" @onclick="OnStatusClickEvent" />
                            }
                        </div>
                        <label class="form-check-label pull-right" for="@_announcement.IsActive">@TranslationState.GetValue(_announcement.IsActive? "Active" : "Inactive")</label>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <h6 class="title fw-bold ps-2 py-1">Title</h6>
                    </div>
                    <div class="col-md-12">
                        <div class="row mb-3">
                            <div class="col">
                                <label for="titleField" class="form-label">The title of your announcement</label>
                                <input type="text" class="form-control" id="titleField" placeholder="Enter title" @bind-value="_announcement.Title" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <h6 class="title fw-bold ps-2 py-1">Start Date</h6>
                            </div>
                            <div class="col-md-4">
                                <h6 class="title fw-bold ps-2 py-1">End Date</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <DateRangePicker class="form-control"
                                                 StartDate="_announcement.StartDate"
                                                 OnRangeSelect="OnRangeSelectStartDate"
                                                 TimePicker="true"
                                                 TimePicker24Hour="true"
                                                 SingleDatePicker="true"
                                                 DateFormat="@($"MMM dd, yyyy HH:mm")" />
                            </div>
                            <div class="col-md-4">
                                <DateRangePicker class="form-control"
                                                 MinDate="_announcement.StartDate"
                                                 StartDate="_announcement.EndDate"
                                                 OnRangeSelect="OnRangeSelectEndDate"
                                                 TimePicker="true"
                                                 TimePicker24Hour="true"
                                                 SingleDatePicker="true"
                                                 DateFormat="@($"MMM dd, yyyy HH:mm")" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <h6 class="title fw-bold ps-2 py-1">Clients</h6>
                        <label for="titleField" class="form-label">Select the clients who will see this announcement.</label>
                    </div>
                    <div class="col-md-12">
                        <div class="row mb-3">
                            <div class="col">
                                <select id="select-@_announcement.Id" class="@_selectClass form-select d-block" multiple="multiple">
                                    @foreach (var cc in _clientCodes)
                                    {
                                        <option value="@cc" selected=@(_announcement.Clients.Any(c => c.ClientCode == cc))>@cc</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <h6 class="title fw-bold ps-2 py-1">Message</h6>
                    </div>
                    <div class="col-md-12">
                        <div class="row mb-3">
                            <div class="col">
                                <label for="messageField" class="form-label">Enter the message of your announcement</label>
                                <input type="text" class="form-control" id="messageField" placeholder="Enter the message of your announcement" @bind-value="_announcement.Message" multiple />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </EditForm>
    }
</div>
<div class="modal-footer">
    @if (_alerts != null && _alerts.Any())
    {
        <div class="col-md-8">
            @foreach (var alert in _alerts)
            {
                <AlertMessage AlertModel="@alert" />
            }
        </div>
    }
    <button type="button" class="btn modalBtn modalCancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent" disabled=@_isPreload>@TranslationState.GetValue("Cancel")</button>
    <button type="button" class="btn modalBtn modalSave waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickEvent" disabled=@_isPreload>@TranslationState.GetValue("Save")</button>
</div>