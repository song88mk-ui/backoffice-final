
@if (SportsTree != null && SportsTree.Any())
{
    foreach (var sport in SportsTree)
    {
        <li>
            <a class="dropdown-toggle dropdown-item" data-bs-toggle="collapse" role="button" href="#Row@(RowCount)Collapse@(sport.SportId)">@_translationState.GetValue(sport.SportName)</a>
            @if (sport.Segments != null && sport.Segments.Any())
            {
                <div id="Row@(RowCount)Collapse@(sport.SportId)" class="collapse ms-2">
                    @for (int x = 0; x < sport.Segments.Count; x++)
                    {
                        var segment = sport.Segments[x];

                        <a class="dropdown-toggle dropdown-item" data-bs-toggle="collapse" role="button" aria-controls="Row@(RowCount)SegmentCollapse@(segment.SegmentId)" href="#Row@(RowCount)SegmentCollapse@(segment.SegmentId)">@segment.SegmentName</a>

                        @if (segment.Leagues != null && segment.Leagues.Any())
                        {
                            <div id="Row@(RowCount)SegmentCollapse@(segment.SegmentId)" class="collapse ms-3">
                                @for (int y = 0; y < segment.Leagues.Count; y++)
                                {
                                    var league = segment.Leagues[y];

                                    <a class="dropdown-toggle dropdown-item" data-bs-toggle="collapse" role="button" aria-controls="Row@(RowCount)LeagueCollapse@(league.LeagueId)" href="#Row@(RowCount)LeagueCollapse@(league.LeagueId)">@league.LeagueName</a>

                                    if (league.Fixtures != null && league.Fixtures.Any())
                                    {
                                        <div id="Row@(RowCount)LeagueCollapse@(league.LeagueId)" class="collapse">

                                            @for (int z = 0; z < league.Fixtures.Count; z++)
                                            {
                                                var fixture = league.Fixtures[z];
                                                if (!CurrentTopFixtures.Contains(fixture.FixtureId) || fixture.FixtureId == SelectedTopFixture)
                                                {
                                                    if (fixture.FixtureId == SelectedTopFixture)
                                                    {
                                                        <div class="form-check ms-4" id="Row@(RowCount)Fixture@(fixture.FixtureId)" @onclick="() => OnGameSelectedEvent(fixture)">
                                                            <input class="form-check-input" type="radio" name="@RowCount" value="@fixture.FixtureId" id="@fixture.FixtureId" checked />
                                                            <label class="form-check-label" id="@fixture.FixtureId" for="@fixture.FixtureId">@fixture.FixtureName</label>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="form-check ms-4" id="Row@(RowCount)Fixture@(fixture.FixtureId)" @onclick="() => OnGameSelectedEvent(fixture)">
                                                            <input class="form-check-input" type="radio" name="@RowCount" value="@fixture.FixtureId" id="@fixture.FixtureId" />
                                                            <label class="form-check-label" id="@fixture.FixtureId" for="@fixture.FixtureId">@fixture.FixtureName</label>
                                                        </div>
                                                    }
                                                }

                                            }

                                        </div>
                                    }
                                }
                            </div>
                        }
                    }
                </div>
            }
        </li>
    }
}