<EditForm Model="@TopFixture" OnValidSubmit="OnSaveClickEvent">
    <div class="modal-body">
        <div class="row">
            <div class="col-2">
                <label class="my-1 mr-2">@_translationState.GetValue("Clients")</label>
                <div class="dropdown">
                    @if (ClientIdSelectedModel != null && ClientIdSelectedModel.Any())
                    {
                        <button class="btn clientBtn dropdown-toggle" type="button" id="clientDropdown" data-bs-auto-close="outside" data-bs-toggle="dropdown" aria-expanded="false">@_translationState.GetValue("Clients") (@ClientIdSelectedModel?.Where(x => x.IsSelected).Count())</button>

                        <ul class="dropdown-menu" aria-labelledby="clientDropdown">
                            <li class="dropdown-item">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="@IsSelectAll" @onclick="_ => SelectAllToggleCheckbox(!IsSelectAll)" />
                                    <label class="form-check-label" for="ClientAll">@_translationState.GetValue("Select All")</label>
                                </div>
                            </li>

                            @foreach (var item in ClientIdSelectedModel)
                            {
                                <li class="dropdown-item">
                                    <div class="form-check">
                                        <InputCheckbox class="form-check-input" @bind-Value="@item.IsSelected" @onclick="_ => ToggleCheckbox(item.ClientId)" />
                                        <label class="form-check-label" for="Client1">@item.ClientName</label>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {

                        <button class="btn clientBtn dropdown-toggle" type="button" id="clientDropdown" data-bs-auto-close="outside" data-bs-toggle="dropdown" aria-expanded="false">@_translationState.GetValue("Clients") (@ClientIdSelectedModel?.Where(x => x.IsSelected).Count())</button>
                    }
                </div>
            </div>

            @if (ClientIdSelectedModel != null && ClientIdSelectedModel.Any())
            {
                <div class="col-10 mt-2 pt-3">
                    <div class="d-flex flex-wrap border border-2 rounded p-2">
                        @foreach (var item in ClientIdSelectedModel.Where(x => x.IsSelected))
                        {
                            <div class="mx-2 mb-2 p-2 clientBorder">
                                @item.ClientName
                                <span>
                                    <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="_ => RemoveClient(item.ClientId)"></button>
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="row">
            <div class="col-12">
                <label class="my-1 mr-2">@_translationState.GetValue("Top Fixtures")</label>
                <div class="d-flex flex-wrap p-3 leagueContainer">
                    @if (TopFixture != null)
                    {
                        foreach (var item in TopFixture.TopFixtures)
                        {
                            <div class="mx-2 mb-2 p-2 clientBorder">
                                @item.FixtureName
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn copyModalBtn copyModalCancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent">@_translationState.GetValue("Cancel")</button>
        <button type="button" class="btn copyModalBtn copyModalSave waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickEvent">@_translationState.GetValue("Save")</button>
    </div>
</EditForm>
