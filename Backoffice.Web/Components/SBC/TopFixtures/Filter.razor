<div class="content-filter mx-3">
    <div class="d-flex flex-row justify-content-between">
        <div class="select-container d-flex">
            <div class="me-4 w-100">
                <label class="form-label d-block">@TranslationState.GetValue("Client")</label>
                <div class="dropdown">
                    <button class="btn form-select dropdown-toggle" type="button" id="client-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        @if (Clients.Any())
                        {
                            if (Clients.Count - 1 == SelectedClientCount)
                            {
                                <span>@TranslationState.GetValue("All Clients") (@SelectedClientCount)</span>
                            }
                            else
                            {
                                <span>@(SelectedClientCount == 1 ? SelectedClientName : $"{TranslationState.GetValue("Clients")} ({SelectedClientCount})")</span>
                            }
                        }
                        else
                        {
                            <span>@TranslationState.GetValue("No Clients Available")</span>
                        }
                    </button>
                    @if (Clients.Any())
                    {
                        <SelectWithCheckbox Items="Clients" OnCheckboxCallback="OnClientCheckboxClickEvent" AriaLabel="client-dropdown" />
                    }
                </div>
            </div>
        </div>
        <div class="input-container d-flex flex-row-reverse align-items-end">
            <div>
                <EditForm Model="SearchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
                    <div class="input-group">
                        <InputText id="search" placeholder=@TranslationState.GetValue("Search") class="form-control search-text valid border-end-0" @bind-Value="SearchForm.SearchText" @oninput="() => SearchForm.IsReset = SearchForm.SearchText != string.Empty" />
                        <span class="input-group-text border-start-0">
                            <i class="fa fa-search"></i>
                        </span>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>