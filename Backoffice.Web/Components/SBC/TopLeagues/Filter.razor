@using Backoffice.Web.Components.Common

<div class="content-filter mx-3">
    <div class="d-flex flex-row justify-content-between">
        <div class="select-container d-flex">
            @if (Clients != null)
            {
                <div class="me-4 w-50">
                    <label class="form-label d-block">@_translationState.GetValue("Client")</label>
                    <div class="dropdown">
                        <button class="btn form-select dropdown-toggle" type="button" id="client-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (Clients.Any(c => !c.Value.Equals("ALL", StringComparison.OrdinalIgnoreCase)))
                            {
                                if (Clients.Count - 1 == SelectedClientCount)
                                {
                                    <span>@_translationState.GetValue("All Clients") (@SelectedClientCount)</span>
                                }
                                else
                                {
                                    <span>@(SelectedClientCount == 1 ? SelectedClientName : $"{_translationState.GetValue("Clients")} ({SelectedClientCount})")</span>
                                }
                            }
                            else
                            {
                                <span>@_translationState.GetValue("No Clients Available")</span>
                            }
                        </button>
                        @if (Clients.Any(c => !c.Value.Equals("ALL", StringComparison.OrdinalIgnoreCase)))
                        {
                            <SelectWithCheckbox Items="Clients" OnCheckboxCallback="OnClientCheckboxClickEvent" AriaLabel="client-dropdown" />
                        }
                    </div>
                </div>
            }
            @if (Sports != null)
            {
                <div class="me-4 w-50">
                    <label class="form-label d-block">@_translationState.GetValue("Sports")</label>
                    <select class="form-select d-block" @onchange="OnSportsChangedEvent">
                        @foreach (var item in Sports)
                        {
                            <option value="@item.Value" selected="@(item.Value == SelectedSportId)">@_translationState.GetValue(item.Name)</option>
                        }
                    </select>
                </div>
            }
        </div>
        <div class="input-container d-flex flex-row-reverse align-items-end">
            <div>
                <EditForm Model="SearchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
                    <div class="input-group">
                        <InputText id="search" placeholder=@_translationState.GetValue("Search") class="form-control search-text valid border-end-0" @bind-Value="SearchForm.SearchText" @oninput="() => SearchForm.IsReset = SearchForm.SearchText != string.Empty" />
                        <span class="input-group-text border-start-0">
                            @if (!SearchForm.IsReset)
                            {
                                <i class="fa fa-search"></i>
                            }
                            else
                            {
                                <a @onclick="ClearSearch">
                                    <i class="fa fa-remove"></i>
                                </a>
                            }
                        </span>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>