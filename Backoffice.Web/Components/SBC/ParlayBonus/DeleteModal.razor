<div class="modal-body">
    <div class="d-flex flex-column justify-content-center p-5">
        <div class="text-center">
            <icon class="ico ico-warning"></icon>
        </div>
        <div class="text-center">
            You are about to delete "<span class="fw-bold">Parlay Bonus for @ClientName > @((ParlayBonusConfig.ParlayBonus).ToString("#.00"))%</span>".
            <br />
            @_translationState.GetValue("Please be certain as this cannot be undone")
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn cancel-btn" data-bs-dismiss="modal" @onclick="OnCancelClickEvent">@_translationState.GetValue("Cancel")</button>
    <button type="button" class="btn modal-btn apply-btn" data-bs-dismiss="modal" @onclick="OnApplyClickEvent">@_translationState.GetValue("Apply")</button>
</div>