@using Backoffice.Web.Components.Common

<div class="p-4">
    @if (!string.IsNullOrEmpty(LoadError))
    {
        <div class="alert alert-danger">@LoadError</div>
    }

    @if (SelectedBatchId == null)
    {
        <h5 class="mb-3">Update History</h5>

        @if (string.IsNullOrEmpty(LoadError) && !Batches.Any())
        {
            <p class="text-muted">No update batches found.</p>
        }
        else if (Batches.Any())
        {
            <div class="table-responsive" style="max-height: 480px;">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Started</th>
                            <th>Environment</th>
                            <th>Status</th>
                            <th>Started By</th>
                            <th>Clients</th>
                            <th>Succeeded</th>
                            <th>Failed</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var batch in Batches)
                        {
                            <tr>
                                <td>@batch.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@batch.Environment</td>
                                <td>
                                    @if (batch.Status == "Completed")
                                    {
                                        <span class="text-success fw-bold">Completed</span>
                                    }
                                    else if (batch.Status == "PartiallySuccessful")
                                    {
                                        <span class="text-warning fw-bold">Partially successful</span>
                                    }
                                    else if (batch.Status == "Failed")
                                    {
                                        <span class="text-danger fw-bold">Failed</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@batch.Status</span>
                                    }
                                </td>
                                <td>@batch.StartedByUserName</td>
                                <td>@batch.TotalRows</td>
                                <td class="text-success">@batch.SucceededRows</td>
                                <td class="text-danger">@batch.FailedRows</td>
                                <td>
                                    <button class="btn btn-sm modalBtn modalSave" @onclick="() => OnViewChangesClickEvent(batch.BatchId)">
                                        View changes
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="d-flex justify-content-end mt-4">
            <button class="btn modalBtn modalCancel" @onclick="Modal.Close">Close</button>
        </div>
    }
    else
    {
        <h5 class="mb-3">Field Changes — Batch #@SelectedBatchId</h5>

        @if (IsLoadingChanges)
        {
            <p class="text-muted">Loading...</p>
        }
        else if (string.IsNullOrEmpty(LoadError) && !SelectedBatchChanges.Any())
        {
            <p class="text-muted">No field changes recorded for this batch.</p>
        }
        else if (SelectedBatchChanges.Any())
        {
            <div class="table-responsive" style="max-height: 480px;">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Client Code</th>
                            <th>Field</th>
                            <th>Previous Value</th>
                            <th>New Value</th>
                            <th>When</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var change in SelectedBatchChanges)
                        {
                            <tr>
                                <td>@change.ClientCode</td>
                                <td><strong>@change.FieldName</strong></td>
                                <td class="text-muted">@change.PreviousValue</td>
                                <td>@change.NewValue</td>
                                <td>@change.TimeStamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="d-flex justify-content-end gap-2 mt-4">
            <button class="btn modalBtn modalCancel" @onclick="OnBackToListClickEvent">Back to list</button>
            <button class="btn modalBtn modalSave" @onclick="Modal.Close">Close</button>
        </div>
    }
</div>
