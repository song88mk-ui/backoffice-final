<div class="modal-body">
    <div class="business-container">
        <div class="row">
            <div class="col-md-12">
                <table class="table table-bordered">
                    <tbody>
                        <tr>
                            <td class="col-bet-setting col-header w-50">Bet Setting</td>
                            <td class="w-50">
                                <select class="form-control form-select d-block" id="currencyDropdown" @onchange="OnCurrencyClicked">
                                    @foreach (var currency in Currencies)
                                    {
                                        if (currency == SelectedCurrency)
                                        {
                                            <option value="@currency" selected>@currency</option>
                                        }
                                        else
                                        {
                                            <option value="@currency">@currency</option>
                                        }
                                    }
                                </select>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @if (SelectedSetting != null)
            {
                <div class="col-md-12">
                    <table class="table table-bordered">
                        <thead class="table-head">
                            <tr>
                                <th class="w-50 border-0">Soccer</th>
                                <th class="w-50 border-0"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Min Per Ticket</td>
                                <td>@SelectedSetting.BetSettingSoccer.MinPerTicket</td>
                            </tr>
                            <tr>
                                <td>Max Per Ticket</td>
                                <td>@SelectedSetting.BetSettingSoccer.MaxPerTicket</td>
                            </tr>
                            <tr>
                                <td>Max Per Game</td>
                                <td>@SelectedSetting.BetSettingSoccer.MaxPerGame</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-12">
                    <table class="table table-bordered">
                        <thead class="table-head">
                            <tr>
                                <th class="w-50 border-0">Cricket</th>
                                <th class="w-50 border-0"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Min Per Ticket</td>
                                <td>@SelectedSetting.BetSettingCricket.MinPerTicket</td>
                            </tr>
                            <tr>
                                <td>Max Per Ticket</td>
                                <td>@SelectedSetting.BetSettingCricket.MaxPerTicket</td>
                            </tr>
                            <tr>
                                <td>Max Per Game</td>
                                <td>@SelectedSetting.BetSettingCricket.MaxPerGame</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-12">
                    <table class="table table-bordered">
                        <thead class="table-head">
                            <tr>
                                <th class="w-50 border-0">Other Sports</th>
                                <th class="w-50 border-0"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Min Per Ticket</td>
                                <td>@SelectedSetting.BetSettingAllSports.MinPerTicket</td>
                            </tr>
                            <tr>
                                <td>Max Per Ticket</td>
                                <td>@SelectedSetting.BetSettingAllSports.MaxPerTicket</td>
                            </tr>
                            <tr>
                                <td>Max Per Game</td>
                                <td>@SelectedSetting.BetSettingAllSports.MaxPerGame</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-12">
                    <table class="table table-bordered">
                        <thead class="table-head">
                            <tr>
                                <th class="w-50 border-0">Parlay</th>
                                <th class="w-50 border-0"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Min Per Ticket</td>
                                <td>@SelectedSetting.BetSettingParlay.MinPerTicket</td>
                            </tr>
                            <tr>
                                <td>Max Per Ticket</td>
                                <td>@SelectedSetting.BetSettingParlay.MaxPerTicket</td>
                            </tr>
                            <tr>
                                <td>Max Payout Per Ticket</td>
                                <td>@SelectedSetting.BetSettingParlay.MaxPayoutPerTicket</td>
                            </tr>
                            <tr>
                                <td>Max Bonus Winnings</td>
                                <td>@SelectedSetting.BetSettingParlay.MaxWinningsBonus</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-12">
                    <table class="table table-bordered">
                        <thead class="table-head">
                            <tr>
                                <th class="w-50 border-0">Priceboost</th>
                                <th class="w-50 border-0"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Max Stake</td>
                                <td>@SelectedSetting.BetSettingPriceboost.MaxStake</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-12">
                    <table class="table table-bordered">
                        <thead class="table-head">
                            <tr>
                                <th class="w-50 border-0">Bet Builder</th>
                                <th class="w-50 border-0"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td scope="col">Min Per Ticket</td>
                                <td>@SelectedSetting.BetSettingBetBuilder.MinStake</td>
                            </tr>
                            <tr>
                                <td>Max Per Ticket</td>
                                <td>@SelectedSetting.BetSettingBetBuilder.MaxStake</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-cancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent">@TranslationState.GetValue("Close")</button>
</div>