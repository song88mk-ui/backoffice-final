<div class="content-filter mx-3">
    <div class="w-100 d-flex flex-row justify-content-between">
        <div class="input-container d-flex">
            <div class="me-4">
                <EditForm Model="SearchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
                    <label class="form-label d-block">Business Name</label>
                    <InputText id="search" placeholder=@_translationState.GetValue("Search") class="form-control search-text valid" @bind-Value="SearchForm.SearchText" />
                </EditForm>
            </div>
            <div class="me-4">
                <label class="form-label d-block">Sort By</label>
                <select class="form-select d-block" @onchange="OnSortByChangedEvent">
                    @foreach (var item in SelectSortByList)
                    {
                        <option value="@item.Value" selected="@(SortBy == item.Value)">@_translationState.GetValue(item.Name)</option>
                    }
                </select>
            </div>
        </div>
        <div class="button-container d-flex flex-row-reverse align-items-end">
            <AuthorizeView Policy="sbc-clients-canedit">
                <Authorized Context="ActivateAll">
                    <a href="javascript:void(0)" class="btn btn-create px-4" @onclick="OnCreateClientClickEvent">Create Client</a>
                    <a href="javascript:void(0)" class="btn btn-import px-4 me-2" @onclick="OnImportClientsClickEvent">Import using CSV</a>
                    <a href="/templates/client-import-template.csv" download class="btn btn-download-template px-4 me-2">Download CSV</a>
                    <a href="javascript:void(0)" class="btn btn-import px-4 me-2" @onclick="OnUpdateClientsClickEvent">Update via CSV</a>
                    <a href="javascript:void(0)" class="btn btn-download-template px-4 me-2" @onclick="OnExportClientsClickEvent">Export CSV</a>
                    <a href="javascript:void(0)" class="btn btn-download-template px-4" @onclick="OnViewUpdateHistoryClickEvent">Update History</a>
                </Authorized>
                <NotAuthorized Context="ActivateAll">
                    <a href="javascript:void(0)" class="btn btn-create px-4" disabled>Create Client</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>