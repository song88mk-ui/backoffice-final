@using Backoffice.Web.Components.Common;
<div class="modal-body">
    <div class="business-container">
        <div class="row">
            <div class="col-md-10">
                <h6 class="title fw-bold ps-2 py-1">Sub-User Information</h6>
            </div>
            <div class="col-md-2">
                @if (!IsEdit)
                {
                    <button type="button" class="btn btn-dark pull-right" @onclick="OnResetClickEvent">Reset</button>
                }
            </div>

            <div class="col-md-12">
                <form class="row g-3">
                    <div class="col-md-6">
                        <label for="inputUserName" class="form-label">Username</label>
                        <div class="input-group">
                            <span class="input-group-text" id="inputGroupPrepend3">@SubUserClaims.MainUserName</span>
                            @if (IsEdit)
                            {
                                <input type="text" class="form-control" id="inputUserName" @bind-value="SubUser.UserName" disabled>
                            }
                            else
                            {
                                <input type="text" class="form-control" id="inputUserName" @bind-value="SubUser.UserName">
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label for="inputName" class="form-label">Nickname</label>
                        <input type="text" class="form-control" id="inputName" placeholder="Enter Nickname" @bind-value="SubUser.NickName">
                    </div>

                    <div class="col-md-6">
                        <label for="inputPassword" class="form-label">Password</label>
                        <div class="input-group">
                            @if (IsTogglePassword)
                            {
                                <input type="text" class="form-control" id="inputPassword" placeholder="Enter your Password" @bind-value="SubUser.Password">
                            }
                            else
                            {
                                <input type="password" class="form-control" id="inputPassword" placeholder="Enter your Password" @bind-value="SubUser.Password">
                            }
                            <span class="input-group-text" @onclick="OnTogglePasswordClickEvent">
                                <i class="@(IsTogglePassword ? "fa fa-eye" : "fa fa-eye-slash")" id="togglePassword"></i>
                            </span>
                        </div>
                        <p class="fst-italic p-desc">Password must contain any character from A-Z or a-z with any digit from 0-9 and between 8 to 15 characters long</p>
                    </div>
                    @if (IsEdit == true)
                    {
                        <div class="col-md-6">
                            <div class="d-flex flex-column">
                                <div>
                                    <label for="selectStatus" class="form-label">Status</label>
                                </div>

                                <div class="btn-group border rounded" role="group" aria-label="Status Toggle Button Group">
                                    @if (SubUser.Status == "Normal")
                                    {
                                        <input type="radio" class="btn-check" name="statusRadio" id="normalRadio" autocomplete="off" @onchange="(e) => OnStatusNormalChangedEvent(e)" checked />
                                    }
                                    else
                                    {
                                        <input type="radio" class="btn-check" name="statusRadio" id="normalRadio" autocomplete="off" @onchange="(e) => OnStatusNormalChangedEvent(e)" />
                                    }
                                    <label class="btn btn-radio" for="normalRadio">Normal</label>
                                    @if (SubUser.Status == "Locked")
                                    {
                                        <input type="radio" class="btn-check" name="statusRadio" id="lockedRadio" autocomplete="off" @onchange="(e) => OnStatusLockedChangedEvent(e)" checked />
                                    }
                                    else
                                    {
                                        <input type="radio" class="btn-check" name="statusRadio" id="lockedRadio" autocomplete="off" @onchange="(e) => OnStatusLockedChangedEvent(e)" />
                                    }
                                    <label class="btn btn-radio" for="lockedRadio">Locked</label>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6"></div>
                    }

                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-12">
                                <h6 class="title fw-bold ps-2 py-1">Sub-User Preference</h6>
                            </div>
                            <div class="col-md-12">
                                &nbsp;
                            </div>

                            <div class="col-md-12 preferenceCol">
                                @if (SubUserClaims != null && SubUserClaims.SubUserClaims.Any())
                                {
                                    for (int i = 0; i < SubUserClaims.SubUserClaims.Count; i++)
                                    {
                                        var x = i;

                                        <div class="preferenceCard noselect">
                                            <div class="form-check ">
                                                <label class="form-check-label" for="permisionTopLeagues@(x)">
                                                    @if (SubUserClaims.SubUserClaims[x].IsEnabled)
                                                    {
                                                        if (SubUserClaims.SubUserClaims[x].ClaimValue == "1")
                                                        {
                                                            <input class="form-check-input" type="checkbox" id="permisionTopLeagues@(x)" @onchange="(e) => OnSubUserPreferenceClicked(e, SubUserClaims.SubUserClaims[x], false)" checked>
                                                        }
                                                        else
                                                        {
                                                            <input class="form-check-input" type="checkbox" id="permisionTopLeagues@(x)" @onchange="(e) => OnSubUserPreferenceClicked(e, SubUserClaims.SubUserClaims[x], false)">
                                                        }

                                                    }
                                                    else
                                                    {
                                                        if (SubUserClaims.SubUserClaims[x].ClaimValue == "1")
                                                        {
                                                            <input class="form-check-input" type="checkbox" value="" id="permisionTopLeagues@(x)" checked disabled>
                                                        }
                                                        else
                                                        {
                                                            <input class="form-check-input" type="checkbox" value="" id="permisionTopLeagues@(x)" disabled>
                                                        }
                                                    }
                                                    @SubUserClaims.SubUserClaims[x].Name
                                                </label>
                                            </div>
                                        </div>

                                        @if (SubUserClaims.SubUserClaims[x].HasReadOnly)
                                        {
                                            <div class="preferenceCard noselect">
                                                <div class="form-check">
                                                    <label class="form-check-label" for="permisionTopLeagues@(x)-readonly">
                                                        @if (SubUserClaims.SubUserClaims[x].IsEnabled)
                                                        {
                                                            if (SubUserClaims.SubUserClaims[x].ClaimValue == "2")
                                                            {
                                                                <input class="form-check-input" type="checkbox" value="" id="permisionTopLeagues@(x)-readonly" @onchange="(e) => OnSubUserPreferenceClicked(e, SubUserClaims.SubUserClaims[x], true)" checked>
                                                            }
                                                            else
                                                            {
                                                                <input class="form-check-input" type="checkbox" value="" id="permisionTopLeagues@(x)-readonly" @onchange="(e) => OnSubUserPreferenceClicked(e, SubUserClaims.SubUserClaims[x], true)">
                                                            }
                                                        }
                                                        else
                                                        {
                                                            if (SubUserClaims.SubUserClaims[x].ClaimValue == "2")
                                                            {
                                                                <input class="form-check-input" type="checkbox" value="" id="permisionTopLeagues@(x)-readonly" checked disabled>
                                                            }
                                                            else
                                                            {
                                                                <input class="form-check-input" type="checkbox" value="" id="permisionTopLeagues@(x)-readonly" disabled>
                                                            }
                                                        }
                                                        @SubUserClaims.SubUserClaims[x].Name (Readonly)
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-12 modal-footer">
                        @if (Alerts != null && Alerts.Any())
                        {
                            <div class="col-md-8">
                                @foreach (var alert in Alerts)
                                {
                                    <AlertMessage AlertStatus="@alert.AlertStatus" AlertMessageStr="@alert.AltertMessage" Opacity="@alert.Opacity" />
                                }
                            </div>
                        }

                        <button type="button" class="btn modalBtn modalCancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent">Cancel</button>
                        <button type="button" class="btn modalBtn modalSave waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickEvent">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>