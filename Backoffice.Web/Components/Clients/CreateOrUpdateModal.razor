                                }
                                else
                                {
                                    <input type="radio" class="btn-check" name="currencyOptions" id="@currency" @onchange="() => OnCurrencyClicked(currency)" />
                                }
                                <label class="btn modalTab" for="@currency">@currency</label>
                            </div>
                        }
