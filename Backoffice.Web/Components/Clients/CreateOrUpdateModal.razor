    </EditForm>
</div>
<div class="modal-footer">
    @if (Alerts != null && Alerts.Any())
    {
        <div class="col-md-8">
            @foreach (var alert in Alerts)
            {
                <AlertMessage AlertStatus="@alert.AlertStatus" AlertMessageStr="@alert.AltertMessage" Opacity="@alert.Opacity" />
            }
        </div>
    }
    <button type="button" class="btn modalBtn modalCancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent">Cancel</button>
    <button type="button" class="btn modalBtn modalSave waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickEvent">Save</button>
</div>