                                    <label class="form-label" for="soccerMaxGameField">Max Per Game</label>
                                    <input type="text" class="form-control" id="soccerMaxGameField" @bind-value="SelectedBetSetting.BetSettingSoccer.MaxPerGame" />
                                </div>
                            </div>
                        </div>

