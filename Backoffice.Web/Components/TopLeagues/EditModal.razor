<div class="modal-body">
    <EditFilter ClientId="ClientId" SportId="SportId" OnInitCallback="OnInitCallback" />
    <table class="table table-hover table-borderless mt-4 @TableClass">
        <thead class="table-head">
            <tr>
                <th class="th-no">No.</th>
                <th class="th-segment">Segment</th>
                <th class="th-league">League</th>
                <th class="th-status">Status</th>
                <th class="th-action">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (NewTopLeagues != null && NewTopLeagues.Any())
            {
                foreach (var model in NewTopLeagues)
                {
                    if (model.LeagueId != 0)
                    {
                        <tr id="@($"name-{@model.SportId}-{@model.SegmentId}-{@model.LeagueId}")">
                            <td>@model.SortOrder</td>
                            <td>@model.SegmentName</td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn dropdown-toggle d-block w-100" data-bs-auto-close="outside" type="button" id="row-@model.SortOrder" data-bs-toggle="dropdown" aria-expanded="false" @onclick="() => OnDropdownClick(model.SortOrder)">
                                        @model.LeagueName
                                    </button>
                                    @if (SelectedRow == model.SortOrder)
                                    {
                                        <Select SportId="SportId" SportsTree="SportsTree" CurrentTopLeagues="CurrentTopLeagues" SelectedTopLeagues="model.LeagueId" RowCount="model.SortOrder" OnSelectedLeague="OnSelectedLeagueEvent" />
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="status-active py-1 px-4 rounded-pill">Active</span>
                            </td>
                            <td class="actions">
                                <a href="javascript:void(0);" class="me-2" @onclick="() => OnAddClickEvent(model.SortOrder)">
                                    <i class="fa fa-plus-square" aria-hidden="true"></i>
                                </a>
                                <a href="javascript:void(0);" class="me-2" @onclick="() => OnDeleteClickEvent(model)">
                                    <i class="fa fa-minus-square" aria-hidden="true"></i>
                                </a>
                                <a href="javascript:void(0);" class="drag-handle">
                                    <i class="fa fa-bars" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>@model.SortOrder</td>
                            <td></td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn dropdown-toggle d-block w-100" data-bs-auto-close="outside" type="button" id="Row-@model.SortOrder" data-bs-toggle="dropdown" aria-expanded="false" @onclick="() => OnDropdownClick(model.SortOrder)">
                                        @model.LeagueName
                                    </button>
                                    @if (SelectedRow == model.SortOrder)
                                    {
                                        <Select SportId="SportId" SportsTree="SportsTree" CurrentTopLeagues="CurrentTopLeagues" SelectedTopLeagues="model.LeagueId" RowCount="model.SortOrder" OnSelectedLeague="OnSelectedLeagueEvent" />
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="status-active py-1 px-4 rounded-pill">Active</span>
                            </td>
                            <td class="actions">
                                <a href="javascript:void(0);" class="me-2" @onclick="() => OnAddClickEvent(model.SortOrder)">
                                    <i class="fa fa-plus-square" aria-hidden="true"></i>
                                </a>
                                <a href="javascript:void(0);" class="me-2" @onclick="() => OnDeleteClickEvent(model)">
                                    <i class="fa fa-minus-square" aria-hidden="true"></i>
                                </a>
                                <a href="javascript:void(0);"  class="drag-handle">
                                    <i class="fa fa-bars" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
    @if (!string.IsNullOrEmpty(AlertMessage))
    {
        <div class="mt-3">
            <AlertMessage AlertMessageStr="@AlertMessage" AlertStatus="@(AlertStatus.ToString())" AlwaysShow="true" />
        </div>
    }
</div>
<div class="modal-footer mx-4 p-0 py-3 border-0">
    <button type="button" class="btn btn-cancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent">Cancel</button>
    <button type="button" class="btn btn-edit waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickEvent">Save</button>
</div>