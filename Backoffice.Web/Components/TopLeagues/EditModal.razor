<div class="modal-body">
    <EditFilter ClientId="ClientId" SportId="SportId" OnInitCallback="OnInitCallback" />
    <table class="table table-hover table-borderless mt-4 @TableClass">
        <thead class="table-head">
            <tr>
                <th class="th-no">No.</th>
                <th class="th-segment">Segment</th>
                <th class="th-league">League</th>
                <th class="th-status">Status</th>
                <th class="th-action">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (NewTopLeagues != null && NewTopLeagues.Any())
            {
                @for (int i = 0; i < NewTopLeagues.Count; i++)
                {
                    var index = i;
                    if (NewTopLeagues[index].LeagueId != 0)
                    {
                        <tr id="@($"name-{@NewTopLeagues[index].SportId}-{@NewTopLeagues[index].SegmentId}-{@NewTopLeagues[index].LeagueId}")">
                            <td>@NewTopLeagues[index].SortOrder</td>
                            <td>@NewTopLeagues[index].SegmentName</td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn dropdown-toggle d-block w-100" data-bs-auto-close="outside" type="button" id="Row@(index+1)" data-bs-toggle="dropdown" aria-expanded="false" @onclick="async () => await OnDropdownSelect(index)">
                                        @NewTopLeagues[index].LeagueName
                                    </button>
                                    <Select @key="@($"Key{index}")" SportId="@SportId" SportsTree="@SportsTree" CurrentTopLeagues="@CurrentTopLeagues" SelectedTopLeagues="@NewTopLeagues[index].LeagueId" RowCount="@(index+1)" OnSelectedLeague="OnSelectedLeagueEvent" />
                                </div>
                            </td>
                            <td>
                                @*@if (NewTopLeagues[index].Status == true)
                                {
                                    <span class="status-active py-1 px-4 rounded-pill">Active</span>
                                }
                                else
                                {
                                    <span class="status-inactive py-1 px-4 rounded-pill">Inactive</span>
                                }*@
                                <span class="status-active py-1 px-4 rounded-pill">Active</span>
                            </td>
                            <td class="actions">
                                <a href="javascript:void(0);" class="me-2" @onclick="async () => await OnAddRow(NewTopLeagues[index].SortOrder)">
                                    <i class="fa fa-plus-square" aria-hidden="true"></i>
                                </a>
                                <a href="javascript:void(0);" class="me-2" @onclick="async () => await OnDeleteRow(NewTopLeagues[index])">
                                    <i class="fa fa-minus-square" aria-hidden="true"></i>
                                </a>
                                <a href="javascript:void(0);" class="drag-handle">
                                    <i class="fa fa-bars" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>@NewTopLeagues[index].SortOrder</td>
                            <td></td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn dropdown-toggle d-block w-100" data-bs-auto-close="outside" type="button" id="Row@(index+1)" data-bs-toggle="dropdown" aria-expanded="false" @onclick="async () => await OnDropdownSelect(index)">
                                        @NewTopLeagues[index].LeagueName
                                    </button>
                                    <Select @key="@($"Key{index}")" SportId="@SportId" SportsTree="@SportsTree" CurrentTopLeagues="@CurrentTopLeagues" SelectedTopLeagues="@NewTopLeagues[index].LeagueId" RowCount="@(index+1)" OnSelectedLeague="OnSelectedLeagueEvent" />
                                </div>
                            </td>
                            <td>
                                <span class="status-active py-1 px-4 rounded-pill">Active</span>
                            </td>
                            <td class="actions">
                                <a href="javascript:void(0);" class="me-2" @onclick="async () => await OnAddRow(NewTopLeagues[index].SortOrder)">
                                    <i class="fa fa-plus-square" aria-hidden="true"></i>
                                </a>
                                <a href="javascript:void(0);" class="me-2" @onclick="async () => await OnDeleteRow(NewTopLeagues[index])">
                                    <i class="fa fa-minus-square" aria-hidden="true"></i>
                                </a>
                                <a href="javascript:void(0);"  class="drag-handle">
                                    <i class="fa fa-bars" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>

    </table>
</div>
<div class="modal-footer mx-4 p-0 py-3 border-0">
    <button type="button" class="btn btn-cancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent">Cancel</button>
    <button type="button" class="btn btn-edit waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickEvent">Save</button>
</div>