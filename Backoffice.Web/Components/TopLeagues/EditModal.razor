<div class="modal-body">

    <EditFilter ClientId="ClientId" SportId="SportId" OnInitCallback="OnInitCallback" />

    <table class="table editModalTbl">
        <thead class="editModalThead">
            <tr>
                <th scope="col">No.</th>
                <th scope="col">Segment</th>
                <th scope="col">League</th>
                <th scope="col">Status</th>
                <th scope="col">Action</th>
            </tr>
        </thead>

        <tbody>
            @if (NewTopLeagues != null && NewTopLeagues.Any())
            {
                @for (int i = 0; i < NewTopLeagues.Count; i++)
                {
                    var index = i;
                    if (NewTopLeagues[index].LeagueId != 0)
                    {
                        <tr>
                            <td>@NewTopLeagues[index].SortOrder</td>
                            <td>@NewTopLeagues[index].SegmentName</td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn dropdown-toggle" data-bs-auto-close="outside" type="button" id="Row@(index+1)"
                                data-bs-toggle="dropdown" aria-expanded="false" @onclick="async () => await OnDropdownSelect(index)">
                                        @NewTopLeagues[index].LeagueName
                                    </button>
                                    <Select @key="@($"Key{index}")" SportId="@SportId" SportsTree="@SportsTree" CurrentTopLeagues="@CurrentTopLeagues" SelectedTopLeagues="@NewTopLeagues[index].LeagueId" RowCount="@(index+1)" OnSelectedLeague="OnSelectedLeagueEvent" />
                                </div>
                            </td>
                            <td>@NewTopLeagues[index].Status</td>
                            <td class="actions">
                                <span><a @onclick="async () => await OnAddRow(NewTopLeagues[index].SortOrder)"><i class="fa fa-plus-square" aria-hidden="true"></i></a></span>
                                <span><a @onclick="async () => await OnDeleteRow(NewTopLeagues[index])"><i class="fa fa-minus-square" aria-hidden="true"></i></a></span>
                                <span><a href="#"><i class="fa fa-bars" aria-hidden="true"></i></a></span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td>@NewTopLeagues[index].SortOrder</td>
                            <td></td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn dropdown-toggle" data-bs-auto-close="outside" type="button" id="Row@(index+1)"
                                data-bs-toggle="dropdown" aria-expanded="false" @onclick="async () => await OnDropdownSelect(index)">
                                        @NewTopLeagues[index].LeagueName
                                    </button>
                                    <Select @key="@($"Key{index}")" SportId="@SportId" SportsTree="@SportsTree" CurrentTopLeagues="@CurrentTopLeagues" SelectedTopLeagues="@NewTopLeagues[index].LeagueId" RowCount="@(index+1)" OnSelectedLeague="OnSelectedLeagueEvent" />
                                </div>
                            </td>
                            <td></td>
                            <td class="actions">
                                <span><a @onclick="async () => await OnAddRow(NewTopLeagues[index].SortOrder)"><i class="fa fa-plus-square" aria-hidden="true"></i></a></span>
                                <span><a @onclick="async () => await OnDeleteRow(NewTopLeagues[index])"><i class="fa fa-minus-square" aria-hidden="true"></i></a></span>
                                <span><a href="#"><i class="fa fa-bars" aria-hidden="true"></i></a></span>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>

    </table>
</div>
<div class="modal-footer">
    <button type="button" class="btn editModalBtn editModalCancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent">Cancel</button>
    <button type="button" class="btn editModalBtn editModalSave waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickEvent">Save</button>
</div>