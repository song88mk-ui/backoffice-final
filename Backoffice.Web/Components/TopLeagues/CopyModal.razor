@using Backoffice.Web.Components;

<EditForm Model="@CopyTopLeaguesModel" OnValidSubmit="OnSaveClickEvent">
    <div class="modal-body">
        <div class="row">
            <div class="col-md-12 mb-4">
                <div class="d-flex justify-content-between">
                    <div class="select-container">
                        <div class="me-4">
                            <label class="form-label my-1 mr-2">Clients</label>
                            <div class="dropdown">
                                <button class="btn btn-client dropdown-toggle" type="button" id="client-dropdown" data-bs-auto-close="outside" data- data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (Clients.Any())
                                    {
                                        <span>@(SelectedClientCount == 1 ? SelectedClientName : $"Clients ({SelectedClientCount})")</span>
                                    }
                                    else
                                    {
                                        <span>No Clients Available</span>
                                    }
                                </button>
                                @if (Clients.Any())
                                {
                                    <SelectWithCheckbox Items="Clients" AriaLabel="client-dropdown" OnCheckboxCallback="OnClientCheckboxClickEvent" />
                                }
                                @*<ul class="dropdown-menu" aria-labelledby="clientDropdown">
                                    <li class="dropdown-item">
                                        <div class="form-check">
                                            <InputCheckbox class="form-check-input" @bind-Value="@IsSelectAll" @onclick="_ => SelectAllToggleCheckbox(!IsSelectAll)" />
                                            <label class="form-check-label" for="ClientAll">Select All</label>
                                        </div>
                                    </li>

                                    @if (CopyTopLeaguesModel.ClientIdSelectedModel.Any())
                                    {
                                        @foreach (var item in CopyTopLeaguesModel.ClientIdSelectedModel)
                                        {
                                            <li class="dropdown-item">
                                                <div class="form-check">
                                                    <InputCheckbox class="form-check-input" @bind-Value="@item.IsSelected" @onclick="_ => ToggleCheckbox(item.ClientId)" />
                                                    <label class="form-check-label" for="Client1">@item.ClientName</label>
                                                </div>
                                            </li>
                                        }
                                    }
                                </ul>*@
                            </div>
                        </div>
                    </div>
                    <div class="input-container d-flex align-items-end">
                        <div class="client d-flex flex-wrap w-100 border border-2 rounded p-2">
                            @foreach (var item in CopyTopLeaguesModel.ClientIdSelectedModel.Where(x => x.IsSelected))
                            {
                                <div class="mx-2 mb-2 p-2 client-border">
                                    @item.ClientName
                                    <span>
                                        <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="_ => RemoveClient(item.ClientId)"></button>
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(ClientIdErrorMessage))
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="alert alert-danger" role="alert">
                        @ClientIdErrorMessage
                    </div>
                </div>
            </div>
        }
        <div class="row">
            <div class="col-md-12">
                <label class="form-label my-1 mr-2">Leagues</label>
                <div class="d-flex flex-wrap p-3 league-container">
                    @foreach (var item in CopyTopLeaguesModel.CopyFromClientTopLeagues)
                    {
                        <div class="mx-2 mb-2 p-2 client-border">
                            @item.SegmentName > @item.LeagueName
                            @*<span><button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="_ => RemoveLeague(item.LeagueId)"></button></span>*@                        
                        </div>
                    }
                </div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(AlertMessage))
        {
            <br/>
            <div class="alert @AlertStatus" role="alert">
                @AlertMessage
            </div>
        }
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-cancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent">Cancel</button>
        <button type="button" class="btn btn-edit waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickEvent">Save</button>
    </div>
</EditForm>
