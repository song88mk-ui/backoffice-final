<div class="content-filter mx-3">
    <form>
        <div class="row">
            <div class="col-md-3">
                <div class="row">
                    <div class="col">
                        <label class="my-1 mr-2">Client</label>
                        @if (Clients.Any())
                        {
                            <select class="form-select my-1 mr-sm-2" @onchange="OnClientChangedEvent">
                                <option value="" selected>Choose client...</option>
                                @foreach (var item in Clients)
                                {
                                    if (item.Value == TopLeaguesFilterModel.ClientId)
                                    {
                                        <option value="@item.Value" selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Name</option>
                                    }
                                }
                            </select>
                        }
                    </div>
                    <div class="col">
                        <label class="my-1 mr-2">Sports</label>
                        @if (Sports.Any())
                        {
                            <select class="form-select my-1 mr-sm-2" @onchange="OnSportsChangedEvent">
                                <option value="" selected>Choose sport...</option>
                                @foreach (var item in Sports)
                                {
                                    if (item.Value == TopLeaguesFilterModel.SportId)
                                    {
                                        <option value="@item.Value" selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Name</option>
                                    }
                                }
                            </select>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-9 search-content">
                <div class="pull-right">
                    <div class="right-icon-control">
                        <EditForm Model="SearchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
                            <InputText id="search" placeholder="Search" class="form-control search-text valid" @bind-Value="SearchForm.SearchText" />
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>