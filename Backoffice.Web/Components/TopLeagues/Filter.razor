                    }
                </div>*@
                <div class="dropdown">
                    <button class="btn form-select dropdown-toggle" type="button" id="client-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        @if (Clients.Any())
                        {
                            <span>@(SelectedClientCount == 1 ? SelectedClientName : $"Clients ({SelectedClientCount})")</span>
                        }
                        else
                        {
                            <span>No Clients Available</span>
                        }
                    </button>
                    @if (Clients.Any())
                    {
                        <SelectWithCheckbox Items="Clients" OnCheckboxCallback="OnClientCheckboxClickEvent" AriaLabel="client-dropdown" />
                    }
                </div>
            </div>
            <div class="me-4 w-50">
                <label class="form-label d-block">Sports</label>
                <select class="form-select d-block" @onchange="OnSportsChangedEvent">
                    @foreach (var item in Sports)
                    {
                        if (item.Value == SelectedSportId)
                        {
                            <option value="@item.Value" selected>@item.Name</option>
                        }
                        else
                        {
                            <option value="@item.Value">@item.Name</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="input-container d-flex flex-row-reverse align-items-end">
            <div>
                <EditForm Model="SearchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
                    <div class="input-group">
                        <InputText id="search" placeholder="Search" class="form-control search-text valid border-end-0" @bind-Value="SearchForm.SearchText" />
                        <span class="input-group-text border-start-0">
                            <i class="fa fa-search"></i>
                        </span>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
