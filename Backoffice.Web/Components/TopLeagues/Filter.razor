@using Backoffice.Web.Components.Common

<div class="content-filter mx-3">
    <div class="d-flex flex-row justify-content-between">
        <div class="select-container d-flex">
            <div class="me-4 w-50">
                <label class="form-label d-block">Client</label>
                @*<div class="dropdown">
                    <button type="button" id="client-dropdown" data-bs-toggle="dropdown" aria-expanded="false" class="btn form-select @(ShowSelectClient ? "client-focus" : "") dropdown-toggle client-select d-block" @onclick="OnClientClickEvent">
