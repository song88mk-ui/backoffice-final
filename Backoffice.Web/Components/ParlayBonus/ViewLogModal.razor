<div class="modal-body logModal">
    <div class="row">
        <div class="col">
            <table class="table">
                <thead class="">
                    <tr>
                        <th scope="col">Last Updated</th>
                        <th scope="col">Bonus</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var history in ParlayBonusConfig.ParlayBonusHistory)
                    {
                        <tr>
                            <td>
                                @history.LastUpdate
                            </td>
                            <td class="fw-bold">
                                @($"{(history.ParlayBonus * 100).ToString("#.00")}%")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn closeModalCancel waves-effect" data-bs-dismiss="modal" @onclick="OnCloseClickEvent">Close</button>
</div>