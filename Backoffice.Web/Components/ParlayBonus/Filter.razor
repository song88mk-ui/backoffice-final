<div class="content-filter mx-3">
    <div class="w-100 d-flex flex-row justify-content-between">
        <div class="input-container d-flex">
            <div class="me-4">
                <label class="form-label d-block">Client</label>
                <div class="dropdown">
                    <button class="btn clientBtn dropdown-toggle" type="button" id="clientDropdown" data-bs-auto-close="outside" data- data-bs-toggle="dropdown" aria-expanded="false">@selectedClientsCount</button>

                    <ul class="dropdown-menu" aria-labelledby="clientDropdown">
                        <li class="dropdown-item">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="All" id="ClientAll" />
                                <label class="form-check-label" for="ClientAll">Select All</label>
                            </div>
                        </li>

                        @foreach (var client in UserModel.ClientCodes)
                        {
                            <li class="dropdown-item">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="@client" id="@client" />
                                    <label class="form-check-label" for="@client">@client</label>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="odds-container d-flex justify-content-center align-self-end">
                <div class="min-odds-text border-end-0 px-4 rounded-start">Minimum Odds Per Selection</div>
                <div class="border-start-0 rounded-end">
                    <span class="min-odds ms-5 me-4">@ClientParlayBonusResponse.ParlayBonusMinOdds</span>
                    <i class="fa fa-info-circle me-2"></i>
                </div>
            </div>
        </div>
        <div class="button-container d-flex flex-row-reverse align-items-end">
            <!-- Update -->
            <a href="javascript:void(0)" class="btn btn-update px-4">Update</a>
            <!-- Update and Save-->
            @*<a href="javascript:void(0)" class="btn btn-save px-4">Save</a>
            <a href="javascript:void(0)" class="btn btn-cancel px-4 me-2">Cancel</a>*@
        </div>
    </div>
</div>