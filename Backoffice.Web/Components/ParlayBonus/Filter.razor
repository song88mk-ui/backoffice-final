<div class="content-filter mx-3">
    <div class="w-100 d-flex flex-row justify-content-between">
        <div class="input-container d-flex">
            <div class="me-4">
                <label class="form-label d-block">Client</label>
                @if (Clients.Any())
                {
                    <select class="form-control form-select my-1 mr-sm-2" @onchange="OnClientChangedEvent">
                        @foreach (var item in Clients)
                        {
                            if (item.Value.ClientId.ToString() == ClientId)
                            {
                                <option value="@item.Value.ClientId" selected>@item.Name</option>
                            }
                            else
                            {
                                <option value="@item.Value.ClientId">@item.Name</option>
                            }
                        }
                    </select>
                }
            </div>
            <div class="odds-container d-flex justify-content-center align-self-end">                
                <div class="input-group border-0">
                    <span class="input-group-text min-odds-text">Minimum Odds Per Selection</span>
                    @if (IsUpdating)
                    {
                        <input type="number" @bind="@ClientParlayBonusResponse.ParlayBonusMinOdds" @bind:event="oninput" class="form-control pe-5 min-odds-input text-center" />
                    }
                    else
                    {
                        <input type="number" @bind="@ClientParlayBonusResponse.ParlayBonusMinOdds" @bind:event="oninput" class="form-control pe-5 min-odds-input text-center" disabled />
                    }
                    <span class="tooltip2 fa fa-info-circle me-2">
                        <span class="tooltiptext">Minimum Value: 1.20</span>
                    </span>
                </div>
            </div>
        </div>
        <div class="button-container d-flex align-items-end">
            <!-- Update -->
            @if (IsUpdating)
            {
                <button type="button" class="btn btn-cancel px-4 me-2" @onclick="OnCancelClickEvent">Cancel</button>
                <button type="button" class="btn btn-save px-4 me-2" @onclick="OnSaveClickEvent">Save Changes</button>

                @if (ClientParlayBonusResponse.ParlayBonusConfig.Any())
                {
                    @if (ClientParlayBonusResponse.ParlayBonusConfig.Last().ParlayBonus == 0 || ClientParlayBonusResponse.ParlayBonusConfig.Count >= 50)
                    {
                        <button type="button" class="btn btn-add px-4 me-2" @onclick="OnAddClickEvent" disabled>Add</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-add px-4 me-2" @onclick="OnAddClickEvent">Add</button>                        
                    }
                }
                else
                {
                    <button type="button" class="btn btn-add px-4 me-2" @onclick="OnAddClickEvent">Add</button>
                }
            }
            else
            {
                @if (ClientId != "0")
                {
                    <button type="button" class="btn btn-update px-4" @onclick="OnUpdateClickEvent">Update</button>
                }
                else
                {
                    <button type="button" class="btn btn-update px-4" @onclick="OnUpdateClickEvent" disabled>Update</button>
                }
                @*if (!string.IsNullOrEmpty(ClientId) || ClientId != "0")
                {
                    <button type="button" class="btn btn-update px-4" @onclick="OnUpdateClickEvent">Update</button>
                }
                else
                {
                    <button type="button" class="btn btn-update px-4" @onclick="OnUpdateClickEvent" disabled>Update</button>
                }*@
            }
        </div>
    </div>
</div>