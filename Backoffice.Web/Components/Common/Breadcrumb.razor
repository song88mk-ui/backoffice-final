<div class="d-flex mb-2 mt-3">
    <a href="odds-engine" class="me-1">
        <i class="fa fa-home"></i>
    </a>
    @if (Breadcrumbs.Any())
    {
        foreach (var model in Breadcrumbs)
        {
            <span class="me-1">
                <i class="fa fa-chevron-right"></i>
            </span>
            if (!string.IsNullOrEmpty(model.Url))
            {
                <a href="@model.Url" class="me-1 text-decoration-none @(model.IsCurrentPage ? "link-page" : string.Empty)">
                    @model.Name
                </a>
            }
            else
            {
                <span class="me-1">
                    @model.Name
                </span>
            }
        }

    }
</div>