@*<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 11">*@
    <div class="toast @ClassName" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <img src="icons/svg/song88-login-logo.svg" class="rounded me-2" alt="...">
            <strong class="me-auto">@ToastTitle</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            @if (IsMessageMarkup)
            {
                @((MarkupString)ToastMessage)
            }
            else
            {
                @ToastMessage
            }
        </div>
    </div>
@*</div>*@

@code {
    [Parameter] public string ClassName { get; set; }
    [Parameter] public string ToastTitle { get; set; }
    [Parameter] public string ToastMessage { get; set; }
    [Parameter] public bool IsMessageMarkup { get; set; } = false;
}