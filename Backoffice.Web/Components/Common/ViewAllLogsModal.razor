@using Backoffice.Shared.Enums

<div class="modal-body">
    <ViewAllLogsFilter @bind-FilterModel="_priceBoostLogFilterModel" SelectedPage="CurrentPage" OnFilterChangedEventCallback="OnFilterChanged" />
    @if (_isPreLoader)
    {
        <Preloader />
    }
    else
    {
        @if (CurrentPage == SportsbookClientPermission.SBC_OE_PriceBoost_Settings)
        {
            @if (_boostedSettingsActivityLogs != null)
            {
                <table class="table table-bordered mt-3">
                    <thead>
                        <tr>
                            <th valign="middle" align="left"><strong>#</strong></th>
                            <th valign="middle" align="left"><strong>@TranslationState.GetValue("Date")</strong></th>
                            <th valign="middle" align="left"><strong>@TranslationState.GetValue("Client name")</strong></th>
                            <th valign="middle" align="left"><strong>@TranslationState.GetValue("Activity")</strong></th>
                            <th valign="middle" align="left"><strong>@TranslationState.GetValue("From")</strong></th>
                            <th valign="middle" align="left"><strong>@TranslationState.GetValue("To")</strong></th>
                            <th valign="middle" align="left"><strong>@TranslationState.GetValue("Updated By")</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <Virtualize Items="_boostedSettingsActivityLogs" Context="activityLog">
                            <tr>
                                <td>@GetRowNumber(_boostedSettingsActivityLogs.IndexOf(activityLog))</td>
                                <td>@activityLog.TimeStamp.ToLocalTime().ToString("dd/MM/yy\nHH:mm")</td>
                                <td>@activityLog.Payload</td>
                                <td>@activityLog.Activity</td>
                                <td>@((MarkupString)activityLog.From)</td>
                                <td>@((MarkupString)activityLog.To)</td>
                                <td>@activityLog.UserName</td>
                            </tr>
                        </Virtualize>
                    </tbody>
                    <Pagination MetaData="_metaData" Spread="3" SelectPageEvent="SelectPage" PaginationColspan="7" />
                </table>
            }
            else
            {
                <NoRecordFound />
            }
        }
        @if (CurrentPage == SportsbookClientPermission.SBC_OE_PriceBoost_Manage)
        {
            @if (_priceBoostActivityLogs != null)
            {
                @if (_priceBoostActivityLogs.Any())
                {
                    <table class="table table-bordered mt-3">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Date</th>
                                <th scope="col">@TranslationState.GetValue("Client name")</th>
                                <th scope="col">@TranslationState.GetValue("Sports")</th>
                                <th scope="col">@TranslationState.GetValue("Details")</th>
                                <th scope="col">@TranslationState.GetValue("Activity")</th>
                                <th scope="col">@TranslationState.GetValue("From")</th>
                                <th scope="col">@TranslationState.GetValue("To")</th>
                                <th scope="col">@TranslationState.GetValue("Updated By")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize Items="_priceBoostActivityLogs" Context="activityLog">
                                <tr>
                                    <td>@GetRowNumber(_priceBoostActivityLogs.IndexOf(activityLog))</td>
                                    <td>@activityLog.TimeStamp.ToLocalTime().ToString("dd/MM/yy\nHH:mm")</td>
                                    <td>@GetClientName(activityLog.Payload)</td>
                                    <td>@GetSportName(activityLog)</td>
                                    <td>@((MarkupString)GetDetails(activityLog))</td>
                                    <td>@activityLog.Activity</td>
                                    <td>@((MarkupString)activityLog.From.HtmlDetail)</td>
                                    <td>@((MarkupString)activityLog.To.HtmlDetail)</td>
                                    <td>@activityLog.Username</td>
                                </tr>
                            </Virtualize>
                        </tbody>
                        <Pagination MetaData="_metaData" Spread="3" SelectPageEvent="SelectPage" PaginationColspan="7" />
                    </table>
                }
                else
                {
                    <NoRecordFound />
                }
            }
            else
            {
                <NoRecordFound />
            }
        }
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn modal-cancel" @onclick="OnCancelModalClick">@TranslationState.GetValue("Close")</button>
</div>