<div class="modal-body">
    <div class="d-flex flex-column justify-content-center p-5">
        <div class="text-center">@_translationState.GetValue("Are you sure you want to logout?")</div>
    </div>
</div>
<div class="modal-footer mx-4 justify-content-around">
    <button type="button" class="btn modal-btn btn-cancel" @onclick="OnCancelModalClickEvent">@_translationState.GetValue("Cancel")</button>
    <a class="btn modal-btn btn-logout" href="/logout">@_translationState.GetValue("Logout")</a>
</div>