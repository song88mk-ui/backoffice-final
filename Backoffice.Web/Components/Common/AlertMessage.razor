@using Backoffice.Web.Models;
@if (!string.IsNullOrEmpty(AlertStatus) && !string.IsNullOrEmpty(AlertMessageStr) && Opacity > 0)
{
    <div>
        <div class=@($"alert {(AlertStatus.Contains("Success") ? "alert-success" : AlertStatus.Contains("Error") || AlertStatus.Contains("Danger") ? "alert-danger" : "alert-primary")} text-left") role="alert" style="@(Opacity == 0 ? $"display: none; opacity: {Opacity}" : $"display: block; opacity: {Opacity}")">
            @AlertMessageStr
        </div>
    </div>

}


@code {
    [Parameter] public decimal Opacity { get; set; }
    [Parameter] public EventCallback<decimal> OpacityChanged { get; set; }
    [Parameter] public string AlertStatus { get; set; }
    [Parameter] public string AlertMessageStr { get; set; }
    [Parameter] public bool AlwaysShow { get; set; } = false;    
    [Parameter] public Guid Guid { get; set; }

    #region Methods
    protected override async Task OnParametersSetAsync()
    {
        if (!AlwaysShow)
        {
            if (Opacity > 0m)
            {
                while (Opacity >= 0m)
                {
                    if (Opacity > 0.9m)
                    {
                        Opacity -= 0.5m;
                        await Task.Delay(20);
                    }
                    else
                    {
                        Opacity -= 1;
                        //await Task.Delay(10);
                    }

                    StateHasChanged();
                }
                Opacity = 0.0m;
                AlertMessageStr = string.Empty;
                await OpacityChanged.InvokeAsync(Opacity);
            }
        }
        else
        {
            Opacity = 1.00m;
        }
    }

    public void Dispose()
    {

    }

    #endregion
}