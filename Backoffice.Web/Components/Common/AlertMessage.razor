@using Backoffice.Web.Models;
@if (AlertModel != null && !string.IsNullOrEmpty(AlertModel.Message) && AlertModel.Opacity > 0)
{
    <div class="@AlertClass">
        <div class="alert @_alertClass text-left" role="alert" style="@(AlertModel.Opacity == 0 ? $"display: none;" : $"display: block;") opacity: {AlertModel.Opacity}">
            @if (IsHtmlMessage)
            {
                @((MarkupString)(TranslationState.GetValue(AlertModel.Message)))
            }
            else
            {
                @TranslationState.GetValue(AlertModel.Message)
            }
        </div>
    </div>
}


@code {
    [Parameter] public EventCallback<decimal> OpacityChanged { get; set; }
    [Parameter] public AlertModel AlertModel { get; set; } = new();
    [Parameter] public Guid Guid { get; set; }
    [Parameter] public bool IsHtmlMessage { get; set; } = false;
    [Parameter] public string AlertClass { get; set; } = "";

    private string _alertClass = "";

    #region Methods
    protected override async Task OnParametersSetAsync()
    {
        if (AlertModel != null)
        {
            switch (AlertModel.Status)
            {
                case AlertStatus.Success:
                    _alertClass = "alert-success";
                    break;
                case AlertStatus.Error:
                    _alertClass = "alert-danger";
                    break;
                default:
                    _alertClass = "alert-primary";
                    break;
            }

            if (AlertModel.Opacity > 1)
                AlertModel.Opacity = 1;

            if (!AlertModel.IsAlwaysShown)
            {
                if (AlertModel.Opacity > 0m)
                {
                    while (AlertModel.Opacity >= 0m)
                    {
                        if (AlertModel.Opacity > 0.8m)
                        {
                            AlertModel.Opacity -= 0.05m;
                            await InvokeAsync(StateHasChanged);
                            await Task.Delay(1000);
                        }
                        else
                        {
                            AlertModel.Opacity -= 0.05m;
                            await InvokeAsync(StateHasChanged);
                            await Task.Delay(100);
                        }
                    }
                    AlertModel.Opacity = 0.0m;
                    AlertModel.Message = string.Empty;
                    await OpacityChanged.InvokeAsync(AlertModel.Opacity);
                }

                AlertModel.Opacity = 0.0m;
                AlertModel.Message = string.Empty;
            }
            else
            {
                AlertModel.Opacity = 1.00m;
            }
            await OpacityChanged.InvokeAsync(AlertModel.Opacity);
        }
    }

    public async void Dispose()
    {
    }
    #endregion
}