@using Backoffice.Web.Models;
@if (!string.IsNullOrEmpty(AlertModel.Status) && !string.IsNullOrEmpty(AlertModel.Message) && AlertModel.Opacity > 0)
{
    <div>
        <div class=@($"alert {(AlertModel.Status.Contains("Success") ? "alert-success" : AlertModel.Status.Contains("Error") || AlertModel.Status.Contains("Danger") ? "alert-danger" : "alert-primary")} text-left") role="alert" style="@(AlertModel.Opacity == 0 ? $"display: none; opacity: {AlertModel.Opacity}" : $"display: block; opacity: {AlertModel.Opacity}")">
            @if (IsHtmlMessage)
            {
                @((MarkupString)AlertModel.Message)
            }
            else
            {
                @AlertModel.Message
            }
        </div>
    </div>

}


@code {
    [Parameter] public EventCallback<decimal> OpacityChanged { get; set; }
    [Parameter] public AlertModel AlertModel { get; set; }
    [Parameter] public Guid Guid { get; set; }
    [Parameter] public bool IsHtmlMessage { get; set; } = false;

    #region Methods
    protected override async Task OnParametersSetAsync()
    {
        if(AlertModel != null)
        {
            if (AlertModel.Opacity > 1)
                AlertModel.Opacity = 1;

            if (!AlertModel.IsAlwaysShown)
            {
                if (AlertModel.Opacity > 0m)
                {
                    while (AlertModel.Opacity >= 0m)
                    {
                        if (AlertModel.Opacity > 0.9m)
                        {
                            AlertModel.Opacity -= 0.05m;
                            await Task.Delay(2000);
                        }
                        else
                        {
                            AlertModel.Opacity -= 0.03m;
                            await Task.Delay(10);
                        }

                    await InvokeAsync(StateHasChanged);
                }
                Opacity = 0.0m;
                AlertMessageStr = string.Empty;
                await OpacityChanged.InvokeAsync(Opacity);
            }
        }
        else
        {
            Opacity = 1.00m;
                        StateHasChanged();
                    }
                    AlertModel.Opacity = 0.0m;
                    AlertModel.Message = string.Empty;
                    await OpacityChanged.InvokeAsync(AlertModel.Opacity);
                }
            }
            else
            {
                AlertModel.Opacity = 1.00m;
            }
        }
    }

    public void Dispose()
    {

    }

    #endregion
}