@if (HasClientConfig)
{
    <div @attributes="SpanAttributes" class="odds-container @_color me-2 py-1">
        <span class="d-block text-center">@GetClientOdds()</span>
    </div>
}
else
{
    <div @attributes="SpanAttributes" class="odds-container me-2 py-1">
        <span class="d-block text-center">-.-</span>
    </div>
}