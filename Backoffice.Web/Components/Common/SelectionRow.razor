@if (HasClientConfig)
{
    <CallbackOnCssAnimationEnd OnCssAnimationCompleted="OnCompleted">
        <div class="odds-container @GetClientColor() me-2 py-1 px-3">
            @(GetClientOdds())
        </div>
    </CallbackOnCssAnimationEnd>
}
else
{
    <CallbackOnCssAnimationEnd OnCssAnimationCompleted="OnCompleted">
        <div class="odds-container me-2 py-1 px-3">-.-</div>
    </CallbackOnCssAnimationEnd>
}