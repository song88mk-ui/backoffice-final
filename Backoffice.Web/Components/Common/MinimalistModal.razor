<div class="modal @_modalClass modal-z-index" tabindex="-1" role="dialog" style="display:@_modalDisplay;">
    <div class="modal-dialog @_modalDialogClass" role="document" style="@_modalDialogStyle">
        <div class="modal-content">
            <div class="modal-header py-4 mx-4 @_modalHeaderClass">
				<img src="icons/svg/warning-icon-2.svg" />
                <button type="button" class="btn-close" @onclick="_ => Close()" />
            </div>
            <CascadingValue Value="this">
                <CascadingValue Value="@ModalParameters">
                    @ModalContent
                </CascadingValue>
            </CascadingValue>
            <div class="modal-footer">
                <button type="button" class="btn modal-btn modal-close">@_translationState.GetValue("Cancel")</button>
                <button type="button" class="btn modal-btn modal-apply">@_translationState.GetValue("Confirm")</button>
            </div>
        </div>
    </div>
</div>

@if (_showBackdrop)
{
    <div class="modal-backdrop fade show"></div>
}
