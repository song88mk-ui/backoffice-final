<ul class="dropdown-menu w-100" aria-labelledby="@AriaLabel">
    @if (Items != null && Items.Any())
    {
        foreach (var item in Items)
        {
            <li id="@item.Value">
                <div class="form-check ms-2">
                    <input type="checkbox" class="form-check-input" @onclick="() => CheckboxClicked(item)" checked="@item.IsChecked" disabled="@IsReadOnly"/>
                    <label class="form-check-label">@_translationState.GetValue(item.Name)</label>
                </div>
            </li>
        }
    }
</ul>