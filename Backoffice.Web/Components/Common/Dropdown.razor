<div class="dropdown @DropdownClass">
    @if(Multiple)
    {
        <button class="btn form-select dropdown-toggle" type="button" id="client-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
            @if (_items.Any())
            {
                if (_items.Count - 1 == _selectedCount)
                {
                    <span>@TranslationState.GetValue($"All {DropdownName}") (@_selectedCount)</span>
                }
                else
                {
                    <span>@(_selectedCount == 1 ? _selectedName : $"{TranslationState.GetValue(DropdownName)} ({_selectedCount})")</span>
                }
            }
            else
            {
                <span>@TranslationState.GetValue($"No {DropdownName} Available")</span>
            }
        </button>
        @if (_items.Any())
        {
            <SelectWithCheckbox Items="_items" OnCheckboxCallback="OnCheckboxClickEvent" AriaLabel="client-dropdown" />
        }
    }
    else
    {
        <button class="btn btn-secondary @(_items.Any() ? "dropdown-toggle" : "") d-flex align-items-center" type="button" id="dropdownLanguage" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="d-flex">
                <i class="@($"ico-flag flag-{_selectedName.ToString().ToLower()}") me-2" aria-hidden="true"></i>
                <span>@_selectedName</span>
            </span>
        </button>
        <ul class="dropdown-menu" aria-labelledby="dropdownLanguage">
            @foreach (var item in _items)
            {
                <button class="w-100 dropdown-item position-relative d-flex align-items-center" @onclick="() => OnCheckboxChangedEvent(item)">
                    <span class="d-flex">
                        @if (!string.IsNullOrEmpty(ImageClass))
                        {
                            <i class="@($"{ImageClass}{item.Name.ToLower()}") me-2" aria-hidden="true" />
                        }
                        @item.Value
                    </span>
                </button>
            }
        </ul>

    }
</div>