@if (IsSubUser)
{
    if (Claim.Availability == 1)
    {
        <div class="form-switch mb-2">
            @if (Claim.Name.Contains("readonly", StringComparison.OrdinalIgnoreCase) && Claim.ClaimValue == "2")
            {
                <input class="form-check-input me-4" type="checkbox" value="" id="@Claim.ClaimType" checked disabled="@IsReadOnly">
            }
            else if (Claim.ClaimValue == "1")
            {
                <input class="form-check-input me-4" type="checkbox" value="" id="@Claim.ClaimType" checked @onchange="(e) => OnCheckboxClicked(e, false)" disabled="@IsReadOnly">
            }
            else
            {
                <input class="form-check-input me-4" type="checkbox" value="" id="@Claim.ClaimType" @onchange="(e) => OnCheckboxClicked(e, false)" disabled="@IsReadOnly">
            }
            <label class="form-check-label" for="@Claim.ClaimType">@TranslationState.GetValue(Claim.Name)</label>

        </div>
    }
    @if (Claim.HasReadOnly)
    {
        if (Claim.Availability == 2)
        {
            <div class="form-switch mb-2">
                @if (Claim.ClaimValue == "2")
                {
                    <input class="form-check-input me-4" type="checkbox" value="" id="@(Claim.ClaimType)-readonly" checked="@(Claim.ClaimValue == "2")" @onchange="(e) => OnCheckboxClicked(e, true)" disabled="@IsReadOnly">
                    <label class="form-check-label" for="@(Claim.ClaimType)-readonly">@TranslationState.GetValue(Claim.Name) (Readonly)</label>
                }
                else
                {
                    <input class="form-check-input me-4" type="checkbox" value="" id="@(Claim.ClaimType)-readonly" @onchange="(e) => OnCheckboxClicked(e, true)" disabled="@IsReadOnly">
                    <label class="form-check-label" for="@(Claim.ClaimType)-readonly">@TranslationState.GetValue(Claim.Name) (Readonly)</label>
                }
            </div>
        }
    }
}
else
{
    <div class="form-switch mb-2">
        @if (Claim.Name.Contains("readonly", StringComparison.OrdinalIgnoreCase) && Claim.ClaimValue == "2")
        {
            <input class="form-check-input me-4" type="checkbox" value="" id="@Claim.ClaimType" checked disabled="@IsReadOnly">
        }
        else if (Claim.ClaimValue == "1")
        {
            <input class="form-check-input me-4" type="checkbox" value="" id="@Claim.ClaimType" checked @onchange="(e) => OnCheckboxClicked(e, false)" disabled="@IsReadOnly">
        }
        else
        {
            <input class="form-check-input me-4" type="checkbox" value="" id="@Claim.ClaimType" @onchange="(e) => OnCheckboxClicked(e, false)" disabled="@IsReadOnly">
        }
        <label class="form-check-label" for="@Claim.ClaimType">@TranslationState.GetValue(Claim.Name)</label>

    </div>

    @if (Claim.HasReadOnly)
    {
        <div class="form-switch mb-2">
            @if (Claim.ClaimValue == "2")
            {
                <input class="form-check-input me-4" type="checkbox" value="" id="@(Claim.ClaimType)-readonly" checked="@(Claim.ClaimValue == "2")" @onchange="(e) => OnCheckboxClicked(e, true)" disabled="@IsReadOnly">
                <label class="form-check-label" for="@(Claim.ClaimType)-readonly">@TranslationState.GetValue(Claim.Name) (Readonly)</label>
            }
            else
            {
                <input class="form-check-input me-4" type="checkbox" value="" id="@(Claim.ClaimType)-readonly" @onchange="(e) => OnCheckboxClicked(e, true)" disabled="@IsReadOnly">
                <label class="form-check-label" for="@(Claim.ClaimType)-readonly">@TranslationState.GetValue(Claim.Name) (Readonly)</label>
            }
        </div>
    }
}


@if (Groups != null && Groups.Any())
{
    foreach (var group in Groups)
    {
        if (group.Claims.Any())
        {
            <div class="category mb-3 px-4 border-left">
                <div class="category-title fw-bold mb-1">@TranslationState.GetValue(group.GroupName)</div>
                @for (int ctr = 0; ctr < @group.Claims.Count; ctr++)
                {
                    var claim = @group.Claims[ctr];

                    <PermissionRow Claim="@claim" IsReadOnly="@IsReadOnly" Permissions="@Permissions" IsSubUser="@IsSubUser"/>
                }
            </div>

        }
    }
}