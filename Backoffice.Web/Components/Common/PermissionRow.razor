<div class="form-switch mb-2">
    @if (Claim.Name.Contains("readonly", StringComparison.OrdinalIgnoreCase) && Claim.ClaimValue == "2")
    {
    <input class="form-check-input me-4" type="checkbox" value="" id="@ClaimId" checked disabled="@IsReadOnly">
    }
    else if (Claim.ClaimValue == "1")
    {
    <input class="form-check-input me-4" type="checkbox" value="" id="@ClaimId" checked @onchange="(e) => OnCheckboxClicked(e, false)" disabled="@IsReadOnly">
    }
    else
    {
    <input class="form-check-input me-4" type="checkbox" value="" id="@ClaimId" @onchange="(e) => OnCheckboxClicked(e, false)" disabled="@IsReadOnly">
    }
    <label class="form-check-label" for="@ClaimId">@Claim.Name</label>

</div>

@if (Claim.HasReadOnly)
{
    <div class="form-switch mb-2">
        @if (Claim.ClaimValue == "2")
        {
        <input class="form-check-input me-4" type="checkbox" value="" id="@(ClaimId)-readonly" checked @onchange="(e) => OnCheckboxClicked(e, true)" disabled="@IsReadOnly">
        }
        else
        {
        <input class="form-check-input me-4" type="checkbox" value="" id="@(ClaimId)-readonly" @onchange="(e) => OnCheckboxClicked(e, true)" disabled="@IsReadOnly">
        }
        <label class="form-check-label" for="@(ClaimId)-readonly">@Claim.Name (Readonly)</label>

    </div>
}