<div class="p-3">
    <div class="row">
        <div class="container-no-record-found col-md-12 text-center border border-1 rounded d-flex flex-column justify-content-center align-items-center">
            <img class="no-record-found mb-4" src="icons/svg/no-record-found.svg" />
            <h4>
                @if (!string.IsNullOrEmpty(Message))
                {
                    <strong>@Message!</strong>
                }
                else
                {
                    <strong>@_translationState.GetValue("No Record Found")!</strong>
                }
            </h4>
            <p style="color: #787878">@Description</p>
        </div>
    </div>
</div>