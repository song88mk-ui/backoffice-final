@if (Visible)
{
    <div class="modal show d-block confirm-dialog" tabindex="-1" role="alertdialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="d-flex flex-column justify-content-center align-items-center p-5">
                        <img src="icons/svg/warning-icon.svg" alt="" />
                        <div class="confirm-dialog-message text-center mt-4">@_translationState.GetValue(Message)</div>
                    </div>
                </div>
                <div class="modal-footer mx-4">
                    <button type="button" class="btn modal-btn btn-dismiss" @onclick="OnCancel">@_translationState.GetValue(CancelText)</button>
                    <button type="button" class="btn modal-btn btn-confirm" @onclick="OnConfirm">@_translationState.GetValue(ConfirmText)</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show confirm-dialog-backdrop"></div>
}
