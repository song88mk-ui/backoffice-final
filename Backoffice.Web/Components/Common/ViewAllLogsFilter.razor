@using BlazorDateRangePicker
@using Backoffice.Shared.Enums

<div class="row">
    <div class="col-4">
        <button class="btn btn-filter" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
            <i class="fa fa-filter"></i>&nbsp;@_translationState.GetValue("Filters")
        </button>
    </div>
    <div class="col-4"></div>
    <div class="col-4 position-relative">
        @*<EditForm class="f-right" Model="FilterModel" OnValidSubmit="OnSubmitClickEvent">
        <div class="right-icon-control">
        <InputText id="search" class="form-control search-text" placeholder="@_translationState.GetValue("Search Here")..." @bind-Value="FilterModel.SearchText" />
        <div class="form-icon"> <i class="feather icon-search"></i> </div>
        </div>
        </EditForm>*@
    </div>
</div>
<div class="row mt-3">
    <div class="col-12">
        <div class="row collapse" id="filterCollapse">
            @if (SelectedPage == SportsbookClientPermission.SBC_OE_PriceBoost_Manage)
            {
                <div class="col-2">
                    <select class="form-select" @onchange="OnPageSelectionChangedEvent">
                        <optgroup label="Logs Type">
                            @foreach (var item in Pages)
                            {
                                @if (SelectedPage == item.Key)
                                {
                                    <option value="@item.Key" selected>@item.Value</option>
                                }
                                else
                                {
                                    <option value="@item.Key">@item.Value</option>
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select" @onchange="OnClientChangedEvent">
                        <optgroup label="Clients">
                            <option value="ALL">@_translationState.GetValue("All Clients")</option>
                            @if (FilterModel != null && FilterModel.Clients != null)
                            {
                                @foreach (var client in FilterModel.Clients)
                                {
                                    @if (client.Value == FilterModel.ClientCode)
                                    {
                                        <option value="@client.Key" selected>@client.Value</option>
                                    }
                                    else
                                    {
                                        <option value="@client.Key">@client.Value</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select" @onchange="OnSportChangedEvent">
                        <optgroup label="Sports">
                            <option value="0">@_translationState.GetValue("Select Sports")</option>
                            @if (FilterModel != null && FilterModel.Sports != null)
                            {
                                @foreach (var sport in FilterModel.Sports.SportLookup)
                                {
                                    <option value="@sport.SportId" selected="@(sport.SportId == FilterModel.SportId)">@_translationState.GetValue(sport.SportName)</option>
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select" @onchange="OnSegmentChangedEvent">
                        <optgroup label="Segment">
                            <option value="0">@_translationState.GetValue("Select Segment")</option>
                            @if (FilterModel != null && FilterModel.Segments != null)
                            {
                                @foreach (var segment in FilterModel.Segments.SegmentLookup)
                                {
                                    <option value="@segment.SegmentId" selected="@(segment.SegmentId == FilterModel.SportId)">@_translationState.GetValue(segment.SegmentName)</option>
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2">
                    <select class="form-select" @onchange="OnLeagueChangedEvent">
                        <optgroup label="League">
                            <option value="0">@_translationState.GetValue("Select League")</option>
                            @if (FilterModel != null && FilterModel.Leagues != null)
                            {
                                @foreach (var league in FilterModel.Leagues.LeagueLookup)
                                {
                                    <option value="@league.LeagueId" selected="@(league.LeagueId == FilterModel.SportId)">@_translationState.GetValue(league.LeagueName)</option>
                                }
                            }
                        </optgroup>
                    </select>
                </div>

                <div class="col-2">
                    <DateRangePicker class="form-control" DateFormat="MM/dd/yyyy" StartDate="FilterModel.DateFrom" EndDate="FilterModel.DateTo" MaxDate="DateTime.Today" OnRangeSelect="OnDateRangeChangedEvent"></DateRangePicker>
                </div>
            }
            else
            {
                <div class="col-3">
                    <select class="form-select" @onchange="OnPageSelectionChangedEvent">
                        @foreach (var item in Pages)
                        {
                            <option value="@item.Key" selected="@(SelectedPage == item.Key)">@_translationState.GetValue(item.Value)</option>
                        }
                    </select>
                </div>

                <div class="col-3 form-group">
                    <DateRangePicker class="form-control" DateFormat="MM/dd/yyyy" StartDate="FilterModel.DateFrom.ToLocalTime()" EndDate="FilterModel.DateTo.ToLocalTime()" MaxDate="@DateTime.Today" OnRangeSelect="OnDateRangeChangedEvent"></DateRangePicker>
                </div>
            }

        </div>
    </div>
</div>