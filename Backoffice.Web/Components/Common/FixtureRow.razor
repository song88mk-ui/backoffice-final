
<tr>
    <td>
        @if (Market.FixtureStatusId == 1)
        {
            <span class="m-1">@Market.CurrentPeriod</span>
            @if (!string.IsNullOrEmpty(Market.CurrentMinute) && int.Parse(Market.CurrentMinute) > 0)
            {
                <span class="fw-bold">@Market.CurrentMinute</span>
            }
        }
        else
        {
            <span>
                @Market.FixtureStartDate.ToLocalTime().ToString("dd/MM/yy")
                <br>
                <strong>@Market.FixtureStartDate.ToLocalTime().ToString("HH:mm")</strong>
            </span>
        }

    </td>
    <td>
        <div class="d-flex justify-content-between px-2">
            <a href="@($"hk/odds-engine/monitoring-details/{Market.ProviderFixtureId}")" class="fixture-details text-decoration-none">
                <span class="fw-bold">@Market.HomeName.ToUpper()</span>
                <br />
                <span>@Market.AwayName.ToUpper()</span>
            </a>
            @if (Market.FixtureStatusId == 1)
            {
                <span class="score-info py-2 px-2">@Market.Score</span>
            }
        </div>
    </td>

    @if (IsMonitoringPage)
    {
        <AuthorizeView Policy="sbc-monitoring-match-canedit">
            <Authorized Context="ActivateAll">
                <td>
                    <button type="button" class="btn btn-dark close-match-btn mx-4" @onclick="OnCloseMatchClickEvent">Close Match</button>
                </td>
            </Authorized>
        </AuthorizeView>
    }

    <!-- BR CTRL -->
    <td>
        <div class="d-flex justify-content-left">
            @if (Market != null && Market.Selections.Any())
            {
                var hasLine = HasLine;

                foreach (var selection in Market?.Selections)
                {
                    var selectionKey = $"br-{selection.ProviderSelectionId}";

                    <SelectionRow @key="selectionKey" Selection="selection" ColumnSize="@ColumnSize" IsBetStop="IsBetStop" CurrentMarketStatus="@Market.MarketStatusId" HasClientConfig="true" Region="@Region"/>

                    if (hasLine)
                    {
                        <div>
                            <div class="margin-value me-2 py-1">
                                <span class="d-block text-center">@MarketLine</span>
                            </div>
                        </div>

                        hasLine = false;
                    }
                }

                if (Market != null && Market.Selections.Any())
                {
                    <div class="py-1 px-1 ">
                        <span class="text-nowrap">@GetClientMargin(string.Empty, string.Empty, Market.Selections)</span>
                    </div>
                }
            }
            else
            {
                <div class="odds-container me-2 py-1 px-3">
                    <span>-.-</span>
                </div>
                <div class="odds-container me-2 py-1 px-3">
                    <span>-.-</span>
                </div>
                <div class="py-1 px-2">
                    <span>-.-</span>
                </div>
            }

        </div>
    </td>

    <!-- Client Odds -->
    @if (Clients != null)
    {
        foreach (var client in Clients)
        {
            var hasLine = HasLine;

            <td>
                <div class="d-flex justify-content-left">
                    @if (Market != null && Market.Selections.Any())
                    {
                        foreach (var selection in Market?.Selections)
                        {
                            var selectionKey = $"{client.ClientCode.ToLower()}-{selection.ProviderSelectionId}";
                            var hasClientConfig = HasClientConfig(client.ClientCode, Market.ClientCode, Market.ClientCodeMargin);

                            <SelectionRow @key="selection.ProviderSelectionId" CurrentClientCode="@client.ClientCode"
                              Selection="selection" ColumnSize="@ColumnSize" IsBetStop="IsBetStop"
                              CurrentMarketStatus="@GetMarketStatusId(client, Market.ClientCode, Market.MarketStatusId)"
                              HasClientConfig="hasClientConfig" />

                            if (hasLine)
                            {
                                if (hasClientConfig)
                                {
                                    <div>
                                        <div class="margin-value me-2 py-1">
                                            <span class="d-block text-center">@MarketLine</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <div class="margin-value me-2 py-1">
                                            <span class="d-block text-center">-.-</span>
                                        </div>
                                    </div>
                                }

                                hasLine = false;
                            }
                        }

                        if (Market != null && Market.Selections.Any())
                        {
                            if (HasClientConfig(client.ClientCode, Market.ClientCode, Market.ClientCodeMargin))
                            {
                                <div class="py-1 px-1">
                                    <span class ="text-nowrap">@GetClientMargin(client.ClientCode, Market.ClientCodeMargin, Market.Selections)</span>
                                </div>
                            }
                            else
                            {
                                <div class="py-1 px-2">
                                    <span>-.-</span>
                                </div>
                            }
                        }
                    }
                </div>
            </td>
        }
    }

</tr>