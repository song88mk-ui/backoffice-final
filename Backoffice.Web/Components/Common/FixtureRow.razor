<tr class="d-flex">
    <td class="td-start-date">
        @if (_fixtureStatusId == 1)
        {
            <span class="m-1">@_currentPeriod</span>
            @if (!string.IsNullOrEmpty(_currentMinute) && int.Parse(_currentMinute) > 0)
            {
                <span class="fw-bold">@_currentMinute</span>
            }
        }
        else
        {
            <span>
                @_fixtureStartDate.ToLocalTime().ToString("dd/MM/yy")
                <br>
                <strong>@_fixtureStartDate.ToLocalTime().ToString("HH:mm")</strong>
            </span>
        }

    </td>
    <td class="td-fixture-name">
        <div class="d-flex justify-content-between px-2">
            <a href="@($"hk/odds-engine/monitoring-details/{_providerFixtureId}")" class="fixture-details text-decoration-none">
                <span class="fw-bold">@_homeName?.ToUpper()</span>
                <br />
                <span>@_awayName?.ToUpper()</span>
            </a>
            @if (_fixtureStatusId == 1)
            {
                <span class="score-info py-2 px-2">@_score</span>
            }
        </div>
    </td>

    @if (IsMonitoringPage)
    {
        <AuthorizeView Policy="sbc-monitoring-match-canedit">
            <Authorized Context="ActivateAll">
                <td class="td-close-match">
                    <button type="button" class="btn btn-dark close-match-btn mx-4" @onclick="OnCloseMatchClickEvent">Close Match</button>
                </td>
            </Authorized>
        </AuthorizeView>
    }

    <!-- BR CTRL -->
    <td class="td-master">
        <div class="d-flex justify-content-center">
            @if (Market != null && _selections.Any())
            {
                foreach (var selection in _selections)
                {
                    var selectionKey = $"br-{selection.ProviderSelectionId}";

                    <SelectionRow @key="selectionKey" Selection="selection" ColumnSize="@_columnSize" IsBetStop="_isBetStop" CurrentMarketStatus="@_marketStatusId" HasClientConfig="true" Region="@Region"/>

                    if (_hasLine)
                    {
                        <div>
                            <div class="margin-value me-2 py-1">
                                <span class="d-block text-center">@_marketLine</span>
                            </div>
                        </div>
                    }
                }

                if (Market != null && _selections.Any())
                {
                    <div class="py-1 px-1 ">
                        <span class="text-nowrap">@GetClientMargin(string.Empty, string.Empty, _selections)</span>
                    </div>
                }
            }
            else
            {
                <div class="odds-container me-2 py-1 px-3">
                    <span>-.-</span>
                </div>
                <div class="odds-container me-2 py-1 px-3">
                    <span>-.-</span>
                </div>
                <div class="py-1 px-2">
                    <span>-.-</span>
                </div>
            }

        </div>
    </td>

    <!-- Client Odds -->
    @if (Clients != null)
    {
        foreach (var client in Clients)
        {
            <td class="td-master">
                <div class="d-flex justify-content-center">
                    @if (Market != null && _selections.Any())
                    {
                        foreach (var selection in _selections)
                        {
                            @*var selectionKey = $"{client.ClientCode.ToLower()}-{selection.ProviderSelectionId}";*@
                            var hasClientConfig = HasClientConfig(client.ClientCode, _clientCode, _clientCodeMargin);

                            <SelectionRow @key="selection.ProviderSelectionId" CurrentClientCode="@client.ClientCode"
                              Selection="selection" ColumnSize="@_columnSize" IsBetStop="_isBetStop"
                              CurrentMarketStatus="@GetMarketStatusId(client, _clientCode, _marketStatusId)"
                              HasClientConfig="hasClientConfig" />

                            if (_hasLine)
                            {
                                if (hasClientConfig)
                                {
                                    <div>
                                        <div class="margin-value me-2 py-1">
                                            <span class="d-block text-center">@_marketLine</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <div class="margin-value me-2 py-1">
                                            <span class="d-block text-center">-.-</span>
                                        </div>
                                    </div>
                                }
                            }
                        }

                        if (Market != null && _selections.Any())
                        {
                            if (HasClientConfig(client.ClientCode, _clientCode, _clientCodeMargin))
                            {
                                <div class="py-1 px-1">
                                    <span class ="text-nowrap">@GetClientMargin(client.ClientCode, _clientCodeMargin, _selections)</span>
                                </div>
                            }
                            else
                            {
                                <div class="py-1 px-2">
                                    <span>-.-</span>
                                </div>
                            }
                        }
                    }
                </div>
            </td>
        }
    }

</tr>