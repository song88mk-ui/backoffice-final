<div class="modal-body">
    @if (Alerts != null && Alerts.Any())
    {
        <div class="row">
            <div class="col">
                <div class="col">
                    @foreach (var alert in Alerts)
                    {
                        <AlertMessage AlertModel="@alert" Guid="AlertGuid"/>
                    }
                </div>
            </div>
        </div>
    }
    <div class="row">
        <div class="col-md-12 mb-3">
            <label class="form-label">@TranslationState.GetValue("New Password")</label>
            <div class="input-group mb-2">
                <input id="password" type="password" class="form-control pe-5" placeholder=@TranslationState.GetValue("Enter your password") @bind-value="NewPassword" />
                <button type="button" class="d-flex align-items-center position-absolute end-0 h-100 bg-transparent border-0 password-eye" onclick="password_show_hide2(this);">
                    <i class="fa fa-eye-slash text-center eye-icon" id="show_eye"></i>
                    <i class="fa fa-eye d-none text-center eye-icon" id="hide_eye"></i>
                </button>
            </div>
            @* <span class="sub-info d-block fw-light fst-italic ms-1">Password must be 8-15 characters long, which should contain uppercase and lowercase characters, with any digit from 0-9, and must include at least one special character</span> *@
            <span class="sub-info d-block fw-light fst-italic ms-1">@TranslationState.GetValue("password_criteria")</span>
        </div>
        <div class="col-md-12">
            <label class="form-label">@TranslationState.GetValue("Confirm New Password")</label>
            <div class="input-group mb-2">
                <input id="password" type="password" class="form-control pe-5" placeholder=@TranslationState.GetValue("Enter your password") @bind-value="ConfirmNewPassword" />
                <button type="button" class="d-flex align-items-center position-absolute end-0 h-100 bg-transparent border-0 password-eye" onclick="password_show_hide2(this);">
                    <i class="fa fa-eye-slash text-center eye-icon" id="show_eye"></i>
                    <i class="fa fa-eye d-none text-center eye-icon" id="hide_eye"></i>
                </button>
            </div>
            <span class="sub-info d-block fw-light fst-italic ms-1 ">@TranslationState.GetValue("Both passwords must match.")</span>
        </div>
    </div>
</div>
<div class="modal-footer mx-4 px-0 d-block">
    <div class="d-flex justify-content-center">
        <button type="button" class="modal-btn btn-change-password py-2 border-0 w-100 rounded" @onclick="OnChangePasswordClickEvent">@TranslationState.GetValue("Change Password")</button>
    </div>
</div>