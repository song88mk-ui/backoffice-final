<div class="modal-body">
    <div class="row">
        <div class="col-md-12 mb-3">
            <label class="form-label">New Password</label>
            <div class="input-group mb-2">
                <input id="password" type="password" class="form-control pe-5" placeholder="Enter your password" />
                <button type="button" class="d-flex align-items-center position-absolute end-0 h-100 bg-transparent border-0 password-eye" onclick="password_show_hide();">
                    <i class="fa fa-eye-slash text-center eye-icon" id="show_eye"></i>
                    <i class="fa fa-eye d-none text-center eye-icon" id="hide_eye"></i>
                </button>
            </div>
            <span class="sub-info d-block fw-light fst-italic ms-1">Password must contain any character from A-Z or a-z with any digit from 0-9, and between 8 to 15 character long</span>
        </div>
        <div class="col-md-12">
            <label class="form-label">Confirm New Password</label>
            <div class="input-group mb-2">
                <input id="password" type="password" class="form-control pe-5" placeholder="Enter your password" />
                <button type="button" class="d-flex align-items-center position-absolute end-0 h-100 bg-transparent border-0 password-eye" onclick="password_show_hide();">
                    <i class="fa fa-eye-slash text-center eye-icon" id="show_eye"></i>
                    <i class="fa fa-eye d-none text-center eye-icon" id="hide_eye"></i>
                </button>
            </div>
            <span class="sub-info d-block fw-light fst-italic ms-1 ">Both passwords must match.</span>
        </div>
    </div>
</div>
<div class="modal-footer mx-4 px-0 d-block">
    <a class="d-block btn modal-btn btn-change-password py-2" href="javascript:void(0);">Change Password</a>
</div>