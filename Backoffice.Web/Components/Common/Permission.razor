@using Backoffice.Web.Models;

<div class="permission-container">
    <div class="row">
        <div class="col-md-12 mb-1">
            <h6 class="title fw-bold ps-2 py-1">@_translationState.GetValue("Permissions")</h6>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            @if (PermissionTree != null && PermissionTree.Permissions != null && PermissionTree.Permissions.Any())
            {
                foreach (var category in PermissionTree.Permissions)
                {
                    <div class="access-container border rounded mb-3">
                        <div class="access-header mt-3 mx-3 pb-4 border-bottom border-1">
                            <div class="header-title">
                                <h6 class="fw-bold d-inline-block " @onclick="() => OnDropCategoryClickEvent(category)">
                                    <i class="fa fa-plus me-3"></i>
                                    @_translationState.GetValue(category.CategoryName)
                                </h6>
                                <div class="form-switch d-inline-block pull-right">
                                    @if (category.CategoryId == SelectedCategoryId && IsSubUser == false)
                                    {
                                        if (category.IsEnabled)
                                        {
                                            if (IsReadOnly)
                                            {
                                                <input class="form-check-input" type="checkbox" role="switch" checked disabled />
                                            }
                                            else
                                            {
                                                <input class="form-check-input" type="checkbox" role="switch" checked @onclick="() => OnEnableCategoryClickEvent(category)" />
                                            }
                                        }
                                        else
                                        {
                                            if (IsReadOnly)
                                            {
                                                <input class="form-check-input" type="checkbox" role="switch" disabled />
                                            }
                                            else
                                            {
                                                <input class="form-check-input" type="checkbox" role="switch" @onclick="() => OnEnableCategoryClickEvent(category)" />
                                            }
                                        }
                                    }
                                </div>
                            </div>
                            <div class="header-information">
                                @if (category.CategoryId == (int)PermissionCategory.Admin)
                                {
                                    <label>Create and manage user and user groups, modify, settle, or cancel bets, and view manual bet settlement history</label>
                                }
                                else if (category.CategoryId == (int)PermissionCategory.SBC)
                                {
                                    <label>@_translationState.GetValue("Sportsbook Clients details")</label>
                                }
                            </div>
                        </div>
                        @if (category.CategoryId == SelectedCategoryId)
                        {
                            <div class="access-permissions mx-3 my-3">
                                <div class="sub-title mb-4">
                                    <div class="row">
                                        <div class="col-8">
                                            <span class="d-block fw-bold">@_translationState.GetValue("Permissions")</span>
                                            <span class="sub-title-info">@_translationState.GetValue("Require usergroup permission")</span>
                                        </div>
                                        @if (category.CategoryId == (int)PermissionCategory.SBC)
                                        {
                                            <div class="col text-end">
                                                <div class="dropdown w-100">
                                                    @if (!IsSubUser)
                                                    {
                                                        <button class="btn clients-btn dropdown-toggle ps-4" type="button" id="clientDropdown" data-bs-toggle="dropdown" data-bs-auto-close="dropdown" aria-expanded="false" disabled=@(!category.IsEnabled)>
                                                            @_translationState.GetValue("Select Clients")
                                                        </button>
                                                        @if (ClientModel.Clients.Any())
                                                        {
                                                            <SelectWithCheckbox Items="SelectItems" OnCheckboxCallback="OnClientCheckboxClickEvent" AriaLabel="clientDropdown" IsReadOnly="@IsReadOnly" />
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        }
                                        <div class="col text-center">
                                            <button type="button" class="btn btn-enable-all" @onclick="() => OnEnableClickEvent(category)" disabled=@(!category.IsEnabled)>@_translationState.GetValue("Enable All")</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex">
                                    @if (category.SubCategories.Any())
                                    {
                                        var maxRow = (int)Math.Ceiling(Convert.ToDecimal(category.SubCategories.Count) / 2m);
                                        @if (category.CategoryId == (int)PermissionCategory.SBC)
                                            maxRow = category.SubCategories.Count;

                                        <div class="w-50 noselect">
                                            @for (int rowCount = 0; rowCount < maxRow; rowCount++)
                                            {
                                                if (category.SubCategories[rowCount].ColPosition != "RIGHT")
                                                {
                                                    <div class="category mb-3">
                                                        <div class="category-title fw-bold mb-1">@_translationState.GetValue(category.SubCategories[rowCount].SubCategoryName)</div>

                                                        @if (!category.SubCategories[rowCount].Groups.Any())
                                                        {
                                                            for (int ctr = 0; ctr < @category.SubCategories[rowCount].Claims.Count; ctr++)
                                                            {
                                                                var claim = @category.SubCategories[rowCount].Claims[ctr];
                                                                
                                                                if (IsSubUser && claim.Availability > 0)
                                                                {
                                                                    <PermissionRow Claim="@claim" IsAdmin="_isAdmin" Permissions="@Permissions" IsSubUser="@IsSubUser" />
                                                                }
                                                                else if (!IsSubUser)
                                                                {
                                                                    <PermissionRow Claim="@claim" IsAdmin="_isAdmin" Permissions="@Permissions" IsSubUser="@IsSubUser" />
                                                                }
                                                            }
                                                        }
                                                        else
                                                        {
                                                            var claim = @category.SubCategories[rowCount].Claims[0];
                                                            var groups = @category.SubCategories[rowCount].Groups;

                                                            if (IsSubUser && claim.Availability > 0)
                                                            {
                                                                <PermissionRow Claim="@claim" Groups="@groups" IsAdmin="_isAdmin" Permissions="@Permissions" IsSubUser="@IsSubUser" />
                                                            }
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>

                                        <div class="w-50 noselect">
                                            @{
                                                var startCount = category.CategoryId == (int)PermissionCategory.SBC ? 0 : maxRow;
                                            }
                                            @for (int rowCount = startCount; rowCount < category.SubCategories.Count(); rowCount++)
                                            {
                                                if (category.SubCategories[rowCount].ColPosition != "LEFT")
                                                {
                                                    <div class="category mb-3">
                                                        <div class="category-title fw-bold mb-1">@_translationState.GetValue(category.SubCategories[rowCount].SubCategoryName)</div>

                                                        @if (!category.SubCategories[rowCount].Groups.Any())
                                                        {
                                                            for (int ctr = 0; ctr < @category.SubCategories[rowCount].Claims.Count; ctr++)
                                                            {
                                                                var claim = @category.SubCategories[rowCount].Claims[ctr];

                                                                <PermissionRow Claim="@claim" IsAdmin="_isAdmin" Permissions="@Permissions" IsSubUser="@IsSubUser" />
                                                            }
                                                        }
                                                        else
                                                        {
                                                            var claim = @category.SubCategories[rowCount].Claims[0];
                                                            var groups = @category.SubCategories[rowCount].Groups;

                                                            <PermissionRow Claim="@claim" Groups="@groups" IsAdmin="_isAdmin" Permissions="@Permissions" IsSubUser="@IsSubUser" />
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                        }
                    </div>

                }
            }
        </div>
    </div>
</div>
