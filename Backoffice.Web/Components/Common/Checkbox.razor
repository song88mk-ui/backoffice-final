@if (Checked)
{
    if (HasOnChange)
    {
        <input class="form-check-input" type="checkbox" name="option[]" checked="checked" @onchange="@((e) => OnChangeEvent(e.Value))" />
    }
    else
    {
        <input class="form-check-input" type="checkbox" name="option[]" checked="checked" disabled />
    }
}
else
{
    if (HasOnChange)
    {
        <input class="form-check-input" type="checkbox" name="option[]" @onchange="@((e) => OnChangeEvent(e.Value))" />
    }
    else
    {
        <input class="form-check-input" type="checkbox" name="option[]" disabled />
    }
}