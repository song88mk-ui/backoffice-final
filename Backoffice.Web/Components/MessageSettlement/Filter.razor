@using BlazorDateRangePicker
<div class="row">
    <div class="col-md-12">
        <div class="content-filter mx-3 d-flex justify-content-between">
            <div class="button-container d-flex">
                <a href="javascript:void(0)" class="btn btn-message-settlement px-3" @onclick="OnAddMessageSettlement">
                    <i class="fa fa-plus me-1"></i>
                    Add Message Settlement
                </a>
            </div>
            <div class="button-container d-flex flex-row-reverse align-items-end">
                <a href="javascript:void(0)" class="btn btn-export px-3 ms-2" @onclick="OnExportClickEvent">
                    <i class="fa fa-file-excel-o me-1"></i>
                    Export to Excel
                </a>
                <a href="javascript:void(0)" class="btn btn-filter px-3" @onclick="OnFilterClickEvent">
                    <i class="fa fa-filter me-1"></i>
                    Filters
                </a>
            </div>
        </div>
    </div>
</div>

@if (ShowFilter)
{
    <EditForm Model="FilterModel" OnValidSubmit="OnSubmitClickEvent" Context="FormContext">
        <div class="row">
            <div class="d-flex col-md-12 mx-3 mt-4">
                <div class="col-2 me-2">
                    <select class="form-select d-block" @onchange="OnSportChangedEvent">
                        <optgroup label="Sport">
                            <option value="0" selected>All Sports</option>
                        </optgroup>
                        @if (Sports != null && Sports.Any())
                        {
                            @foreach (var item in Sports)
                            {
                                if (item.Value == FilterModel.SportId)
                                {
                                    <option value="@item.Value" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-2 me-2">
                    <select class="form-select d-block" @onchange="OnSegmentChangedEvent">
                        <optgroup label="Segment">
                            <option value="0" selected>All Segments</option>
                        </optgroup>
                        @if (Segments != null && Segments.Any())
                        {
                            @foreach (var item in Segments)
                            {
                                if (item.Value == FilterModel.SegmentId)
                                {
                                    <option value="@item.Value" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-2 me-2">
                    <select class="form-select d-block" @onchange="OnLeagueChangedEvent">
                        <optgroup label="League">
                            <option value="0" selected>All Leagues</option>
                        </optgroup>
                        @if (Leagues != null && Leagues.Any())
                        {
                            @foreach (var item in Leagues)
                            {
                                if (item.Value == FilterModel.LeagueId)
                                {
                                    <option value="@item.Value" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-2 me-2">
                    <select class="form-select d-block" @onchange="OnFixtureChangedEvent">
                        <optgroup label="Fixture">
                            <option value="0" selected>All Fixtures</option>
                        </optgroup>
                        @if (Fixtures != null && Fixtures.Any())
                        {
                            @foreach (var item in Fixtures)
                            {
                                if (item.Value == FilterModel.FixtureId)
                                {
                                    <option value="@item.Value" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-2 me-2">
                    <select class="form-select d-block" @onchange="OnStatusChangedEvent">
                        <optgroup label="Status">
                            <option value="0" selected>All Status</option>
                            @foreach (var item in Statuses)
                            {
                                if (item.Value == FilterModel.ToStatus)
                                {
                                    <option value="@item.Value" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            }
                        </optgroup>
                    </select>
                </div>
            </div>
            <div class="d-flex col-md-12 mx-3 mt-2">
                <div class="col-2 me-2">
                    <select class="form-select d-block" @onchange="OnMarketChangedEvent">
                        <optgroup label="Market">
                            <option value="0" selected>All Markets</option>
                            @if (Markets != null && Markets.Any())
                            {
                                @foreach (var item in Markets)
                                {
                                    if (item.Value == FilterModel.MarketId)
                                    {
                                        <option value="@item.Value" selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Name</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2 me-2 ">
                    <select class="form-select d-block" @onchange="OnSelectionChangedEvent">
                        <optgroup label="Market">
                            <option value="0" selected>All Selections</option>
                            @if (Selections != null && Selections.Any())
                            {
                                @foreach (var item in Selections)
                                {
                                    if (item.Value == FilterModel.SelectionId)
                                    {
                                        <option value="@item.Value" selected>@item.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Name</option>
                                    }
                                }
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-2 me-2 form-group">
                    <DateRangePicker class="form-control" DateFormat="MM/dd/yyyy" LinkedCalendars="true" StartDate="FilterModel.FromDate" EndDate="FilterModel.ToDate" MaxDate="@DateTime.Today" OnRangeSelect="OnRangeSelect" />
                </div>
                <div class="col-2 me-2">
                    <input type="text" class="form-control" placeholder="Settled By" @bind-value="FilterModel.SettledBy" />
                </div>
                <div class="col-2 me-2">
                    <button class="btn btn-search">Search</button>
                </div>
            </div>
        </div>
    </EditForm>
}