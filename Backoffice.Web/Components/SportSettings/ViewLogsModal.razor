<div class="modal-body">
    <div class="row">
        <div class="col-md-12">
            @if (IsPreLoader)
            {
                <Preloader />
            }
            else
            {
                if (ClientSportOrderAudit != null && ClientSportOrderAudit.Any())
                {
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th class="th-date">Date</th>
                                <th class="th-client">Client</th>
                                <th class="th-changes-from">Changes From</th>
                                <th class="th-changes-to">Changes To</th>
                                <th class="th-updated-by">Updated By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var model in ClientSportOrderAudit)
                            {
                                <tr>
                                    <td>
                                        @model.TimeStamp.ToLocalTime().ToString("MM/dd/yyyy") <br>
                                        @model.TimeStamp.ToLocalTime().ToString("hh:mm:ss tt")
                                    </td>
                                    <td>@model.ClientName</td>
                                    <td>
                                        <span>@((MarkupString)model.ChangesFrom)</span>
                                    </td>
                                    <td>
                                        <span>@((MarkupString)model.ChangesTo)</span>
                                    </td>
                                    <td>@model.UserName</td>
                                </tr>
                            }
                        </tbody>
                        }
                    </table>
                }
                else
                {
                    <NoRecordFound />
                }
            }
        </div>
    </div>
</div>
<div class="modal-footer mx-4">
    <button type="button" class="btn btn-cancel" @onclick="OnCancelClickEvent">Close</button>
</div>