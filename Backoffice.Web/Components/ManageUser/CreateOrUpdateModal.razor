<div class="modal-body">
    @if (IsPreLoader)
    {
        <Preloader />
    }
    else
    {
        <div class="information-container mb-3">
            <div class="row">
                <div class="col-md-12 mb-1">
                    <h6 class="title fw-bold ps-2 py-1">User Information</h6>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">Business Name</label>
                    <input type="text" class="form-control" placeholder="Enter Username" @bind-value="UserRegister.UserName" disabled="@IsEdit"/>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email Address</label>
                    <input type="text" class="form-control" placeholder="Enter Email Address" @bind-value="UserRegister.Email" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Password</label>
                    <div class="input-group">
                        <input id="password" type="password" class="form-control pe-5 @(IsValidPassword ? "valid" : "invalid")" placeholder="Enter your password" @bind-value="UserRegister.Password" @onfocusout="OnPasswordFocusOutEvent" />
                        <button type="button" class="d-flex align-items-center position-absolute end-0 h-100 bg-transparent border-0 password-eye" onclick="password_show_hide();">
                            <i class="fa fa-eye-slash text-center eye-icon" id="show_eye"></i>
                            <i class="fa fa-eye d-none text-center eye-icon" id="hide_eye"></i>
                        </button>
                    </div>
                    <div class="form-text fst-italic">
                        Password must contain any character from A-Z or a-z with any digit from 0-9, and between 8 to 15 character long
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">User Group</label>
                    <select class="form-select" @onchange="OnUserGroupOnChangedEvent">
                        @foreach (var userGroup in UserGroupList)
                        {
                            <option value="@userGroup.UserGroupId" selected="@(UserRegister.RoleId == userGroup.UserGroupId)">@userGroup.UserGroupName</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <div class="btn-group border rounded px-2 d-flex" role="group">
                        <input id="radio-normal" name="btn-radio" type="radio" class="btn-check" checked="@(UserRegister.Status == "Normal" || UserRegister.Status == null)" @onclick="() => OnStatusClickedEvent(false)" />
                        <label class="btn btn-radio my-1 w-50 rounded" for="radio-normal">Normal</label>

                        <input id="radio-locked" name="btn-radio" type="radio" class="btn-check" checked="@(UserRegister.Status == "Locked")" @onclick="() => OnStatusClickedEvent(true)" />
                        <label class="btn btn-radio my-1 w-50 rounded" for="radio-locked">Locked</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="permission-container">
            <div class="row">
                <div class="col-md-12 mb-1">
                    <h6 class="title fw-bold ps-2 py-1">Permissions</h6>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="access-container border rounded mb-3">
                        <div class="access-header mt-3 mx-3 pb-4 border-bottom border-1">
                            <div class="header-title">
                                <h6 class="fw-bold d-inline-block">
                                    <i class="fa fa-plus me-3"></i>
                                    Admin
                                </h6>
                                <div class="form-switch d-inline-block pull-right">
                                    @*<input type="checkbox" class="admin-checkbox" readonly />
                                <div class="slider-admin rounded-pill"></div>*@
                                    <input class="form-check-input" type="checkbox" role="switch" disabled checked>
                                </div>
                            </div>
                            <div class="header-information">
                                Create and manage user and user groups, modify, settle, or cancel bets, and view manual bet settlement history
                            </div>
                        </div>
                        <div class="access-permissions mx-3 my-3">
                            <div class="sub-title mb-4">
                                <span class="d-block fw-bold">Permissions</span>
                                <span class="sub-title-info">Enable the permissions required for this user group</span>
                            </div>
                            <div class="d-flex">
                                <div class="w-50">
                                    <div class="category mb-3">
                                        <div class="category-title fw-bold mb-1">Dashboard</div>
                                        <div class="form-switch mb-2">
                                            <input class="form-check-input me-4" type="checkbox" value="" id="cat-dashboard" disabled checked>
                                            <label class="form-check-label" for="cat-dashboard">Dashboard</label>
                                        </div>
                                    </div>
                                    <div class="category mb-3">
                                        <div class="category-title fw-bold mb-1">User & User Groups</div>
                                        <div class="form-switch mb-2">
                                            <input class="form-check-input me-4" type="checkbox" value="" id="cat-manage-users" disabled>
                                            <label class="form-check-label" for="cat-manage-users">Manage Users</label>
                                        </div>
                                        <div class="form-switch mb-2">
                                            <input class="form-check-input me-4" type="checkbox" value="" id="cat-manage-user-groups" disabled>
                                            <label class="form-check-label" for="cat-manage-user-groups">Manage User Groups</label>
                                        </div>
                                    </div>
                                    <div class="category mb-3">
                                        <div class="category-title fw-bold mb-1">Settlements</div>
                                        <div class="form-switch mb-2">
                                            <input class="form-check-input me-4" type="checkbox" value="" id="cat-manual-bet-settlement" disabled>
                                            <label class="form-check-label" for="cat-manual-bet-settlement">Manual Bet Settlement</label>
                                        </div>
                                        <div class="form-switch mb-2">
                                            <input class="form-check-input me-4" type="checkbox" value="" id="cat-resend-settlement" disabled>
                                            <label class="form-check-label" for="cat-resend-settlement">Resend Settlement</label>
                                        </div>
                                        <div class="form-switch mb-2">
                                            <input class="form-check-input me-4" type="checkbox" value="" id="cat-market-settlement" disabled>
                                            <label class="form-check-label" for="cat-market-settlement">Market Settlement</label>
                                        </div>
                                        <div class="form-switch mb-2">
                                            <input class="form-check-input me-4" type="checkbox" value="" id="cat-message-settlement" disabled>
                                            <label class="form-check-label" for="cat-message-settlement">Message Settlement</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="w-50">
                                    <div class="category mb-3">
                                        <div class="category-title fw-bold mb-1">Modify/Cancel Bets</div>
                                        <div class="form-switch mb-2">
                                            <input class="form-check-input me-4" type="checkbox" value="" id="cat-cancel-bets" disabled checked>
                                            <label class="form-check-label" for="cat-cancel-bets">Cancel Bets</label>
                                        </div>
                                        <div class="form-switch mb-2">
                                            <input class="form-check-input me-4" type="checkbox" value="" id="cat-cancel-bet-history" disabled>
                                            <label class="form-check-label" for="cat-manage-users">Cancel Bet History</label>
                                        </div>
                                    </div>
                                    <div class="category mb-3">
                                        <div class="category-title fw-bold mb-1">Maintenance</div>
                                        <div class="form-switch mb-2">
                                            <input class="form-check-input me-4" type="checkbox" value="" id="cat-cancel-bet-history" disabled>
                                            <label class="form-check-label" for="cat-manage-users">Manage Users</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<div class="modal-footer mx-4">
    <button type="button" class="btn btn-cancel waves-effect" data-bs-dismiss="modal">Cancel</button>
    <button type="button" class="btn btn-edit waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickedEvent" disabled="@IsPreLoader">Save</button>
</div>

