<div class="content-filter mx-3 d-flex justify-content-between">
    <div class="input-container d-flex">
        <div class="me-4">
            <label class="form-label d-block">Username</label>
            <EditForm Model="SearchForm" OnValidSubmit="OnInputSearchEvent" Context="FormContext">
                <div class="input-group">
                    <InputText id="search" placeholder="Search" class="form-control search-text valid border-end-0" @bind-Value="SearchForm.SearchText" />
                    <span class="input-group-text border-start-0">
                        <i class="fa fa-search"></i>
                    </span>
                </div>
            </EditForm>
        </div>
        <div class="me-4">
            <label class="form-label d-block">Sort By</label>
            <select class="form-select d-block">
                @foreach (var item in SelectSortByList)
                {
                    if (SelectedSortBy == item.Value)
                    {
                        <option value="@item.Value" selected>@item.Name</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                }
            </select>
        </div>
    </div>
    <div class="button-container d-flex flex-row-reverse align-items-end">
        <a href="javascript:void(0)" class="btn btn-create px-4">Create User</a>
    </div>
</div>