</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn btn-cancel" @onclick="OnModalCancel">Cancel</button>
    @if (!string.IsNullOrEmpty(SelectedClientCode))
    {
        <button type="button" class="btn modal-btn btn-copy" @onclick="OnModalCopy">Copy</button>
    }
    else
    {
        <button type="button" class="btn modal-btn btn-copy" disabled>Copy</button>
    }
</div>