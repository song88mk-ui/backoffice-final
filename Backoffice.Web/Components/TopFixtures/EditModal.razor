                                <td>
                                    <div class="dropdown">
                                        <button class="btn dropdown-toggle d-block w-100" data-bs-auto-close="outside" type="button" id="row-@(index+1)"
                                            data-bs-toggle="dropdown" aria-expanded="false" @onclick="async () => await OnDropdownSelect(index)">
                                            No Game
                                        </button>
                                        <Select @key="@($"Key{index}")" SportsTree="SportsTree" CurrentTopFixtures="@CurrentTopFixtures" SelectedTopFixture="@NewTopFixture.TopFixtures[index].FixtureId" RowCount="@(index+1)" OnSelectedGame="OnSelectedGameEvent" />
                                    </div>
                                </td>
                                <td>
                                </td>
                                <td>
                                </td>
                                <td class="actions">
                                    <a href="javascript:void(0);" class="me-2" @onclick="async () => await OnAddRow(NewTopFixture.TopFixtures[index].SortOrder)">
                                        <i class="fa fa-plus-circle"></i>
                                    </a>
                                    <a href="javascript:void(0);" class="me-2" @onclick="async () => await OnDeleteRow(NewTopFixture.TopFixtures[index])">
                                        <i class="fa fa-minus-circle"></i>
                                    </a>
                                    <a href="javascript:void(0);" class="drag-handle">
                                        <i class="fa fa-bars"></i>
                                    </a>
                                </td>
                            }
                        </tr>
                    }*@
                }
            }
        </tbody>
    </table>
</div>
<div class="modal-footer mx-4 p-0 py-3 border-0">
    <button type="button" class="btn btn-cancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent">Cancel</button>
    <button type="button" class="btn btn-edit waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickEvent">Save</button>
</div>