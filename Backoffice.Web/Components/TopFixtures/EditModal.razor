                                    </div>
                                </td>
                                <td>
                                    @NewTopFixture.TopFixtures[index].FixtureStartDate.ToString("MM/dd/yyyy HH:mm:ss")
                                </td>
                                <td>
                                    @if (@NewTopFixture.TopFixtures[index].FixtureStatus == FixtureStatus.Prematch.ToString())
                                    {
                                        <span class="badge rounded-pill bg-secondary px-3">
                                            Prematch
                                        </span>
                                    }
                                    else if (@NewTopFixture.TopFixtures[index].FixtureStatus == FixtureStatus.Live.ToString())
                                    {
                                        <span class="badge rounded-pill bg-live px-3">
                                            Live
                                        </span>
                                    }
                                </td>
                                <td class="actions">
                                    <a href="javascript:void(0);" class="me-2" @onclick="async () => await OnAddRow(NewTopFixture.TopFixtures[index].SortOrder)">
                                        <i class="fa fa-plus-circle"></i>
                                    </a>
                                    <a href="javascript:void(0);" class="me-2" @onclick="async () => await OnDeleteRow(NewTopFixture.TopFixtures[index])">
                                        <i class="fa fa-minus-circle"></i>
                                    </a>
                                    <a href="javascript:void(0);" class="drag-handle">
                                        <i class="fa fa-bars"></i>
                                    </a>
                                </td>
                            }
                            else
                            {
                                <td scope="row">@NewTopFixture.TopFixtures[index].SortOrder</td>
                                <td></td>
                                <td></td>
