@using Backoffice.Shared.Enums

<div class="modal-body">
    <EditFilter ClientId="TopFixture.ClientIdRef" OnInitCallback="OnInitEvent" />
    <table class="table editModalTbl">
        <thead class="editModalThead">
            <tr>
                <th scope="col">No</th>
                <th scope="col">Sport</th>
                <th scope="col">Segment</th>
                <th scope="col">League</th>
                <th scope="col">Game</th>
                <th scope="col">Kick Off Date & Time</th>
                <th scope="col">Fixture Status</th>
                <th scope="col">Action</th>
            </tr>
        </thead>

        <tbody>
            @if (NewTopFixture != null )
            {
                var rowCtr = 0;
                if (NewTopFixture.TopFixtures != null && NewTopFixture.TopFixtures.Any())
                {
                    foreach (var topFixture in NewTopFixture.TopFixtures)
                    {
                        rowCtr = rowCtr + 1;
                        <tr>
                            <th scope="row">@rowCtr</th>
                            <td>@topFixture.SportName</td>
                            <td>@topFixture.SegmentName</td>
                            <td>@topFixture.LeagueName</td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn dropdown-toggle" data-bs-auto-close="outside" type="button" id="gameDropdown1"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                        @topFixture.FixtureName
                                    </button>

                                    <ul class="dropdown-menu" aria-labelledby="gameDropdown1">
                                        <li>
                                            <a class="dropdown-toggle dropdown-item" data-bs-toggle="collapse" role="button" aria-controls="englandCollapse" href="#englandCollapse">Soccer</a>
                                            <div class="collapse ms-2" id="englandCollapse">
                                                <a class="dropdown-toggle dropdown-item" data-bs-toggle="collapse" role="button" aria-controls="premierLeagueCollapse" href="#premierLeagueCollapse">England</a>

                                                <div class="collapse" id="premierLeagueCollapse">
                                                    <div class="form-check ms-4">
                                                        <input class="form-check-input" type="radio" name="option1" value="option1" id="option1" />
                                                        <label class="form-check-label" for="option1">Manchester United vs. Notttingham Forest</label>
                                                    </div>
                                                    <div class="form-check ms-4">
                                                        <input class="form-check-input" type="radio" name="option1" value="option2" id="option2" />
                                                        <label class="form-check-label" for="option2">Everton FC vs. Wolverchampton Wanderers</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </li>

                                        <li>
                                            <a class="dropdown-toggle dropdown-item">Basketball</a>
                                        </li>

                                        <li>
                                            <a class="dropdown-toggle dropdown-item">Tennis</a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                            <td>
                                @topFixture.StartDate.ToString("MM/dd/yyyy HH:mm:ss")
                            </td>
                            <td>
                                @if (@topFixture.FixtureStatus == FixtureStatus.Prematch.ToString())
                                {
                                    <span class="badge rounded-pill bg-secondary px-3">
                                        Prematch
                                    </span>
                                }
                                else if (@topFixture.FixtureStatus == FixtureStatus.Live.ToString())
                                {
                                    <span class="badge rounded-pill bg-live px-3">
                                        Live
                                    </span>
                                }

                            </td>
                            <td class="actions">
                                <span><a href="#"><i class="fa fa-plus-square" aria-hidden="true"></i></a></span>
                                <span><a href="#"><i class="fa fa-minus-square" aria-hidden="true"></i></a></span>
                                <span><a href="#"><i class="fa fa-bars" aria-hidden="true"></i></a></span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    rowCtr = rowCtr + 1;
                        <tr>
                            <th scope="row">@rowCtr</th>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td>
                                <div class="dropdown">
                                    <button class="btn dropdown-toggle" data-bs-auto-close="outside" type="button" id="gameDropdown1"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                        No Game
                                    </button>

                                    <ul class="dropdown-menu" aria-labelledby="gameDropdown1">
                                        <li>
                                            <a class="dropdown-toggle dropdown-item" data-bs-toggle="collapse" role="button" aria-controls="englandCollapse" href="#englandCollapse">Soccer</a>
                                            <div class="collapse ms-2" id="englandCollapse">
                                                <a class="dropdown-toggle dropdown-item" data-bs-toggle="collapse" role="button" aria-controls="premierLeagueCollapse" href="#premierLeagueCollapse">England</a>

                                                <div class="collapse" id="premierLeagueCollapse">
                                                    <div class="form-check ms-4">
                                                        <input class="form-check-input" type="radio" name="option1" value="option1" id="option1" />
                                                        <label class="form-check-label" for="option1">Manchester United vs. Notttingham Forest</label>
                                                    </div>
                                                    <div class="form-check ms-4">
                                                        <input class="form-check-input" type="radio" name="option1" value="option2" id="option2" />
                                                        <label class="form-check-label" for="option2">Everton FC vs. Wolverchampton Wanderers</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </li>

                                        <li>
                                            <a class="dropdown-toggle dropdown-item">Basketball</a>
                                        </li>

                                        <li>
                                            <a class="dropdown-toggle dropdown-item">Tennis</a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                            <td>
                                
                            </td>
                            <td>
                                
                            </td>
                            <td class="actions">
                                <span><a href="#"><i class="fa fa-plus-square" aria-hidden="true"></i></a></span>
                                <span><a href="#"><i class="fa fa-minus-square" aria-hidden="true"></i></a></span>
                                <span><a href="#"><i class="fa fa-bars" aria-hidden="true"></i></a></span>
                            </td>
                        </tr>
                }

            }

        </tbody>
    </table>
</div>
<div class="modal-footer">
    <button type="button" class="btn editModalBtn editModalCancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent">Cancel</button>
    <button type="button" class="btn editModalBtn editModalSave waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickEvent">Save</button>
</div>