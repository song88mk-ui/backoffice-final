@using Backoffice.Shared.Enums
@using Backoffice.Web.Components.Common

<div class="modal-body mx-4 p-0 pt-4">
    <EditFilter ClientId="TopFixture.ClientIdRef" OnInitCallback="OnInitEvent" />
    <table class="table table-hover table-borderless mt-4 @TableClass">
        <thead class="table-head">
            <tr>
                <th class="th-no">No</th>
                <th class="th-sport">Sport</th>
                <th class="th-segment">Segment</th>
                <th class="th-league">League</th>
                <th class="th-game">Game</th>
                <th class="th-start-date">Kick Off Date & Time</th>
                <th class="th-fixture-status">Fixture Status</th>
                <th class="th-action">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (NewTopFixture != null && NewTopFixture.TopFixtures != null)
            {
                if (NewTopFixture.TopFixtures.Any())
                {
                    foreach (var model in NewTopFixture.TopFixtures)
                    {
                        @if (!string.IsNullOrEmpty(model.FixtureId))
                        {
                            <tr id="match-@model.FixtureId">
                                <td>@model.SortOrder</td>
                                <td>@model.SportName</td>
                                <td>@model.SegmentName</td>
                                <td>@model.LeagueName</td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn dropdown-toggle d-block w-100" data-bs-auto-close="outside" type="button" id="row-@model.SortOrder"
                                            data-bs-toggle="dropdown" aria-expanded="false" @onclick="() => OnDropdownSelect(model.SortOrder)">
                                            @model.FixtureName
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="row-@model.SortOrder" id="select-@model.SortOrder">
                                            @if (model.SortOrder == SelectedRow)
                                            {
                                            <Select @key="@($"Key{model.SortOrder}")" SportsTree="SportsTree" CurrentTopFixtures="CurrentTopFixtures" SelectedTopFixture="@model.FixtureId" RowCount="model.SortOrder" OnSelectedGame="OnSelectedGameEvent" />
                                            }
                                        </ul>
                                    </div>
                                </td>
                                <td>
                                    @model.FixtureStartDate.ToString("MM/dd/yyyy HH:mm:ss")
                                </td>
                                <td>
                                    @if (model.FixtureStatus == FixtureStatus.Prematch.ToString())
                                    {
                                        <span class="badge rounded-pill bg-secondary px-3">
                                            @FixtureStatus.Prematch.ToString()
                                        </span>
                                    }
                                    else if (model.FixtureStatus == FixtureStatus.Live.ToString())
                                    {
                                        <span class="badge rounded-pill bg-live px-3">
                                            @FixtureStatus.Live.ToString()
                                        </span>
                                    }
                                </td>
                                <td class="actions">
                                    <a href="javascript:void(0);" class="me-2" @onclick="() => OnAddClickEvent(model.SortOrder)">
                                        <i class="fa fa-plus-circle"></i>
                                    </a>
                                    <a href="javascript:void(0);" class="me-2" @onclick="() =>  OnDeleteRow(model)">
                                        <i class="fa fa-minus-circle"></i>
                                    </a>
                                    <a href="javascript:void(0);" class="drag-handle">
                                        <i class="fa fa-bars"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>@model.SortOrder</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn dropdown-toggle d-block w-100" data-bs-auto-close="outside" type="button" id="row-@model.SortOrder"
                                            data-bs-toggle="dropdown" aria-expanded="false" @onclick="() => OnDropdownSelect(model.SortOrder)">
                                            No Game
                                        </button>
                                        <ul class="dropdown-menu" aria-labelledby="row-@model.SortOrder" id="select-@model.SortOrder">
                                            @if (model.SortOrder == SelectedRow)
                                            {
                                            <Select @key="@($"Key{model.SortOrder}")" SportsTree="SportsTree" CurrentTopFixtures="CurrentTopFixtures" SelectedTopFixture="@model.FixtureId" RowCount="model.SortOrder" OnSelectedGame="OnSelectedGameEvent" />
                                            }
                                        </ul>
                                    </div>
                                </td>
                                <td></td>
                                <td></td>
                                <td class="actions">
                                    <a href="javascript:void(0);" class="me-2" @onclick="() => OnAddClickEvent(model.SortOrder)">
                                        <i class="fa fa-plus-circle"></i>
                                    </a>
                                    <a href="javascript:void(0);" class="me-2" @onclick="() =>  OnDeleteRow(model)">
                                        <i class="fa fa-minus-circle"></i>
                                    </a>
                                    <a href="javascript:void(0);" class="drag-handle">
                                        <i class="fa fa-bars"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }

                    @*for(var index = 0; index < NewTopFixture.TopFixtures.Count; index++)
                    {
                        <tr>
                            @if (!string.IsNullOrEmpty(NewTopFixture.TopFixtures[index].FixtureId))
                            {
                                <td scope="row">@NewTopFixture.TopFixtures[index].SortOrder</td>
                                <td>@NewTopFixture.TopFixtures[index].SportName</td>
                                <td>@NewTopFixture.TopFixtures[index].SegmentName</td>
                                <td>@NewTopFixture.TopFixtures[index].LeagueName</td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn dropdown-toggle d-block w-100" data-bs-auto-close="outside" type="button" id="Row@(index+1)"
                                            data-bs-toggle="dropdown" aria-expanded="false" @onclick="async () => await OnDropdownSelect(index)">
