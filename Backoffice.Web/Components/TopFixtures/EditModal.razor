@using Backoffice.Shared.Enums
@using Backoffice.Web.Components.Common

<div class="modal-body">
    <EditFilter ClientId="TopFixture.ClientIdRef" OnInitCallback="OnInitEvent" />
    <table class="table editModalTbl">
        <thead class="editModalThead">
            <tr>
                <th scope="col">No</th>
                <th scope="col">Sport</th>
                <th scope="col">Segment</th>
                <th scope="col">League</th>
                <th scope="col">Game</th>
                <th scope="col">Kick Off Date & Time</th>
                <th scope="col">Fixture Status</th>
                <th scope="col">Action</th>
            </tr>
        </thead>

        <tbody>
            @if (NewTopFixture != null)
            {
                if (NewTopFixture.TopFixtures != null && NewTopFixture.TopFixtures.Any())
                {
                    foreach (var topFixture in NewTopFixture.TopFixtures)
                    {
                        if (!string.IsNullOrEmpty(topFixture.FixtureId))
                        {
                            <tr>
                                <th scope="row">@topFixture.SortOrder</th>
                                <td>@topFixture.SportName</td>
                                <td>@topFixture.SegmentName</td>
                                <td>@topFixture.LeagueName</td>
                                <td>
                                    <div class="dropdown">
                                    <button class="btn dropdown-toggle" data-bs-auto-close="outside" type="button" id="Row@(topFixture.SortOrder)"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                            @topFixture.FixtureName
                                        </button>

                                        <Select @key="@($"topFixture{topFixture.SortOrder}")" SportsTree="SportsTree" RowCount="@topFixture.SortOrder" OnSelectedGame="OnSelectedGameEvent" />
                                    </div>
                                </td>
                                <td>
                                    @topFixture.FixtureStartDate.ToString("MM/dd/yyyy HH:mm:ss")
                                </td>
                                <td>
                                    @if (@topFixture.FixtureStatus == FixtureStatus.Prematch.ToString())
                                    {
                                        <span class="badge rounded-pill bg-secondary px-3">
                                            Prematch
                                        </span>
                                    }
                                    else if (@topFixture.FixtureStatus == FixtureStatus.Live.ToString())
                                    {
                                        <span class="badge rounded-pill bg-live px-3">
                                            Live
                                        </span>
                                    }

                                </td>
                                <td class="actions">
                                    <span><a @onclick="() => OnAddRow(topFixture.SortOrder)"><i class="fa fa-plus-square" aria-hidden="true"></i></a></span>
                                    <span><a @onclick="() => OnDeleteRow(topFixture)"><i class="fa fa-minus-square" aria-hidden="true"></i></a></span>
                                    <span><a href="#"><i class="fa fa-bars" aria-hidden="true"></i></a></span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <th scope="row">@topFixture.SortOrder</th>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td>
                                    <div class="dropdown">
                                        <button class="btn dropdown-toggle" data-bs-auto-close="outside" type="button" id="Row@(topFixture.SortOrder)"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                            No Game
                                        </button>
                                        <Select @key="@($"topFixture{topFixture.SortOrder}")" SportsTree="SportsTree" RowCount="@topFixture.SortOrder" OnSelectedGame="OnSelectedGameEvent" />
                                    </div>
                                </td>
                                <td>
                                </td>
                                <td>
                                </td>
                                <td class="actions">
                                    <span><a @onclick="() => OnAddRow(topFixture.SortOrder)"><i class="fa fa-plus-square" aria-hidden="true"></i></a></span>
                                    <span><a @onclick="() => OnDeleteRow(topFixture)"><i class="fa fa-minus-square" aria-hidden="true"></i></a></span>
                                    <span><a href="#"><i class="fa fa-bars" aria-hidden="true"></i></a></span>
                                </td>
                            </tr>
                        }
                    }
                }
            }

        </tbody>
    </table>
</div>
<div class="modal-footer">
    <button type="button" class="btn editModalBtn editModalCancel waves-effect" data-bs-dismiss="modal" @onclick="OnCancelClickEvent">Cancel</button>
    <button type="button" class="btn editModalBtn editModalSave waves-effect" data-bs-dismiss="modal" @onclick="OnSaveClickEvent">Save</button>
</div>