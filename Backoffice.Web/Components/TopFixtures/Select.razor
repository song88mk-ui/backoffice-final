<ul class="dropdown-menu" aria-labelledby="Row@(RowCount)" id="Row@(RowCount)">
    @if (SportsTree != null && SportsTree.Any())
    {
        foreach (var sport in SportsTree)
        {
            <li>
                <a class="dropdown-toggle dropdown-item" data-bs-toggle="collapse" role="button" href="#Collapse@(sport.SportId)">@sport.SportName</a>
                @if (sport.Segments != null && sport.Segments.Any())
                {
                    <div id="Collapse@(sport.SportId)" class="collapse ms-2">                        
                        @for (int x = 0; x < sport.Segments.Count; x++)
                        {
                            var segment = sport.Segments[x];

                            <a class="dropdown-toggle dropdown-item" data-bs-toggle="collapse" role="button" aria-controls="SegmentCollapse@(segment.SegmentId)" href="#SegmentCollapse@(segment.SegmentId)">@segment.SegmentName</a>

                            @if (segment.Leagues != null && segment.Leagues.Any())
                            {
                                <div id="SegmentCollapse@(segment.SegmentId)" class="collapse">
                                @for (int y = 0; y < segment.Leagues.Count; y++)
                                {
                                    var league = segment.Leagues[y];

                                        if (league.Fixtures != null && league.Fixtures.Any())
                                        {
                                            //Games
                                            for (int z = 0; z < league.Fixtures.Count; z++)
                                            {
                                                var fixture = league.Fixtures[z];

                                                <div class="form-check ms-4">
                                                    <input class="form-check-input" type="radio" name="@RowCount" value="@fixture.FixtureId" id="@fixture.FixtureId" @onclick="() => OnGameSelectedEvent(fixture)" />
                                                    <label class="form-check-label" for="@fixture.FixtureId" @onclick="() => OnGameSelectedEvent(fixture)">@fixture.FixtureName</label>
                                                </div>
                                            }
                                        }
                                }
                                </div>
                            }
                        }
                    </div>
                }
            </li>
        }
    }
</ul>