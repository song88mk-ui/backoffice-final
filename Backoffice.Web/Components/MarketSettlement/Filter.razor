@using BlazorDateRangePicker
<div class="row">
    <div class="col-md-12">
        <div class="content-filter mx-3 d-flex justify-content-between">
            <div class="button-container d-flex">
                <a href="javascript:void(0)" class="btn btn-market-settlement px-3" @onclick="OnAddMarketSettlementClickEvent">
                    <i class="fa fa-plus me-1"></i>
                    Add Market Settlement
                </a>
            </div>
            <div class="button-container d-flex flex-row-reverse align-items-end">
                <a href="javascript:void(0)" class="btn btn-export px-3 ms-2">
                    <i class="fa fa-file-excel-o me-1"></i>
                    Export to Excel
                </a>
                <a href="javascript:void(0)" class="btn btn-filter px-3" @onclick="OnFilterClickEvent">
                    <i class="fa fa-filter me-1"></i>
                    Filters
                </a>
            </div>
        </div>
    </div>
</div>

@if (ShowFilter)
{
    <div class="row">
        <div class="col-md-12 mx-3 mt-4">
            <div class="d-flex">
                <div class="me-4 select-container">
                    <select class="form-select d-block" @onchange="OnSportChangedEvent">
                        <option value="0">All Sports</option>
                        @foreach(var item in Sports)
                        {
                            if (item.Value == ModalFilter.SportId)
                            {
                                <option value="@item.Value" selected>@item.Name</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="me-4 select-container">
                    <select class="form-select d-block" @onchange="OnSegmentChangedEvent">
                        <option value="0">All Segments</option>
                        @foreach (var item in Segments)
                        {
                            if (item.Value == ModalFilter.SegmentId)
                            {
                                <option value="@item.Value" selected>@item.Name</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="me-4 select-container">
                    <select class="form-select d-block" @onchange="OnLeagueChangedEvent">
                        <option value="0">All Leagues</option>
                        @foreach (var item in Leagues)
                        {
                            if (item.Value == ModalFilter.LeagueId)
                            {
                                <option value="@item.Value" selected>@item.Name</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="me-4 select-container">
                    <select class="form-select d-block" @onchange="OnFixtureChangedEvent">
                        <option value="0">All Fixtures</option>
                        @foreach (var item in Fixtures)
                        {
                            if (item.Value == ModalFilter.FixtureId)
                            {
                                <option value="@item.Value" selected>@item.Name</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="me-4 select-container">
                    <select class="form-select d-block" @onchange="OnStatusChangedEvent">
                        <option value="0">All Status</option>
                        @foreach (var item in Statuses)
                        {
                            <option value="@item.Value">@item.Name</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div class="col-md-12 mx-3 mt-2">
            <div class="d-flex">
                <div class="me-4 select-container">
                    <select class="form-select d-block" @onchange="OnMarketChangedEvent">
                        <option value="0" selected>All Markets</option>
                        @foreach (var item in Markets)
                        {
                            if (item.Value == ModalFilter.MarketId)
                            {
                                <option value="@item.Value" selected>@item.Name</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="me-4 select-container">
                    <select class="form-select d-block" @onchange="OnSelectionChangedEvent">
                        <option value="0" selected>All Selections</option>
                        @foreach (var item in Selections)
                        {
                            if (item.Value == ModalFilter.SelectionId)
                            {
                                <option value="@item.Value" selected>@item.Name</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="me-4 input-container">
                    <DateRangePicker class="form-control" DateFormat="MM/dd/yyyy" LinkedCalendars="true" StartDate="ModalFilter.FromDate" EndDate="ModalFilter.ToDate" MaxDate="@DateTime.Today" OnRangeSelect="OnRangeSelect" />
                </div>
                <div class="me-4 input-container">
                    <input type="text" class="form-control" placeholder="Settled By" @bind-value="ModalFilter.SettledBy"/>
                </div>
                <div class="me-4 input-container">
                    <a href="javascript:void(0)" class="btn btn-search px-3" @onclick="OnSearchClickEvent">
                        Search
                    </a>
                </div>
            </div>
        </div>
    </div>
}