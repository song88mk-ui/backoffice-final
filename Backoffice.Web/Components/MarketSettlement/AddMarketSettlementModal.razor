@if(IsPreLoader)
{
    <Preloader/>
}

<div class="modal-body">
    <div class="row">
        <div class="col-md-12">
            <MarketSettlementModalFilter @bind-AddMarketSettlement="AddMarketSettlement" OnUpdateRowCallback="UpdateRowDetails" OnLeagueChangedCallback="SetMarketFixtures" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <table class="table">
                <thead>
                    <tr>
                        @if (AddMarketSettlement != null && !string.IsNullOrEmpty(AddMarketSettlement.BetId) && AddMarketSettlement.AddMarketSettlementSelections.Count > 1)
                        {
                            <th scope="col">Select</th>
                        }
                        <th scope="col">Event Details</th>
                        <th scope="col">Selection</th>
                        <th scope="col">Status</th>
                        <th scope="col">Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @if (AddMarketSettlement != null)
                    {
                        var marketId = string.Empty;
                        for (var i = 0; i < AddMarketSettlement.AddMarketSettlementSelections.Count; i++)
                        {
                            int index = i;
                            <tr>
                                @if (!string.IsNullOrEmpty(AddMarketSettlement.BetId) && AddMarketSettlement.AddMarketSettlementSelections.Count > 1)
                                {
                                    <td>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" @onchange="OnCheckboxClicked"/>
                                        </div>
                                    </td>
                                }

                                @if (i == 0 || AddMarketSettlement.AddMarketSettlementSelections[index].MarketId != marketId)
                                {
                                    var rowCount = AddMarketSettlement.AddMarketSettlementSelections.Where(c => c.MarketId == AddMarketSettlement.AddMarketSettlementSelections[index].MarketId).Count();
                                    marketId = AddMarketSettlement.AddMarketSettlementSelections[index].MarketId;
                                    <td rowspan="@rowCount" align="left" valign="top">
                                        @if (string.IsNullOrEmpty(AddMarketSettlement.AddMarketSettlementSelections[index].FixtureName))
                                        {
                                            <p>_</p>
                                        }
                                        else
                                        {
                                            

                                            <span>&nbsp;&nbsp;</span> @AddMarketSettlement.AddMarketSettlementSelections[index].SportName

                                            <br />
                                            <span>@AddMarketSettlement.AddMarketSettlementSelections[index].SegmentName</span> <br>
                                            <span>@AddMarketSettlement.AddMarketSettlementSelections[index].LeagueName.ToUpper()</span>

                                            <br />
                                            @AddMarketSettlement.AddMarketSettlementSelections[index].FixtureName.ToUpper()

                                            <br />
                                            <span>
                                                @AddMarketSettlement.AddMarketSettlementSelections[index].FixtureStartDate.ToLocalTime().ToString("dd/MM/yy") <strong>@AddMarketSettlement.AddMarketSettlementSelections[index].FixtureStartDate.ToLocalTime().ToString("HH:mm")</strong>
                                            </span>

                                            <br />
                                            <span>@AddMarketSettlement.AddMarketSettlementSelections[index].MarketName.ToUpper() @(GetMarketLine(AddMarketSettlement.AddMarketSettlementSelections[index].MarketName, AddMarketSettlement.AddMarketSettlementSelections[index].Line))</span>
                                        }
                                    </td>
                                }

                                <td align="left" valign="top">
                                    @if (string.IsNullOrEmpty(AddMarketSettlement.AddMarketSettlementSelections[index].SelectionName))
                                    {
                                        <p>_</p>
                                    }
                                    else
                                        @AddMarketSettlement.AddMarketSettlementSelections[index].SelectionName

                                    </td>
                                    <td valign="middle" align="left">
                                        <select class="form-control input-sm" name="Status" @onchange="(ChangeEventArgs __e) => OnAddStatusChange(__e, AddMarketSettlement.AddMarketSettlementSelections[index].RowCount)">
                                            <option value="0">Select Status</option>
                                            @if (AddMarketSettlement.AddMarketSettlementSelections[index].Statuses != null)
                                        {
                                            @foreach (var item in AddMarketSettlement.AddMarketSettlementSelections[index].Statuses)
                                            {
                                                if (item.Value == AddMarketSettlement.AddMarketSettlementSelections[index].ToStatus)
                                                {
                                                    <option value="@item.Value" selected>@item.Name</option>
                                                }
                                                else
                                                {
                                                    <option value="@item.Value">@item.Name</option>
                                                }
                                            }
                                        }
                                    </select>
                                </td>
                                <td valign="middle" align="left"><textarea @bind="AddMarketSettlement.AddMarketSettlementSelections[index].Reason" class="form-control" placeholder="Reason"></textarea></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn modal-btn btn-cancel" @onclick="OnCancelModal">Cancel</button>
    <button type="button" class="btn modal-btn btn-settle" @onclick="OnMarketSettlement">Settle Market</button>
</div>