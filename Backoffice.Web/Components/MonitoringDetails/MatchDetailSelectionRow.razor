<tr>
    <td>
        <span class="selection-name-container fw-bold">@Selection.SelectionName</span>
    </td>
    <td>
        <div class="d-flex justify-content-center">
            <div class="odds-container @GetClientColor() me-2 py-1">
                <span class="d-block text-center">@GetClientOdds(null)</span>
            </div>
        </div>
    </td>
    @foreach (var client in ClientModel.Clients)
    {
        <td>
            <div class="d-flex justify-content-center">
                <div class="odds-container @GetClientColor(client.ClientCode) me-2 py-1">
                    @if (HasClientConfig(client.ClientCode, Market.ClientCode, Market.ClientCodeMargin))
                    {
                        <span class="d-block text-center">@GetClientOdds(client.ClientCode)</span>
                    }
                    else
                    {
                        <span class="d-block text-center">-.-</span>
                    }
                </div>
            </div>
        </td>
    }
</tr>