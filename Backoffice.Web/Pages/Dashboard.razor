    {
        const string url = "https://tableau.song88.com/t/song88/views/design/Dashboard1?:showAppBanner=false&:toolbar=no";

        await jsRuntime.InvokeVoidAsync("initViz", vizContainer, url);

        await base.OnAfterRenderAsync(firstRender);
