@page "/dashboard"
@*@inject IJSRuntime jsRuntime*@

<div class="row">
    <div class="main-content col-md-12 mb-4 pb-3">
        <div class="row">
            <div class="col-md-12">
                <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
            </div>
            <div class="col-md-12">
                <div @ref="VizContainer"></div>
                @*<div style="width:800px; height:700px;" @ref="VizContainer"></div>*@
            </div>
        </div>
    </div>
</div>

@*@code
