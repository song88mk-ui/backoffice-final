@using Backoffice.Web.Components.Administration.CancelBets

@page "/admin/cancel-bets"

<AuthorizeView Policy="admin-cancel">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageHeaderModel="@_pageHeaderModel"/>
                    </div>
                    @if (Alerts != null && Alerts.Any())
                    {
                        foreach (var alert in Alerts)
                        {
                            <div class="col-md-12 mt-4 ">
                                <div class="mx-3">
                                    <AlertMessage AlertModel="@alert" />
                                </div>
                            </div>
                        }
                    }
                    @if (IsPreload)
                    {
                        <div class="col-md-12">
                            <div class="mt-4 mx-3">
                                <Preloader />
                            </div>
                        </div>
                    }
                    <div class="col-md-12 mt-4">
                        <Filter OnAddBetReferenceIdCallback="OnAddBetReferenceIdCallbackEvent" OnCancelBetCallback="OnCancelBetCallbackEvent" OnResetCallback="OnResetCallbackEvent" IsPreload="IsPreload" />
                    </div>
                    <div class="col-md-12">
                        <div class="content mx-3">
                            <div class="information-container">
                                <span>Add up to 10 Bet Reference IDs for bet cancellation requests.</span>
                            </div>
                            <table class="table table-bordered mt-4">
                                <thead class="table-head">
                                    <tr>
                                        <th class="th-number py-3">No.</th>
                                        <th class="th-reference-id py-3">Bet Reference ID</th>
                                        <th class="th-manage py-3">Manage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (BetRefenceModel != null && BetRefenceModel.BetReferenceIds.Any())
                                    {
                                        for (var i = 0; i < BetRefenceModel.BetReferenceIds.Count; i++)
                                        {
                                            <tr>
                                                <td class="text-center">@(i + 1)</td>
                                                <td>
                                                    <div class="input-group @(!IsPreload && Alerts != null && Alerts.Any(a => a.Control == i.ToString()) ? "border-danger" : "") ">
                                                        <input type="text" class="form-control" @bind-value="@BetRefenceModel.BetReferenceIds[i]" />
                                                        @if (!IsPreload && !string.IsNullOrEmpty(BetRefenceModel.BetReferenceIds[i]))
                                                        {
                                                            <span class="input-group-text form-clear" @onclick="() => BetRefenceModel.BetReferenceIds[i] = string.Empty"><i class="fa fa-remove"></i></span>
                                                        }
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex justify-content-center">
                                                        <a class="link-trash me-2" href="javascript:(0)" @onclick="() => BetRefenceModel.BetReferenceIds.RemoveAt(i)">
                                                            <i class="fa fa-trash"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="content mx-3">
                            <table class="table table-bordered mt-4">
                                <thead class="table-head">
                                    <tr>
                                        <th class="th-reason py-3">Reason For Canceling</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <div class="form-floating">
                                                @if (BetRefenceModel != null)
                                                {
                                                    <textarea class="form-control input-reason @(!IsPreload && IsReasonRequired ? "border-danger" : "")" @bind="BetRefenceModel.Reason" />
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <CustomModal OnSaveClickCallback="OnConfirmCancelBetEvent" />
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@AdminPermission.Admin_CancelBets.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>