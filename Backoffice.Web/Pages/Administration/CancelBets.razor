@using Backoffice.Web.Components.Administration.CancelBets

@page "/admin/cancel-bets"

<div class="row">
    <div class="main-content col-md-12 mb-4 pb-3">
        <div class="row">
            <div class="col-md-12">
                <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
            </div>
            @if (Alerts != null && Alerts.Any())
            {
                foreach (var alert in Alerts)
                {
                    <div class="col-md-12 mt-4 ">
                        <div class="mx-3">
                            <AlertMessage AlertStatus="@alert.Status" AlertMessageStr="@alert.Message" Opacity="@alert.Opacity" AlwaysShow="true" />
                        </div>
                    </div>
                }
            }
            @if (IsPreload)
            {
                <div class="col-md-12">
                    <div class="mt-4 mx-3">
                        <Preloader />
                    </div>
                </div>
            }
            <div class="col-md-12 mt-4">
                <Filter OnAddBetReferenceIdCallback="OnAddBetReferenceIdCallbackEvent" OnCancelBetCallback="OnCancelBetCallbackEvent" OnResetCallback="OnResetCallbackEvent" IsPreload="IsPreload" />
            </div>
            <div class="col-md-12">
                <div class="content mx-3">
                    <div class="information-container">
                        <span>Add up to 10 Bet Reference IDs for bet cancellation requests.</span>
                    </div>
                    <table class="table table-bordered mt-4">
                        <thead class="table-head">
                            <tr>
                                <th class="th-number py-3">No.</th>
                                <th class="th-reference-id py-3">Bet Reference ID</th>
                                <th class="th-manage py-3">Manage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (CancelBetModel != null && CancelBetModel.BetReferenceIds.Any())
                            {
                                foreach (var bet in CancelBetModel.BetReferenceIds)
                                {
                                    <tr>
                                        <td class="text-center">@bet.Num</td>
                                        <td>
                                            <div class="input-group">
                                                <input type="text" class="@(!IsPreload && Alerts.Any(a => a.Control == bet.Num.ToString()) ? "form-control border-danger" : "form-control")" @bind-value="bet.BetReferenceId" />
                                                @if (!IsPreload && !string.IsNullOrEmpty(bet.BetReferenceId))
                                                {
                                                    <span class="input-group-text form-clear" @onclick="() => OnClearBetReferenceClickEvent(bet)"><i class="fa fa-remove"></i></span>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-center">
                                                <a class="link-trash me-2" href="javascript:(0)" @onclick="() => OnDeleteBetReferenceClickEvent(bet)">
                                                    <i class="fa fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-12">
                <div class="content mx-3">
                    <table class="table table-bordered mt-4">
                        <thead class="table-head">
                            <tr>
                                <th class="th-reason py-3">Reason For Canceling</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="form-floating">
                                        @if (CancelBetModel != null)
                                        {
                                            <textarea class="@(!IsPreload && IsReasonRequired ? "form-control input-reason border-danger" : "form-control input-reason")" @bind="CancelBetModel.Reason" />
                                        }
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div>
    <CustomModal OnSaveClickCallback="OnConfirmCancelBetEvent" />
</div>