@inherits BasePage

@page "/admin/dashboard"
<AuthorizeView Policy="admin-dashboard">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageHeaderModel="_pageHeaderModel" />
                    </div>

                    @if (_isPreLoader)
                    {
                        <Preloader />
                    }
                    else if (_hasAccess)
                    {
                        <metabase-dashboard
                            dashboard-id="@MetabaseService.DashboardId"
                            with-title="true"
                            with-downloads="true"
                            with-subscriptions="false"
                            drills="true"
                            initial-parameters="@_parametersJson"
                        >
                        </metabase-dashboard>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            The current user does not have access to the dashboard.
                        </div>
                    }
                </div>
            </div>
        </div>
        <div>
            <CustomModal />
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@AdminPermission.Admin_Dashboard.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>
