@inherits BasePage

@page "/admin/dashboard"
<AuthorizeView Policy="admin-dashboard">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageHeaderModel="_pageHeaderModel" />
                    </div>
                    @if (!string.IsNullOrEmpty(IFrameSrc))
                    {
                        <iframe class="tableau-iframe" src="@IFrameSrc"></iframe>
                    }
                </div>
            </div>
        </div>
        <div>
            <CustomModal />
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@AdminPermission.Admin_Dashboard.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>