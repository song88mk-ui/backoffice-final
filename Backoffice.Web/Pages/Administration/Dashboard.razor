@inherits BasePage

@page "/admin/dashboard"
<AuthorizeView Policy="admin-dashboard">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageHeaderModel="_pageHeaderModel" />
                    </div>

                    <div class="col-md-12 px-4 mb-3">
                        <div class="sport-selector d-flex align-items-center gap-3">
                            <label class="form-label mb-0 fw-semibold">Sport</label>
                            <select class="form-select sport-select" @onchange="@OnSportChanged">
                                @foreach (var sport in _sports)
                                {
                                    <option value="@sport" selected="@(_selectedSport == sport)">@sport</option>
                                }
                            </select>
                        </div>
                    </div>
                    @if (_isPreLoader)
                    {
                        <Preloader />
                    }
                    else if (!string.IsNullOrEmpty(IFrameSrc))
                    {
                        <iframe class="metabase-iframe"src="@IFrameSrc"></iframe>
                    }
                </div>
            </div>
        </div>
        <div>
            <CustomModal />
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@AdminPermission.Admin_Dashboard.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>
