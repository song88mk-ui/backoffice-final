@page "/admin/maintenance"

<div class="row">
    <div class="main-content col-md-12 mb-4 pb-3">
        <div class="row">
            <div class="col-md-12">
                <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
            </div>
            <div class="col-md-12">
                @if (IsPreLoader)
                {
                    <Preloader />
                }
                else
                {
                    <div class="maintenance-container d-flex justify-content-center align-items-center border rounded mx-3">
                        <div>
                            <i class="ico ico-maintenance d-block text-center"></i>
                            <div class="form-switch mb-3 d-flex justify-content-center">
                                <input class="form-check-input me-3" type="checkbox" checked="@IsMaintenance" value="" id="maitenance-mode" @onchange="e => OnMaintenanceClickEvent(e.Value)">
                                <label class="form-check-label fw-bold" for="maitenance-mode">Song88 Maintenance Mode</label>
                            </div>
                            <p class="text-center">
                                Maintenance mode is currently enabled on Song88.
                                <br />
                                Disabling maintenance mode will allow members to sign in.
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div>
    <CustomModal OnSaveClickCallback="OnSaveClickedEvent"/>
</div>
<AlertMessage AlertStatus="@AlertModel.Status" AlertMessageStr="@AlertModel.Message" Opacity="@AlertModel.Opacity" />