@inherits BasePage

@page "/admin/client-site-config"

<div class="row client-site-config me-3">
    @if (_isPreloader)
    {
        <Preloader />
    }
    else
    {
        <div class="page-title my-3">
            <div class="d-flex justify-content-between">
                <div class="d-flex align-items-center">
                    <h4 class="fw-bolder">
                        @_translationState.GetValue(_title)
                    </h4>
                </div>
            </div>
        </div>
        <div class="page-content m-3">
            <div class="m-2">
                <p class="fw-bolder">Manage Client Site Config</p>
                <p class="text-muted mb-3">Controls the per-client site configuration read by platform-web (feature toggles, themes, game tracker products, layout). Changes save directly to the client's config in webprops-api without a deploy, and appear on the client site within about an hour (the site caches its config for up to 60 minutes).</p>
                <p class="fw-bold">Select Client</p>
                <select class="form-select" @onchange="HandleClientSelected" disabled="@_isProcessing">
                    <option value="">-- Select a client --</option>
                    @foreach (var client in _clients)
                    {
                        var clientGuid = client.ClientId.ToString().ToUpper();
                        <option value="@clientGuid" selected="@(clientGuid == _selectedClientGuid)">@client.ClientName (@client.ClientCode)</option>
                    }
                </select>
            </div>
            @if (_clientFeatureFlags != null)
            {
                <div class="m-2 mt-4">
                    @if (_isNewConfig)
                    {
                        <div class="alert alert-warning py-2 px-3 mb-3" role="alert">
                            No existing configuration found for this client. Saving will create a new one.
                        </div>
                    }
                    <div class="category-title fw-bold mb-3">Feature Flags</div>
                    <div class="d-flex">
                        <div class="w-50 noselect">
                            <div class="form-switch mb-3">
                                <input class="form-check-input" type="checkbox" role="switch" id="ff-betting-rules" @bind="_clientFeatureFlags.Features.BettingRules" @bind:after="HandleFlagChanged" disabled="@(_isProcessing || !_canEdit)">
                                <label class="form-check-label" for="ff-betting-rules">Betting Rules</label>
                                <div class="text-muted small">Shows the Betting Rules button in the site header.</div>
                            </div>
                            <div class="form-switch mb-3">
                                <input class="form-check-input" type="checkbox" role="switch" id="ff-dark-mode" @bind="_clientFeatureFlags.Features.DarkMode" @bind:after="HandleFlagChanged" disabled="@(_isProcessing || !_canEdit)">
                                <label class="form-check-label" for="ff-dark-mode">Dark Mode</label>
                                <div class="text-muted small">Enables the dark mode theme toggle for the client's site.</div>
                            </div>
                            <div class="form-switch mb-3">
                                <input class="form-check-input" type="checkbox" role="switch" id="ff-language-options" @bind="_clientFeatureFlags.Features.LanguageOptions" @bind:after="HandleFlagChanged" disabled="@(_isProcessing || !_canEdit)">
                                <label class="form-check-label" for="ff-language-options">Language Options</label>
                                <div class="text-muted small">Enables the language selector, scoped to English and Chinese (ZH) only.</div>
                            </div>
                        </div>
                        <div class="w-50 noselect">
                            <div class="form-switch mb-3">
                                <input class="form-check-input" type="checkbox" role="switch" id="ff-og-auth" @bind="_clientFeatureFlags.Features.OGAuth" @bind:after="HandleFlagChanged" disabled="@(_isProcessing || !_canEdit)">
                                <label class="form-check-label" for="ff-og-auth">OG Auth</label>
                                <div class="text-muted small">Switches the site into Oriental Gaming (OG) mode: page title, bet ID formatting, and header/auth behavior for OG-integrated operators.</div>
                            </div>
                            <div class="form-switch mb-3">
                                <input class="form-check-input" type="checkbox" role="switch" id="ff-partial-cashout" @bind="_clientFeatureFlags.Features.PartialCashout" @bind:after="HandleFlagChanged" disabled="@(_isProcessing || !_canEdit)">
                                <label class="form-check-label" for="ff-partial-cashout">Partial Cashout</label>
                                <div class="text-muted small">Enables the partial cash-out button on eligible open bets.</div>
                            </div>
                            <div class="form-switch mb-3">
                                <input class="form-check-input" type="checkbox" role="switch" id="ff-bet-recommendation" @bind="_clientFeatureFlags.Features.BetRecommendation" @bind:after="HandleFlagChanged" disabled="@(_isProcessing || !_canEdit)">
                                <label class="form-check-label" for="ff-bet-recommendation">Bet Recommendation</label>
                                <div class="text-muted small">Shows the bet recommendation widget on the client site's main odds table.</div>
                            </div>
                            <div class="form-switch mb-3">
                                <input class="form-check-input" type="checkbox" role="switch" id="ff-euro-layout" @bind="_clientFeatureFlags.Features.IsEuroLayout" @bind:after="HandleFlagChanged" disabled="@(_isProcessing || !_canEdit)">
                                <label class="form-check-label" for="ff-euro-layout">Euro Layout</label>
                                <div class="text-muted small">Switches the client's site to the Euro (EL2) layout variant instead of the default Asian layout.</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="m-2 mt-4">
                    <div class="category-title fw-bold mb-3">Game Tracker Product Names</div>
                    <div class="text-muted small mb-2">Product name strings passed to the Game Tracker widget on the client's site.</div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        @foreach (var productName in _clientFeatureFlags.Features.GameTrackerProductNames)
                        {
                            <span class="badge product-name-tag">
                                @productName
                                @if (_canEdit)
                                {
                                    <button type="button" class="btn-close btn-close-white ms-1" title="Remove" disabled="@_isProcessing" @onclick="() => HandleRemoveGameTrackerProductName(productName)"></button>
                                }
                            </span>
                        }
                        @if (!_clientFeatureFlags.Features.GameTrackerProductNames.Any())
                        {
                            <span class="text-muted small">None configured.</span>
                        }
                    </div>
                    @if (_canEdit)
                    {
                        <div class="d-flex gap-2">
                            <input class="form-control product-name-input" placeholder="e.g. song88-light" @bind="_newGameTrackerProductName" disabled="@_isProcessing" />
                            <button class="btn btn-save" @onclick="HandleAddGameTrackerProductName" disabled="@_isProcessing">Add</button>
                        </div>
                    }
                </div>
                @if (_clientFeatureFlags.Layout.Any())
                {
                    <div class="m-2 mt-4">
                        <div class="category-title fw-bold mb-3">Themes</div>
                        <div class="text-muted small mb-2">Theme options available to the client's site, per layout. Only themes that exist in platform-web are listed.</div>
                        <div class="d-flex">
                            @foreach (var layout in _clientFeatureFlags.Layout)
                            {
                                var layoutKey = layout.Key;
                                <div class="w-50 noselect">
                                    <p class="fw-bold">@layoutKey</p>
                                    @if (ValidLayoutThemes.TryGetValue(layoutKey.ToUpper(), out var validThemes))
                                    {
                                        @foreach (var theme in validThemes)
                                        {
                                            var themeName = theme;
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="theme-@layoutKey-@themeName" checked="@IsThemeSelected(layoutKey, themeName)" disabled="@(_isProcessing || !_canEdit)" @onchange="e => HandleThemeToggled(layoutKey, themeName, (bool)e.Value)">
                                                <label class="form-check-label" for="theme-@layoutKey-@themeName">@themeName</label>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted small">Unknown layout - themes managed elsewhere: @string.Join(", ", layout.Value.Themes)</p>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
        @if (_hasChange && _canEdit)
        {
            <div>
                <button class="btn btn-save" @onclick="HandleSaveClick" disabled="@_isProcessing">Save</button>
                <button class="btn btn-cancel" @onclick="HandleCancelClick">Cancel</button>
            </div>
        }
    }
</div>
