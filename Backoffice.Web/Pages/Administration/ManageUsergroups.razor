@using Backoffice.Web.Components.Administration.ManageUserGroups

@layout MainLayout

@page "/admin/manage-usergroup"

<AuthorizeView Policy="admin-usergroups">
    <Authorized>
        <div class="col-md-12">
            <PageHeader PageHeaderModel="_pageHeaderModel" />
        </div>
        @if (Alerts != null && Alerts.Any())
        {
            foreach (var alert in Alerts)
            {
                <div class="col-md-12 mt-4 ">
                    <div class="mx-3">
                        <AlertMessage AlertModel="@alert" />
                    </div>
                </div>
            }
        }
        <div class="col-md-12">
            <Filter OnInitCallback="OnInitEvent" OnCreateUserGroupCallback="OnCreateUserGroupClickEvent" />
        </div>
        <div class="col-md-12">
            <div class="mx-3 mt-4">
                <table class="table table-hover table-bordered">
                    <thead class="table-head">
                        <tr>
                            <th>#</th>
                            <th>@TranslationState.GetValue("Market Group Name")</th>
                            <th>@TranslationState.GetValue("Markets")</th>
                            <th>@TranslationState.GetValue("Action")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsPreLoader)
                        {
                            <tr>
                                <td colspan="5">
                                    <Preloader />
                                </td>
                            </tr>
                        }
                        else
                        {
                            @if (UserGroupListModel != null && UserGroupListModel.UserGroups.Any())
                            {
                                if (!UserGroupListModel.UserGroups.Any())
                                {
                                    <tr>
                                        <td colspan="4">
                                            <NoRecordFound Message="@TranslationState.GetValue("No Record Found")" />
                                        </td>
                                    </tr>
                                }

                                foreach (var userGroup in UserGroupListModel.UserGroups)
                                {
                                    <tr>
                                        <td>@userGroup.Num</td>
                                        <td>@userGroup.UserGroupName</td>
                                        <td class="text-center">
                                            <a class="btn btn-view-users" href="javascript:(0)" @onclick="() => OnViewUsersClickEvent(userGroup)">View Users</a>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-center">
                                                <a class="link-edit me-2" href="javascript:(0)" @onclick="() => OnEditUserGroupClickEvent(userGroup)">
                                                    <i class="fa fa-edit"></i>
                                                </a>
                                                <a class="link-logs me-2" href="javascript:(0)" @onclick="() => OnViewUserGroupLogClickEvent(userGroup)">
                                                    <i class="fa fa-list"></i>
                                                </a>
                                                @if (userGroup.UserGroupName.ToLower() == "default")
                                                {
                                                    <a class="link-trash me-2" href="javascript:(0)" disabled>
                                                        <i class="fa fa-trash-o"></i>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="link-trash me-2" href="javascript:(0)" @onclick="() => OnDeleteUserGroupClickEvent(userGroup)">
                                                        <i class="fa fa-trash"></i>
                                                    </a>
                                                }

                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">
                                        <NoRecordFound Message="@TranslationState.GetValue("No Record Found")" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <Pagination MetaData="MetaData" Spread="3" SelectPageEvent="SelectPage" PaginationColspan="5" />
                </table>

            </div>
        </div>
        <div>
            <CustomModal OnSaveClickCallback="OnSaveClickEvent" />
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@AdminPermission.Admin_ManageUserGroups.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>