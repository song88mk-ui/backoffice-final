@using Backoffice.Web.Components.ManageUser

@page "/admin/manage-user"

<div class="row">
    <div class="main-content col-md-12 mb-4 pb-3">
        <div class="row">
            <div class="col-md-12">
                <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
            </div>
            <div class="col-md-12">
                <Filter />
            </div>
            <div class="col-md-12">
                <table class="table table-hover table-borderless mt-4">
                    <thead class="table-head">
                        <tr>
                            <th class="th-no py-3">No</th>
                            <th class="th-username py-3">Username</th>
                            <th class="th-status py-3">Status</th>
                            <th class="th-user-group py-3">Usergroup</th>
                            <th class="th-action py-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>Username 1</td>
                            <td>
                                <span class="status-normal py-1 px-4 rounded-pill">Normal</span>
                            </td>
                            <td>Usergroup 1</td>
                            <td>
                                <a class="link-edit me-2" href="javascript:(0)">
                                    <i class="fa fa-edit"></i>
                                </a>
                                <a class="link-logs me-2" href="javascript:(0)">
                                    <i class="fa fa-list"></i>
                                </a>
                            </td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>Username 2</td>
                            <td>
                                <span class="status-locked py-1 px-4 rounded-pill">Locked</span>
                            </td>
                            <td>Usergroup 1</td>
                            <td>
                                <a class="link-edit me-2" href="javascript:(0)">
                                    <i class="fa fa-edit"></i>
                                </a>
                                <a class="link-logs me-2" href="javascript:(0)">
                                    <i class="fa fa-list"></i>
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>