@using Backoffice.Web.Components.Common
@using Backoffice.Web.Components.Administration.MessageSettlement

@page "/admin/message-settlement"

<AuthorizeView Policy="admin-settlement-message">
    @*<AuthorizeView Policy="disabled">*@
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageHeaderModel="_pageHeaderModel" />
                    </div>
                    <div class="col-md-12">
                        <Filter @bind-FilterModel="FilterModel" OnInitializeCallback="GetContents" OnAddCallback="OnAddClickedEvent" OnExportCallback="OnExportClickedEvent" />
                    </div>
                    <div class="col-md-12 mt-3 ms-3">
                        <span class="fs-6">Manual Message Settlement History</span>
                    </div>
                    <div class="col-md-12">
                        <div class="mx-3 mt-4">
                            @if (IsPreLoader)
                            {
                                <Preloader />
                            }
                            else
                            {
                                <table class="table table-bordered mt-4">
                                    <thead class="table-head">
                                        <tr>
                                            <th>#</th>
                                            <th>Date and Time</th>
                                            <th>Bet ID</th>
                                            <th>@_translationState.GetValue("Sports")</th>
                                            <th>Message Settled</th>
                                            <th>Settled By</th>
                                            <th>Date Settled</th>
                                            <th>Reason</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (MessageSettlementModel != null && MessageSettlementModel.Any())
                                        {
                                            var rowCount = (MetaData.CurrentPage - 1) * MetaData.PageSize;

                                            @foreach (var item in MessageSettlementModel)
                                            {
                                                rowCount++;

                                                <tr>
                                                    <td>
                                                        @rowCount
                                                    </td>
                                                    <td>
                                                        <span class="date d-block">@item.BetDate.ToString("MM/dd/yyyy")</span>
                                                        <span class="time d-block">@item.BetDate.ToString("hh:mm tt")</span>
                                                    </td>
                                                    <td>
                                                        @item.BetId
                                                    </td>
                                                    <td>
                                                        @_translationState.GetValue(item.Sports)
                                                    </td>
                                                    <td>
                                                        @item.MessagesSettled
                                                    </td>
                                                    <td>
                                                        @item.SettledBy
                                                    </td>
                                                    <td>
                                                        <span class="date d-block">@item.DateSettled.ToString("MM/dd/yyyy")</span>
                                                        <span class="time d-block">@item.DateSettled.ToString("hh:mm tt")</span>
                                                    </td>
                                                    <td>
                                                        @item.Reason
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="8">
                                                    <NoRecordFound Message="@_translationState.GetValue("No Record Found")" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <Pagination MetaData="MetaData" Spread="3" SelectPageEvent="SelectPage" PaginationColspan="6" />
                                </table>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <CustomModal OnSaveClickCallback="OnSaveClickedEvent" />
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@AdminPermission.Admin_Settlements_MessageSettlement.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>