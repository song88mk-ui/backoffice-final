<div class="p-4">
    <p>Are you sure you want to delete <strong>@TranslationKey</strong>? This removes the key and its translations in <strong>all languages</strong>.</p>
    <div class="d-flex justify-content-end">
        <button type="button" class="btn btn-secondary me-2" @onclick="CancelDelete">Cancel</button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
    </div>
</div>
