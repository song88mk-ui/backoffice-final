@using Backoffice.Web.Components.Common
@using Backoffice.Web.Components.TopLeagues

@page "/top-leagues"

<AuthorizeView Policy="sbc-menu-topleagues">
    <Authorized>
<div class="row">
    <div class="main-content col-md-12 mb-4 pb-3">
        <div class="row">
            <div class="col-md-12">
                <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
            </div>
            <div class="col-md-12">
                <Filter OnInitCallback="OnInitEvent" OnFilterCallback="OnFilterEvent" />
            </div>
            <div class="col-md-12">
                <div class="content mx-3">
                    <table class="table table-hover table-borderless mt-4">
                        <thead class="table-head">
                            <tr>
                                <th class="th-number py-2">No.</th>
                                <th class="th-client py-2">Client</th>
                                <th class="th-top-leagues py-2">Top Leagues</th>
                                <th class="th-action py-2">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (TopLeaguesList != null && TopLeaguesList.ClientTopLeagues.Any())
                            {
                                @foreach (var item in TopLeaguesList.ClientTopLeagues)
                                {
                                    <tr>
                                        <td class="py-2">
                                            <span>@item.RowNo</span>
                                        </td>
                                        <td class="py-2">
                                            <span>@item.ClientName</span>
                                        </td>
                                        <td class="py-2">
                                            <div class="w-100 m-auto d-flex flex-row flex-wrap justify-content-start align-items-center">
                                                @foreach (var x in item.TopLeagues)
                                                {
                                                    <div class="tl-fixture m-1 py-1 rounded-2">
                                                        <span class="px-3">@x.SegmentName > @x.LeagueName</span>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                        <td class="py-2">
                                            <a class="tl-link-edit me-2" href="javascript:(0)" @onclick="_ => OnEditClickEvent(item)">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            @if (item.TopLeagues.Any())
                                            {
                                                <a class="tl-link-copy me-2" href="javascript:(0)" @onclick="_ => OnCopyClickEvent(item)">
                                                    <i class="fa fa-copy"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a class="tl-link-copy-disabled me-2">
                                                    <i class="fa fa-copy"></i>
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <Pagination MetaData="MetaData" Spread="3" PaginationColspan="3" SelectPageEvent="SelectPage" />
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div>
    <CustomModal OnSaveClickCallback="OnSaveClickEvent" />
</div>
    </Authorized>
    <NotAuthorized>
    </NotAuthorized>
</AuthorizeView>