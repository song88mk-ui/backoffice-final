@inherits BasePage

@page "/sports"

<AuthorizeView Policy="sbc-sports">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageHeaderModel="_pageHeaderModel" />
                    </div>
                    @if (!string.IsNullOrEmpty(IFrameSrc))
                    {
                        <iframe class="tableau-iframe" src="@IFrameSrc"></iframe>
                    }
                </div>
            </div>
        </div>
        <CustomModal />
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@SportsbookClientPermission.SBC_Reports_Sports.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>