@inherits BasePage

@page "/dashboard"

<AuthorizeView Policy="sbc-dashboard">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageHeaderModel="PageHeaderModel" />
                    </div>
                    @if (!string.IsNullOrEmpty(_iFrameSrc))
                    {
                        <iframe class="tableau-iframe" src="@_iFrameSrc"></iframe>
                    }
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@SportsbookClientPermission.SBC_Dashboard.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>