@inherits BasePage

@page "/dashboard"

<AuthorizeView Policy="sbc-dashboard">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageHeaderModel="PageHeaderModel" />
                    </div>
                    @if (_isPreLoader)
                    {
                        <Preloader />
                    }
                    else if (!string.IsNullOrEmpty(_iFrameSrc))
                    {
                        <iframe class="metabase-iframe" src="@_iFrameSrc"></iframe>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            The current user does not have access to the dashboard.
                        </div>
                    }
                </div>
            </div>
        </div>
        <CustomModal />
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@SportsbookClientPermission.SBC_Dashboard.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>