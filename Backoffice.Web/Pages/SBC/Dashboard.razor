@page "/dashboard"

<div class="row">
    <div class="main-content col-md-12 mb-4 pb-3">
        <div class="row">
            <div class="col-md-12">
                <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
            </div>
            @if (!string.IsNullOrEmpty(IFrameSrc))
            {
               @* <object class="tableauViz" width="900" height="700">
                    <param name="path" value="@IFrameSrc" />
                </object> *@

                <iframe src="@IFrameSrc" width="800" height="600"></iframe>
            }
        </div>
    </div>
</div>