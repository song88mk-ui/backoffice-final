@inherits BasePage
@using Backoffice.Web.Models
@using Backoffice.Web.Components.Common
@using Backoffice.Web.Shared
@using Backoffice.Shared.Enums
@using Microsoft.AspNetCore.Components.Authorization

@page "/translations/dynamic"

<AuthorizeView>
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageHeaderModel="_pageHeaderModel" />
                    </div>
                    <div class="col-md-12">
                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @_errorMessage
                            </div>
                        }

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="languageSelect" class="form-label">Language</label>
                                <select id="languageSelect" class="form-select" value="@SelectedLanguageCode" @onchange="OnLanguageChanged">
                                    <option value="EN">English (EN)</option>
                                    <option value="JA">Japanese (JA)</option>
                                    <option value="BR">Portuguese (BR)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="searchInput" class="form-label white-label">Search Translations</label>
                                <div class="input-group">
                                    <input id="searchInput" type="text" class="form-control" placeholder="Search by String ID or Source Text" @bind-value="SearchText" @bind-value:event="oninput" />
                                    <span class="input-group-text bg-white border-start-0">
                                        <img src="icons/svg/icon-search.svg" alt="Search Icon" style="width:16px;height:16px;" />
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-semibold">Page @MetaData.CurrentPage of @Math.Max(MetaData.TotalPages, 1)</span>
                                    <span class="text-muted">(@MetaData.TotalCount glossary terms)</span>
                                </div>
                            </div>
                            <div class="col-md-6 d-flex justify-content-end align-items-center gap-2">
                                <label class="mb-0">Items per page</label>
                                <select class="form-select form-select-sm w-auto" value="@MetaData.PageSize" @onchange="OnPageSizeChanged">
                                    <option value="10">10</option>
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mb-3 gap-2">
                            <button class="add-translation-btn" @onclick="OnAddGlossary">Add Glossary Term</button>
                        </div>

                        @if (Glossary.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-header">
                                        <tr>
                                            <th>String ID</th>
                                            <th>Source Text (EN)</th>
                                            <th>Translation (@SelectedLanguageCode)</th>
                                            <th>Processed</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var entry in Glossary)
                                        {
                                            <tr>
                                                <td>@entry.StringId</td>
                                                <td>@entry.SourceText</td>
                                                <td>@entry.TargetText</td>
                                                <td>@(entry.Processed ? "Yes" : "No")</td>
                                                <td class="d-flex">
                                                    <img @onclick="() => OnEditGlossary(entry)" src="icons/svg/icon-edit.svg" alt="edit Icon">
                                                    <img @onclick="() => OnDeleteGlossary(entry)" src="icons/svg/icon-delete.svg" alt="delete Icon">
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="pagination-container">
                                <span class="pagination-info">Showing @Glossary.Count of @MetaData.TotalCount</span>
                                <div class="d-flex align-items-center gap-1 flex-wrap justify-content-end">
                                    <button class="btn btn-sm pagination-label" @onclick="PreviousPage" disabled="@(!MetaData.HasPrevious)">@("<")</button>
                                    @if (MetaData.TotalPages > 0)
                                    {
                                        @if (PageNumbers.Any() && PageNumbers.First() > 1)
                                        {
                                            <button class="btn btn-sm pagination-label" @onclick="() => GoToPage(1)">1</button>
                                            <span class="px-2">...</span>
                                        }

                                        @foreach (var pageNumber in PageNumbers)
                                        {
                                            <button class="btn btn-sm @(pageNumber == MetaData.CurrentPage ? "selected-page" : "pagination-label")" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                                        }

                                        @if (PageNumbers.Any() && PageNumbers.Last() < MetaData.TotalPages)
                                        {
                                            <span class="px-2">...</span>
                                            <button class="btn btn-sm pagination-label" @onclick="() => GoToPage(MetaData.TotalPages)">@MetaData.TotalPages</button>
                                        }
                                    }
                                    <button class="btn btn-sm pagination-label" @onclick="NextPage" disabled="@(!MetaData.HasNext)">@(">")</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info" role="alert">
                                No glossary terms found for the selected language/search.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <CustomModal />
    </Authorized>
    <NotAuthorized>
        <LoginRedirect />
    </NotAuthorized>
</AuthorizeView>
