<div class="p-4">
    <div class="mb-3">
        <label class="form-label">Translation Key</label>
        <input class="form-control" @bind="TranslationKey" @bind:event="oninput" disabled="@(!IsNew)" />
        @if (!IsNew)
        {
            <small class="text-muted">Key cannot be changed after creation.</small>
        }
    </div>
    <div class="mb-3">
        <label class="form-label">Source Text (EN)</label>
        <textarea class="form-control" rows="3" @bind="SourceText" @bind:event="oninput"></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Translation (@SelectedLanguageCode)</label>
        <textarea class="form-control" rows="3" @bind="TargetText" @bind:event="oninput"></textarea>
    </div>
    <div class="d-flex justify-content-end">
        <button type="button" class="btn btn-secondary me-2" @onclick="CancelEdit">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="SaveEdit" disabled="@(string.IsNullOrWhiteSpace(TranslationKey) || string.IsNullOrWhiteSpace(SourceText))">Save</button>
    </div>
</div>
