<div class="p-4">
    <div class="mb-3">
        <label class="form-label">Translation Key</label>
        <input class="form-control" value="@TranslationKey" readonly />
    </div>
    <div class="mb-3">
        <label class="form-label">Translation Value</label>
        <textarea class="form-control" rows="5" @bind="TranslationValue"></textarea>
    </div>
    <div class="d-flex justify-content-end">
        <button type="button" class="btn btn-secondary me-2" @onclick="CancelEdit">Cancel</button>
        <button type="button" class="btn btn-primary" @onclick="SaveEdit">Save</button>
    </div>
</div>
