@inherits BasePage
@using Backoffice.Web.Models
@using Backoffice.Web.Components.Common
@using Backoffice.Web.Shared
@using Backoffice.Shared.Enums
@using Microsoft.AspNetCore.Components.Authorization

@page "/translations/static"

<AuthorizeView Policy="translations-static">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageHeaderModel="_pageHeaderModel" />
                    </div>
                    <div class="col-md-12">
                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @_errorMessage
                            </div>
                        }
                        @if (SourceTranslations != null)
                        {
                             <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="languageSelect" class="form-label">Language</label>
                                    <select id="languageSelect" class="form-select" value="@SelectedLanguageCode" @onchange="OnLanguageChanged">
                                        <option value="ZH">Chinese (ZH)</option>
                                        <option value="JA">Japanese (JA)</option>
                                        <option value="BR">Portuguese (BR)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="searchInput" class="form-label">Search Translations</label>
                                    <div class="input-group">
                                        <input id="searchInput" type="text" class="form-control" placeholder="Search by Key, Source Text or Translation" @bind-value="SearchText" @bind-value:event="oninput" />
                                        <span class="input-group-text bg-white border-start-0">
                                            <img src="icons/svg/icon-search.svg" alt="Search Icon" style="width:16px;height:16px;" />
                                        </span>
                                    </div>
                                    <div class="form-check mt-1">
                                        <input type="checkbox" class="form-check-input" id="exactMatch" @bind="ExactMatch" />
                                        <label class="form-check-label" for="exactMatch">Exact match</label>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-semibold">Page @CurrentPage of @Math.Max(TotalPages, 1)</span>
                                        <span class="text-muted">(@TotalFilteredCount translations)</span>
                                    </div>
                                </div>
                                <div class="col-md-6 d-flex justify-content-end align-items-center gap-2">
                                    <label class="mb-0">Items per page</label>
                                    <select class="form-select form-select-sm w-auto" value="@PageSize" @onchange="OnPageSizeChanged">
                                        <option value="10">10</option>
                                        <option value="20">20</option>
                                        <option value="50">50</option>
                                    </select>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="showOnlyUntranslated" @bind="ShowOnlyUntranslated" />
                                    <label class="form-check-label" for="showOnlyUntranslated">Show only untranslated</label>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-secondary" @onclick="OnExportToExcel" disabled="@(!CanExportToExcel)">
                                        <i class="fa fa-file-excel-o me-1"></i>
                                        Export to Excel
                                    </button>
                                    <AuthorizeView Policy="translations-static-canedit" Context="canEdit">
                                        <button class="add-translation-btn" @onclick="OnAddTranslation">Add Translation</button>
                                    </AuthorizeView>
                                </div>
                            </div>

                            @if (_stats.Any())
                            {
                                <div class="text-muted small mb-3">
                                    @foreach (var stat in _stats)
                                    {
                                        <span class="badge @(stat.UntranslatedCount == 0 ? "bg-success" : "bg-warning text-dark") me-2"
                                              title="@(stat.TranslatedCount) of @(stat.TotalCount) keys translated">
                                            @stat.LanguageCode: @stat.TranslatedCount/@stat.TotalCount
                                            @(stat.TotalCount > 0 ? $"({stat.TranslatedCount * 100 / stat.TotalCount}%)" : "")
                                        </span>
                                    }
                                </div>
                            }

                            @if (FilteredRows.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-header">
                                            <tr>
                                                <th>Key</th>
                                                <th>Source Text (EN)</th>
                                                <th>Translation (@SelectedLanguageCode)</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in PagedRows)
                                            {
                                                <tr>
                                                    <td>@row.Key</td>
                                                    <td class="@(string.IsNullOrWhiteSpace(row.SourceText) ? "table-warning" : "")">
                                                        @if (string.IsNullOrWhiteSpace(row.SourceText))
                                                        {
                                                            <em class="text-muted">— missing —</em>
                                                        }
                                                        else
                                                        {
                                                            @row.SourceText
                                                        }
                                                    </td>
                                                    <td class="@(string.IsNullOrWhiteSpace(row.TargetText) ? "table-warning" : "")">
                                                        @if (string.IsNullOrWhiteSpace(row.TargetText))
                                                        {
                                                            <em class="text-muted">— missing —</em>
                                                        }
                                                        else
                                                        {
                                                            @row.TargetText
                                                        }
                                                    </td>
                                                    <td>
                                                        <AuthorizeView Policy="translations-static-canedit" Context="canEdit">
                                                            <div class="d-flex align-items-center gap-2">
                                                                <img @onclick="() => OnEditTranslation(row)" src="icons/svg/icon-edit.svg" alt="edit Icon">
                                                                <img @onclick="() => OnDeleteTranslation(row)" src="icons/svg/icon-trash.svg" alt="delete Icon">
                                                            </div>
                                                        </AuthorizeView>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="pagination-container">
                                    <span class="pagination-info">Showing @PagedRows.Count() of @TotalFilteredCount</span>
                                    <div class="d-flex align-items-center gap-1 flex-wrap justify-content-end">
                                        <button class="btn btn-sm pagination-label" @onclick="PreviousPage" disabled="@(CurrentPage <= 1)">@("<")</button>
                                        @if (TotalPages > 0)
                                        {
                                            @if (PageNumbers.Any() && PageNumbers.First() > 1)
                                            {
                                                <button class="btn btn-sm pagination-label" @onclick="() => GoToPage(1)">1</button>
                                                <span class="px-2">...</span>
                                            }

                                            @foreach (var pageNumber in PageNumbers)
                                            {
                                                <button class="btn btn-sm @(pageNumber == CurrentPage ? "selected-page" : "pagination-label")" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                                            }

                                            @if (PageNumbers.Any() && PageNumbers.Last() < TotalPages)
                                            {
                                                <span class="px-2">...</span>
                                                <button class="btn btn-sm pagination-label" @onclick="() => GoToPage(TotalPages)">@TotalPages</button>
                                            }
                                        }
                                        <button class="btn btn-sm pagination-label" @onclick="NextPage" disabled="@(CurrentPage >= TotalPages)">@(">")</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info" role="alert">
                                    No translations found for the selected language.
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-info" role="alert">
                                Loading translations...
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <CustomModal />
    </Authorized>
    <NotAuthorized>
        <LoginRedirect />
    </NotAuthorized>
</AuthorizeView>
