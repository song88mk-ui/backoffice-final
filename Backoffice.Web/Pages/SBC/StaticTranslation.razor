@inherits BasePage
@using Backoffice.Web.Models
@using Backoffice.Web.Components.Common
@using Backoffice.Web.Shared
@using Backoffice.Shared.Enums
@using Microsoft.AspNetCore.Components.Authorization

@page "/translations/static"

<AuthorizeView>
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageHeaderModel="_pageHeaderModel" />
                    </div>
                    <div class="col-md-12">
                        @if (Translations != null)
                        {
                             <div class="row mb-3">
                                <div class="col-md-6">
                                    <label for="languageSelect" class="form-label">Language</label>
                                    <select id="languageSelect" class="form-select" value="@SelectedLanguageCode" @onchange="OnLanguageChanged">
                                        <option value="EN">English (EN)</option>
                                        <option value="JA">Japanese (JA)</option>
                                        <option value="BR">Portuguese (BR)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="searchInput" class="form-label white-label">Search Translations</label>
                                    <div class="input-group">
                                        <input id="searchInput" type="text" class="form-control" placeholder="Search" @bind-value="SearchText" @bind-value:event="oninput" />
                                        <span class="input-group-text bg-white border-start-0">
                                            <img src="icons/svg/icon-search.svg" alt="Search Icon" style="width:16px;height:16px;" />
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-semibold">Page @CurrentPage of @Math.Max(TotalPages, 1)</span>
                                        <span class="text-muted">(@TotalFilteredCount translations)</span>
                                    </div>
                                </div>
                                <div class="col-md-6 d-flex justify-content-end align-items-center gap-2">
                                    <label class="mb-0">Items per page</label>
                                    <select class="form-select form-select-sm w-auto" value="@PageSize" @onchange="OnPageSizeChanged">
                                        <option value="10">10</option>
                                        <option value="20">20</option>
                                        <option value="50">50</option>
                                    </select>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mb-3">
                                <button class="add-translation-btn" @onclick="OnAddTranslation">Add Translation</button>
                            </div>

                            @if (FilteredTranslations.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-header">
                                            <tr>
                                                <th>Key</th>
                                                <th>Value</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var translation in PagedTranslations)
                                            {
                                                <tr>
                                                    <td>@translation.Key</td>
                                                    <td>@translation.Value</td>
                                                    <td class="d-flex">
                                                        <img @onclick="() => OnEditTranslation(translation)" src="icons/svg/icon-edit.svg" alt="edit Icon">
                                                        @* <img @onclick="() => OnDeleteTranslation(translation)" src="icons/svg/icon-delete.svg" alt="delete Icon"> *@
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="pagination-container">
                                    <span class="pagination-info">Showing @PagedTranslations.Count() of @TotalFilteredCount</span>
                                    <div class="d-flex align-items-center gap-1 flex-wrap justify-content-end">
                                        <button class="btn btn-sm pagination-label" @onclick="PreviousPage" disabled="@(CurrentPage <= 1)">@("<")</button>
                                        @if (TotalPages > 0)
                                        {
                                            @if (PageNumbers.Any() && PageNumbers.First() > 1)
                                            {
                                                <button class="btn btn-sm pagination-label" @onclick="() => GoToPage(1)">1</button>
                                                <span class="px-2">...</span>
                                            }

                                            @foreach (var pageNumber in PageNumbers)
                                            {
                                                <button class="btn btn-sm @(pageNumber == CurrentPage ? "selected-page" : "pagination-label")" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                                            }

                                            @if (PageNumbers.Any() && PageNumbers.Last() < TotalPages)
                                            {
                                                <span class="px-2">...</span>
                                                <button class="btn btn-sm pagination-label" @onclick="() => GoToPage(TotalPages)">@TotalPages</button>
                                            }
                                        }
                                        <button class="btn btn-sm pagination-label" @onclick="NextPage" disabled="@(CurrentPage >= TotalPages)">@(">")</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info" role="alert">
                                    No translations found for the selected language.
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-info" role="alert">
                                Loading translations...
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <CustomModal />
    </Authorized>
    <NotAuthorized>
        <LoginRedirect />
    </NotAuthorized>
</AuthorizeView>
