@using Backoffice.Web.Components.Common
@using Backoffice.Web.Components.SBC.Announcements

@page "/announcements"
<AuthorizeView Policy="sbc-announcements">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageHeaderModel="_pageHeaderModel" />
                    </div>
                    <div class="col-md-12">
                        <Filter OnInitCallback="OnInitEvent" OnFilterCallback="OnFilterEvent" />
                    </div>
                    <div class="col-md-12">
                        <div class="content mx-3">
                            <table class="table table-hover table-borderless mt-4">
                                <thead class="table-head">
                                    <tr>
                                        <th class="th-number py-2">@TranslationState.GetValue("No.")</th>
                                        <th class="th-title py-2">@TranslationState.GetValue("Title")</th>
                                        <th class="th-client py-2">@TranslationState.GetValue("Clients")</th>
                                        <th class="th-description py-2">@TranslationState.GetValue("Description")</th>
                                        <th class="th-date py-2">@TranslationState.GetValue("Start Date")</th>
                                        <th class="th-date py-2">@TranslationState.GetValue("End Date")</th>
                                        <th class="th-status py-2">@TranslationState.GetValue("Status")</th>
                                        <th class="th-action py-2">@TranslationState.GetValue("Action")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_isPreLoader)
                                    {
                                        <tr>
                                            <td colspan=8>
                                                <Preloader />
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        if (_model != null && _model.Announcements.Any())
                                        {
                                            foreach (var item in _model.Announcements)
                                            {
                                                <tr>
                                                    <td class="py-2">
                                                        <span>@item.Row</span>
                                                    </td>
                                                    <td class="py-2">
                                                        <span>@item.Title</span>
                                                    </td>
                                                    <td class="py-2">
                                                        <div class="w-100 m-auto d-flex flex-row flex-wrap justify-content-start align-items-center">
                                                            @foreach (var x in item.Clients)
                                                            {
                                                                <div class="tl-fixture m-1 py-1 rounded-2">
                                                                    <span class="px-3">@x.ClientCode</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td class="py-2">
                                                        <span>@item.Message</span>
                                                    </td>
                                                    <td class="py-2">
                                                        <span>@item.StartDate.ToString("MM/dd/yy HH:mm")</span>
                                                    </td>
                                                    <td class="py-2">
                                                        <span>@item.EndDate.ToString("MM/dd/yy HH:mm")</span>
                                                    </td>
                                                    <td class="py-2">
                                                        <span>@item.IsActive</span>
                                                    </td>
                                                    <td class="py-2">
                                                        <AuthorizeView Policy="sbc-announcements-canedit">
                                                            <Authorized Context="ActivateAll">
                                                                <a class="tl-link-edit me-2" href="javascript:(0)" @onclick="item.EditAction">
                                                                    <i class="fa fa-edit" />
                                                                </a>
                                                                <a class="link-delete me-2" href="javascript:(0)" @onclick="item.DeleteAction">
                                                                    <i class="fa fa-trash" />
                                                                </a>
                                                            </Authorized>
                                                            <NotAuthorized Context="ActivateAll">
                                                                <a class="tl-link-edit me-2" href="javascript:(0)" disabled>
                                                                    <i class="fa fa-edit"></i>
                                                                </a>
                                                                <a class="tl-link-delete me-2" href="javascript:(0)" disabled>
                                                                    <i class="fa fa-trash"></i>
                                                                </a>
                                                            </NotAuthorized>
                                                        </AuthorizeView>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan=8>
                                                    <NoRecordFound Message="@TranslationState.GetValue("No Record Found")" />
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <Pagination MetaData="MetaData" Spread="3" PaginationColspan="7" SelectPageEvent="SelectPage" />
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <CustomModal />
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@SportsbookClientPermission.SBC_Settings_Announcements.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>