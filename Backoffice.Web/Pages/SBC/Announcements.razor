@using Backoffice.Web.Components.Common
@using Backoffice.Web.Components.SBC.Announcements

@page "/announcements"
<AuthorizeView Policy="sbc-announcements">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="announcements-header col-md-12">
                        <PageHeader PageHeaderModel="_pageHeaderModel" PageHeaderClass="announcements" />
                    </div>
                    @if (_alerts != null && _alerts.Any())
                    {
                        foreach (var alert in _alerts)
                        {
                            <div class="col-md-12 mt-4 ">
                                <div class="mx-3">
                                    <AlertMessage AlertModel="@alert" />
                                </div>
                            </div>
                        }
                    }
                    <div class="announcements-filter-group col-md-12">
                        <Filter OnInitCallback="OnInitEvent" OnFilterCallback="OnFilterEvent" />
                    </div>
                    <div class="col-md-12">
                        <div class="announcements-content mx-3">
                            <table class="table table-borderless">
                                <thead class="table-head">
                                    <tr>
                                        <th class="th-number">@TranslationState.GetValue("No.")</th>
                                        <th class="th-title">@TranslationState.GetValue("Title")</th>
                                        <th class="th-client">@TranslationState.GetValue("Clients")</th>
                                        <th class="th-languages">@TranslationState.GetValue("Languages")</th>
                                        <th class="th-description">@TranslationState.GetValue("Description")</th>
                                        <th class="th-date">@TranslationState.GetValue("Start Date (UTC)")</th>
                                        <th class="th-date">@TranslationState.GetValue("End Date (UTC)")</th>
                                        <th class="th-status">@TranslationState.GetValue("Status")</th>
                                        <AuthorizeView Policy="sbc-announcements-canedit">
                                            <Authorized Context="ActivateAll">
                                                <th class="th-action"></th>
                                            </Authorized>
                                        </AuthorizeView>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_isPreLoader)
                                    {
                                        <tr>
                                            <td colspan=8>
                                                <Preloader />
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        if (_model != null && _model.Announcements.Any())
                                        {
                                            foreach (var item in _model.Announcements)
                                            {
                                                <tr class="content-row">
                                                    <td class="content-cell">
                                                        <span>@item.Row</span>
                                                    </td>
                                                    <td class="content-cell title">
                                                        <span>@item.Title.ToUpper()</span>
                                                    </td>
                                                    <td class="content-cell client">
                                                        <div class="clients-container">
                                                            <span class="client-visible">@(GetClientsConcat(item.Clients))</span>
                                                            @if (ShowClientsCount(item.Clients))
                                                            {
                                                                <div class="clients-count">+@(GetHiddenClientsCount(item.Clients))</div>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td class="content-cell languages">
                                                        <span class="languages-concat">@(GetLanguagesConcat(item.Languages))</span>
                                                    </td>
                                                    <td class="content-cell message">
                                                        <span class="text">@item.Message</span>
                                                    </td>
                                                    <td class="content-cell date">
                                                        <span>@item.StartDate.ToString("MM/dd/yy HH:mm")</span>
                                                    </td>
                                                    <td class="content-cell date">
                                                        <span>@item.EndDate.ToString("MM/dd/yy HH:mm")</span>
                                                    </td>
                                                    <td class="content-cell status">
                                                        <div class="status-container @(item.IsActive ? "active-status" : "inactive-status")">
                                                            <div class="dot"></div>
                                                            <span>@(GetStatusLabel(item.IsActive))</span>
                                                        </div>
                                                    </td>
                                                    <AuthorizeView Policy="sbc-announcements-canedit">
                                                        <Authorized Context="ActivateAll">
                                                            <td class="content-cell actions">
                                                                <a class="tl-link-edit @item.DisabledClass" href="javascript:(0)" @onclick="item.EditAction">
                                                                    <i class="fa fa-edit" />
                                                                </a>
                                                                <a class="tl-link-delete @item.DisabledClass" href="javascript:(0)" @onclick="item.DeleteAction">
                                                                    <i class="fa fa-trash" />
                                                                </a>
                                                            </td>
                                                        </Authorized>
                                                    </AuthorizeView>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan=8>
                                                    <NoRecordFound Message="@TranslationState.GetValue("No Record Found")" />
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <Pagination MetaData="MetaData" Spread="3" PaginationColspan="7" SelectPageEvent="SelectPage" />
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <CustomModal OnSaveClickCallback="OnSaveClickEvent" />
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@SportsbookClientPermission.SBC_Settings_Announcements.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>