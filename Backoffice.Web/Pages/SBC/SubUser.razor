@using Backoffice.Web.Components.Common
@using Backoffice.Web.Components.SBC.SubUser

@page "/sub-user"

<AuthorizeView Policy="sbc-subusers">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageHeaderModel="_pageHeaderModel" />
                    </div>
                    @if (Alerts != null && Alerts.Any())
                    {
                        foreach (var alert in Alerts)
                        {
                            <div class="col-md-12 mt-4 ">
                                <div class="mx-3">
                                    <AlertMessage AlertModel="@alert" />
                                </div>
                            </div>
                        }
                    }
                    <div class="col-md-12">
                        <Filter OnInitCallback="OnInitEvent" OnCreateSubUserCallback="OnCreateSubUserClickEvent" />
                    </div>
                    <div class="col-md-12">
                        <table class="table table-hover table-borderless mt-4">
                            <thead class="table-head">
                                <tr>
                                    <th class="th-username py-3">Username</th>
                                    <th class="th-nickname py-3">Nickname</th>
                                    <th class="th-date-created py-3">Date Created</th>
                                    <th class="th-status py-3">Status</th>
                                    <th class="th-preference py-3">Sub User Preference</th>
                                    <th class="th-manage py-3">Manage</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (SubUsers.Users.Any())
                                {
                                    foreach (var user in SubUsers.Users)
                                    {
                                        <tr>
                                            <td>
                                                <span class="fw-bold">@user.UserName</span>
                                            </td>
                                            <td>@user.NickName</td>
                                            <td>@user.CreatedDate.ToString("MM/dd/yyyy")</td>
                                            <td>
                                                @if (user.Status == "Normal")
                                                {
                                                    <span class="status-normal py-1 px-4 rounded-pill">Normal</span>
                                                }
                                                else
                                                {
                                                    <span class="status-locked py-1 px-4 rounded-pill">Locked</span>
                                                }
                                            </td>
                                            <td class="text-break">
                                                @if (user.Claims != null && user.Claims.Any())
                                                {
                                                    @($"{GetClaimsList(user.Claims)}")
                                                }
                                            </td>
                                            <td>
                                                <AuthorizeView Policy="sbc-subusers-canedit">
                                                    <Authorized Context="ActivateAll">
                                                        <a class="link-edit me-2" href="javascript:(0)" @onclick="() => OnEditSubUserClickEvent(user)">
                                                            <i class="fa fa-edit"></i>
                                                        </a>
                                                    </Authorized>
                                                    <NotAuthorized Context="ActivateAll">
                                                        <a class="link-edit me-2" href="javascript:(0)">
                                                            <i class="fa fa-edit"></i>
                                                        </a>
                                                    </NotAuthorized>
                                                </AuthorizeView>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <Pagination MetaData="MetaData" Spread="3" SelectPageEvent="SelectPage" PaginationColspan="4" />
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <CustomModal OnSaveClickCallback="OnSaveClickEvent" />
        </div>
    </Authorized>
    <NotAuthorized>
        @{
            JSRuntime.InvokeVoidAsync("console.log", "Sub-User = Unauthorized");
        }
        <RedirectToPage FromPage="@SportsbookClientPermission.SBC_SubUsers.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>