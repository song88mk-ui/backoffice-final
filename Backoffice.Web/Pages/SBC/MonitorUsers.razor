@page "/monitor-users"

<AuthorizeView Policy="sbc-monitor-users">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
                    </div>
                    @if (!string.IsNullOrEmpty(Token) && !string.IsNullOrEmpty(IFrameSrc))
                    {
                        <div class="col-md-12">
                                <tableau-viz id='tableau-viz'
                                         src='@IFrameSrc'
                                         token="@Token"
                                         toolbar='bottom'
                                         hide-tabs
                                         hide-edit-button>
                            </tableau-viz>
                        </div>
                    }
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
</AuthorizeView>