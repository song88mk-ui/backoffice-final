@page "/drill-down-report"
@using System.Text.Json;

<AuthorizeView Policy="sbc-drilldown">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
                    </div>
                    @if (!string.IsNullOrEmpty(IFrameSrc))
                    {
                        @* <object class="tableauViz" width="900" height="700">
                    <param name="path" value="@IFrameSrc" />
                    </object> *@

                        <iframe class="tableau-iframe" src="@IFrameSrc"></iframe>
                    }
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <AccessDenied />
    </NotAuthorized>
</AuthorizeView>