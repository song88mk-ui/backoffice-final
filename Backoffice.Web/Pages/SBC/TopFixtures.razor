@using Backoffice.Web.Components.Common
@using Backoffice.Web.Components.SBC.TopFixtures

@page "/top-fixtures"


<AuthorizeView Policy="sbc-topfixtures">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
                    </div>
                    <div class="col-md-12">
                        <Filter OnInitCallback="OnInitEvent" OnFilterCallback="OnFilterEvent" />
                    </div>
                    <div class="col-md-12">
                        <div class="content mx-3">
                            <table class="table table-hover table-borderless mt-4">
                                <thead class="table-head">
                                    <tr>
                                        <th class="th-number py-2">No.</th>
                                        <th class="th-client py-2">Client</th>
                                        <th class="th-top-fixtures py-2">Top Fixtures</th>
                                        <th class="th-action py-2">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (IsPreLoader)
                                    {
                                        <tr>
                                            <td colspan=4>
                                                <Preloader />
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @if (TopFixturesModel.TopFixturesFiltered.Any())
                                        {
                                            var rowCount = (MetaData.CurrentPage - 1) * MetaData.PageSize;

                                            foreach (var model in TopFixturesModel.TopFixturesFiltered)
                                            {
                                                rowCount++;

                                                <tr>
                                                    <td class="py-2">
                                                        <span>@rowCount</span>
                                                    </td>
                                                    <td class="py-2">
                                                        <span>@model.ClientName</span>
                                                    </td>
                                                    <td class="py-2">
                                                        <div class="w-100 m-auto d-flex flex-row flex-wrap justify-content-start align-items-center">
                                                            @if (model.TopFixtures != null && model.TopFixtures.Any())
                                                            {
                                                                foreach (var fixture in model.TopFixtures)
                                                                {
                                                                    <div class="tl-fixture m-1 py-1 rounded-2">
                                                                        <span class="px-3">@fixture.FixtureName</span>
                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    </td>
                                                    <td class="py-2">
                                                        <AuthorizeView Policy="sbc-topfixtures-canedit">
                                                            <Authorized Context="ActivateAll">
                                                                <a class="tl-link-edit me-2" href="javascript:(0)" @onclick="() => OnEditClickEvent(model)">
                                                                    <i class="fa fa-edit"></i>
                                                                </a>
                                                                @if (model.TopFixtures != null && model.TopFixtures.Any())
                                                                {
                                                                    <a class="tl-link-copy me-2" href="javascript:(0)" @onclick="() => OnCopyClickEvent(model)">
                                                                        <i class="fa fa-copy"></i>
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <a class="tl-link-copy me-2 disabled" href="javascript:(0)">
                                                                        <i class="fa fa-copy"></i>
                                                                    </a>
                                                                }
                                                            </Authorized>
                                                            <NotAuthorized Context="ActivateAll">
                                                                <a class="tl-link-edit me-2" href="javascript:(0)" disabled>
                                                                    <i class="fa fa-edit"></i>
                                                                </a>
                                                                <a class="tl-link-copy me-2 disabled" href="javascript:(0)">
                                                                    <i class="fa fa-copy"></i>
                                                                </a>
                                                            </NotAuthorized>
                                                        </AuthorizeView>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan=4>
                                                    <NoRecordFound />
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <Pagination MetaData="MetaData" Spread="3" SelectPageEvent="SelectPage" PaginationColspan="2" />
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <CustomModal OnSaveClickCallback="OnSaveClickEvent" />
        </div>
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@SportsbookClientPermission.SBC_Settings_TopFixtures.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>