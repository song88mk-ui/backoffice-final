@page "/login"

@using Backoffice.Web.States
@using Microsoft.AspNetCore.Authorization
@using Backoffice.Shared.Extensions;

@model Backoffice.Web.Pages.Authentication.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@attribute [AllowAnonymous]

@{
    var hasError = TempData["HasError"] != null ? bool.Parse(TempData["HasError"].ToString()) : false;
    var logError = TempData["LogError"];

    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

    <link href="css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="css/flags.css" rel="stylesheet" />
    <link href="css/font-awesome/css/font-awesome.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="css/login.css" />
    <link rel="stylesheet" href="css/site.css" />
    <!-- script -->
    <script src="js/bootstrap.bundle.min.js"></script>

    <!-- preload images and svg -->
    <link rel="preload" as="image" href="background/login-background-image.png" />
    <link rel="preload" as="image" type="image/svg+xml" href="icons/svg/song88-login-logo.svg" />
    <link rel="preload" as="image" type="image/svg+xml" href="icons/svg/login-banner-icons.svg" />

    <title>
        Backoffce - Login
    </title>
</head>
<body>
    <div class="access-layout">
        <div class="page">
            <div class="row h-100">
                <div class="col-6 first-banner d-flex flex-column justify-content-center align-items-center">
                    <div class="first-header-text">
                        @Model.Translations.GetValue("Welcome to")
                    </div>
                    <div class="second-header-text mb-3">
                        @Model.Translations.GetValue("Back Office")
                    </div>
                    <div class="banner-icons">
                        <img src="icons/svg/login-banner-icons.svg" alt="login banner icons" />
                    </div>
                </div>
                <div class="col-6 second-banner d-flex flex-column justify-content-center align-items-center">
                    <div class="w-75 mx-4 login-container">
                        <div class="col-12 d-flex justify-content-end">
                            @* Translation *@
                            @if (Model.LanguageCodes != null)
                            {
                                <form method="post">
                                    <div class="d-flex align-items-center">
                                        <div class="dropdown">
                                            <button class="btn btn-secondary @(Model.LanguageCodes.Any() ? "dropdown-toggle" : "") d-flex align-items-center font-white" type="button" id="dropdownLanguage" data-bs-toggle="dropdown" aria-expanded="false">
                                                <span class="d-flex">
                                                    <i class="@($"ico-flag flag-{Model.UserModel.LanguageCode.ToLower()}") me-2" aria-hidden="true"></i>
                                                    <span>@Model.UserModel.LanguageCode.ToString()</span>
                                                </span>
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="dropdownLanguage">
                                                @foreach (var langCode in Model.LanguageCodes.Select(s => s.ToString()))
                                                {
                                                    <button type="submit" class="w-100 dropdown-item position-relative d-flex align-items-center" name="action" value="@langCode">
                                                        <span class="d-flex">
                                                            <i class="@($"ico-flag flag-{langCode.ToLower()}") me-2" aria-hidden="true">
                                                            </i>@langCode
                                                        </span>
                                                    </button>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </form>
                            }
                        </div>

                        <form method="post">
                            @Html.HiddenFor(m => m.UserModel.LanguageCode)
                            @Html.HiddenFor(m => m.Translations)
                            <div class="login-header">
                                <div class="logo">
                                    <img src="icons/svg/song88-login-logo.svg" alt="login logo" />
                                </div>
                                <div class="row d-flex flex-column">
                                    <div class="title text-center mt-4 mb-0">
                                        @Model.Translations.GetValue("Login")
                                    </div>
                                    <hr class="col-lg-5 col-md-7 col-sm-10 align-self-center title-break" />
                                </div>
                            </div>
                            <div class="login-body mb-3">
                                <div class="mb-4">
                                    <label class="form-label">
                                        @Model.Translations.GetValue("Username")
                                    </label>
                                    @Html.TextBoxFor(m => m.UserModel.Username, new { @class = "form-control p-3", @placeholder = Model.Translations.GetValue("Enter your username"), @id = "username", @autocomplete = "off", @onchange = "" })
                                    @* @Html.ValidationMessageFor(m => m.UserModel.Username) *@
                                    @if (ViewData.ModelState.ContainsKey("UserModel.Username"))
                                    {
                                        var modelState = ViewData.ModelState["UserModel.Username"];
                                        if (modelState != null && modelState.Errors.Count > 0)
                                        {
                                            <div class="text-danger">
                                                @Model.Translations.GetValue(modelState.Errors[0].ErrorMessage)
                                            </div>
                                        }
                                    }
                                </div>
                                <div class="mb-4">
                                    <label class="form-label">
                                        @Model.Translations.GetValue("Password")
                                    </label>
                                    <div class="input-group">
                                        @Html.TextBoxFor(m => m.UserModel.Password, new { @type = "password", @class = "form-control p-3 pe-5", @placeholder = Model.Translations.GetValue("Enter your password"), id = "password", autocomplete = "off" })
                                        <button type="button" class="d-flex align-items-center position-absolute end-0 h-100 bg-transparent border-0 password-eye" onclick="password_show_hide();">
                                            <i class="fa fa-eye-slash text-center eye-icon" id="show_eye"></i>
                                            <i class="fa fa-eye d-none text-center eye-icon" id="hide_eye"></i>
                                        </button>
                                    </div>
                                    @* @Html.ValidationMessageFor(m => m.UserModel.Password) *@
                                    @if (ViewData.ModelState.ContainsKey("UserModel.Password"))
                                    {
                                        var modelState = ViewData.ModelState["UserModel.Password"];
                                        if (modelState != null && modelState.Errors.Count > 0)
                                        {
                                            <div class="text-danger">
                                                @Model.Translations.GetValue(modelState.Errors[0].ErrorMessage)
                                            </div>
                                        }
                                    }
                                </div>
                                @if (hasError)
                                {
                                    <div class="cold-block border border-0 border-secondary rounded d-flex justify-content-center h-50 p-3" style="background-color: #FFB5B5">
                                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage))
                                        {
                                            <div class="text-danger">
                                                @Model.Translations.GetValue(error)
                                            </div>
                                        }
                                        @Html.Raw(Model.Translations.GetValue(logError?.ToString() ?? string.Empty))
                                    </div>
                                }
                                <div class="row my-4">
                                    <div class="col-md-6">
                                        @Html.CheckBoxFor(m => m.IsSaveCookie, new { @class = "form-check-input m8e-1", @id = "rememberMe" })
                                        <label class="form-check-label">
                                            @Model.Translations.GetValue("Remember Information")
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="login-footer">
                                <button type="submit" class="d-block rounded-2 text-decoration-none text-center col-12 border-0" name="action" value="login">
                                    @Model.Translations.GetValue("Login")
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="js/common-v1.js"></script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>