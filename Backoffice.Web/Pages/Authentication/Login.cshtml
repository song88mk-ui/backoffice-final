@page "/login"
@using Microsoft.AspNetCore.Authorization
@model Backoffice.Web.Pages.Authentication.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@attribute [AllowAnonymous]

@{
    var hasError = TempData["HasError"] != null ? bool.Parse(TempData["HasError"].ToString()) : false;
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

    <link href="css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="css/font-awesome/css/font-awesome.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="css/site.css" />
    <!-- script -->
    <script src="js/bootstrap.bundle.min.js"></script>

    <!-- preload images and svg -->
    <link rel="preload" as="image" href="background/login-background-image.png" />
    <link rel="preload" as="image" type="image/svg+xml" href="icons/svg/song88-login-logo.svg" />
    <link rel="preload" as="image" type="image/svg+xml" href="icons/svg/login-banner-icons.svg" />

    <style>

        body {
            overflow: hidden;
        }

        .access-layout {
            height: 100vh;
            background-color: #404E67;
        }

        .page {
            height: inherit;
        }

        .first-banner {
            background-image: url('../background/login-background-image.png');
            background-size: 100% 100%;
        }

        .second-banner {
            background-color: #FFFFFF;
            background-size: 100%;
        }

        .first-header-text {
            letter-spacing: 0px;
            color: #FFFFFF;
            text-transform: capitalize;
            opacity: 1;
            font-size: 25px;
        }

        .third-header-text {
            letter-spacing: 0px;
            color: #FFFFFF;
            text-transform: capitalize;
            opacity: 1;
            text-align: center;
            font-size: 18px;
        }

        .second-header-text {
            font-size: 60px;
            font-weight: bold;
            color: #FFFFFF;
            text-align: center;
        }

        .banner-icons img {
            height: 66px;
        }

        .login-header .title {
            font-size: 28px;
            font-weight: bold;
            color: #404E67;
        }

        .logo img {
            margin: 0 auto;
            display: block;
        }

        .title-break {
            background-image: linear-gradient(270deg, #EA6442 0%, #E43F2C 51%, #E12E22 100%);
            padding-block: 3px
        }

        .login-body .form-label, .login-body .form-check-label {
            color: #1F1F1F;
        }

        .login-body .form-label {
            font-size: 14px;
            font-weight: 600;
        }

        .login-body .form-check-label {
            font-size: 13px;
        }

        .login-body .form-link {
            font-size: 13px;
            color: #EA6140;
        }

        .login-footer a, .login-footer button {
            background-image: linear-gradient(270deg, #EA6442, #E43F2C, #E12E22);
            color: white;
            font-size: 14px;
            padding-top: 11px;
            padding-bottom: 11px;
        }

        .login-body {
            padding: 0.575rem 0.75rem;
            border-color: #E5E5E5;
        }

            .login-body .input-group .input-group-text {
                border-color: #E5E5E5;
            }

        .password-eye:hover {
            cursor: pointer;
        }

        .password-eye {
            z-index: 9999;
        }

        .form-control {
            font-size: 14px;
        }

        .field-validation-error {
            color: red;
            font-size: 14px;
        }

        .eye-icon {
            width: 3rem;
            display: block;
        }

        input[type="password"] {
            z-index: 0;
        }

        input[type=password]::-ms-reveal,
        input[type=password]::-ms-clear {
            display: none;
        }

        input.input-validation-error,
        textarea.input-validation-error,
        select.input-validation-error
        span.input-validation-error {
            border: 1px solid #CD0A0A;
        }
    </style>
</head>
<body>
    <div class="access-layout">
        <div class="page">
            <div class="row h-100">
                <div class="col-6 first-banner d-flex flex-column justify-content-center align-items-center">
                    <div class="first-header-text">
                        Welcome To
                    </div>
                    <div class="second-header-text">
                        Back Office
                    </div>
                    <div class="third-header-text text-white mb-3">
                        <p>Admin, Partner Management, Sportsbook Clients,</p>
                        <p>And Trading Platform</p>
                    </div>
                    <div class="banner-icons">
                        <img src="icons/svg/login-banner-icons.svg" alt="login banner icons" />
                    </div>
                </div>
                <div class="col-6 second-banner d-flex flex-column justify-content-center align-items-center">
                    <div class="w-75 mx-4 login-container">
                        <div class="login-header">
                            <div class="logo">
                                <img src="icons/svg/song88-login-logo.svg" alt="login logo" />
                            </div>
                            <div class="row d-flex flex-column">
                                <div class="title text-center mt-4 mb-0">Client Login</div>
                                <hr class="col-lg-5 col-md-7 col-sm-10 align-self-center title-break" />
                            </div>
                        </div>
                        <form method="post">
                            <div class="login-body mb-3">
                                <div class="mb-4">
                                    <label class="form-label">Username</label>
                                    @Html.TextBoxFor(m => m.UserModel.Name, new {@class = "form-control p-3", @placeholder="Enter your username"})
                                    @Html.ValidationMessageFor(m => m.UserModel.Name)
                                </div>
                                <div class="mb-4">
                                    <label class="form-label">Password</label>
                                    <div class="input-group">
                                        @Html.PasswordFor(m => m.UserModel.Password, new {@type="password", @class = "form-control p-3 pe-5", @placeholder="Enter your password", id="password"})

                                        @*<div class="validation-summary-errors" data-valmsg-summary="true">
                                        <ul>
                                        <li>The Email field is required.</li>
                                        <li>The Password field is required.</li>
                                        </ul>
                                        </div>*@
                                        <button type="button" class="d-flex align-items-center position-absolute end-0 h-100 bg-transparent border-0 password-eye" onclick="password_show_hide();">
                                            <i class="fa fa-eye-slash text-center eye-icon" id="show_eye"></i>
                                            <i class="fa fa-eye d-none text-center eye-icon" id="hide_eye"></i>
                                        </button>
                                    </div>
                                    @Html.ValidationMessageFor(m => m.UserModel.Password)
                                </div>
                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <input type="checkbox" class="form-check-input me-1" />
                                        <label class="form-check-label">Remember Information</label>
                                    </div>
                                    <div class="col-md-6">
                                        <a class="form-link text-decoration-none float-end" href="javascript:void(0);">Forgot Password?</a>
                                    </div>
                                </div>
                            </div>
                            <div class="login-footer">
                                <button type="submit" class="d-block rounded-2 text-decoration-none text-center col-12 border-0">Log in</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        function password_show_hide() {
            var x = document.getElementById("password");
            var show_eye = document.getElementById("show_eye");
            var hide_eye = document.getElementById("hide_eye");
            hide_eye.classList.remove("d-none");
            if (x.type === "password") {
                x.type = "text";
                show_eye.style.display = "none";
                hide_eye.style.display = "block";
            } else {
                x.type = "password";
                show_eye.style.display = "block";
                hide_eye.style.display = "none";
            }
        }
    </script>
</body>
</html>