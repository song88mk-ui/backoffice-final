@using Backoffice.Web.Components.OddsEngine.Configuration

<AuthorizeView Policy="sbc-config">
    <Authorized>
        <div class="col-md-12 mb-4">
            <AlertMessage AlertClass="mx-3" AlertModel="@_alertModel"></AlertMessage>
            <div class="d-flex justify-content-between m-4">

                <div>
                    <h4 class="page-title">@_translationState.GetValue(_pageTitle)</h4>
                </div>

                <div>
                    <a class="btn btn-logs" href="javascript:void(0)" @onclick="HandleLogsClick">
                        <i class="fa fa-list"></i>
                        <span>@_translationState.GetValue("Logs")</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-12 mb-4">
            <div class="d-flex justify-content-between mx-4">
                <div class="d-flex filter-div">
                    <div class="input-container d-flex">
                        <EditForm Model="_searchForm" OnValidSubmit="HandleSearchInput" Context="FormContext">
                            <div class="input-group">
                                <InputText id="search" placeholder="@_translationState.GetValue("Find")" class="form-control search-text border-end-0" @bind-Value="_searchForm.SearchText" />
                                <button class="input-group-text border-start-0">
                                    <i class="fa fa-search"></i>
                                </button>
                            </div>
                        </EditForm>
                    </div>

                    <select class="form-select" @onchange="HandleSportChange">
                        <option value="-1" selected="@_selectedSportId == -1">@_translationState.GetValue("All Sports")</option>
                        @if (FilterModel.Sports.Any())
                        {
                            @foreach (var item in FilterModel.Sports)
                            {
                                <option value="@item.Value" selected="@(item.Value == _selectedSportId.ToString())">@_translationState.GetValue(item.Name)</option>
                            }
                        }
                        else
                        {
                            <option value="0">--</option>
                        }
                    </select>

                    <select class="form-select" @onchange="HandleScopeChange">
                        @if (FilterModel.Scopes.Any())
                        {
                            @foreach (var item in FilterModel.Scopes)
                            {
                                <option value="@item.Value" selected="@(item.Value == _selectedScopeId.ToString())">@_translationState.GetValue(item.Name)</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <AuthorizeView Policy="sbc-config-canedit">
                        <Authorized Context="ActivateAll">
                            <button class="btn btn-create" @onclick="HandleNewTemplateClick">
                                @_translationState.GetValue("Create New")
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>

        <div class="col-md-12">
            <div class="mx-4">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th class="px-4 w-25" scope="col">@_translationState.GetValue("Template Name")</th>
                            <th class="px-4 w-25" scope="col">@_translationState.GetValue("Sports")</th>
                            <th class="text-center" scope="col">@_translationState.GetValue("Client Assigned")</th>
                            <th class="text-center" scope="col">@_translationState.GetValue("League Assigned")</th>
                            <th class="text-center" scope="col">@_translationState.GetValue("Date Created")</th>
                            <th class="text-center" scope="col">@_translationState.GetValue("Manage")</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (_isPreloader)
                        {
                            <tr>
                                <td colspan="7">
                                    <Preloader />
                                </td>
                            </tr>
                        }
                        else
                        {
                            @if (_configTemplates != null && _configTemplates.Any())
                            {
                                <Virtualize Items="_configTemplates" Context="config" SpacerElement="tr">
                                    <ConfigMyTemplateRow ConfigTemplate="config" ModalClickedCallback="HandleModalClick" />
                                </Virtualize>
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7">
                                        <NoRecordFound Message="@_translationState.GetValue("No Record Found")" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>


        <CustomModal OnSaveClickCallback="HandleModalSave" />
    </Authorized>
</AuthorizeView>