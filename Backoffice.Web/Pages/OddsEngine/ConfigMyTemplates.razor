<AuthorizeView Policy="sbc-config">
    <Authorized>
        <div class="col-md-12 mb-4">
            <div class="d-flex justify-content-between mx-4">
                <div>
                    <h4 class="page-title">@PageTitle</h4>
                </div>

                <div>
                    <a class="btn btn-logs" href="javascript:void(0)" @onclick="OnLogsClickEvent">
                        <i class="fa fa-list"></i>
                        <span>Logs</span>
                    </a>
                </div>
            </div>
        </div>

        @if (AlertModel != null && !string.IsNullOrEmpty(AlertModel.Message))
        {
            <div class="col-md-12 mb-3">
                <div class="mt-4 mx-3">
                    <AlertMessage AlertModel="@AlertModel" />
                </div>
            </div>
        }

        <div class="col-md-12 mb-4">
            <div class="d-flex justify-content-between mx-4">
                <div class="d-flex filter-div">
                    <select class="form-select" @onchange="OnSportChangedEvent">
                        <option value="-1" selected="@SelectedSportId == -1">All Sports</option>
                        @if (Sports.Any())
                        {
                            @foreach (var item in Sports)
                            {
                                if (item.Value == SelectedSportId.ToString())
                                {
                                    <option value="@item.Value" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            }
                        }
                        else
                        {
                            <option value="0">--</option>
                        }
                    </select>

                    <select class="form-select" @onchange="OnScopeChangedEvent">
                        @if (Scopes.Any())
                        {
                            @foreach (var item in Scopes)
                            {
                                if (item.Value == SelectedScopeId.ToString())
                                {
                                    <option value="@item.Value" selected>@item.Name</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Name</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div>
                    <AuthorizeView Policy="sbc-config-canedit">
                        <Authorized Context="ActivateAll">
                            <button class="btn btn-create" @onclick="OnCreateNewTemplateClickEvent">
                                Create New
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>

        <div class="col-md-12">
            <div class="mx-4">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th class="px-4" scope="col">Template Name</th>
                            <th class="px-4" scope="col">Sports</th>
                            <th class="px-4" scope="col">Scope</th>
                            <th  class="text-center" scope="col">Client Assigned</th>
                            <th  class="text-center" scope="col">League Assigned</th>
                            <th  class="text-center" scope="col">Date Created</th>
                            <th  class="text-center" scope="col">Manage</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (IsPreloader)
                        {
                            <tr>
                                <td colspan="7">
                                    <Preloader />
                                </td>
                            </tr>
                        }
                        else
                        {
                            @if (ConfigTemplates != null && ConfigTemplates.Any())
                            {
                                foreach (var configTemplate in ConfigTemplates)
                                {
                                    var isReadOnly = !(configTemplate.ClientsCount > 0 && configTemplate.LeaguesCount > 0);
                                    <tr>
                                        <th class="px-4" scope="row" @onclick="() => OnEditTemplateClickEvent(configTemplate)">@configTemplate.Name</th>
                                        <td class="px-4" @onclick="() => OnEditTemplateClickEvent(configTemplate)">@(Sports.FirstOrDefault(e => e.Value == configTemplate.SportId.ToString()) != null ? $"{Sports.FirstOrDefault(e => e.Value == configTemplate.SportId.ToString()).Name}" : "")</td>
                                        <td class="px-4" @onclick="() => OnEditTemplateClickEvent(configTemplate)">@(((FixtureStatus)configTemplate.FixtureTypeId).ToString())</td>
                                        <td  @onclick="() => OnEditTemplateClickEvent(configTemplate)" class="text-center">@($"{configTemplate.ClientsCount} Client{(configTemplate.ClientsCount > 1 ? "s" : "")}")</td>
                                        <td @onclick="() => OnEditTemplateClickEvent(configTemplate)" class="text-center">@($"{configTemplate.LeaguesCount} League{(configTemplate.LeaguesCount > 1 ? "s" : "")}")</td>
                                        <td @onclick="() => OnEditTemplateClickEvent(configTemplate)" class="text-center">@(configTemplate.Timestamp.ToString("hh:mm dd/mm/yyyy"))</td>
                                        <td>
                                            <div class="manage-cell">
                                                <AuthorizeView Policy="sbc-config-canedit">
                                                    <Authorized Context="ActivateAll">
                                                        <a class= href="javascript:void(0)" @onclick="() => OnEditTemplateClickEvent(configTemplate)" title="Edit Template">
                                                            <i class="fa fa-edit"></i>
                                                        </a>
                                                        <a href="javascript:void(0)" @onclick="() => OnDeleteTemplateClickEvent(configTemplate)" title="Delete Template">
                                                            <i class="fa fa-trash"></i>
                                                        </a>
                                                    </Authorized>
                                                </AuthorizeView>
                                                <a href="javascript:void(0)" @onclick="OnExportTemplateClickEvent" title="Export Template">
                                                    <i class="fa fa-file-archive-o"></i>
                                                </a>
                                                <a href="javascript:void(0)" @onclick="() => OnViewAssignedClickEvent(configTemplate)" title="View Assigned" class="@(isReadOnly ? "disabled" : "")">
                                                    <i class="fa fa-list"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7">
                                        <NoRecordFound />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>


        <CustomModal OnSaveClickCallback="OnModalSaveEvent" />
    </Authorized>
</AuthorizeView>