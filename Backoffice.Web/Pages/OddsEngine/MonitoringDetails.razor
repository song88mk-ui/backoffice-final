@using Backoffice.Web.Components.OddsEngine.MonitoringDetails
@using Backoffice.Web.Components.Common

@layout OEMonitoringLayout

@page "/odds-engine/monitoring-details/{Id}"

<div class="col-md-12">
    <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
</div>
<div class="col-md-12">
    @if (!string.IsNullOrEmpty(Id))
    {
        <Filter OnInitCallback="MonitoringDetailsCallback" ProviderFixtureId="@Id" />
    }
</div>
<div class="col-md-12">
    <div class="mx-3 mt-4">
        <table class="table table-hover table-bordered">
            <thead class="table-head">
                <tr>
                    <th></th>
                    <th></th>
                    <th>BR CTRL</th>
                    @foreach (var client in ClientModel.Clients)
                    {
                        <th>@client.ClientName</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (FilteredMarkets != null)
                {
                    @foreach (var market in FilteredMarkets)
                    {
                        <FixtureRow @key="@market.ProviderMarketId" Clients="@ClientModel.Clients" MainMarketName="@CallbackModel.SelectedMarketTemplateId" Market="market" />
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<div class="col-md-12">
    <MarketGroupFilter />
</div>
