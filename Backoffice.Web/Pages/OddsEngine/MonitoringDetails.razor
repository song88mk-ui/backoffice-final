@using Backoffice.Web.Components.MonitoringDetails
@using Backoffice.Web.Components.Common

@layout OEMonitoringLayout

@page "/odds-engine/monitoring-details/{Id}"

<div class="col-md-12">
    <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
</div>
<div class="col-md-12">
    <Filter OnInitCallback="OnInitCallback" ProviderFixtureId="@Id" />
</div>
<div class="col-md-12">
    <div class="mx-3 mt-4">
        <table class="table table-hover table-bordered">
            <thead class="table-head">
                <tr>
                    <th class="th-start-date py-3"></th>
                    <th class="th-fixture-name py-3"></th>
                    <th>BR CTRL</th>
                    @foreach (var client in ClientModel.Clients)
                    {
                        <th>@client.ClientName</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var market in MonitoringDetailsModel.Fixtures)
                {
                    <FixtureRow @key="@market.ProviderMarketId" Clients="ClientModel.Clients" MainMarketName="@MonitoringDetailsModel.SelectedMarketTemplateId" Market="market" />
                }
            </tbody>
        </table>
    </div>
</div>
