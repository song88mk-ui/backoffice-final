@using Backoffice.Web.Components.OddsEngine.BoostedSettings
@layout OEMonitoringLayout

@page "/{Region}/odds-engine/boosted-settings"
@*@page "/hk/odds-engine/boosted-settings"*@

<AuthorizeView Policy="sbc-priceboost-settings">
    <Authorized>
        <CascadingValue Name="Region" Value="@Region">
            <div class="col-md-12">
                <Breadcrumb Breadcrumbs="_breadcrumbs" />
            </div>
            <div class="col-md-12">
                <OEPageHeader PageHeaderModel="_pageHeaderModel" />
            </div>
            @if (_alertModel != null && !string.IsNullOrEmpty(_alertModel.Message))
            {
                <div class="col-md-12 mb-3">
                    <div class="mt-4 mx-3">
                        <AlertMessage AlertModel="@_alertModel" OpacityChanged="OpacityChanged" />
                    </div>
                </div>
            }
            <div class="col-md-12">
                <Filter OnInitializeCallback="GetContent" OnViewAllLogsCallback="OnViewAllLogsClickEvent" />
            </div>
            <div class="col-md-12">
                <div class="mx-3 mt-4">
                    <table class="table table-bordered mt-3">
                        <thead>
                            <tr>
                                <th><strong>@TranslationState.GetValue("Client name")</strong></th>
                                <th><strong>% @TranslationState.GetValue("Cap of Current Odds from Boosted Odds")</strong></th>
                                <th><strong>@TranslationState.GetValue("Manage")</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_isPreLoader)
                            {
                                <tr>
                                    <td colspan="3">
                                        <Preloader />
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @if (_clientsView != null && _clientsView.Any())
                                {
                                    <Virtualize Items="_clientsView" Context="client" OverscanCount="20">
                                        <ItemContent>
                                            <BoostedSettingsRow BoostedSettings="client" ClientId="client.ClientId" />
                                        </ItemContent>
                                    </Virtualize>
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3">
                                            <NoRecordFound Message="@TranslationState.GetValue("No Record Found")" />
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <CustomModal OnSaveClickCallback="OnSaveSettingClickEvent" />
        </CascadingValue>
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@SportsbookClientPermission.SBC_OE_PriceBoost_Settings.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>