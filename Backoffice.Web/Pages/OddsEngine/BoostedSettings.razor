@using Backoffice.Web.Components.OddsEngine.BoostedSettings
@layout OEMonitoringLayout

@page "/{Region}/odds-engine/boosted-settings"
@*@page "/hk/odds-engine/boosted-settings"*@

<AuthorizeView Policy="sbc-priceboost-settings">
    <Authorized>
        <CascadingValue Name="Region" Value="@Region">
            <div class="col-md-12">
                <Breadcrumb Breadcrumbs="Breadcrumbs" Region="@Region"/>
            </div>
            <div class="col-md-12">
                <PageHeader PageHeaderModel="_pageHeaderModel" />
            </div>
            @if (_alertModel != null && !string.IsNullOrEmpty(_alertModel.Message))
            {
                <div class="col-md-12 mb-3">
                    <div class="mt-4 mx-3">
                        <AlertMessage AlertMessageStr="@_alertModel.Message" AlertStatus="@_alertModel.Status" Opacity=_alertModel.Opacity OpacityChanged="OpacityChanged" />
                    </div>
                </div>
            }
            <div class="col-md-12">
                <Filter @bind-SearchForm="@SearchForm" OnInitializeCallback="GetContent" OnViewAllLogsCallback="OnViewAllLogsClickEvent" />
            </div>
            <div class="col-md-12">
                <div class="mx-3 mt-4">

                    <table class="table table-bordered mt-3">
                        <thead>
                            <tr>
                                <th><strong>Client Name</strong></th>
                                <th><strong>% Cap of Current Odds from Boosted Odds</strong></th>
                                <th><strong>Manage</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (IsPreLoader)
                            {
                                <tr>
                                    <td colspan="3">
                                        <Preloader />
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @if (ClientsView == null)
                                {
                                    <tr>
                                        <td colspan="3">
                                            <NoRecordFound />
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var client in ClientsView)
                                    {
                                        <BoostedSettingsRow BoostedSettings="client" ClientId="client.ClientId" />
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <CustomModal OnSaveClickCallback="OnSaveSettingClickEvent" />
        </CascadingValue>
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@SportsbookClientPermission.SBC_OE_PriceBoost_Settings.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>