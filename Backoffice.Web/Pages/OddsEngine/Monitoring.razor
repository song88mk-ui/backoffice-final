@using Backoffice.Web.Components.OddsEngine.Monitoring
@using Backoffice.Web.Components.Common

@inherits BasePage
@layout OEMonitoringLayout

@page "/hk/odds-engine"
@page "/hk/odds-engine/monitoring"
@*@page "/{Region}/odds-engine/monitoring/{SportId}/{SegmentId}"*@
@page "/hk/odds-engine/monitoring/{SportId:int}/{SegmentId:int}/{LeagueId:int}"

<AuthorizeView Policy="sbc-monitoring-match">
    <Authorized>
        <div class="col-md-12">
            <Breadcrumb Breadcrumbs="_breadcrumbs" />
        </div>
        <div class="col-md-12">
            <OEPageHeader PageHeaderModel="@_pageHeaderModel" />
        </div>
        <div class="col-md-12">
            <Filter SportId="_sportId" LeagueId="_leagueId" OnInitCallback="MonitoringCallback" OnFilterClientCallback="FilterClientCallback" />
        </div>

        @if (!string.IsNullOrEmpty(_alertModel.Message))
        {
            <div class="col-md-12">
                <div class="mt-4 mx-3">
                    <AlertMessage AlertModel="@_alertModel" />
                </div>
            </div>
        }
        <div class="col-md-12">
            <div class="table-container mt-4 mx-3">
                @if (_isPreloader)
                {
                    <Preloader />
                }
                else
                {
                    <table class="table table-hover table-bordered mb-0">
                        <thead class="table-head">
                            <tr>
                                <th class="th-start-date py-3"></th>
                                <th class="th-fixture-name py-3"></th>
                                <th class="th-icon-provider"></th>
                                <th class="th-icon-provider"></th>
                                <AuthorizeView Policy="sbc-monitoring-match-canedit">
                                    <Authorized Context="ActivateAll">
                                        <th class="th-close-match py-3"></th>
                                    </Authorized>
                                </AuthorizeView>
                                <th class="th-master py-3">BTR CTRL</th>
                                @if (_clients != null && _clients.Any())
                                {
                                    foreach (var client in _clients)
                                    {
                                        <th class="th-client py-3">@client.ClientName</th>
                                    }
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (_fixtureMarketPreLoader)
                            {
                                <tr>
                                    <td colspan="@_colCtr">
                                        <Preloader />
                                    </td>
                                </tr>
                            }
                            else
                            {
                                if (_fixtureMarkets != null && _fixtureMarkets.Any())
                                {
                                    <Virtualize Items="_fixtureMarkets" Context="fixture" OverscanCount="10">
                                        @if (fixture != null)
                                        {
                                            <MonitoringFixtureRow @key="fixture" IsBetStop="fixture.IsBetStopGlobal || (fixture.BetStop?.Count > 0 && fixture.BetStop?.FirstOrDefault() == 1)" UnixTime="fixture.UnixTime" Markets="fixture.ClientMarkets" Clients="_clients">
                                                <FixtureHeaderContent>
                                                    <td class="td-start-date">
                                                        @if (fixture.FixtureStatusId == 1)
                                                        {
                                                            <span class="m-1">@fixture.CurrentPeriod</span>
                                                            @if (!string.IsNullOrEmpty(fixture.CurrentMinute) && int.TryParse(fixture.CurrentMinute, out var currentMinute) && currentMinute > 0)
                                                            {
                                                                <span class="fw-bold">@currentMinute</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span>
                                                                @fixture.FixtureStartDate.ToLocalTime().ToString("dd/MM/yy", CultureInfo.InvariantCulture)
                                                                <br />
                                                                <strong>@fixture.FixtureStartDate.ToLocalTime().ToString("HH:mm")</strong>
                                                            </span>
                                                        }
                                                    </td>
                                                    <td class="td-fixture-name">
                                                        <div class="d-flex justify-content-between px-2">
                                                            <a href="@($"hk/odds-engine/monitoring-details/{fixture.ProviderFixtureId}")"
                                                               class="fixture-details text-decoration-none">
                                                                <span class="fw-bold">@fixture.HomeName?.ToUpper()</span>
                                                                <br />
                                                                <span>@fixture.AwayName?.ToUpper()</span>
                                                            </a>
                                                            @if (fixture.FixtureStatusId == 1)
                                                            {
                                                                <span class="score-info py-2 px-2">@fixture.Score</span>
                                                            }
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="provider-icon sr">SR</div>
                                                    </td>
                                                    <td>
                                                        <div class="provider-icon disabled-icon">BG</div>
                                                    </td>
                                                    <AuthorizeView Policy="sbc-monitoring-match-canedit">
                                                        <Authorized Context="authorizedContext">
                                                            <td class="td-close-match">
                                                                <button type="button"
                                                                        class="btn btn-dark close-match-btn mx-4"
                                                                        @onclick="fixture.CloseMatchClick">
                                                                    @_translationState.GetValue("Close Match")
                                                                </button>
                                                            </td>
                                                        </Authorized>
                                                    </AuthorizeView>
                                                </FixtureHeaderContent>
                                            </MonitoringFixtureRow>
                                        }
                                    </Virtualize>

                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@_colCtr">
                                            <NoRecordFound Message="@_translationState.GetValue("No Record Found")" />
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <CustomModal OnSaveClickCallback="OnSaveClickedEvent" />
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@SportsbookClientPermission.SBC_OE_Monitoring_MatchType.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>