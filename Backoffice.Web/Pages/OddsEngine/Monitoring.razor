@using Backoffice.Web.Components.OddsEngine.Monitoring
@using Backoffice.Web.Components.Common

@layout OEMonitoringLayout

@page "/odds-engine"
@page "/odds-engine/monitoring"
@page "/odds-engine/monitoring/{SportId}/{SegmentId}"
@page "/odds-engine/monitoring/{SportId}/{SegmentId}/{LeagueId}"

<div class="col-md-12">
    <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
</div>
<div class="col-md-12">
    @if (defaultSport != null && defaultSport.SportId > 0)
    {
        <Filter OnInitCallback="OnInitEvent" SportId="@defaultSport.SportId" />
    }
</div>
<div class="col-md-12">
    <table class="table table-hover table-bordered mt-4">
        <thead class="table-head">
            <tr>
                <th class="th-start-date py-3"></th>
                <th class="th-fixture-name py-3"></th>
                <th>BTR CTRL</th>
                @if (CallbackModel.Clients.Clients.Any())
                {
                    foreach (var client in CallbackModel.Clients.Clients)
                    {
                        <th>@client.ClientName</th>
                    }
                }
            </tr>
        </thead>
        <tbody>
            @if (FixtureMarkets != null && FixtureMarkets.Any() && defaultSport != null && defaultSport.SportId > 0)
            {
                foreach (var market in FixtureMarkets)
                {
                    <FixtureRow @key="@market.ProviderMarketId" Clients="@CallbackModel.Clients.Clients" MainMarketName="@CallbackModel.SelectedMarketTemplateId" Market="market" />
                }
            }
        </tbody>
    </table>

    @if (FixtureMarkets != null && !FixtureMarkets.Any())
    {
        <NoRecordFound />
    }
</div>