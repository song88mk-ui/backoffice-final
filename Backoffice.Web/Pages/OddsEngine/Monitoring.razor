@using Backoffice.Web.Components.Monitoring
@using Backoffice.Web.Components.Common

@layout OEMonitoringLayout

@page "/odds-engine"
@page "/odds-engine/monitoring"
@page "/odds-engine/monitoring/{SportId}/{SegmentId}"
@page "/odds-engine/monitoring/{SportId}/{SegmentId}/{LeagueId}"

<div class="col-md-12">
    <Breadcrumb Breadcrumbs="Breadcrumbs" />
</div>
<div class="col-md-12">
    <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
</div>
<div class="col-md-12">
    @if (SelectedSport != null)
    {
        <Filter OnInitCallback="MonitoringCallback" SportId="@SelectedSport.SportId" />
    }
</div>
<div class="col-md-12">
        @if (IsPreloader)
        {
            <Preloader />
        }
        else
        {
            if (FixtureMarkets != null && !FixtureMarkets.Any())
            {
                <NoRecordFound />
            }
            else
            {
                <div class="table-container mt-4">
                    <table class="table table-hover table-bordered mb-0">
                        <thead class="table-head">
                            <tr>
                                <th class="th-start-date py-3"></th>
                                <th class="th-fixture-name py-3"></th>
                                <th>BTR CTRL</th>
                                @foreach (var client in ClientModel.Clients)
                                {
                                    <th>@client.ClientName</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (FixtureMarkets != null && FixtureMarkets.Any())
                            {
                                foreach (var market in FixtureMarkets)
                                {
                                    <FixtureRow @key="@market.ProviderMarketId" Clients="@ClientModel.Clients" MainMarketName="@MonitoringCallbackModel.SelectedMarketTemplateId" Market="market" />
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
</div>