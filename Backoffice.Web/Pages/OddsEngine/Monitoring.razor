@using Backoffice.Web.Components.OddsEngine.Monitoring
@using Backoffice.Web.Components.Common

@layout OEMonitoringLayout

@page "/hk/odds-engine"
@page "/hk/odds-engine/monitoring"
@*@page "/{Region}/odds-engine/monitoring/{SportId}/{SegmentId}"*@
@page "/hk/odds-engine/monitoring/{SportId}/{SegmentId}/{LeagueId}"

<AuthorizeView Policy="sbc-monitoring-match">
    <Authorized>
        <div class="col-md-12">
            <Breadcrumb Breadcrumbs="Breadcrumbs" Region="@Region"/>
        </div>
        <div class="col-md-12">
            <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
        </div>
        <div class="col-md-12">
            @if (SelectedSport != null)
            {
                <Filter OnInitCallback="MonitoringCallback" SportId="SelectedSport.SportId" SegmentId="SelectedSport.SegmentId" LeagueId="SelectedSport.LeagueId" />
            }
        </div>

        @if (!string.IsNullOrEmpty(AlertModel.Message))
        {
            <div class="col-md-12">
                <div class="mt-4 mx-3">
                    <AlertMessage AlertMessageStr="@AlertModel.Message" AlertStatus="@AlertModel.Status" Opacity="@AlertModel.Opacity" />
                </div>
            </div>
        }
        <div class="col-md-12">
            @if (IsPreloader)
            {
                <Preloader />
            }
            else
            {
                if (FixtureMarkets != null && !FixtureMarkets.Any())
                {
                    <NoRecordFound />
                }
                else
                {
                    <div class="table-container mt-4 mx-3">
                        <table class="table table-hover table-bordered mb-0">
                            <thead class="table-head">
                                <tr>
                                    <th class="th-start-date py-3"></th>
                                    <th class="th-fixture-name py-3"></th>
                                    <AuthorizeView Policy="sbc-monitoring-match-canedit">
                                        <Authorized Context="ActivateAll">
                                            <th class="th-close-match py-3"></th>
                                        </Authorized>
                                    </AuthorizeView>
                                    <th class="th-master py-3">BTR CTRL</th>
                                    @foreach (var client in ClientModel.Clients)
                                    {
                                        <th class="th-client py-3">@client.ClientName</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (FixtureMarkets != null && FixtureMarkets.Any())
                                {
                                    foreach (var market in FixtureMarkets)
                                    {
                                        <FixtureRow @key="@market.ProviderMarketId" Clients="@ClientModel.Clients" MainMarketName="@market.MarketName" Market="market" Region="@Region" IsMonitoringPage=true />
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>

        <CustomModal OnSaveClickCallback="OnSaveClickedEvent"/>
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@SportsbookClientPermission.SBC_OE_Monitoring_MatchType.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>