@using Backoffice.Web.Components.OddsEngine.Configuration

@layout OEMonitoringLayout

@*@page "/{Region}/odds-engine/config/my-templates"*@
@page "/hk/odds-engine/config/assigned"

<Breadcrumb Breadcrumbs="Breadcrumbs" Region="@Region"></Breadcrumb>

@*<div class="col-md-12 mb-4">
    <ConfigNavMenu Region="@Region" CurrentMenu="2"></ConfigNavMenu>
</div>*@

<div class="col-md-12 mb-4">
    <div class="col-md-12 mb-4">
        <div class="d-flex justify-content-between mx-4">
            <div>
                <h4 class="page-title">@PageTitle</h4>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12 mb-4">
    <div class="d-flex justify-content-between mx-4">
        <div class="d-flex filter-div">
            <div class="dropdown">
                <button class="btn form-select dropdown-toggle" type="button" id="client-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    @if (Clients != null && Clients.Any())
                    {
                        if (Clients.Count - 1 == SelectedClientCount)
                        {
                            <span>All Clients (@SelectedClientCount)</span>
                        }
                        else
                        {
                            <span>@(SelectedClientCount == 1 ? SelectedClientName : $"Clients ({SelectedClientCount})")</span>
                        }
                    }
                    else
                    {
                        <span>No Clients Available</span>
                    }
                </button>
                @if (Clients != null && Clients.Any())
                {
                    <SelectWithCheckbox Items="Clients" OnCheckboxCallback="OnClientCheckboxClickEvent" AriaLabel="scope-dropdown" />
                }
            </div>

            @if (Sports != null && Sports.Any())
            {
                <select class="form-select" @onchange="OnSportCheckboxClickEvent">
                    @foreach (var item in Sports)
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                </select>
            }

            @if (Scopes != null && Scopes.Any())
            {
                <select class="form-select" @onchange="OnScopeCheckboxClickEvent">
                    @foreach (var item in Scopes)
                    {
                        <option value="@item.Value">@item.Name</option>
                    }
                </select>
            }

            <button class="btn btn-dark" @onclick="OnResetClickEvent">
                Reset
            </button>
        </div>

        <div>
            <div class="input-group">
                <input type="text" id="search" placeholder="Search" class="form-control search-text valid border-end-0" />
                <span class="input-group-text border-start-0">
                    <i class="fa fa-search"></i>
                </span>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12">
    <div class="mx-4">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th class="text-center" scope="col">No.</th>
                    <th class="text-center" scope="col">Client Name</th>
                    <th class="text-center" scope="col">Sport</th>
                    <th class="text-center" scope="col">Scope</th>
                    <th class="text-center" scope="col">League Name</th>
                    <th class="text-center" scope="col">Template</th>
                    <th class="text-center" scope="col">Manage</th>
                </tr>
            </thead>

            <tbody>
                @if(IsPreloader)
                {
                        <tr>
                            <td colspan="7">
                            <Preloader />
                        </td>
                    </tr>
                }
                else
                {
                    @if (ConfigClients != null && ConfigClients.Any())
                    {
                        foreach (var config in ConfigClients)
                        {
                            <ConfigStateRow Index="@(ConfigClients.IndexOf(config) + 1)" Config="config" />
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <NoRecordFound />
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <Pagination MetaData="MetaData" Spread="2" SelectPageEvent="SelectedPage" PaginationColspan="7" />
        </table>
    </div>
</div>