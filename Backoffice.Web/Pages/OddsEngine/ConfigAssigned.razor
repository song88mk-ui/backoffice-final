@using Backoffice.Web.Components.OddsEngine.Configuration

@layout OEMonitoringLayout

<div class="col-md-12">
    <div class="col-md-12 mb-4">
        <AlertMessage AlertClass="mx-3" AlertModel="@_alertModel"></AlertMessage>
        <div class="d-flex justify-content-between m-4">
            <div>
                <h4 class="page-title">@_translationState.GetValue(_pageTitle)</h4>
            </div>
        </div>
        <div id="selectedLeagueWrapper" style="display: none">
            <div class="d-flex align-items-center justify-content-between mx-4 p-2 border">
                <div class="col d-inline-flex align-items-center">
                    <div class="selection-logo"><i class="ico ico-top-leagues mx-4" aria-hidden="true"></i></div>
                    <p class="lbl-selection m-0">@(_translationState.GetValue((_selectedConfigClients?.Count ?? 0) >= 2 ? $"{_selectedConfigClients?.Count ?? 0} Leagues selected" : $"{_selectedConfigClients?.Count ?? 0} League selected"))</p>
                </div>
                <div class="d-flex h-75 justify-content-end">
                    <button href="javascript:void(0)" @onclick="HandleSelectAllClick" class="btn btn-selection-all px-4">@_translationState.GetValue("Select All")</button>
                    <button href="javascript:void(0)" @onclick="HandleClearSelectionClick" class="btn btn-selection-clear px-4">@_translationState.GetValue("Clear Selection")</button>
                    <button href="javascript:void(0)" @onclick="HandleEditTemplateClick" class="btn btn-selection-modify px-4">@(_translationState.GetValue(_state == ConfigState.Assigned ? "Change template" : "Assign a template"))</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12 mb-4">
    <div class="d-flex justify-content-between mx-4">
        <div class="d-flex filter-div">
            <div class="dropdown">
                <button class="btn form-select dropdown-toggle" type="button" id="client-dropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    @if (FilterModel.Clients != null && FilterModel.Clients.Any())
                    {
                        if (FilterModel.Clients.Count - 1 == _selectedClientCount)
                        {
                            <span>@_translationState.GetValue("All Clients") (@_selectedClientCount)</span>
                        }
                        else
                        {
                            <span>@(_selectedClientCount == 1 ? _selectedClientName : $"Clients ({_selectedClientCount})")</span>
                        }
                    }
                    else
                    {
                        <span>@_translationState.GetValue("No Clients Available")</span>
                    }
                </button>
                @if (FilterModel.Clients != null && FilterModel.Clients.Any())
                {
                    <SelectWithCheckbox Items="FilterModel.Clients" OnCheckboxCallback="HandleClientCheckboxClick" AriaLabel="scope-dropdown" />
                }
            </div>

            @if (FilterModel.Sports != null && FilterModel.Sports.Any())
            {
                <select class="form-select" @onchange="HandleSportCheckboxClick">
                    @foreach (var item in FilterModel.Sports)
                    {
                        <option value="@item.Value" selected="@(item.Value == _stateFilterModel.SportId.ToString())">@_translationState.GetValue(item.Name)</option>
                    }
                </select>
            }

        </div>

        <div>
            <div class="input-container d-flex">
                <EditForm Model="_searchForm" OnValidSubmit="HandleSearchInput" Context="FormContext">
                    <div class="input-group">
                        <InputText id="search" placeholder="@_translationState.GetValue("Find Client")" class="form-control search-text border-end-0" @bind-Value="_searchForm.SearchText" />
                        <button class="input-group-text border-start-0">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </EditForm>
            </div>

        </div>
    </div>
</div>

<div class="col-md-12">
    <div class="mx-4">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>

                    <AuthorizeView Policy="sbc-config-canedit">
                        <Authorized Context="ActivateAll">
                            <th class="index" scope="col" rowspan="2"></th>
                        </Authorized>
                    </AuthorizeView>
                    <th class="index" scope="col" rowspan="2">@_translationState.GetValue("No.")</th>
                    <th class="filter" scope="col" rowspan="2">@_translationState.GetValue("Client name")</th>
                    <th class="filter" scope="col" rowspan="2">@_translationState.GetValue("Sport")</th>
                    <th class="template" scope="col" rowspan="2">@_translationState.GetValue("League Name")</th>
                    <th class="template" scope="col" colspan="2">@_translationState.GetValue("Template")</th>
                </tr>
                <tr>
                    <th class="template" scope="col">@_translationState.GetValue("Prematch")</th>
                    <th class="template" scope="col">@_translationState.GetValue("Live")</th>
                </tr>
            </thead>

            <tbody>
                @if (_isPreloader)
                {
                    <tr>
                        <AuthorizeView Policy="sbc-config-canedit">
                            <Authorized Context="ActivateAll">
                                <td colspan="7">
                                    <Preloader />
                                </td>
                            </Authorized>
                            <NotAuthorized>
                                <td colspan="6">
                                    <Preloader />
                                </td>
                            </NotAuthorized>
                        </AuthorizeView>
                    </tr>
                }
                else
                {
                    @if (_configClients != null && _configClients.Any())
                    {
                        <Virtualize Items="_configClients" Context="config" SpacerElement="tr">
                            <ConfigStateRow State="_state" Config="config" ItemSelectionChangedEvent="@HandleConfigSelectionChange" />
                        </Virtualize>
                    }
                    else
                    {
                        <tr>
                            <AuthorizeView Policy="sbc-config-canedit">
                                <Authorized Context="ActivateAll">
                                    <td colspan="7">
                                        <NoRecordFound Message="@_translationState.GetValue("No Record Found")" />
                                    </td>
                                </Authorized>
                                <NotAuthorized>
                                    <td colspan="6">
                                        <NoRecordFound Message="@_translationState.GetValue("No Record Found")" />
                                    </td>
                                </NotAuthorized>
                            </AuthorizeView>
                        </tr>
                    }
                }
            </tbody>
            <Pagination MetaData="_metaData" Spread="5" SelectPageEvent="HandledPageSelect" PaginationColspan="7" RowInfColSpan="5" />
        </table>
    </div>
</div>

<CustomModal OnSaveClickCallback="HandleModalSave" />