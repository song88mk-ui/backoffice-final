@using Backoffice.Shared.Enums;
@using Backoffice.Web.Components.OddsEngine.ManageBoost

@layout OEMonitoringLayout

@page "/odds-engine/manage-boost"

<div class="col-md-12">
    <Breadcrumb Breadcrumbs="Breadcrumbs" />
</div>
<div class="col-md-12">
    <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
</div>
<div class="col-md-12">
    <Filter @bind-PriceboostFilterModel="PriceBoostFilterModel"
            OnClientChangedCallback="OnClientChangedEvent"
            OnSportChangedCallback="OnSportChangedEvent"
            OnSegmentChangedCallback="OnSegmentChangedEvent"
            OnLeagueChangedCallback="OnLeagueChangedEvent"
            OnInitCallback="GetContents" />
</div>
<div class="col-md-12">
    <div class="mx-3 mt-4">
        @if (IsPreLoader)
        {
            <Preloader />
        }
        else
        {
            @if (PriceBoostList != null && PriceBoostList.Any())
            {
                <table class="table table-hover table-bordered">
                    <thead class="table-head">
                        <tr>
                            <th>Client Name</th>
                            <th>Sports</th>
                            <th>Details</th>
                            <th>BR Ctrl</th>
                            <th>Current Odds</th>
                            <th>Boosted Odds</th>
                            <th>Manage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var priceboost in PriceBoostList)
                        {
                            <tr class="@(priceboost.FixtureStatusId >= 1 ? "boost-expired" : "")">
                                <td>@priceboost.ClientName</td>
                                <td>@priceboost.SportName</td>
                                <td>
                                    <span class="d-block selection-name fw-bold">@priceboost.SelectionName</span>
                                    <span class="d-block market">@priceboost.MarketName</span>
                                    <span class="d-block segment">@priceboost.SegmentName</span>
                                    <span class="d-block league">@priceboost.LeagueName</span>
                                    <span class="d-block date">@priceboost.FixtureStartDate.ToLocalTime().ToString("dd/MM/yy")</span>
                                    <span class="d-block time">@priceboost.FixtureStartDate.ToLocalTime().ToString("HH:mm")</span>
                                    @if (priceboost.FixtureStatusId == (int)FixtureStatus.Live)
                                    {
                                        <span class="d-block score">@priceboost.Score</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center">
                                        <div class="odds-container py-1 px-3">
                                            <span>@priceboost.BROdds.ToString("0.00")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center">
                                        <div class="odds-container py-1 px-3">
                                            <span>@priceboost.ClientOdds.ToString("0.00")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center">
                                        <div class="odds-container py-1 px-3">
                                            <span>@priceboost.BoostedOdds.ToString("0.00")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (priceboost.FixtureStatusId < (int)FixtureStatus.Live)
                                    {
                                        <div class="d-flex justify-content-center">
                                            <a class="link-edit me-2" @onclick="_ => OnEdit(priceboost)" href="javascript:(0)">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <a class="link-logs me-2" @onclick="_ => OnViewLog(priceboost)" href="javascript:(0)">
                                                <i class="fa fa-list"></i>
                                            </a>
                                            <a class="link-delete me-2" @onclick="_ => OnDelete(priceboost)" href="javascript:(0)">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex justify-content-center">
                                            <a class="link-edit me-2" @onclick="_ => OnEdit(priceboost)" href="javascript:(0)" disabled>
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <a class="link-logs me-2" @onclick="_ => OnViewLog(priceboost)" href="javascript:(0)">
                                                <i class="fa fa-list"></i>
                                            </a>
                                            <a class="link-delete me-2" @onclick="_ => OnDelete(priceboost)" href="javascript:(0)">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <NoRecordFound />
            }
        }
    </div>
</div>
<Backoffice.Web.Components.Common.CustomModal OnSaveClickCallback="OnModalSave" OnCancelClickCallback="OnModalBack" />