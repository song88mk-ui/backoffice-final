                    </td>
                    <td>All Markets</td>
                    <td>
                        <div class="d-flex justify-content-center">
                            <a class="link-view me-2" href="javascript:(0)" @onclick="OnViewMarketGroup">
                                <i class="fa fa-eye"></i>
                                11
                            </a>
                        </div>
                    </td>
                    <td>
                        <div class="d-flex justify-content-center">
                            <a class="link-edit me-2" href="javascript:(0)" @onclick="OnEditMarketGroup">
