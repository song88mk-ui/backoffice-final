@using Backoffice.Web.Components.OddsEngine.MarketGroups

@layout OEMonitoringLayout

@page "/odds-engine/market-groups"

<div class="col-md-12">
    <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
</div>
<div class="col-md-12">
    <Filter @bind-MarketGroupModel="MarketGroupModel"
            OnAddMarketGroupCallback="OnMarketGroupAdd"
            OnCopyMarketGroupCallback="OnCopyMarketGroup"
            OnUpdateyMarketGroupCallback="OnUpdateMarketGroup"
            OnViewLogsCallback="OnViewLogs"
            OnCancelCallback="OnCanceUpdateClickedEvent"
            OnInitCallback="OnInit" />
</div>
<div class="col-md-12">
    <div class="mx-3 mt-4">
        @if (IsPreLoader)
        {
            <Preloader />
        }
        else
        {
            if (MarketGroupModel != null && MarketGroupModel.MarketTemplateGroups != null)
            {
                <table class="table table-hover table-bordered">
                    <thead class="table-head">
                        <tr>
                            <th width="5%" valign="middle" align="center">
                                <Checkbox HasOnChange="MarketGroupModel.IsUpdate" Checked="IsSelectAll" OnChangeCallback="CheckboxSelectAllClicked" />
                            </th>
                            <th>User Group Name</th>
                            <th>Users</th>
                            <th>Manage</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var MarketTemplateGroup in MarketGroupModel.MarketTemplateGroups.OrderBy(o => o.SortOrder))
                        {
                            <tr>
                                <td>
                                    <div class="d-flex justify-content-center">
                                        <Checkbox HasOnChange="MarketGroupModel.IsUpdate" Checked="MarketTemplateGroup.IsActive" OnChangeCallback="CheckboxMarketGroupClicked" Param1="MarketTemplateGroup" />
                                    </div>
                                </td>
                                <td>@MarketTemplateGroup.Name</td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(MarketTemplateGroup.MarketTemplateIds))
                                    {
                                        <a class="btn btn-default btn-sm text-center"
                           @onclick="async () => await OnViewMarketGroup(MarketTemplateGroup.Name, MarketTemplateGroup.MarketTemplateIds)">
                                            <span data-toggle="tooltip" data-placement="left" title="Click to View" data-original-title="Click to View">
                                                <i class="fa fa-eye"></i>@(MarketTemplateGroup.MarketTemplateIds.Split(",").ToList().Count)
                                            </span>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-default btn-sm text-center" disabled>
                                            <span data-toggle="tooltip" data-placement="left" title="Click to View" data-original-title="Click to View">
                                                <i class="fa fa-eye"></i>0
                                            </span>
                                        </a>
                                    }
                                </td>
                                <td class="text-center">
                                    <a class="link-edit me-2" href="javascript:(0)" @onclick="async () => await OnEditMarketGroup(MarketTemplateGroup.MarketTemplateGroupId)">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <a class="link-delete me-2" href="javascript:(0)">
                                        <i class="fa fa-trash" @onclick="async () => await OnDeleteMarketGroup(MarketTemplateGroup)"></i>
                                    </a>
                                </td>
                                <td class="text-center">
                                    <a class="link-bars me-2" href="javascript:(0)">
                                        <i class="fa fa-bars"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <NoRecordFound />
            }
        }
    </div>
</div>
<CustomModal OnSaveClickCallback="OnSaveMarketGroupClickEvent" />