@using Backoffice.Web.Components.OddsEngine.SportSettings

@layout OEMonitoringLayout

@page "/hk/odds-engine/sport-settings"

<AuthorizeView Policy="sbc-sports-setting">
    <Authorized>
        <div class="col-md-12">
            <Breadcrumb Breadcrumbs="Breadcrumbs" Region="@Region"/>
        </div>
        <div class="col-md-12">
            <PageHeader PageHeaderModel="_pageHeaderModel" />
        </div>

        @if (!string.IsNullOrEmpty(AlertMessage))
        {
            <div class="col-md-12">
                <div class="mt-4 mx-3">
                    <AlertMessage AlertMessageStr="@AlertMessage" AlertStatus="@(AlertStatus.ToString())" AlwaysShow="true" />
                </div>
            </div>
        }

        <div class="col-md-12">
            <Filter OnClientChangedCallback="OnClientChangedEvent" OnUpdateClickCallback="OnUpdateClickEvent" OnCancelClickCallback="OnCancelClickEvent" OnSaveClickCallback="OnSaveClickEvent" OnCopyClickCallback="OnCopyClickEvent" OnViewLogsCallback="OnViewLogsClickEvent" IsPreload="IsPreload" Region="Region"/>
        </div>
        <div class="col-md-12">
            <div class="mx-3 mt-4">
                @if (IsPreload)
                {
                    <Preloader />
                }
                else
                {
                    <table class="table table-hover table-bordered @TableClass">
                        <thead class="table-head">
                            <tr>
                                <th class="th-no py-3">#</th>
                                <th class="th-checkbox py-3">
                                    <div class="form-check d-flex justify-content-center">
                                        <input class="form-check-input" type="checkbox" @onchange="e => OnActiveHeaderChangedEvent(e)" disabled="@(!IsUpdate)">
                                    </div>
                                </th>
                                <th class="th-sports py-3">Sports</th>
                                <th class="th-action py-3"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ClientSportsSettingsModel.Sports.Any())
                            {

                                foreach (var sport in ClientSportsSettingsModel.Sports)
                                {
                                    <tr @key="@($"sport-{sport.SportId}")" id="sport-@sport.SportId" class="sport-row">
                                        <td class="text-center fw-bold">@sport.SortOrder</td>
                                        <td>
                                            <div class="form-check d-flex justify-content-center">
                                                <input class="form-check-input" type="checkbox" @bind="sport.IsActive" disabled="@(!IsUpdate)">
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-between">
                                                <span>@sport.SportName</span>
                                                <span class="dropdown-cat dropdown-segment @(IsUpdate ? "" : "disabled")">
                                                    <i class="fa fa-chevron-down" @onclick="() => OnSportClickEvent(sport)"></i>
                                                </span>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <a class="link-bars me-2 drag-handle" href="javascript:(0)">
                                                <i class="fa fa-bars"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        <CustomModal OnSaveClickCallback="OnSaveCopyClickEvent" />
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@SportsbookClientPermission.SBC_OE_SportsSettings.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>