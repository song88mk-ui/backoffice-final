@using Backoffice.Web.Components.OddsEngine.Configuration

@layout OEMonitoringLayout

@page "/odds-engine/config"

<div class="col-md-12">
    <Breadcrumb Breadcrumbs="Breadcrumbs" />
</div>
<div class="col-md-12">
    <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
    <HeaderConfigTopMenu />
</div>

<div class="col-md-12">
    <Filter @bind-ConfigFilterModel="ConfigFilterModel" FixtureType="FixtureType" IsMarketEditingChanged="UndoEditedMarkets" @ref="FilterReference"/>
</div>

<div class="col-md-12 mb-2">
    <button type="button" class="btn float-end" @onclick="OnAllMarketStatusClickEvent">@AllMarketStatusName</button>
</div>

<div class="col-md-12">
    @if (ConfigFilterModel != null && ConfigFilterModel.MarketTemplates != null)
    {
        SelectedContents = null;
        if (!string.IsNullOrEmpty(ConfigFilterModel.ClientCode) && ConfigFilterModel.MarketTemplates.Any())
        {
            SelectedContents = GetContents();

            if (SelectedContents.Any())
            {
                var marketCount = 0;
                foreach (var market in SelectedContents)
                {

                    if (market.NewMarketLookup == null)
                        market.IsSelected = marketCount >= 3 ? true : false;

                    GetNewSettings(market);
                    var configStatus = market.MarketLookup.IsActive ? 1 : 0;

                    if (ConfigFilterModel.FilterConfigStatus == -99 || configStatus == ConfigFilterModel.FilterConfigStatus)
                    {
                        if (AllMarketStatus != null)
                        {
                            market.NewMarketLookup.IsActive = (int)AllMarketStatus == 1 ? true : false;
                        }
                        marketCount++;
                    }
                }

                if (marketCount > 0)
                {
                    @*SaveBarVisible = false;*@
                    AllMarketStatus = null;

                    if (ConfigFilterModel.FilterConfigStatus == 0)
                        AllMarketStatusName = "Activate All";
                    if (ConfigFilterModel.FilterConfigStatus == 1)
                        AllMarketStatusName = "Deactivate All";
                    if (!SelectedContents.Any(s => s.NewMarketLookup.IsActive))
                        AllMarketStatusName = "Activate All";
                    if (!SelectedContents.Any(s => s.NewMarketLookup.IsActive == false))
                        AllMarketStatusName = "Deactivate All";

                    <Virtualize Context="market" Items="ConfigFilterModel.MarketTemplates" OverscanCount="6" @ref="MarketVirtualizeReference">
                        <ItemContent>
                            @{
                                string marketActiveLabel = market.MarketLookup.IsActive ? "Market Active" : "Market Inactive";
                                bool isMarketActive = market.MarketLookup.IsActive;
                            }
                            <div class="accordion">
                                <div class="accordion-item">
                                    <div class="accordion-header">
                                        <button class="accordion-button ps-5" type="button" data-bs-toggle="collapse" aria-expanded="false" data-bs-target="@($"#market-{market.MarketLookup.MarketTemplateId}")">
                                            @market.MarketLookup.MarketTemplateName
                                        </button>

                                        <div class="d-flex justify-content-around market-toggle">
                                            <span>@marketActiveLabel</span>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox"
                                                    id="@($"market-{market.MarketLookup.MarketTemplateId}Toggle")" role="switch"
                                                       aria-label="@($"{market.MarketLookup.MarketTemplateName} Toggle Switch")"
                                       checked="@isMarketActive" @oninput="(ChangeEventArgs e) => OnMarketActiveChangedEvent(e, market)" />
                                            </div>
                                        </div>
                                    </div>

                                    <div id="@($"market-{market.MarketLookup.MarketTemplateId}")" class="accordion-collapse collapse show">
                                        <div class="accordion-body">
                                            @{
                                                var configStatus = market.MarketLookup.IsActive ? 1 : 0;
                                                if ((ConfigFilterModel.FilterConfigStatus == -99 || configStatus == ConfigFilterModel.FilterConfigStatus))
                                                {
                                                    if ((ConfigFilterModel.Scope == 99 || ConfigFilterModel.Scope == 0))
                                                    {
                                                        //prematch
                                                        <PreMatchConfig @key=@(market.MarketLookup.MarketTemplateId + "prematch") @bind-PrematchSettings="market.PrematchSettings" />
                                                    }

                                                    if ((ConfigFilterModel.Scope == 99 || ConfigFilterModel.Scope == 1))
                                                    {
                                                        //live
                                                        <LiveMatchConfig @key=@(market.MarketLookup.MarketTemplateId + "live") @bind-LiveSettings="market.NewLiveSettings" />
                                                    }
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </ItemContent>
                    </Virtualize>
                }
                else
                {
                    <NoRecordFound />
                }
            }
            else
            {
                <NoRecordFound />
            }
        }
        else
        {
            <NoRecordFound />
        }
    }
    else
    {
        <Preloader />
    }
</div>

@if (IsMarketEditing)
{
    <div class="market-save-changes">
        <div class="row market-save-details">
            <div class="col">
                <span>Make sure to save your changes</span>
            </div>
            <div class="col"></div>
            <div class="col">
                <div class="market-save-actions">
                    <button type="button" class="btn market-cancel me-2" @onclick="OnMarketEditingCancelClickEvent">Cancel</button>
                    <button type="button" class="btn market-save" @onclick="OnMarketSaveClickEvent">Save My Changes</button>
                </div>
            </div>
        </div>
    </div>
}
<CustomModal/>