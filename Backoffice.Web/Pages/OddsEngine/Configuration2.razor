@using Backoffice.Web.Components.OddsEngine.Configuration

@layout OEMonitoringLayout

@page "/hk/odds-engine/config-templates"

<Breadcrumb Breadcrumbs="_breadcrumbs" Region="@Region" />

@if (_isPreleader)
{
    <Preloader />
}
else
{
    <div class="col-md-12 mb-2">
        <ConfigNavMenu
            ParamModel="_navMenuParamModel"
            SelectConfigNavMenuCallback="OnConfigNavMenuSelected" 
            SelectCopyClientCallback="OnCopyClientSettings" />
    </div>

    <AlertMessage AlertClass="mx-3" AlertModel="_alertModel"></AlertMessage>

    @if (_selectedConfigNavMenu == ConfigTemplateNavMenu.MyTemplates)
    {
        <ConfigMyTemplates FilterModel="_contentFilterModel" QueryMessage="@QueryMessage" OnStateHasChanged="OnNavMenuCallback" />
    }
    else if (_selectedConfigNavMenu == ConfigTemplateNavMenu.Assigned || _selectedConfigNavMenu == ConfigTemplateNavMenu.UnAssigned)
    {
        var state = _selectedConfigNavMenu == ConfigTemplateNavMenu.Assigned ? ConfigState.Assigned : ConfigState.UnAssigned;

        <ConfigAssigned State="state" FilterModel="_contentFilterModel" OnStateHasChanged="OnNavMenuCallback" />
    }
}