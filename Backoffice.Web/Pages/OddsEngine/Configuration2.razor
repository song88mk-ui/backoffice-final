@using Backoffice.Web.Components.OddsEngine.Configuration

@layout OEMonitoringLayout

@page "/hk/odds-engine/config-templates"

<Breadcrumb Breadcrumbs="_breadcrumbs" />

@if (_isPreloader)
{
    <Preloader />
}
else
{
    <div class="col-md-12 mb-2">
        <ConfigNavMenu ParamModel="_navMenuParamModel" SelectConfigNavMenuCallback="OnConfigNavMenuSelected" SelectCopyClientCallback="OnCopyClientSettings" />
    </div>

    <AlertMessage AlertClass="mx-3" AlertModel="_alertModel"></AlertMessage>

    @switch (_navMenuParamModel.SelectedNavMenu)
    {
        case ConfigTemplateNavMenu.MyTemplates:
            <ConfigMyTemplates FilterModel="_contentFilterModel" QueryMessage="@QueryMessage" OnStateHasChanged="OnNavMenuCallback" />
            break;
        case ConfigTemplateNavMenu.Assigned:
        case ConfigTemplateNavMenu.UnAssigned:
            <ConfigAssigned State="_currentState" FilterModel="_contentFilterModel" OnStateHasChanged="OnNavMenuCallback" />
            break;
    }
}