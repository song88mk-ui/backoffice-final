@using Backoffice.Web.Components.OddsEngine.Configuration

@layout OEMonitoringLayout

@*@page "/{Region}/odds-engine/config/my-templates"*@
@page "/hk/odds-engine/config-templates"

<Breadcrumb Breadcrumbs="Breadcrumbs" Region="@Region"/>

<div class="col-md-12 mb-4">
    <ConfigNavMenu Region="@Region" SelectConfigNavMenuCallback="OnConfigNavMenuSelected"/>
</div>


@if(SelectedConfigNavMenu == ConfigTemplateNavMenu.MyTemplates)
{
    <ConfigMyTemplates Sports="@Sports" Scopes="@Scopes"/>
}
else if(SelectedConfigNavMenu == ConfigTemplateNavMenu.Assigned)
{
    <ConfigAssigned Clients="@Clients" Sports="@Sports" Scopes="@Scopes"/>
}
else if (SelectedConfigNavMenu == ConfigTemplateNavMenu.UnAssigned)
{
    <ConfigUnassigned Clients="@Clients" Sports="@Sports" Scopes="@Scopes" />
}

<CustomModal/>