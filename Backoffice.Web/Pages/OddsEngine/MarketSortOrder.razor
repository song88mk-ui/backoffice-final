@using Backoffice.Web.Components.OddsEngine.MarketSortOrder

@layout OEMonitoringLayout

@page "/odds-engine/market-sort-order"

<div class="col-md-12">    
    <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
</div>
<div class="col-md-12">
    <Filter OnUpdateCallback="OnUpdateClickEvent" OnCancelCallback="OnCancelClickEvent" MarketSortOrderModelCallback="PrepareMarketSortOrderModel" />
</div>
<div class="col-md-12">
    <div class="mx-3 mt-4">
        @if (MarketSortOrderModel.MarketTemplates.Any())
        {
            <table class="table table-hover table-bordered market-sort-order-table">
                <thead class="table-head">
                <tr>
                    <th>Market</th>
                    <th>Market Group</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                    @foreach (var model in MarketSortOrderModel.MarketTemplates)
                    {
                        <tr>
                            <td id="@model.MarketTemplateId">@model.MarketTemplateName</td>
                            <td>
                                <div class="d-flex justify-content-center">                            
                                    <select class="form-select d-block" multiple>
                                        <option value="1" selected>Market Group 1</option>
                                        <option value="2">Market Group 2</option>
                                        <option value="3">Market Group 3</option>
                                    </select>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex justify-content-center">
                                    <a class="link-bars me-2 drag-handle" href="javascript:(0)">
                                        <i class="fa fa-bars"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>