@using Backoffice.Web.Components.OddsEngine.MarketSortOrder

@inherits BasePage
@layout OEMonitoringLayout

@page "/hk/odds-engine/market-sort-order"

<AuthorizeView Policy="sbc-market-sortorder">
    <Authorized>
        <div class="col-md-12">
            <Breadcrumb Breadcrumbs="_breadcrumbs" />
        </div>
        <div class="col-md-12">
            <OEPageHeader PageHeaderModel="_pageHeaderModel" />
        </div>
        <div class="col-md-12">
            <Filter @bind-IsUpdate="_isUpdate" @bind-IsPreLoader="_isPreLoader" OnInitializeEventCallback="PrepareMarketSortOrderModel" OnUpdateCallback="OnUpdateClickEvent" OnCancelCallback="OnCancelClickEvent" OnSaveCallback="OnSaveClickEvent" Region="Region" />
            <div class="row">
                @if (_isPreLoader || _isMarketPreLoader)
                {
                    <div class="col-md-12 justify-content-center">
                        <Preloader />
                    </div>
                }
                else
                {
                    <div class="col-md-12">
                        @if (_clientMarketTemplateGroupsRef != null && _clientMarketTemplateGroupsRef.Any())
                        {
                            <div class="d-flex mx-3 mt-3">
                                @foreach (var model in _clientMarketTemplateGroupsRef)
                                {
                                    <div class="me-2">
                                        <a href="javascript:void(0)" class="btn btn-market-group @(_selectedMarketGroupId == model.Id ? "active" : "") px-3" id="mtg-@model.Id" @onclick="() => OnMarketGroupClickEvent(model.Id)">
                                            @_translationState.GetValue(model.Name)
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (_alertModel != null && !string.IsNullOrEmpty(_alertModel.Message))
        {
            <div class="col-md-12">
                <div class="mt-4 mx-3">
                    <AlertMessage AlertModel="@_alertModel" />
                </div>
            </div>
        }
        <div class="col-md-12">
            <div class="mx-3 mt-4">
                <table class="table @(_isUpdate ? "table-hover": "") table-bordered market-sort-order-table">
                    <thead class="table-head">
                        <tr>
                            <th class="th-market">@_translationState.GetValue("Market")</th>
                            <th class="th-market-group">@_translationState.GetValue("Market Group")</th>
                            <th class="th-action"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_isPreLoader || _isMarketPreLoader)
                        {
                            <tr>
                                <td colspan="3">
                                    <Preloader />
                                </td>
                            </tr>
                        }
                        else
                        {
                            if (_marketTemplates != null && _marketTemplates.Any())
                            {
                                @foreach (var model in _marketTemplates.OrderBy(x => x.SortOrder))
                                {
                                    <tr @key="@($"row-sp:{_filterModel.SelectedSportId}-fist:{_filterModel.SelectedFixtureStatusId}-mate:{model.MarketTemplateId}")" class="@(_isUpdate ? "" : "row-disabled")" id="name-@model.MarketTemplateId" data-sort-order="@model.SortOrder">
                                        <td>@model.MarketTemplateName</td>
                                        <td>
                                            <div @key="@($"select-sp:{_filterModel.SelectedSportId}-fist:{_filterModel.SelectedFixtureStatusId}-mate:{model.MarketTemplateId}")" class="d-flex justify-content-center">
                                                <select id="select-@model.MarketTemplateId" class="@_selectClass form-select" multiple="multiple">
                                                    @foreach (var group in _marketGroups)
                                                    {
                                                        <option value="@group.Value" selected=@(model.MarketTemplateGroupNames.Select(s => s.ToLower()).Contains(group.Name.ToLower()))>@group.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-center">
                                                <a class="link-bars me-2 drag-handle" href="javascript:(0)">
                                                    <i class="fa fa-bars"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3">
                                        <NoRecordFound Message="@_translationState.GetValue("No Record Found")" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <CustomModal OnSaveClickCallback="OnSaveCopyClickEvent" OnCancelClickCallback="OnModalDiscardChanges" />
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@SportsbookClientPermission.SBC_OE_MarketSetting_SortOrder.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>