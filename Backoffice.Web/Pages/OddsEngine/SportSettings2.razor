@using Backoffice.Web.Components.OddsEngine.SportSettings

@layout OEMonitoringLayout

@page "/hk/odds-engine/sport-settings"

<AuthorizeView Policy="sbc-sports-setting">
    <Authorized>
        <div class="d-flex flex-column">
            <div>
                <Breadcrumb Breadcrumbs="_breadcrumbs" Region="hk" />
            </div>
            <div>
                <PageHeader PageHeaderModel="_pageHeaderModel" />
            </div>
            @if (_alertModel != null)
            {
                <div class="mx-3 mb-3">
                    <AlertMessage AlertModel="_alertModel" />
                </div>
            }
            <div>
                <Filter2 Render="_renderFilter" OnClientChangedCallback="OnClientChangedEvent" OnUpdateClickCallback="OnUpdateClickEvent" />
            </div>
            <div class="d-flex @(_isPreload || !_isUpdate || (_isUpdate && _currentEditPage == EditSportSettingsPage.SegmentAndLeagues) ? "flex-column" : "") mx-3 mt-4">
                @if (!_isPreload)
                {

                    if (_sportSettings.Any())
                    {
                        if (!_isUpdate)
                        {
                            <div class="mb-2">
                                <h6 class="fw-bold">Sports</h6>
                            </div>

                            <Main SportSettings="_sportSettings" />
                        }
                        else if (_sportLookupSettings.Any())
                        {
                            if (_currentEditPage == EditSportSettingsPage.Sport)
                            {
                                <EditSports SportSettings="_sportSettings" SportLookupSettings="_sportLookupSettings" />
                            }
                            else if (_currentEditPage == EditSportSettingsPage.SegmentAndLeagues)
                            {
                                <div class="mb-2">
                                    <h6 class="fw-bold">Sports Tree</h6>
                                </div>

                                <EditSegmentLeagues @bind-SportSettings="_editedSportSettings" />
                            }
                        }
                    }
                    else
                    {
                        // no record found
                    }
                }
                else
                {
                    <div class="my-2">
                        <Preloader />
                    </div>
                }
            </div>
        </div>
        <CustomModal />
    </Authorized>
    <NotAuthorized>
        <RedirectToPage FromPage="@SportsbookClientPermission.SBC_OE_SportsSettings.ToString().Replace('_', '.')" />
    </NotAuthorized>
</AuthorizeView>