@using Backoffice.Web.Components.OddsEngine.Configuration

@inherits BasePage

@layout OEMonitoringLayout

@page "/hk/odds-engine/config-templates/{Action}/{configTemplateId:long}"
@page "/hk/odds-engine/config-templates/{Action}/{configTemplateId:long}/{view:bool}"

<Breadcrumb Breadcrumbs="_breadcrumbs" />

<div class="col-md-12 mb-4">
    <div class="col-md-12 my-4">
        <div class="d-flex justify-content-between">
            @if (!_isEdttingName)
            {
                <div class="d-flex align-items-center">
                    <h4 class="page-title fw-bold m-0">@_configTemplateName</h4>

                    @if (!string.IsNullOrEmpty(_configTemplateName))
                    {
                        <icon class="btn border-0 ico ico-pen mx-2" @onclick="OnTemplateNameClicked" disabled="@(!_isProcessing)"></icon>
                    }
                </div>
            }
            else
            {
                <div class="d-flex border col-8">
                    <input class="template-name edit border-0 form-control w-100 shadow-none" @bind-value="_temporaryName" />
                    <button class="btn border-0 fa fa-close" @onclick="OnCancelTemplateNameClicked"></button>
                    <button class="btn border-0 fa fa-check" @onclick="OnSaveTemplateNameClicked"></button>
                </div>
            }
            <div class="d-flex align-items-center">
                @if (!View)
                {
                    <button type="button" class="btn btn-cancel mx-1" @onclick="OnCancelMarginTemplate">@_translationState.GetValue("Cancel")</button>
                    <button type="button" class="btn btn-save mx-1" disabled="@(!(_hasChanges || _isNameChanges) || _isPreloader || _isProcessing || _isEdttingName)" @onclick="OnSaveMarginTemplate">@_translationState.GetValue("Save Changes")</button>
                }
            </div>
        </div>
        @if (_isExisitngName)
        {
            <div class="col">
                <span class="fst-italic text-danger">Sorry, that name already exists!</span>
            </div>
        }
    </div>

    <div class="col-md-12 mb-4">
        <div class="d-flex card-flex">
            <div class="border card-block">
                <div class="card-icon">
                    <i class=@($"iconfont iconfont-{_sportIcon}")></i>
                </div>

                <div class="card-desc">
                    <label class="fw-bold">@_translationState.GetValue("Sport")</label>
                    <label>@_translationState.GetValue(_sportName)</label>
                </div>
            </div>

            <div class="border card-block">
                <div class="card-icon">
                    <i class="ico ico-top-leagues"></i>
                </div>

                <div class="card-desc">
                    <label class="fw-bold">@_translationState.GetValue("Scope")</label>
                    <label>@_translationState.GetValue(_scope)</label>
                </div>
            </div>
        </div>

    </div>

    <AlertMessage AlertClass="mx-3" AlertModel="@_alertModel"></AlertMessage>
    <hr />
</div>

<EditConfigTemplateFilter ConfigTemplateId="@ConfigTemplateId" EditConfigTemplateFilterCallback="InitConfigEditTemplate" />

<div class="d-flex justify-content-end mb-4">
    <button type="button" class="btn btn-activate-all fw-bold" @onclick="OnAllMarketStatusClickEvent" disabled="@View">@_allMarketStatusName</button>
</div>

<div class="col-md-12 mb-4">
    @if (_isPreloader)
    {
        <Preloader />
    }
    else
    {
        if (_marketLookupNavigation != null && _marketLookupNavigation.Any(m => m.IsVisible))
        {
            foreach (var market in _marketLookupNavigation.Where(m => m.IsVisible))
            {
                <AccordionTemplateConfiguration Market="market" IsReadOnly="View"
                                                @key="@($"{_editConfigTemplateFilterModel.ConfigTemplate.SportId}-{market.MarketLookup.MarketTemplateId}")"
                                                FilterConfigStatus="@_editConfigTemplateFilterModel.SelectedConfigStatus"
                                                Scope="@_editConfigTemplateFilterModel.ScopeId"
                                                OnTemplateMarginChangeCallback="OnTemplateMarginChange" />
            }
        }
        else
        {
            <NoRecordFound Message="@_translationState.GetValue("No Record Found")" />
        }
    }


</div>

<CustomModal />