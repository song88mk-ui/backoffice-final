@using Backoffice.Web.Components.OddsEngine.Configuration

@layout OEMonitoringLayout

@page "/hk/odds-engine/config-templates/{Action}/{configTemplateId:long}"
@page "/hk/odds-engine/config-templates/{Action}/{configTemplateId:long}/{view:bool}"

<Breadcrumb Breadcrumbs="Breadcrumbs" Region="@Region" />

<div class="col-md-12 mb-4">
    <div class="col-md-12 my-4">
        <div class="d-flex justify-content-between">
            @if (!_isEdttingName)
            {
                <div class="d-flex align-items-center">
                    <h4 class="page-title fw-bold m-0">@ConfigTemplateName</h4>

                    @if (!string.IsNullOrEmpty(ConfigTemplateName))
                    {
                        <icon class="btn border-0 ico ico-pen mx-2" @onclick="OnTemplateNameClicked"></icon>
                    }
                </div>
            }
            else
            {
                <div class="d-flex border col-8">
                    <input class="template-name edit border-0 form-control w-100 shadow-none" @bind-value="_temporaryName" />
                    <button class="btn border-0 fa fa-close" @onclick="OnCancelTemplateNameClicked"></button>
                    <button class="btn border-0 fa fa-check" @onclick="OnSaveTemplateNameClicked"></button>
                </div>
            }
            <div class="d-flex align-items-center">
                @if (!View)
                {
                    <button type="button" class="btn btn-cancel mx-1" @onclick="OnCancelMarginTemplate">Cancel</button>
                    <button type="button" class="btn btn-save mx-1" disabled="@(!(HasChanges || IsNameChanges) || IsPreloader || _isProcessing || _isEdttingName)" @onclick="OnSaveMarginTemplate">@TranslationState.GetValue("Save Changes")</button>
                }
            </div>
        </div>
        @if (_isExisitngName)
        {
            <div class="col">
                <span class="fst-italic text-danger">Sorry, that name already exists!</span>
            </div>
        }
    </div>

    <div class="col-md-12 mb-4">
        <div class="d-flex card-flex">
            <div class="border card-block">
                <div class="card-icon">
                    <i class=@($"iconfont iconfont-{SportIcon}")></i>
                </div>

                <div class="card-desc">
                    <label class="fw-bold">Sport</label>
                    <label>@SportName</label>
                </div>
            </div>

            <div class="border card-block">
                <div class="card-icon">
                    <i class="ico ico-top-leagues"></i>
                </div>

                <div class="card-desc">
                    <label class="fw-bold">Scope</label>
                    <label>@($"{Scope}")</label>
                </div>
            </div>
        </div>

    </div>

    <AlertMessage AlertClass="mx-3" AlertModel="@_alertModel"></AlertMessage>
    <hr />
</div>

<EditConfigTemplateFilter ConfigTemplateId="@ConfigTemplateId" EditConfigTemplateFilterCallback="InitConfigEditTemplate" />

<div class="d-flex justify-content-end mb-4">
    <button type="button" class="btn btn-activate-all fw-bold" @onclick="OnAllMarketStatusClickEvent" disabled="@View">@AllMarketStatusName</button>
</div>

<div class="col-md-12 mb-4">
    @if (IsPreloader)
    {
        <Preloader />
    }
    else
    {
        if (MarketLookupNavigation != null && MarketLookupNavigation.Any(m => m.IsVisible))
        {
            foreach (var market in MarketLookupNavigation.Where(m => m.IsVisible))
            {
                <AccordionTemplateConfiguration Market="market" IsReadOnly="View"
                                                @key="@($"{EditConfigTemplateFilterModel.ConfigTemplate.SportId}-{market.MarketLookup.MarketTemplateId}")"
                                                FilterConfigStatus="@EditConfigTemplateFilterModel.SelectedConfigStatus"
                                                Scope="@EditConfigTemplateFilterModel.ScopeId"
                                                OnTemplateMarginChangeCallback="OnTemplateMarginChange" />
            }
        }
        else
        {
            <NoRecordFound />
        }
    }


</div>

<CustomModal />