@using Backoffice.Web.Components.OddsEngine.Configuration

@layout OEMonitoringLayout

@page "/hk/odds-engine/config-templates/edit/{configTemplateId:long}"
@page "/hk/odds-engine/config-templates/edit/{configTemplateId:long}/{view:bool}"

<Breadcrumb Breadcrumbs="Breadcrumbs" Region="@Region" />

<div class="col-md-12 mb-4">
    <div class="col-md-12 mb-4">
        <div class="d-flex justify-content-between mx-4">
            <div>
                <h4 class="page-title fw-bold">@ConfigTemplateName</h4>
            </div>

            <div>
                @if(!View)
                {
                    <button type="button" class="btn btn-cancel" @onclick="OnCancelMarginTemplate">Cancel</button>
                    <button type="button" class="btn btn-save" disabled="@(!HasChanges)" @onclick="OnSaveMarginTemplate">Save Changes</button>
                }
            </div>
        </div>
    </div>

    <div class="col-md-12 mb-4">
        <div class="d-flex card-flex">
            <div class="border card-block">
                <div class="card-icon">
                    <i class=@($"iconfont iconfont-{SportIcon}")></i>
                </div>

                <div class="card-desc">
                    <label class="fw-bold">Sport</label>
                    <label>@SportName</label>
                </div>
            </div>

            <div class="border card-block">
                <div class="card-icon">
                    <i class="ico ico-top-leagues"></i>
                </div>

                <div class="card-desc">
                    <label class="fw-bold">Scope</label>
                    <label>@($"{Scope}")</label>
                </div>
            </div>
        </div>

    </div>

    <AlertMessage AlertClass="mx-3" AlertModel="@_alertModel"></AlertMessage>
    <hr />
</div>

<EditConfigTemplateFilter ConfigTemplateId="@ConfigTemplateId" EditConfigTemplateFilterCallback="InitConfigEditTemplate" />

<div class="d-flex justify-content-end mb-4">
    <button type="button" class="btn btn-activate-all fw-bold" @onclick="OnAllMarketStatusClickEvent" disabled="@View">@AllMarketStatusName</button>
</div>

<div class="col-md-12 mb-4">
    @if (IsPreloader)
    {
        <Preloader />
    }
    else
    {
        if (MarketLookupNavigation != null && MarketLookupNavigation.Any(m => m.IsVisible))
        {
            foreach (var market in MarketLookupNavigation.Where(m => m.IsVisible))
            {
                <AccordionTemplateConfiguration Market="market" IsReadOnly="View"
                    @key="@($"{EditConfigTemplateFilterModel.ConfigTemplate.SportId}-{market.MarketLookup.MarketTemplateId}")"
                    FilterConfigStatus="@EditConfigTemplateFilterModel.SelectedConfigStatus"
                    Scope="@EditConfigTemplateFilterModel.ScopeId" 
                    OnTemplateMarginChangeCallback="OnTemplateMarginChange"/>
            }
        }
        else
        {
            <NoRecordFound />
        }
    }


</div>

<CustomModal />