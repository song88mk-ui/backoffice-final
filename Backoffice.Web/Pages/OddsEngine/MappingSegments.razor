@using Backoffice.Web.Components.OddsEngine.Mapping.Segment
@using Backoffice.Web.Pages.OddsEngine.Base

@inherits BaseMappingPage
@layout OEMonitoringLayout

@page "/hk/odds-engine/mapping-segments"

<AuthorizeView Policy="sbc-mapping">
    <Authorized>
        <div class="col-md-12">
            <Breadcrumb Breadcrumbs="BreadcrumbModel" />
        </div>    
        <div class="tab-container">
            <div class="tab @(ActiveTab == MappingTab.Unmapped ? "active-tab" : "inactive-tab")" @onclick="_ => HandleTabClick(MappingTab.Unmapped)">@_translationState.GetValue("Unmapped") (@UnmappedCount)</div>
            <div class="tab @(ActiveTab == MappingTab.Mapped ? "active-tab" : "inactive-tab")" @onclick="_ => HandleTabClick(MappingTab.Mapped)">@_translationState.GetValue("Mapped") (@MappedCount)</div>
        </div>
        <div class="header-container">
            <OEPageHeader PageHeaderModel="PageHeaderModel" PageHeaderClassName="mapping-fixture" />
            <div class="button-logs">
                @_translationState.GetValue("Logs")
            </div>
        </div>

        @if (ActiveTab == MappingTab.Unmapped)
        {
            <UnmappedSegment OnItemsCountUpdateCallback="SetMappingTabCount"  />
        }

        @if (ActiveTab == MappingTab.Mapped)
        {
            <MappedSegment OnItemsCountUpdateCallback="SetMappingTabCount" />
        }
    </Authorized>
</AuthorizeView>