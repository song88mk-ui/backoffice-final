@using Backoffice.Web.Components.Common
@using Backoffice.Web.Components.ParlayBonus

@page "/parlay-bonus"

<AuthorizeView Policy="sbc-menu-parlaybonus">
    <Authorized>
        <div class="row">
            <div class="main-content col-md-12 mb-4 pb-3">
                <div class="row">
                    <div class="col-md-12">
                        <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
                    </div>
                    <div class="col-md-12">
                        <Filter ClientParlayBonusResponse="@ClientParlayBonusResponse" OnClientChangedCallback="OnClientChangedEvent" OnUpdateClickCallback="OnUpdateClick" />
                    </div>
                    <div class="col-md-12">
                        @if (ClientParlayBonusResponse == null || ClientParlayBonusResponse.ParlayBonusConfig.Count == 0)
                        {
                            <NoRecordFound />
                        }
                        else
                        {
                            <table class="table table-hover table-borderless mt-4">
                                <thead class="table-head-pb">
                                    <tr>
                                        <th class="th-number py-3">No. of Selections</th>
                                        <th class="th-parlay-bonus py-3">
                                            <span>Parlay Bonus</span>
                                            <i class="tooltip2 fa fa-info-circle ms-5">
                                                <span class="tooltiptext">Minimum Value: 0.01<br />Maximum Value: 5000</span>
                                            </i>
                                        </th>
                                        <th class="th-action py-3">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in ClientParlayBonusResponse.ParlayBonusConfig)
                                    {
                                        <tr>
                                            <td>@item.SelectionCount</td>
                                            <td class="td-parlay-bonus">@(item.ParlayBonus * 100)%</td>
                                            <td>
                                                @if (IsUpdating)
                                                {

                                                    <button type="button" class="btn tl-link-add me-2" title="Delete" @onclick="_ => OnDeleteConfig(item)">
                                                        <i class="fa fa-trash"></i>
                                                    </button>
                                                }            
                                                else
                                                {
                                                    <button type="button" class="btn tl-link-add me-2" title="Delete" @onclick="_ => OnDeleteConfig(item)" disabled>
                                                        <i class="fa fa-trash"></i>
                                                    </button>
                                                }
                                                <button type="button" class="btn tl-link-minus me-2" title="View History" @onclick="_ => OnViewConfigLog(item)">
                                                    <i class="fa fa-list-alt"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <Pagination MetaData="MetaData" Spread="3" SelectPageEvent="SelectPage" PaginationColspan="1" />
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div>
            <CustomModal />
        </div>
    </Authorized>
    <NotAuthorized>
    </NotAuthorized>
</AuthorizeView>