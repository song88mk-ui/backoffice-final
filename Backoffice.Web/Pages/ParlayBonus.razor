@using Backoffice.Web.Components.Common
@using Backoffice.Web.Components.ParlayBonus

@page "/parlay-bonus"

<div class="row">
    <div class="main-content col-md-12 mb-4 pb-3">
        <div class="row">
            <div class="col-md-12">
                <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
            </div>
            <div class="col-md-12">
                <Filter ClientParlayBonusResponse="@ClientParlayBonusResponse" OnClientChangedCallback="OnClientChangedEvent" />
            </div>
            <div class="col-md-12">
                @if (ClientParlayBonusResponse == null || ClientParlayBonusResponse.ParlayBonusConfig.Count == 0)
                {
                    <NoRecordFound/>
                }
                else
                {
                    <table class="table table-hover table-borderless mt-4">
                        <thead class="table-head-pb">
                            <tr>
                                <th class="th-number py-3">No. of Selections</th>
                                <th class="th-parlay-bonus py-3">
                                    <span>Parlay Bonus</span>
                                    <i class="fa fa-info-circle ms-5"></i>
                                </th>
                                <th class="th-action py-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ClientParlayBonusResponse.ParlayBonusConfig)
                            {
                                <tr>
                                    <td>@item.SelectionCount</td>
                                    <td class="td-parlay-bonus">@(item.ParlayBonus * 100)%</td>
                                    <td>
                                        <a class="tl-link-add me-2" title="Delete" @onclick="_ => OnDeleteConfig(item)">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                        <a class="tl-link-minus me-2" title="View History" @onclick="_ => OnViewConfigLog(item)">
                                            <i class="fa fa-list-alt"></i>
                                        </a>                                       
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <Pagination MetaData="MetaData" Spread="3" SelectPageEvent="SelectPage" PaginationColspan="1" />
                    </table>
                }
            </div>
        </div>
    </div>
</div>
<div>
    <CustomModal/>
</div>