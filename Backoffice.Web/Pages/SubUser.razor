@using Backoffice.Web.Components.Common
@using Backoffice.Web.Components.SubUser

@page "/sub-user"

<div class="rpw">
    <div class="main-content col-md-12 mb-4 pb-3">
        <div class="row">
            <div class="col-md-12">
                <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
            </div>
            <div class="col-md-12">
                <Filter />
            </div>
            <div class="col-md-12">
                <table class="table table-hover table-borderless mt-4">
                    <thead class="table-head">
                        <tr>
                            <th class="th-username py-3">Username</th>
                            <th class="th-nickname py-3">Nickname</th>
                            <th class="th-date-created py-3">Date Created</th>
                            <th class="th-status py-3">Status</th>
                            <th class="th-preference py-3">Sub User Preference</th>
                            <th class="th-manage py-3">Manage</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <span class="fw-bold">User 1</span>
                            </td>
                            <td>US1</td>
                            <td>02/12/2022</td>
                            <td>
                                <span class="status-normal py-1 px-4 rounded-pill">Normal</span>
                            </td>
                            <td>Dashboard</td>
                            <td>
                                <a class="link-edit me-2" href="javascript:(0)">
                                    <i class="fa fa-edit"></i>
                                </a>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <span class="fw-bold">User 2</span>
                            </td>
                            <td>US2</td>
                            <td>03/12/2022</td>
                            <td>
                                <span class="status-locked py-1 px-4 rounded-pill">Locked</span>
                            </td>
                            <td>Dashboard</td>
                            <td>
                                <a class="link-edit me-2" href="javascript:(0)">
                                    <i class="fa fa-edit"></i>
                                </a>
                            </td>
                        </tr>
                    </tbody>
                    <Pagination MetaData="MetaData" Spread="3" SelectPageEvent="SelectPage" PaginationColspan="4" />
                </table>
            </div>
        </div>
    </div>
</div>
<div>
    <CustomModal />
</div>