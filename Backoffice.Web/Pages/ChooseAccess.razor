@layout AccessLayout
@page "/"
@page "/choose-access"

<AuthorizeView>
    <Authorized>
        <PageTitle>Backoffice - Choose Access</PageTitle>
        <div class="d-flex justify-content-center justify-content-center align-items-center h-100 w-100">
            <div class="d-block align-items-center justify-content-center" style="width: 45rem;">
                <div class="d-flex justify-content-between">
                    @if (UserClaims.Any(c => c.Type.Contains(nameof(PermissionCategory.Admin) + ".")))
                    {
                        <div class="access-item m-2 d-flex flex-column justify-content-between rounded-2">
                            <div class="top-row mx-2 pt-5">
                                <div class="access-item-logo">
                                    <i class="ico ico-admin"></i>
                                </div>
                                <h4 class="text-center mt-3 fw-bold">Admin</h4>
                            </div>
                            <div class="middle-row mx-2 mt-3 mb-1">
                                <p class="text-center mx-1">
                                    Create and manage user and user groups, modify, settle, or cancel bets, and view manual bet settlement history
                                </p>
                            </div>
                            <div class="bottom-row mx-2 mb-2">
                                <a href="admin/dashboard" class="d-block py-2 rounded-2 text-decoration-none">
                                    <span class="link-text">@_translationState.GetValue("Go to admin page")</span>
                                    <i class="fa fa-chevron-right"></i>
                                </a>
                            </div>
                        </div>
                    }
                    @if (UserClaims.Any(c => c.Type.Contains(nameof(PermissionCategory.PMS) + ".")))
                    {
                        <div class="access-item m-2 d-flex flex-column justify-content-between rounded-2">
                            <div class="top-row mx-2 pt-5">
                                <div class="access-item-logo">
                                    <i class="ico ico-pm"></i>
                                </div>
                                <h4 class="text-center mt-3 fw-bold">Partner Management</h4>
                            </div>
                            <div class="middle-row mx-2 mt-3 mb-1">
                                <p class="text-center mx-1">
                                    Create and manage partners, transfer payments, view reports, payment, and settlement history, and more
                                </p>
                            </div>
                            <div class="bottom-row mx-2 mb-2">
                                <a href="/dashboard" class="d-block py-2 rounded-2 text-decoration-none">
                                    <span class="link-text">Go to Partner Management Page</span>
                                    <i class="fa fa-chevron-right"></i>
                                </a>
                            </div>
                        </div>
                    }
                    @if (UserClaims.Any(c => c.Type.Contains(nameof(PermissionCategory.SBC) + ".")))
                    {
                        <div class="access-item m-2 d-flex flex-column justify-content-between rounded-2">
                            <div class="top-row mx-2 pt-5">
                                <div class="access-item-logo">
                                    <i class="ico ico-sbc"></i>
                                </div>
                                <h4 class="text-center mt-3 fw-bold">@_translationState.GetValue("Sportsbook Clients")</h4>
                            </div>
                            <div class="middle-row mx-2 mt-3 mb-1">
                                <p class="text-center mx-1">
                                    @_translationState.GetValue("Sportsbook Clients details")
                                </p>
                            </div>
                            <div class="bottom-row mx-2 mb-2">
                                <a href="/dashboard" class="d-block py-2 rounded-2 text-decoration-none">
                                    <span class="link-text">@_translationState.GetValue("Go to Sportsbook Client Page")</span>
                                    <i class="fa fa-chevron-right"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
                <div class="d-flex justify-content-end">
                    <div class="w-75 d-flex justify-content-end align-items-center">
                        <button type="button" @onclick="OnLogoutClickEvent" class="btn-logout m-2 py-2 px-3 text-decoration-none text-center">
                            <i class="me-2 fa fa-sign-out" aria-hidden="true"></i>
                            @_translationState.GetValue("Logout")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <LoginRedirect />
    </NotAuthorized>
</AuthorizeView>
<CustomModal/>
