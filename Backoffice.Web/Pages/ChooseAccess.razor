@layout AccessLayout
@page "/choose-access"
@using Backoffice.Shared.Enums;

<AuthorizeView>
    <Authorized>
        <div class="col-12 h-75 d-flex justify-content-center justify-content-center align-items-end">
            <div class="w-75 d-flex align-self-end">
                @if (UserClaims?.Where(c => c.Type.Contains(nameof(Application.Admin)) && c.Value != "0").ToList().Count > 0)
                {
                    <div class="access-item m-2 d-flex flex-column justify-content-between rounded-2">
                        <div class="top-row mx-2 pt-5">
                        <div class="access-item-logo">
                            <i class="ico ico-admin"></i>
                        </div>
                        <h4 class="text-center mt-3 fw-bold">Admin</h4>
                    </div>
                    <div class="middle-row mx-2 mt-3 mb-1">
                        <p class="text-center mx-1">
                            Create and manage user and user groups, modify, settle, or cancel bets, and view manual bet settlement history
                        </p>
                    </div>
                    <div class="bottom-row mx-2 mb-2">
                        <a href="/dashboard" class="d-block py-2 rounded-2 text-decoration-none">
                            <span class="link-text">Go to Admin Page</span>
                            <i class="fa fa-chevron-right"></i>
                        </a>
                    </div>
                </div>
                }
                @if (UserClaims?.Where(c => c.Type.Contains(nameof(Application.PartnerManagement)) && c.Value != "0").ToList().Count > 0)
                {
                    <div class="access-item m-2 d-flex flex-column justify-content-between rounded-2">
                        <div class="top-row mx-2 pt-5">
                        <div class="access-item-logo">
                            <i class="ico ico-pm"></i>
                        </div>
                        <h4 class="text-center mt-3 fw-bold">Partner Management</h4>
                    </div>
                    <div class="middle-row mx-2 mt-3 mb-1">
                        <p class="text-center mx-1">
                            Create and manage partners, transfer payments, view reports, payment, and settlement history, and more
                        </p>
                    </div>
                    <div class="bottom-row mx-2 mb-2">
                        <a href="/dashboard" class="d-block py-2 rounded-2 text-decoration-none">
                            <span class="link-text">Go to Partner Management Page</span>
                            <i class="fa fa-chevron-right"></i>
                        </a>
                    </div>
                </div>
                }
                @if (UserClaims?.Where(c => c.Type.Contains(nameof(Application.SportsbookClient)) && c.Value != "0").ToList().Count > 0)
                {
                    <div class="access-item m-2 d-flex flex-column justify-content-between rounded-2">
                        <div class="top-row mx-2 pt-5">
                            <div class="access-item-logo">
                                <i class="ico ico-sbc"></i>
                            </div>
                            <h4 class="text-center mt-3 fw-bold">Sportsbook Clients</h4>
                        </div>
                        <div class="middle-row mx-2 mt-3 mb-1">
                            <p class="text-center mx-1">
                                Generate deeplink, modify top leagues and fixtures, manage clients, update parlay bonus, and view all bets, reports, and monthly settlements
                            </p>
                        </div>
                        <div class="bottom-row mx-2 mb-2">
                            <a href="/dashboard" class="d-block py-2 rounded-2 text-decoration-none">
                                <span class="link-text">Go to Sportsbook Clients Page</span>
                                <i class="fa fa-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                }
                @if (UserClaims?.Where(c => c.Type.Contains(nameof(Application.Trading)) && c.Value != "0").ToList().Count > 0)
                {
                    <div class="access-item m-2 mr-0 d-flex flex-column justify-content-between rounded-2">
                        <div class="top-row mx-2 pt-5">
                            <div class="access-item-logo">
                                <i class="ico ico-trading"></i>
                            </div>
                            <h4 class="text-center mt-3 fw-bold">Trading</h4>
                        </div>
                        <div class="middle-row mx-2 mt-3 mb-1">
                            <p class="text-center mx-1">
                                Access Odds Engine and manage max liabilities
                            </p>
                        </div>
                        <div class="bottom-row mx-2 mb-2">
                            <a href="/odds-engine" class="d-block py-2 rounded-2 text-decoration-none">
                                <span class="link-text">Go to Trading Page</span>
                                <i class="fa fa-chevron-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="col-12">
            <div class="m-auto w-75 d-flex justify-content-end align-items-center">
                <a href="/logout" class="btn-logout m-2 py-2 px-3 text-decoration-none text-center">
                    <i class="me-2 fa fa-sign-out" aria-hidden="true"></i>
                    Logout
                </a>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <LoginRedirect />
    </NotAuthorized>
</AuthorizeView>

