@using Backoffice.Web.Components.TopLeagues

@page "/top-leagues"

<div class="row">
    <div class="main-content col-md-12 mb-4">
        <div class="row">
            <div class="col-md-12">
                <PageHeader PageTitle="@PageTitle" />
            </div>
            <div class="col-md-12">
                <Filter />
            </div>
            <div class="col-md-12">
                <div class="content mx-3">
                    <table class="tbl tbl-top-leagues">
                        <thead>
                            <tr>
                                <th class="th-number py-2">No.</th>
                                <th class="th-client py-2">Client</th>
                                <th class="th-top-leagues py-2">Top Leagues</th>
                                <th class="th-action py-2">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="py-2">
                                    <span>1</span>
                                </td>
                                <td class="py-2">
                                    <span>10 Cric India</span>
                                </td>
                                <td class="py-2">
                                    <div class="row mb-1">
                                        <div class="col-md-4 tl-fixture py-1 px-1 rounded-2 me-1">USA > Major League Soccer</div>
                                        <div class="col-md-4 tl-fixture py-1 px-1 rounded-2 me-1">Denmark > 1st Division</div>
                                        <div class="col-md-4 tl-fixture py-1 px-1 rounded-2 me-1">England > EFL Cup</div>
                                    </div>
                                    <div class="row mb-1">
                                        <div class="col-md-4 tl-fixture py-1 px-1 rounded-2 me-1">USA > Major League Soccer 5</div>
                                        <div class="col-md-4 tl-fixture py-1 px-1 rounded-2 me-1">USA > Major League Soccer 6</div>
                                    </div>
                                </td>
                                <td class="py-2">
                                    <a class="tl-link-edit me-2" href="javascript:(0)">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <a class="tl-link-copy me-2" href="javascript:(0)">
                                        <i class="fa fa-copy"></i>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td class="py-2">
                                    <span>2</span>
                                </td>
                                <td class="py-2">
                                    <span>10 Cric India</span>
                                </td>
                                <td class="py-2">
                                    <div class="row mb-1">
                                        <div class="col-md-4 tl-fixture py-1 px-1 rounded-2 me-1">USA > Major League Soccer</div>
                                        <div class="col-md-4 tl-fixture py-1 px-1 rounded-2 me-1">USA > Major League Soccer 2</div>
                                    </div>
                                </td>
                                <td class="py-2">
                                    <a class="tl-link-edit me-2" href="javascript:(0)">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <a class="tl-link-copy me-2" href="javascript:(0)">
                                        <i class="fa fa-copy"></i>
                                    </a>
                                </td>
                            </tr>
                            <tr>
                                <td class="py-2">
                                    <span>3</span>
                                </td>
                                <td class="py-2">
                                    <span>10 Cric India</span>
                                </td>
                                <td class="py-2">
                                    <div class="row mb-1">
                                        <div class="col-md-4 tl-fixture py-1 px-1 rounded-2 me-1">USA > Major League Soccer</div>
                                        <div class="col-md-4 tl-fixture py-1 px-1 rounded-2 me-1">USA > Major League Soccer 2</div>
                                        <div class="col-md-4 tl-fixture py-1 px-1 rounded-2 me-1">USA > Major League Soccer 3</div>
                                    </div>
                                </td>
                                <td class="py-2">
                                    <a class="tl-link-edit me-2" href="javascript:(0)">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <a class="tl-link-copy me-2" href="javascript:(0)">
                                        <i class="fa fa-copy"></i>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td class="py-2">
                                    <span>Showing 10 of 100 entries</span>
                                </td>
                                <td class="py-2 text-end" colspan="3">
                                    <div class="tbl-pagination">
                                        <a class="me-2 text-decoration-none" href="javascript:void(0);">
                                            <i class="fa fa-chevron-left"></i>
                                        </a>
                                        <a class="me-2 text-decoration-none active" href="javascript:void(0);">1</a>
                                        <a class="me-2 text-decoration-none" href="javascript:void(0);">2</a>
                                        <a class="me-2 text-decoration-none" href="javascript:void(0);">3</a>
                                        <span class="me-2">.......</span>
                                        <a class="me-2 text-decoration-none" href="javascript:void(0);">30</a>
                                        <a class="me-2 text-decoration-none" href="javascript:void(0);">
                                            <i class="fa fa-chevron-right"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>