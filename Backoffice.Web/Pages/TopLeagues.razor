@using Backoffice.Web.Components.Common
@using Backoffice.Web.Components.TopLeagues

@page "/top-leagues"

<div class="row">
    <div class="main-content col-md-12 mb-4 pb-3">
        <div class="row">
            <div class="col-md-12">
                <PageHeader PageTitle="@PageTitle" IconClass="@IconClass" />
            </div>
            <div class="col-md-12">
                <Filter />
                @*                <Filter OnInitCallback="OnInitEvent" OnSearchCallback="OnSearchEvent"  />  *@
            </div>
            <div class="col-md-12">
                <div class="content mx-3">
                    <table class="tbl tbl-top-leagues">
                        <thead>
                            <tr>
                                <th class="th-number py-2">No.</th>
                                <th class="th-client py-2">Client</th>
                                <th class="th-top-leagues py-2">Top Leagues</th>
                                <th class="th-action py-2">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (TopLeaguesList != null && TopLeaguesList.ClientTopLeagues.Any())
                            {
                                int i = 1;
                                @foreach (var item in TopLeaguesList.ClientTopLeagues)
                                {
                                    <tr>
                                        <td class="py-2">
                                            <span>@i</span>
                                        </td>
                                        <td class="py-2">
                                            <span>@item.ClientName</span>
                                        </td>
                                        <td class="py-2">
                                            <div class="w-100 m-auto d-flex flex-row flex-wrap justify-content-start align-items-center">
                                                @foreach (var x in item.TopLeagues)
                                                {
                                                    <div class="tl-fixture m-1 py-1 rounded-2">
                                                        <span class="px-3">@x.LeagueName</span>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                        <td class="py-2">
                                            <a class="tl-link-edit me-2" href="javascript:(0)" @onclick="OnEdit">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <a class="tl-link-copy me-2" href="javascript:(0)" @onclick="OnEdit">
                                                <i class="fa fa-copy"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td class="py-2">
                                    <span>Showing 10 of 100 entries</span>
                                </td>
                                <td class="py-2 text-end" colspan="3">
                                    <div class="tbl-pagination">
                                        <a class="me-2 text-decoration-none" href="javascript:void(0);">
                                            <i class="fa fa-chevron-left"></i>
                                        </a>
                                        <a class="me-2 text-decoration-none active" href="javascript:void(0);">1</a>
                                        <a class="me-2 text-decoration-none" href="javascript:void(0);">2</a>
                                        <a class="me-2 text-decoration-none" href="javascript:void(0);">3</a>
                                        <span class="me-2">.......</span>
                                        <a class="me-2 text-decoration-none" href="javascript:void(0);">30</a>
                                        <a class="me-2 text-decoration-none" href="javascript:void(0);">
                                            <i class="fa fa-chevron-right"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        </tfoot>
                        <Pagination MetaData="MetaData" Spread="3" />
@*                        <Pagination MetaData="MetaData" Spread="3" SelectPageEvent="SelectPage" />
*@                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div>
    <CustomModal />
</div>