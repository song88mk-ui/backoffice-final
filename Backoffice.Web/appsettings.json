{
  "Serilog": {
    "Using": ["Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Information"
      }
    },
    "Enrich": ["FromLogContext", "WithEnvironmentName", "WithMachineName"],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "API": {
    "Backoffice": {
      "Uri": "https://bo-api.stg.song88.com",
      "Security": {
        "APIKey": "${API_KEY}"
      }
    },
    "HubAPI": "https://bo-ws.dev.song88.com/bohub"
  },
  "Tableau": {
    "Username": "NOC1",
    "Uri": "https://tableau.song88.com",
    "SiteId": "song88"
  },
  "Region": "HK",
  "Telemetry": {
    "Environment": "dev",
    "Enabled": false
  },
  "SlackWebHook": "https://hooks.slack.com",
  "Metabase": {
    "SiteUrl": "https://metabase.stg.song88.com",
    "SsoSecretKey": "${METABASE_SSO_SECRET_KEY}",
    "DashboardId": "13",
    "EmailDomain": "clients.song88.com"
  }
}
