@using Backoffice.Web.Models
@using Backoffice.Shared.Enums
@using Backoffice.Web.Utilities

@if (_navMenuAccess == PermissionCategory.SBC || _navMenuAccess == PermissionCategory.Admin)
{
    <div class="top-row ps-3 navbar">
        <div class="container-fluid">
            <img src="icons/svg/song-logo.svg" alt="Song88" />
        </div>
    </div>
}
else if (_navMenuAccess == PermissionCategory.OE)
{
    <div class="top-row navbar">
        <div class="container-fluid justify-content-start">
            <a href="dashboard" class="btn-back border border-2 rounded-circle me-3">
                <i class="fa fa-chevron-left ps-1 pe-2"></i>
            </a>
            <img src="icons/svg/song-logo.svg" alt="Song88" />
        </div>
    </div>
}

<div class="middle-bottom-row d-flex flex-column justify-content-between">
    <div class="middle-row mt-3" @onclick="() => collapseNavMenu = !collapseNavMenu">
        @if (_navMenuAccess == PermissionCategory.Admin || _navMenuAccess == PermissionCategory.SBC)
        {
            <nav class="flex-column">

                @if (_navMenus != null && _navMenus.Menus.Any())
                {
                    foreach (var menu in _navMenus.Menus)
                    {
                        if (menu.SubMenus.Any())
                        {
                            <div class="nav-item px-3">
                                <NavLink class="nav-link collapsed" data-bs-toggle="collapse" href="@menu.Url" role="button" aria-expanded="false" aria-controls="@menu.Id">
                                    <span class="ico ico-@(menu.IconName)" aria-hidden="true"></span>
                                    <span class="nav-menu-text">@_translationState.GetValue(menu.Name)</span>
                                    <span class="fa fa-chevron-right"></span>
                                </NavLink>
                                <div class="sub-menu collapse" id="@menu.Id">
                                    @*<nav class="flex-column">*@
                                    @foreach (var submenu in menu.SubMenus)
                                    {
                                        <div class="nav-item">
                                            <NavLink class="nav-link" href="@submenu.Url">
                                                <span class="ico ico-@(submenu.IconName)" aria-hidden="true"></span>
                                                <span class="nav-menu-text">@_translationState.GetValue(submenu.Name)</span>
                                            </NavLink>
                                        </div>
                                    }
                                    @*</nav>*@
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="@menu.Url">
                                    <span class="ico ico-@(menu.IconName)" aria-hidden="true"></span>
                                    <span class="nav-menu-text">@_translationState.GetValue(menu.Name)</span>
                                </NavLink>
                            </div>
                        }
                    }
                }

                @*<div class="nav-item px-3">
            <NavLink class="nav-link" href="oddin-poc">
            <span class="ico ico-oddin" aria-hidden="true"></span>
            <span class="nav-menu-text">Oddin POC</span>
            </NavLink>
            </div>*@
            </nav>
        }
        else if (_navMenuAccess == PermissionCategory.OE)
        {
            if (_sports?.Any() ?? false)
            {
                <div class="flex-column">
                    <div class="nav-item px-3">
                        <div class="nav-link header" href="javascript:void(0);">
                            <span class="fa fa-trophy all-sports" aria-hidden="true"></span>
                            <span class="nav-menu-text">@_translationState.GetValue("All Sports")</span>
                        </div>
                    </div>
                    @foreach (var sport in _sports.OrderBy(c => c.SortOrder))
                    {
                        <Backoffice.Web.Components.OddsEngine.SportsTree.SportItem Sport="sport" SelectecSport="_selectedSport"/>
                    }
                </div>
            }
        }
    </div>
    <div class="bottom-row">
        <nav class="flex-column">
            @*<div class="nav-item px-3">
            <NavLink class="nav-link" href="javascript:void(0)">
            <span class="ico ico-notification" aria-hidden="true"></span>
            <span class="nav-menu-text">Notifications</span>
            </NavLink>
            </div>*@
            <div class="nav-item px-3 pb-1">
                <span class="nav-item-header">@_translationState.GetValue("PROFILE")</span>
            </div>
            <div class="nav-item info mx-3 pb-1 mb-3 d-flex justify-content-between">
                <NavLink class="nav-link account ps-0" href="javascript:void(0)">
                    <span class="ico ico-user" aria-hidden="true"></span>
                    <span class="nav-menu-text">@UserModel.UserName?.ToUpper()</span>
                </NavLink>
                <NavLink class="nav-link key p-0" href="javascript:void(0)" @onclick="OnChangePasswordClickEvent">
                    <span class="ico ico-key" aria-hidden="true"></span>
                </NavLink>
            </div>
            @if (_showSwitchAccess)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link switch-access justify-content-center" href="choose-access">
                        <span class="ico ico-switch-access" aria-hidden="true"></span>
                        <span class="const-menu-item nav-menu-text">@_translationState.GetValue("Switch Access")</span>
                    </NavLink>
                </div>
            }
            <div class="nav-item px-3">
                <NavLink class="nav-link logout justify-content-center" href="javascript:void(0)" @onclick="OnLogoutClickEvent">
                    <span class="ico ico-logout" aria-hidden="true"></span>
                    <span class="const-menu-item nav-menu-text">@_translationState.GetValue("Logout")</span>
                </NavLink>
            </div>
        </nav>
    </div>
</div>
@* <CustomModal /> *@