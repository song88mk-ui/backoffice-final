@using Backoffice.Web.Models
@using Backoffice.Shared.Enums

@if (NavMenuAccess == NavMenuAccess.SBC || NavMenuAccess == NavMenuAccess.Admin)
{
    <div class="top-row ps-3 navbar">
        <div class="container-fluid">
            <img src="icons/svg/song-logo.svg" alt="Song88" />
        </div>
    </div>
}
else if (NavMenuAccess == NavMenuAccess.OE)
{
    <div class="top-row navbar">
        <div class="container-fluid justify-content-start">
            <a href="dashboard" class="btn-back border border-2 rounded-circle me-3">
                <i class="fa fa-chevron-left ps-1 pe-2"></i>
            </a>
            <img src="icons/svg/song-logo.svg" alt="Song88" />
        </div>
    </div>
}

<div class="middle-bottom-row d-flex flex-column justify-content-between">
    <div class="middle-row mt-3" @onclick="ToggleNavMenu">
        @if (NavMenuAccess == NavMenuAccess.SBC)
        {
            <nav class="flex-column">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/dashboard">
                        <span class="ico ico-dashboard" aria-hidden="true"></span>
                        <span class="nav-menu-text">Dashboard</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link collapsed" data-bs-toggle="collapse" href="#sub-menu-report" role="button" aria-expanded="false" aria-controls="sub-menu-report">
                        <span class="ico ico-reports" aria-hidden="true"></span>
                        <span class="nav-menu-text">Reports</span>
                        <span class="fa fa-chevron-right"></span>
                    </NavLink>
                    <div class="sub-menu collapse" id="sub-menu-report">
                    </div>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" data-bs-toggle="collapse" href="#sub-menu-setting" role="button" aria-expanded="false" aria-controls="sub-menu-setting">
                        <span class="ico ico-settings" aria-hidden="true"></span>
                        <span class="nav-menu-text">Settings</span>
                        <span class="fa fa-chevron-down"></span>
                    </NavLink>
                    <div class="sub-menu collapse show" id="sub-menu-setting">
                        <nav class="flex-column">
                            @if (UserModel?.Claims.Where(c => c.Type.Contains("SportsbookClient.TopLeagues") && c.Value != "0").ToList().Count > 0)
                            {
                                <div class="nav-item">
                                    <NavLink class="nav-link" href="/top-leagues">
                                        <span class="ico ico-top-leagues" aria-hidden="true"></span>
                                        <span class="nav-menu-text">Top Leagues</span>
                                    </NavLink>
                                </div>
                            }
                            @if (UserModel?.Claims.Where(c => c.Type.Contains("SportsbookClient.TopFixtures") && c.Value != "0").ToList().Count > 0)
                            {
                                <div class="nav-item">
                                    <NavLink class="nav-link" href="/top-fixtures">
                                        <span class="ico ico-top-fixtures" aria-hidden="true"></span>
                                        <span class="nav-menu-text">Top Fixtures</span>
                                    </NavLink>
                                </div>
                            }
                            @if (UserModel?.Claims.Where(c => c.Type.Contains("SportsbookClient.ParlayBonus") && c.Value != "0").ToList().Count > 0)
                            {
                                <div class="nav-item">
                                    <NavLink class="nav-link" href="/parlay-bonus">
                                        <span class="ico ico-parlay-bonus" aria-hidden="true"></span>
                                        <span class="nav-menu-text">Parlay Bonus</span>
                                    </NavLink>
                                </div>
                            }
                        </nav>
                    </div>
                </div>
                @if (string.IsNullOrWhiteSpace(UserModel?.MainUserId))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/sub-user">
                            <span class="ico ico-sub-user" aria-hidden="true"></span>
                            <span class="nav-menu-text">Sub User</span>
                        </NavLink>
                    </div>
                }
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="clients">
                        <span class="ico ico-clients" aria-hidden="true"></span>
                        <span class="nav-menu-text">Clients</span>
                    </NavLink>
                </div>

                @if (Claims.Where(c => c.Type.Contains("Trading.") && c.Value != "0").ToList().Count > 0)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="odds-engine">
                            <span class="ico ico-odds-engine" aria-hidden="true"></span>
                            <span class="nav-menu-text">Odds Engine</span>
                        </NavLink>
                    </div>
                }
            </nav>
        }
        else if (NavMenuAccess == NavMenuAccess.Admin)
        {
            <nav class="flex-column">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/dashboard">
                        <span class="ico ico-dashboard" aria-hidden="true"></span>
                        <span class="nav-menu-text">Dashboard</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/manage-user">
                        <span class="ico ico-manage-user" aria-hidden="true"></span>
                        <span class="nav-menu-text">Manage User</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/manage-user-group">
                        <span class="ico ico-manage-user" aria-hidden="true"></span>
                        <span class="nav-menu-text">Manage User Group</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" data-bs-toggle="collapse" href="#sub-menu-settlements" role="button" aria-expanded="false" aria-controls="sub-menu-setting">
                        <span class="ico ico-settlements" aria-hidden="true"></span>
                        <span class="nav-menu-text">Settlements</span>
                        <span class="fa fa-chevron-down"></span>
                    </NavLink>
                    <div class="sub-menu collapse show" id="sub-menu-settlements">
                        <nav class="flex-column">
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/manual-bet-settlement">
                                    <span class="ico ico-resend-settlement" aria-hidden="true"></span>
                                    <span class="nav-menu-text">Manual Bet Settlement</span>
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/resend-settlement">
                                    <span class="ico ico-resend-settlement" aria-hidden="true"></span>
                                    <span class="nav-menu-text">Resend Settlement</span>
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/market-settlement">
                                    <span class="ico ico-market-settlement" aria-hidden="true"></span>
                                    <span class="nav-menu-text">Market Settlement</span>
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/message-settlement">
                                    <span class="ico ico-message-settlement" aria-hidden="true"></span>
                                    <span class="nav-menu-text">Message Settlement</span>
                                </NavLink>
                            </div>
                        </nav>
                    </div>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/maintenance">
                        <span class="ico ico-maintenance" aria-hidden="true"></span>
                        <span class="nav-menu-text">Maintenance</span>
                    </NavLink>
                </div>
            </nav>
        }
        else if (NavMenuAccess == NavMenuAccess.OE)
        {
            <nav class="flex-column">
                <div class="nav-item px-3">
                    <NavLink class="nav-link header" href="javascript:void(0);">
                        <span class="fa fa-trophy all-sports" aria-hidden="true"></span>
                        <span class="nav-menu-text">All Sports</span>
                    </NavLink>
                </div>
                @if (Menu != null && Menu.Sports.Count > 0)
                {
                    @foreach (var sport in Menu.Sports)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" @onclick="_ => OnSportClickEvent(sport.SportId)">
                                <span class="@($"iconfont iconfont-{sport.SportName.ToLower().Replace(' ', '-')}")" aria-hidden="true"></span>
                                <span class="nav-menu-text">@sport.SportName</span>
                                <span class="@(sport.SportId == SelectedSport.SportId ? "fa fa-chevron-down" : "fa fa-chevron-right")"></span>
                            </NavLink>
                            @if (sport.SportId == SelectedSport.SportId)
                            {
                                <div class="sub-menu-oddsengine ms-3 show">
                                    <nav class="flex-column">
                                        <div class="nav-item">
                                            @foreach (var segment in sport.Segments)
                                            {
                                                <NavLink class="nav-link" @onclick="_ => OnSegmentClickEvent(segment.SegmentId)">
                                                    <span class="fa fa-chevron-right me-2"></span>
                                                    <span class="nav-menu-text">@segment.SegmentName</span>
                                                    <span class="@(sport.SportId == SelectedSport.SportId && segment.SegmentId == SelectedSport.SegmentId ? "fa fa-chevron-down" : "fa fa-chevron-right")"></span>
                                                </NavLink>
                                                @if (sport.SportId == SelectedSport.SportId && segment.SegmentId == SelectedSport.SegmentId)
                                                {
                                                    <div class="sub-menu-oddsengine ms-3 show">
                                                        @foreach (var league in segment.Leagues)
                                                        {
                                                            <NavLink class="nav-link" @onclick="_ => OnLeagueClickEvent(league.LeagueId)">
                                                                <span class="fa fa-chevron-right me-2"></span>
                                                                <span class="nav-menu-text">@league.LeagueName</span>
                                                            </NavLink>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </nav>
                                </div>
                            }
                        </div>
                    }
                }

            </nav>
        }
    </div>
    <div class="bottom-row">
        <nav class="flex-column">
            @*<div class="nav-item px-3">
            <NavLink class="nav-link" href="javascript:void(0)">
            <span class="ico ico-notification" aria-hidden="true"></span>
            <span class="nav-menu-text">Notifications</span>
            </NavLink>
            </div>*@
            <div class="nav-item px-3">
                <NavLink class="nav-link account" href="choose-access">
                    <span class="ico ico-user" aria-hidden="true"></span>
                    <span class="nav-menu-text">@UserModel?.UserName?.ToUpper()</span>
                </NavLink>
            </div>
        </nav>
    </div>
</div>
