@using Backoffice.Shared.Enums
@using Backoffice.Web.Models

@inherits MainLayoutBase

<ToastComponent />
<CascadingValue Value="AuthenticateAccessEvent" Name="AuthenticateAccessEvent">
    <CascadingValue Value="UserModel" Name="UserModel">
        <PageTitle>Backoffice - SBC - Odds Engine</PageTitle>
        <div class="page">
            @if (IsPreLoader)
            {
                <div class="preload-container d-flex justify-content-center align-items-center">
                    <Preloader InlineSpinnerCss="@InlineSpinnerCss" />
                </div>
            }
            else
            {
                <div class="sidebar">
                    <NavMenu NavMenuAccess="PermissionCategory.OE" OnSportClickCallback="OnSportClickEvent" Region="@Region" />
                </div>
                <main>
                    <article class="content px-4">
                        <div class="row">
                            <div class="main-content col-md-12 mb-4 pb-3 rounded">
                                <div class="row">
                                    <div class="header-container col-md-12">
                                        <HeaderNavMenu @ref="HeaderNavMenuReference" Region="@Region" />
                                    </div>

                                    <CascadingValue Value="SelectedSport" Name="SelectedSport">
                                        <CascadingValue Value="HeaderNavMenuReference" Name="HeaderNavMenuReference">
                                            @Body
                                        </CascadingValue>
                                    </CascadingValue>
                                </div>
                            </div>
                        </div>
                    </article>
                </main>
            }
        </div>
    </CascadingValue>
</CascadingValue>