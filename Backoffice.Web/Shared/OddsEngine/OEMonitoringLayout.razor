@using Backoffice.Shared.Enums
@inherits LayoutBase

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        @if (!PreRenderService.IsPreRendering)
        {
            <PageTitle>Backoffice - SBC - Odds Engine</PageTitle>
            <div class="page">
                @if (IsPreloader)
                {
                    <div class="preload-container d-flex justify-content-center align-items-center">
                        <Preloader InlineSpinnerCss="@InlineSpinnerCss" />
                    </div>
                }
                else
                {
                    <div class="sidebar">
                        <NavMenu NavMenuParameter="_navMenuParameter" OnSportClickCallback="HandleSportClick" />
                    </div>
                    <main>
                        <article class="content px-4">
                            <div class="row">
                                <div class="main-content col-md-12 mb-4 pb-3 rounded">
                                    <div class="row">
                                        <div class="header-container col-md-12">
                                            <HeaderNavMenu @ref="_headerNavMenuReference" />
                                        </div>

                                        <CascadingValue Value="_selectedSport" Name="SelectedSport">
                                            @Body
                                        </CascadingValue>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </main>
                }
            </div>
            <ToastComponent />
        }
    </ChildContent>
    <ErrorContent Context="errorException">
        <div id="blazor-error-ui">
            <div class="blazor-error-body">
                @{
                    LogError(errorException);
                }
            </div>
        </div>
    </ErrorContent>
</ErrorBoundary>


@code {
    [Inject] public IJSRuntime JsRuntime { get; set; }
    private ErrorBoundary? _errorBoundary;

    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }
    private async void LogError(Exception ex)
    {
        await JsRuntime.InvokeAsync<string>("console.log", $"{ex.Message}\n{ex.StackTrace}");
    }
}