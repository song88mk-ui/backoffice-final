<div class="d-flex">
    <div class="px-2 me-2 py-3 active">
        <a class="header-link text-decoration-none" href="odds-engine/monitoring">
            Monitoring
        </a>
    </div>
    <div class="px-2 me-2 py-3">
        <a class="header-link text-decoration-none" href="/odds-engine/config">
            Config
        </a>
    </div>
    <div class="px-2 me-2 py-3">
        <a class="header-link text-decoration-none" href="javascript:void(0)" @onclick="OnPriceBoostClickEvent">
            <span class="me-3">Price Boost</span>
            @if (ShowPriceBoostMenu)
            {
                <i class="fa fa-chevron-up"></i>
            }
            else
            {
                <i class="fa fa-chevron-down"></i>
            }
        </a>
        @if (ShowPriceBoostMenu)
        {
            <ul class="sub-menu-container rounded mt-2">
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="odds-engine/manage-boost">
                        Manage Boost
                    </a>
                </li>
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="odds-engine/boosted-settings">
                        Boosted Settings
                    </a>
                </li>
            </ul>
        }
    </div>
    <div class="px-2 me-2 py-3">
        <a class="header-link text-decoration-none" href="javascript:void(0)" @onclick="OnAdministrationClickEvent">
            <span class="me-3">Administration</span>
            @if (ShowAdministrationMenu)
            {
                <i class="fa fa-chevron-up"></i>
            }
            else
            {
                <i class="fa fa-chevron-down"></i>
            }
        </a>
        @if (ShowAdministrationMenu)
        {
            <ul class="sub-menu-container rounded mt-2">
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="odds-engine/manage-usergroup">
                        Manage User Groups
                    </a>
                </li>
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="javascript:void(0)">
                        Manage Users
                    </a>
                </li>
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="javascript:void(0)" @onclick="OnSettlementClickEvent">
                        <span>Settlement</span>
                        <i class="fa fa-chevron-right pull-right mt-1"></i>
                    </a>
                    @if (ShowSettlementMenu)
                    {
                        <ul class="settlement-container rounded w-100 ms-1">
                            <li class="py-2">
                                <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="javascript:void(0)">
                                    Market Settlement
                                </a>
                            </li>
                            <li class="py-2">
                                <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="odds-engine/message-settlement">
                                    Message Settlement
                                </a>
                            </li>
                        </ul>
                    }
                </li>
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3  d-block" href="odds-engine/sport-settings">
                        Sport Settings
                    </a>
                </li>
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="javascript:void(0)" @onclick="OnMarketSettingsClickEvent">
                        <span>Market Settings</span>
                        <i class="fa fa-chevron-right pull-right mt-1"></i>
                    </a>
                    @if (ShowMarketSettingsMenu)
                    {
                        <ul class="market-settings-container rounded w-100 ms-1">
                            <li class="py-2">
                                <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="javascript:void(0)">
                                    Market Sort Order
                                </a>
                            </li>
                            <li class="py-2">
                                <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="odds-engine/market-groups">
                                    Market Group
                                </a>
                            </li>
                        </ul>
                    }
                </li>
            </ul>
        }
    </div>
</div>
