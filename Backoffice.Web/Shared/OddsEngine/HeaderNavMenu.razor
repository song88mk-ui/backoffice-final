<div class="d-flex justify-content-between">
    <div class="d-flex align-items-center">
        @if (_userState.Model.Claims?.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_Monitoring_MatchType.ToString().Replace("_", ".")}") ?? false)
        {
            <div class="px-2 me-2 py-3 @(_menu == OeNavMenu.Monitoring ? "active" : "")">
                <a class="header-link text-decoration-none" href="@_address/monitoring">
                    @_translationState.GetValue("Monitoring")
                </a>
            </div>
        }
        @if (_userState.Model.Claims?.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_Config.ToString().Replace("_", ".")}") ?? false)
        {
            <div class="px-2 me-2 py-3 @(_menu == OeNavMenu.Config ? "active" : "")">
                <a class="header-link text-decoration-none" href="@_address/config-templates">
                    @_translationState.GetValue("Config")
                </a>
            </div>
        }
        @if (_userState.Model.Claims?.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_PriceBoost_Manage.ToString().Replace("_", ".")}"
        || x.Type == $"{SportsbookClientPermission.SBC_OE_PriceBoost_Settings.ToString().Replace("_", ".")}") ?? false)
        {
            <div class="px-2 me-2 py-3 @(_menu == OeNavMenu.PriceBoost ? "active" : "")">
                <a class="header-link text-decoration-none" href="javascript:void(0)" @onclick="HandlePriceBoostClick">
                    <span class="me-3">@_translationState.GetValue("Price Boost")</span>
                    @if (_showPriceBoostMenu)
                    {
                        <i class="fa fa-chevron-up"></i>
                    }
                    else
                    {
                        <i class="fa fa-chevron-down"></i>
                    }
                </a>
                @if (_showPriceBoostMenu)
                {
                    <ul class="sub-menu-container rounded mt-2">
                        @if (_userState.Model.Claims?.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_PriceBoost_Manage.ToString().Replace("_", ".")}") ?? false)
                        {
                            <li class="py-2">
                                <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/manage-boost">
                                    @_translationState.GetValue("Manage Boost")
                                </a>
                            </li>
                        }
                        @if (_userState.Model.Claims?.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_PriceBoost_Settings.ToString().Replace("_", ".")}") ?? false)
                        {
                            <li class="py-2">
                                <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/boosted-settings">
                                    @_translationState.GetValue("Boosted Settings")
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        }

        @if (_userState.Model.Claims?.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_SportsSettings.ToString().Replace("_", ".")}") ?? false)
        {
            <div class="px-2 me-2 py-3 @(_menu == OeNavMenu.SportSettings ? "active" : "")">
                <a class="header-link text-decoration-none" href="@_address/sport-settings">
                    @_translationState.GetValue("Sports Settings")
                </a>
            </div>
        }

        @if (_userState.Model.Claims?.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_Mapping.ToString().Replace("_", ".")}") ?? false)
        {
            <div class="px-2 me-2 py-3 @(_menu == OeNavMenu.Mapping ? "active" : "")">
                <a class="header-link text-decoration-none" href="javascript:void(0)" @onclick="HandleMappingClick">
                    @_translationState.GetValue("Mapping")
                    <i class="fa fa-chevron-@(_showMappingMenu ? "up" : "down")"></i>
                </a>
                @if (_showMappingMenu)
                {
                    <ul class="sub-menu-container rounded mt-2">
                        <li class="py-2">
                            <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/mapping-sports">
                                @_translationState.GetValue("Sports Mapping")
                            </a>
                        </li>
                        <li class="py-2">
                            <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/mapping-leagues">
                                @_translationState.GetValue("League Mapping")
                            </a>
                        </li>
                        <li class="py-2">
                            <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/mapping-fixture">
                                @_translationState.GetValue("Fixture Mapping")
                            </a>
                        </li>
                    </ul>
                }
            </div>
        }

        @if (_userState.Model.Claims?.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_MarketSetting_Group.ToString().Replace("_", ".")}"
        || x.Type == $"{SportsbookClientPermission.SBC_OE_MarketSetting_SortOrder.ToString().Replace("_", ".")}") ?? false)
        {
            <div class="px-2 me-2 py-3 @(_menu == OeNavMenu.MarketSettings ? "active" : "")">
                <a class="header-link text-decoration-none" href="javascript:void(0)" @onclick="HandleMarketSettingsClick">
                    <span class="me-3">@_translationState.GetValue("Market Settings")</span>
                    @if (_showMarketSettingsMenu)
                    {
                        <i class="fa fa-chevron-up"></i>
                    }
                    else
                    {
                        <i class="fa fa-chevron-down"></i>
                    }
                </a>
                @if (_showMarketSettingsMenu)
                {
                    <ul class="sub-menu-container rounded mt-2">
                        @if (_userState.Model.Claims?.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_MarketSetting_SortOrder.ToString().Replace("_", ".")}") ?? false)
                        {
                            <li class="py-2">
                                <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/market-sort-order">
                                    @_translationState.GetValue("Market Sort Order")
                                </a>
                            </li>
                        }
                        @if (_userState.Model.Claims?.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_MarketSetting_Group.ToString().Replace("_", ".")}") ?? false)
                        {
                            <li class="py-2">
                                <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/market-groups">
                                    @_translationState.GetValue("Market Group")
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    </div>

    <LanguageDropDown DropDownButtonClassName="font-white" />
</div>
