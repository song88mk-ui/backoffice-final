<div class="d-flex justify-content-between">
    <div class="d-flex align-items-center">
        @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_Monitoring_MatchType.ToString().Replace("_", ".")}"))
        {
            <div class="px-2 me-2 py-3 @(_menu == OeNavMenu.Monitoring ? "active" : "")">
                <a class="header-link text-decoration-none" href="@_address/monitoring">
                    @TranslationState.GetValue("Monitoring")
                </a>
            </div>
        }
        @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_Config.ToString().Replace("_", ".")}"))
        {
            <div class="px-2 me-2 py-3 @(_menu == OeNavMenu.Config ? "active" : "")">
                <a class="header-link text-decoration-none" href="@_address/config-templates">
                    @TranslationState.GetValue("Config")
                </a>
            </div>
        }
        @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_PriceBoost_Manage.ToString().Replace("_", ".")}"
        || x.Type == $"{SportsbookClientPermission.SBC_OE_PriceBoost_Settings.ToString().Replace("_", ".")}"))
        {
            <div class="px-2 me-2 py-3 @(_menu == OeNavMenu.PriceBoost ? "active" : "")">
                <a class="header-link text-decoration-none" href="javascript:void(0)" @onclick="OnPriceBoostClickEvent">
                    <span class="me-3">@TranslationState.GetValue("Price Boost")</span>
                    @if (_showPriceBoostMenu)
                    {
                        <i class="fa fa-chevron-up"></i>
                    }
                    else
                    {
                        <i class="fa fa-chevron-down"></i>
                    }
                </a>
                @if (_showPriceBoostMenu)
                {
                    <ul class="sub-menu-container rounded mt-2">
                        @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_PriceBoost_Manage.ToString().Replace("_", ".")}"))
                        {
                            <li class="py-2">
                                <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/manage-boost">
                                    @TranslationState.GetValue("Manage Boost")
                                </a>
                            </li>
                        }
                        @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_PriceBoost_Settings.ToString().Replace("_", ".")}"))
                        {
                            <li class="py-2">
                                <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/boosted-settings">
                                    @TranslationState.GetValue("Boosted Settings")
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
        @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_SportsSettings.ToString().Replace("_", ".")}"))
        {
            <div class="px-2 me-2 py-3 @(_menu == OeNavMenu.SportSettings ? "active" : "")">
                <a class="header-link text-decoration-none" href="@_address/sport-settings">
                    @TranslationState.GetValue("Sports Settings")
                </a>
            </div>
        }
        @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_MarketSetting_Group.ToString().Replace("_", ".")}"
        || x.Type == $"{SportsbookClientPermission.SBC_OE_MarketSetting_SortOrder.ToString().Replace("_", ".")}"))
        {
            <div class="px-2 me-2 py-3 @(_menu == OeNavMenu.MarketSettings ? "active" : "")">
                <a class="header-link text-decoration-none" href="javascript:void(0)" @onclick="OnMarketSettingsClickEvent">
                    <span class="me-3">@TranslationState.GetValue("Market Settings")</span>
                    @if (_showMarketSettingsMenu)
                    {
                        <i class="fa fa-chevron-up"></i>
                    }
                    else
                    {
                        <i class="fa fa-chevron-down"></i>
                    }
                </a>
                @if (_showMarketSettingsMenu)
                {
                    <ul class="sub-menu-container rounded mt-2">
                        @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_MarketSetting_SortOrder.ToString().Replace("_", ".")}"))
                        {
                            <li class="py-2">
                                <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/market-sort-order">
                                    @TranslationState.GetValue("Market Sort Order")
                                </a>
                            </li>
                        }
                        @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_MarketSetting_Group.ToString().Replace("_", ".")}"))
                        {
                            <li class="py-2">
                                <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/market-groups">
                                    @TranslationState.GetValue("Market Group")
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    </div>

    <LanguageDropDown DropDownButtonClassName="font-white" />
</div>
