@using Backoffice.Shared.Enums;

<div class="d-flex">
    @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_Monitoring_MatchType.ToString().Replace("_", ".")}"))
    {
        <div class="px-2 me-2 py-3 @(_isActiveMonitoring ? "active" : "")">
            <a class="header-link text-decoration-none" href="@_address/monitoring" @onclick='() => ActivateMenu("monitoring")'>
                Monitoring
            </a>
        </div>
    }
    @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_Config.ToString().Replace("_", ".")}"))
    {
        <div class="px-2 me-2 py-3 @(_isActiveConfig ? "active" : "")">
            <a class="header-link text-decoration-none" href="@_address/config" @onclick='() => ActivateMenu("config")'>
                Config
            </a>
        </div>
    }
    @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_PriceBoost_Manage.ToString().Replace("_", ".")}"
    || x.Type == $"{SportsbookClientPermission.SBC_OE_PriceBoost_Settings.ToString().Replace("_", ".")}"))
    {
        <div class="px-2 me-2 py-3 @(_isActivePriceBoost ? "active" : "")">
            <a class="header-link text-decoration-none" href="javascript:void(0)" @onclick="OnPriceBoostClickEvent">
                <span class="me-3">Price Boost</span>
                @if (_showPriceBoostMenu)
                {
                    <i class="fa fa-chevron-up"></i>
                }
                else
                {
                    <i class="fa fa-chevron-down"></i>
                }
            </a>
            @if (_showPriceBoostMenu)
            {
                <ul class="sub-menu-container rounded mt-2">
                    @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_PriceBoost_Manage.ToString().Replace("_", ".")}"))
                    {
                        <li class="py-2">
                            <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/manage-boost" @onclick='() => ActivateMenu("priceboost")'>
                                Manage Boost
                            </a>
                        </li>
                    }
                    @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_PriceBoost_Settings.ToString().Replace("_", ".")}"))
                    {
                        <li class="py-2">
                            <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/boosted-settings" @onclick='() => ActivateMenu("priceboost")'>
                                Boosted Settings
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    }
    @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_SportsSettings.ToString().Replace("_", ".")}"))
    {
        <div class="px-2 me-2 py-3 @(_isActiveSportSettings ? "active" : "")">
            <a class="header-link text-decoration-none" href="@_address/sport-settings" @onclick='() => ActivateMenu("sport-settings")'>
                Sport Settings
            </a>
        </div>
    }
    @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_MarketSetting_Group.ToString().Replace("_", ".")}"
    || x.Type == $"{SportsbookClientPermission.SBC_OE_MarketSetting_SortOrder.ToString().Replace("_", ".")}"))
    {
        <div class="px-2 me-2 py-3 @(_isActiveMarketSettings ? "active" : "")">
            <a class="header-link text-decoration-none" href="javascript:void(0)" @onclick="OnMarketSettingsClickEvent">
                <span class="me-3">Market Settings</span>
                @if (_showMarketSettingsMenu)
                {
                    <i class="fa fa-chevron-up"></i>
                }
                else
                {
                    <i class="fa fa-chevron-down"></i>
                }
            </a>
            @if (_showMarketSettingsMenu)
            {
                <ul class="sub-menu-container rounded mt-2">
                    @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_MarketSetting_SortOrder.ToString().Replace("_", ".")}"))
                    {
                        <li class="py-2">
                            <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/market-sort-order" @onclick='() => ActivateMenu("market-settings")'>
                                Market Sort Order
                            </a>
                        </li>
                    }
                    @if (UserClaims != null && UserClaims.Any(x => x.Type == $"{SportsbookClientPermission.SBC_OE_MarketSetting_Group.ToString().Replace("_", ".")}"))
                    {
                        <li class="py-2">
                            <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="@_address/market-groups" @onclick='() => ActivateMenu("market-settings")'>
                                Market Group
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</div>
