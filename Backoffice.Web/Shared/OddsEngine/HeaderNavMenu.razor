<div class="d-flex">
    <div class="px-2 me-2 py-3 @(IsActiveMonitoring ? "active" : "")">
        <a class="header-link text-decoration-none" href="odds-engine/monitoring" @onclick='() => ActivateMenu("monitoring")'>
            Monitoring
        </a>
    </div>
    <div class="px-2 me-2 py-3 @(IsActiveConfig ? "active" : "")">
        <a class="header-link text-decoration-none" href="odds-engine/config" @onclick='() => ActivateMenu("config")'>
            Config
        </a>
    </div>
    <div class="px-2 me-2 py-3 @(IsActivePriceBoost ? "active" : "")">
        <a class="header-link text-decoration-none" href="javascript:void(0)" @onclick="OnPriceBoostClickEvent">
            <span class="me-3">Price Boost</span>
            @if (ShowPriceBoostMenu)
            {
                <i class="fa fa-chevron-up"></i>
            }
            else
            {
                <i class="fa fa-chevron-down"></i>
            }
        </a>
        @if (ShowPriceBoostMenu)
        {
            <ul class="sub-menu-container rounded mt-2">
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="odds-engine/manage-boost" @onclick='() => ActivateMenu("priceboost")'>
                        Manage Boost
                    </a>
                </li>
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="odds-engine/boosted-settings" @onclick='() => ActivateMenu("priceboost")'>
                        Boosted Settings
                    </a>
                </li>
            </ul>
        }
    </div>
    <div class="px-2 me-2 py-3 @(IsActiveSportSettings ? "active" : "")">
        <a class="header-link text-decoration-none" href="odds-engine/sport-settings" @onclick='() => ActivateMenu("sport-settings")'>
            Sport Settings
        </a>
    </div>
    <div class="px-2 me-2 py-3 @(IsActiveMarketSettings ? "active" : "")">
        <a class="header-link text-decoration-none" href="javascript:void(0)" @onclick="OnMarketSettingsClickEvent">
            <span class="me-3">Market Settings</span>
            @if (ShowMarketSettingsMenu)
            {
                <i class="fa fa-chevron-up"></i>
            }
            else
            {
                <i class="fa fa-chevron-down"></i>
            }
        </a>
        @if (ShowMarketSettingsMenu)
        {
            <ul class="sub-menu-container rounded mt-2">
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="odds-engine/market-sort-order" @onclick='() => ActivateMenu("market-settings")'>
                        Market Sort Order
                    </a>
                </li>
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3 d-block" href="odds-engine/market-groups" @onclick='() => ActivateMenu("market-settings")'>
                        Market Group
                    </a>
                </li>
            </ul>
        }
    </div>
</div>
