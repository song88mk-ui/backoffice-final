<div class="d-flex">
    <div class="px-2 me-2 py-3 active">
        <a class="header-link text-decoration-none" href="odds-engine/monitoring">
            Monitoring
        </a>
    </div>
    <div class="px-2 me-2 py-3">
        <a class="header-link text-decoration-none" href="javascript:void(0)">
            Config
        </a>
    </div>
    <div class="px-2 me-2 py-3">
        <a class="header-link text-decoration-none" href="javascript:void(0)" @onclick="OnPriceBoostClickEvent">
            <span class="me-3">Price Boost</span>
            @if (ShowPriceBoostMenu)
            {
                <i class="fa fa-chevron-up"></i>
            }
            else
            {
                <i class="fa fa-chevron-down"></i>
            }
        </a>
        @if (ShowPriceBoostMenu)
        {
            <ul class="sub-menu-container rounded mt-2">
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3" href="odds-engine/manage-boost">
                        Manage Boost
                    </a>
                </li>
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3" href="odds-engine/boosted-settings">
                        Boosted Settings
                    </a>
                </li>
            </ul>
        }
    </div>
    <div class="px-2 me-2 py-3">
        <a class="header-link text-decoration-none" href="javascript:void(0)" @onclick="OnAdministrationClickEvent">
            <span class="me-3">Administration</span>
            @if (ShowAdministrationMenu)
            {
                <i class="fa fa-chevron-up"></i>
            }
            else
            {
                <i class="fa fa-chevron-down"></i>
            }
        </a>
        @if (ShowAdministrationMenu)
        {
            <ul class="sub-menu-container rounded mt-2">
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3" href="odds-engine/manage-usergroup">
                        Manage User Groups
                    </a>
                </li>
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3" href="javascript:void(0)">
                        Manage Users
                    </a>
                </li>
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3" href="javascript:void(0)">
                        <span>Settlement</span>
                        <i class="fa fa-chevron-right pull-right me-2 mt-1"></i>
                    </a>
                </li>
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3" href="javascript:void(0)">
                        Sport Settings
                    </a>
                </li>
                <li class="py-2">
                    <a class="sub-header-link text-decoration-none ps-2 pe-3" href="javascript:void(0)">
                        <span>Market Settings</span>
                        <i class="fa fa-chevron-right pull-right me-2 mt-1"></i>
                    </a>
                </li>
            </ul>
        }
    </div>
</div>
