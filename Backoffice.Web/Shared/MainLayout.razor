@using Backoffice.Shared.Enums
@inject NavigationManager NavigationManager

@inherits MainLayoutBase

<CascadingValue Value="UserModel" Name="UserModel">
    <PageTitle>Backoffice</PageTitle>
    <div class="page">
        <div class="sidebar">
            @if (NavigationManager.Uri.Contains("/odds-engine"))
            {
                <NavMenu NavMenuAccess="NavMenuAccess.OE" />
            }
            else
            {
                <NavMenu NavMenuAccess="NavMenuAccess.SBC" />
            }
        </div>
        <main>
            <article class="content px-4">
                <CascadingValue Value="OnSportClickCallback" Name="OnSportClickCallback">
                    <CascadingValue Value="DefaultSport" Name="DefaultSport">
                        @Body
                    </CascadingValue>
                </CascadingValue>
            </article>
        </main>
    </div>
</CascadingValue> 