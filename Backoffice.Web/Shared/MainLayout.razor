@using Backoffice.Shared.Enums
@inject NavigationManager NavigationManager

@inherits MainLayoutBase

<CascadingValue Value="UserModel" Name="UserModel">
    <PageTitle>Backoffice</PageTitle>
    <div class="page">
        @if (IsPreLoader)
        {
            <Preloader />
        }
        else
        {
            <div class="sidebar">
                @if (NavigationManager.Uri.Contains("/admin"))
                {
                    <NavMenu NavMenuAccess="NavMenuAccess.Admin" />
                }
                else
                {
                    <NavMenu NavMenuAccess="NavMenuAccess.SBC" />
                }
            </div>
            <main>
                <Toast ToastMessage="@ToastMessage" ToastTitle="@ToastTitle" IsMessageMarkup="true"/>
                <article class="content px-4">
                    @Body
                </article>
            </main>
        }
    </div>
</CascadingValue> 