@using Backoffice.Shared.Enums
@inherits MainLayoutBase

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        <CascadingValue Value="AuthenticateAccessEvent" Name="AuthenticateAccessEvent">
            <CascadingValue Value="UserModel" Name="UserModel">
                <CascadingValue Value="UserClaims" Name="UserClaims">
                    <CascadingValue Value="UserClientCodes" Name="UserClientCodes">
                        @if (NavigationManager.Uri.Contains("/admin"))
                        {
                            <PageTitle>Backoffice - Administration</PageTitle>
                        }
                        else
                        {
                            <PageTitle>Backoffice - SBC</PageTitle>
                        }

                        @if (IsPreLoader)
                        {
                            <div class="preload-container d-flex justify-content-center align-items-center">
                                <Preloader InlineSpinnerCss="@InlineSpinnerCss" />
                            </div>
                        }
                        else
                        {
                            <div class="page">
                                <div class="sidebar">
                                    @if (NavigationManager.Uri.Contains("/admin"))
                                    {
                                        <NavMenu NavMenuAccess="PermissionCategory.Admin" NavMenus="NavMenus" />
                                    }
                                    else
                                    {
                                        <NavMenu NavMenuAccess="PermissionCategory.SBC" NavMenus="NavMenus" />
                                    }
                                </div>
                                <main>
                                    <article class="content px-4">
                                        @Body
                                    </article>
                                </main>
                            </div>
                        }
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
        <ToastComponent />
    </ChildContent>
    <ErrorContent Context="errorException">
        <div id="blazor-error-ui">
            <div class="blazor-error-body">
                <script>
                    console.log(@errorException)
                </script>
            </div>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private ErrorBoundary? _errorBoundary;

    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }
}