@using Backoffice.Shared.Enums
@inject NavigationManager NavigationManager

@inherits MainLayoutBase

<CascadingValue Value="Token" Name="Token">
    <CascadingValue Value="AuthenticateAccessEvent" Name="AuthenticateAccessEvent">
        <CascadingValue Value="UserModel" Name="UserModel">
            @if (NavigationManager.Uri.Contains("/admin"))
            {
                <PageTitle>Backoffice - Administration</PageTitle>
            }
            else
            {
                <PageTitle>Backoffice - SBC</PageTitle>
            }

            @if (IsPreLoader)
            {
                <div class="preload-container d-flex justify-content-center align-items-center">
                    <Preloader InlineSpinnerCss="@InlineSpinnerCss" />
                </div>
            }
            else
            {
                <div class="page">
                    <div class="sidebar">
                        @if (NavigationManager.Uri.Contains("/admin"))
                        {
                            <NavMenu NavMenuAccess="PermissionCategory.Admin" NavMenus="NavMenus" />
                        }
                        else
                        {
                            <NavMenu NavMenuAccess="PermissionCategory.SBC" NavMenus="NavMenus" />
                        }
                    </div>
                    <main>
                        <article class="content px-4">
                            @Body
                        </article>
                    </main>
                </div>
            }
        </CascadingValue>
    </CascadingValue>
</CascadingValue>
<ToastComponent />