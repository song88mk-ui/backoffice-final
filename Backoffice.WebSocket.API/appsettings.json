{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*",
  "Security": {
    "Enforce": false,
    "PublisherApiKey": "",
    "SubscriberApiKey": ""
  },
  "API": {
    "AuthenticationAPI": {
      "JWT": {
        "Issuer": "bo.auth.api",
        "Key": ""
      }
    }
  },
  "Telemetry": {
    "Environment": "dev",
    "Enabled": false
  }
}
