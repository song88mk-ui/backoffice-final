{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "MessageBroker": {
    "Host": "vmsws1.eastasia.cloudapp.azure.com",
    "Username": "fcadmin",
    "Password": "${RABBITMQ_PASSWORD}",
    "VirtualHost": "/",
    "Exchange": "e.central",
    "Queue": "q.bo.util",
    "Consumer": "BO.Utility",
    "RoutingKey": "r.bo.util.#"
  },
  "Custom": {
    "AzureStorage": "${AZURE_STORAGE_CONNECTION_STRING}",
    "Hub": "https://preprod-bo.song88.com/bohub"
  },
  "ConnectionStrings": {
    "Backoffice": "Data Source=23.100.93.193, 1433;Database=Backoffice;User Id=sa;Password=${DB_PASSWORD};"
  },
  "Telemetry": {
    "Environment": "dev",
    "Enabled": false
  }
}
